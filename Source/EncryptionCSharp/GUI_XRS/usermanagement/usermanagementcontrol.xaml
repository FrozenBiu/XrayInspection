<UserControl
	x:Class="GUI_XRS.UsermanagementControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:d="clr-namespace:System.ComponentModel;assembly=PresentationFramework"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="UsermanagementControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary />
	</FrameworkElement.Resources>
	<Grid>
		<Grid>
			<Border
				Margin="20,0,20,0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock
						Name="tbCurrentUser"
						Grid.Row="0"
						VerticalAlignment="Center"
						FontSize="25"
						FontWeight="Bold"
						FontFamily="Helvetica"
						Text="{Binding Path=CurrentUser.Username}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Text="{Binding Path=UserID.LocalizedText, FallbackValue=Benutzer ID}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Margin="200,0,0,0"
						Text="{Binding Path=UserName.LocalizedText, FallbackValue=Benutzername}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Margin="400,0,0,0"
						Text="{Binding Path=UserGroup.LocalizedText, FallbackValue=Benutzergruppe}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Margin="600,0,0,0"
						Text="{Binding Path=UserRfid.LocalizedText, FallbackValue=Rfid}" />
					<ListBox
						Name="lstUsers"
						Grid.Row="2"
						Background="#00FFFFFF"
						SelectionMode="Single"
						IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding Path=UserList}"
						SelectedItem="{Binding Path=SelectedUser}">
						<ItemsControl.ItemContainerStyle>
							<!--Unknown connection ID: 4-->
							<Style
								TargetType="{x:Type ListBoxItem}" />
						</ItemsControl.ItemContainerStyle>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid
									Height="50">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="200" />
										<ColumnDefinition
											Width="200" />
										<ColumnDefinition
											Width="200" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<TextBlock
										Name="tbID"
										Grid.Column="0"
										FontSize="20"
										FontFamily="Helvetica"
										VerticalAlignment="Center"
										TextWrapping="Wrap"
										Margin="5"
										Text="{Binding Path=ID}" />
									<TextBlock
										Name="tbUsername"
										Grid.Column="1"
										FontSize="20"
										FontFamily="Helvetica"
										VerticalAlignment="Center"
										TextWrapping="Wrap"
										Margin="5"
										Text="{Binding Path=Username}" />
									<TextBlock
										Name="tbGroup"
										Grid.Column="2"
										FontSize="20"
										FontFamily="Helvetica"
										VerticalAlignment="Center"
										TextWrapping="Wrap"
										Margin="5"
										Text="{Binding Path=Userlevel}" />
									<Image
										Name="tbRfid"
										Grid.Column="3"
										VerticalAlignment="Center"
										Margin="5">
										<FrameworkElement.Style>
											<Style
												TargetType="{x:Type Image}">
												<Setter
													Property="Source"
													Value="/img/rfid.png" />
												<Style.Triggers>
													<DataTrigger
														Value="Disabled"
														Binding="{Binding Path=Rfid}">
														<Setter
															Property="Source"
															Value="/img/rfid_disabled.png" />
													</DataTrigger>
													<DataTrigger
														Value="{x:Static sys:String.Empty}"
														Binding="{Binding Path=Rfid}">
														<Setter
															Property="Source"
															Value="{x:Null}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</FrameworkElement.Style>
									</Image>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ListBox>
					<StackPanel
						Grid.Row="3"
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						Margin="0,5,0,0">
						<Image
							Source="..\img\zoom2.png"
							HorizontalAlignment="Right"
							Height="30" />
						<TextBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							Width="200"
							Margin="5 5 5 5"
							FontSize="20"
							common:MouseCommandBehavior.MouseUpCommand="{Binding UserSearch.SearchTextInListCommand}"
							Text="{Binding UserSearch.SearchText}"
							Foreground="{Binding UserSearch.SearchTextBrush}"
							TextAlignment="{Binding UserSearch.SearchTextAlignment}" />
						<Button
							Name="Filter"
							Command="{Binding ResetFilterCommand}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource defaultButtonStyle}"
									TargetType="{x:Type Button}">
									<Setter
										Property="IsEnabled"
										Value="{Binding IsFilterActive}" />
									<Setter
										Property="Content">
										<Setter.Value>
											<Image
												Source="/img/filter_inaktiv.png"
												Width="34"
												Margin="0,5,0,0" />
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding IsFilterActive}">
											<Setter
												Property="Content">
												<Setter.Value>
													<Image
														Source="/img/filter_aktiv.png"
														Width="34"
														Margin="0,5,0,0" />
												</Setter.Value>
											</Setter>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
