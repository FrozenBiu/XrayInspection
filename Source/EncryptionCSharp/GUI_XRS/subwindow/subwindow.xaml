<Window
	x:Class="GUI_XRS.Subwindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Name="subWindow"
	Title="Subwindow"
	ResizeMode="NoResize"
	WindowStartupLocation="Manual"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	WindowState="{Binding WState}"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}"
	Closing="Window_Closing"
	Loaded="Window_Loaded"
	ButtonBase.Click="subWindow_Click"
	MouseUp="subWindow_MouseUp"
	Unloaded="subWindow_Unloaded"
	ContentRendered="subWindow_ContentRendered">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:MachineTypeEntryOrHigherGridLengthFixedValueConverter
				x:Key="machineTypeEntryOrHigherGridLengthFixedValueConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="overlay">
		<Grid
			Name="subWindowContent">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding Source={StaticResource MainWindowHeaderHeight}}" />
				<RowDefinition
					Name="subWindowContentRow" />
				<RowDefinition
					Height="{Binding Source={StaticResource MainWindowFooterHeight}}" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition>
					<ColumnDefinition.Width>
						<MultiBinding
							Converter="{StaticResource machineTypeEntryOrHigherGridLengthFixedValueConverter}">
							<Binding
								Path="DataContext.Machine.MachineType" />
							<Binding
								Source="{StaticResource MainWindowMainMenuWidth}" />
						</MultiBinding>
					</ColumnDefinition.Width>
				</ColumnDefinition>
			</Grid.ColumnDefinitions>
			<Grid
				Name="mainGrid"
				Row="1"
				ColumnSpan="1">
				<Border
					Name="brdMainGrid"
					BorderBrush="#ffffff"
					BorderThickness="0 1 0 0"
					Background="{Binding BrushBackground}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="5" />
							<RowDefinition />
							<RowDefinition
								Height="80" />
						</Grid.RowDefinitions>
						<Grid
							Name="contentGrid"
							Row="1" />
						<Border
							Name="mainContent"
							Grid.Row="2"
							Margin="25 5 0 0"
							BorderBrush="#7e7e7e"
							BorderThickness="0 1 0 0">
							<Border
								BorderBrush="#ffffff"
								BorderThickness="0 1 0 0">
								<Grid>
									<Grid
										Name="buttonGrid">
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="20" />
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="50" />
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="50" />
											<ColumnDefinition
												Width="Auto" />
										</Grid.ColumnDefinitions>
										<Button
											Name="btnCancel"
											Style="{StaticResource defaultButtonStyle}"
											Grid.Column="0"
											HorizontalAlignment="Left"
											Visibility="{Binding CancelVisibility}"
											Click="cancel_Click">
											<Image
												Source="..\img\return.png"
												Stretch="None" />
										</Button>
										<Button
											Name="btnConfirm"
											Style="{StaticResource okButtonStyle}"
											Grid.Column="2"
											HorizontalAlignment="Left"
											Visibility="{Binding ConfirmVisibility}"
											Click="confirm_Click">
											<Image
												Source="..\img\ok.png"
												Stretch="None" />
										</Button>
										<Button
											Name="btnHome"
											Style="{StaticResource defaultButtonStyle}"
											Grid.Column="0"
											HorizontalAlignment="Left"
											Visibility="{Binding HomeVisibility}"
											Click="btnHome_Click">
											<Image
												Source="..\img\home.png"
												Stretch="None" />
										</Button>
										<Button
											Name="btnBack"
											Style="{StaticResource defaultButtonStyle}"
											Grid.Column="2"
											HorizontalAlignment="Left"
											Visibility="{Binding BackVisibility}"
											Click="back_Click">
											<Image
												Source="..\img\return.png"
												Stretch="None" />
										</Button>
										<StackPanel
											Name="buttonPanel"
											Grid.Column="4"
											VerticalAlignment="Stretch"
											Orientation="Horizontal" />
										<StackPanel
											Grid.Column="6"
											VerticalAlignment="Stretch"
											Orientation="Horizontal">
											<Grid
												Visibility="{Binding AutotrainVisibility}">
												<Grid.ColumnDefinitions>
													<ColumnDefinition />
													<ColumnDefinition />
													<ColumnDefinition />
													<ColumnDefinition />
													<ColumnDefinition />
													<ColumnDefinition />
												</Grid.ColumnDefinitions>
												<Grid.RowDefinitions>
													<RowDefinition />
													<RowDefinition />
												</Grid.RowDefinitions>
												<TextBlock
													Margin="0 0 10 0"
													Grid.Column="0"
													Grid.Row="0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													FontSize="20"
													FontWeight="Bold"
													Text="{Binding Path=StrAutoKVActive.LocalizedText, FallbackValue=AutoKV}" />
												<Image
													Source="/img/minus_small.png"
													Grid.Column="1"
													Grid.Row="0"
													Height="4"
													Margin="0,13,30,0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													Visibility="{Binding Path=AutoKVCheckBox, Converter={StaticResource bVisConverter}}" />
												<TextBlock
													Margin="0 0 20 0"
													Grid.Column="1"
													Grid.Row="0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													FontSize="20"
													Text="{Binding Path=AutoKVText}" />
												<TextBlock
													Margin="0 0 5 0"
													Grid.Column="2"
													Grid.Row="0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													FontSize="20"
													FontWeight="Bold"
													Text="{Binding Path=StrXRayVoltage.LocalizedText, FallbackValue=Röntgenspannung}" />
												<TextBlock
													Margin="0 0 20 0"
													Grid.Column="3"
													Grid.Row="0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													FontSize="20"
													Text="{Binding Path=VoltageText}" />
												<TextBlock
													Margin="0 0 5 0"
													Grid.Column="2"
													Grid.Row="1"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													FontSize="20"
													FontWeight="Bold"
													Text="{Binding Path=StrXRayCurrent.LocalizedText, FallbackValue=Röntgenstrom}" />
												<TextBlock
													Margin="0 0 20 0"
													Grid.Column="3"
													Grid.Row="1"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													FontSize="20"
													Text="{Binding Path=MAText}" />
												<TextBlock
													Margin="0 0 5 0"
													Grid.Column="4"
													Grid.Row="0"
													FontSize="20"
													FontWeight="Bold"
													Text="{Binding Path=StrAutoEdgeFilterActive.LocalizedText, FallbackValue=AutoKantenfilter}" />
												<CheckBox
													Margin="0,2,20,0"
													Grid.Row="0"
													Grid.Column="5"
													Height="26"
													Width="26"
													HorizontalAlignment="Left"
													IsEnabled="False"
													VerticalAlignment="Top"
													Style="{StaticResource StyleCheckBoxDisplay}"
													IsChecked="{Binding Path=AutoEdgeFilterEnable}" />
												<TextBlock
													Margin="0 0 5 0"
													Grid.Column="4"
													Grid.Row="1"
													FontSize="20"
													FontWeight="Bold"
													Text="{Binding Path=StrEdgeFilterActive.LocalizedText, FallbackValue=Kantenfilter aktiv}" />
												<CheckBox
													Margin="0,2,20,0"
													Grid.Row="1"
													Grid.Column="5"
													Height="26"
													Width="26"
													HorizontalAlignment="Left"
													IsEnabled="False"
													VerticalAlignment="Top"
													Style="{StaticResource StyleCheckBoxDisplay}"
													IsChecked="{Binding Path=EdgeActive}" />
											</Grid>
										</StackPanel>
									</Grid>
									<StackPanel
										Name="panelRightAligned"
										VerticalAlignment="Center"
										HorizontalAlignment="Right" />
								</Grid>
							</Border>
						</Border>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>
