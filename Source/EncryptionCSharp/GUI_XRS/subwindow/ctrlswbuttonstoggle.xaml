<UserControl
	x:Class="GUI_XRS.CtrlSWButtonsToggle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS">
	<Grid>
		<ToggleButton
			Name="btn"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Right"
			Width="140"
			Height="45"
			Checked="btn_Checked"
			Unchecked="btn_Unchecked">
			<Control.Template>
				<ControlTemplate
					TargetType="{x:Type ToggleButton}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Border
							BorderThickness="2"
							CornerRadius="1"
							Grid.ColumnSpan="4">
							<Border.BorderBrush>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#888888" />
									<GradientStop
										Offset="0.60"
										Color="#333333" />
								</LinearGradientBrush>
							</Border.BorderBrush>
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#b8e409" />
									<GradientStop
										Offset="1.00"
										Color="#7B9907" />
								</LinearGradientBrush>
							</Border.Background>
						</Border>
						<Border
							Name="borderClicked"
							BorderThickness="2"
							CornerRadius="1"
							Grid.ColumnSpan="4"
							Opacity="0">
							<Border.BorderBrush>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#888888" />
									<GradientStop
										Offset="0.60"
										Color="#333333" />
								</LinearGradientBrush>
							</Border.BorderBrush>
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#7B9907" />
									<GradientStop
										Offset="1.00"
										Color="#b8e409" />
								</LinearGradientBrush>
							</Border.Background>
						</Border>
						<Polygon
							Name="triangle"
							Stroke="#FF000000"
							Fill="#333333"
							Points="0,8 7,17 14,8"
							Margin="8 0 0 0"
							RenderTransformOrigin="0.5,0.5"
							VerticalAlignment="Center"
							HorizontalAlignment="Left">
							<UIElement.RenderTransform>
								<RotateTransform
									Angle="90" />
							</UIElement.RenderTransform>
						</Polygon>
						<Canvas
							Grid.Column="1"
							Margin="0 0 58 20"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
							<Ellipse
								Stroke="#FF000000"
								Width="20"
								Height="20"
								StrokeThickness="2" />
							<Ellipse
								Canvas.Left="30"
								Stroke="#FF000000"
								Width="20"
								Height="20"
								StrokeThickness="2" />
							<Line
								Stroke="#FF000000"
								X1="11"
								X2="39"
								Y1="1"
								Y2="1"
								StrokeThickness="2" />
							<Line
								Stroke="#FF000000"
								X1="11"
								X2="39"
								Y1="19"
								Y2="19"
								StrokeThickness="2" />
							<TextBlock
								Text="M"
								Canvas.Left="34"
								Canvas.Top="2"
								FontWeight="Bold"
								FontSize="12" />
						</Canvas>
						<TextBlock
							Text="/"
							Grid.Column="2"
							VerticalAlignment="Center"
							TextAlignment="Right"
							FontSize="22"
							FontWeight="Bold"
							Margin="0 0 0 4" />
						<Image
							Source="/img/xray.png"
							Grid.Column="3"
							Width="32"
							HorizontalAlignment="Left"
							Margin="1 0 0 0" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="True">
							<TriggerBase.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="triangle"
											Storyboard.TargetProperty="RenderTransform.Angle"
											From="90"
											To="0"
											Duration="00:00:0.3" />
									</Storyboard>
								</BeginStoryboard>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="borderClicked"
											Storyboard.TargetProperty="Opacity"
											From="0"
											To="1"
											Duration="00:00:0.05" />
									</Storyboard>
								</BeginStoryboard>
							</TriggerBase.EnterActions>
							<TriggerBase.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="triangle"
											Storyboard.TargetProperty="RenderTransform.Angle"
											From="0"
											To="90"
											Duration="00:00:0.3" />
									</Storyboard>
								</BeginStoryboard>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="borderClicked"
											Storyboard.TargetProperty="Opacity"
											From="1"
											To="0"
											Duration="00:00:0.05" />
									</Storyboard>
								</BeginStoryboard>
							</TriggerBase.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Control.Template>
		</ToggleButton>
	</Grid>
</UserControl>
