<UserControl
	x:Class="GUI_XRS.CtrlSWButtons" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		BorderBrush="#999999"
		BorderThickness="1"
		CornerRadius="1">
		<Border.Background>
			<LinearGradientBrush
				StartPoint="0 0"
				EndPoint="0 1">
				<GradientStop
					Offset="0.0"
					Color="#CCCCCC" />
				<GradientStop
					Offset="1.0"
					Color="#AAAAAA" />
			</LinearGradientBrush>
		</Border.Background>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="120" />
			</Grid.ColumnDefinitions>
			<ContentControl
				Margin="5 5 5 0"
				Grid.Row="0"
				Template="{StaticResource TemplateConveyorButtons}" />
			<Grid
				Column="1">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock
					Text="Röntgenstrahlung starten"
					TextAlignment="Center"
					FontWeight="Bold"
					FontSize="13"
					TextWrapping="Wrap" />
				<Button
					Name="btnStartXRay"
					Grid.Row="1"
					Height="70"
					Width="70"
					Margin="10 0 10 5"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Center">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1"
								x:Key="EllipseDarkStroke">
								<GradientStop
									Offset="0.00"
									Color="#666666" />
								<GradientStop
									Offset="1.00"
									Color="#191919" />
							</LinearGradientBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1"
								x:Key="EllipseStroke">
								<GradientStop
									Offset="0.00"
									Color="#ca5050" />
								<GradientStop
									Offset="0.60"
									Color="#730000" />
							</LinearGradientBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1"
								x:Key="EllipseUpFill">
								<GradientStop
									Offset="0.00"
									Color="#ee0000" />
								<GradientStop
									Offset="1.00"
									Color="#aa0000" />
							</LinearGradientBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1"
								x:Key="EllipseDownFill">
								<GradientStop
									Offset="1.00"
									Color="#ee0000" />
								<GradientStop
									Offset="0.00"
									Color="#aa0000" />
							</LinearGradientBrush>
						</ResourceDictionary>
					</FrameworkElement.Resources>
					<Control.Template>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Grid>
								<Ellipse
									StrokeThickness="3"
									Stroke="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="btnXRayBorderUp"
									Height="65"
									Width="65"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="65"
									Width="65"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Control.Template>
				</Button>
			</Grid>
		</Grid>
	</Border>
</UserControl>
