<UserControl
	x:Class="GUI_XRS.HistoryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="UserControl_Unloaded"
	Loaded="UserControl_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:ImageSelectionBoolToBackgroundColorConverter
				x:Key="imageSelectionBoolToBackgroundColorConverter" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Disabled" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<StackPanel
											Orientation="Horizontal"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtBlockStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="10 0 10 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="30" />
				<Setter
					Property="Width"
					Value="30" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="1"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="25"
									Width="25"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="25"
									Width="25"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				x:Key="TextBlock2">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
				<Setter
					Property="HorizontalAlignment"
					Value="Center" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Center" />
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding Widescreen}">
						<Setter
							Property="FontSize"
							Value="30" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding Widescreen}">
						<Setter
							Property="FontSize"
							Value="20" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="15*" />
			<RowDefinition
				Height="10*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<image:XRSImageBox
				Name="imagebox"
				Grid.Row="0"
				Grid.Column="0"
				Loaded="imagebox_Loaded" />
			<Border
				Grid.Row="1"
				Margin="5 5 5 0"
				Visibility="{Binding RetrainMax, Converter={StaticResource bVisConverter}}">
				<Border.Background>
					<LinearGradientBrush
						StartPoint="0,0"
						EndPoint="0,1">
						<GradientStop
							Color="#f2e998"
							Offset="0" />
						<GradientStop
							Color="#f4e21d"
							Offset="1" />
					</LinearGradientBrush>
				</Border.Background>
				<StackPanel
					Orientation="Horizontal">
					<Border>
						<Image
							Source="/img/info.png"
							Height="25"
							Margin="2" />
					</Border>
					<Label
						Grid.Row="0"
						Background="#00FFFFFF"
						FontFamily="Helvetica"
						FontSize="15"
						Content="{Binding Path=StrRetrainMax.LocalizedText, FallbackValue=Maximale Anzahl Bilder für Retrain erreicht}" />
				</StackPanel>
			</Border>
		</Grid>
		<Grid
			Name="subGrid"
			Background="#e7efc5"
			Row="0"
			Column="0"
			HorizontalAlignment="Right"
			Margin="0,0,0,0"
			Width="250"
			VerticalAlignment="Stretch"
			Visibility="{Binding FileListVisible, Converter={StaticResource bVisConverter}}">
			<TreeView
				Name="listTree"
				Grid.Row="0"
				Grid.Column="0"
				HorizontalAlignment="Right"
				Margin="0,0,0,0"
				BorderThickness="0 0 0 0"
				VerticalAlignment="Top"
				Width="250">
				<ItemsControl.ItemTemplate>
					<HierarchicalDataTemplate
						DataType="x:Type self:Data"
						ItemsSource="{Binding Items}">
						<TextBlock
							Background="#e7efc5"
							Text="{Binding name}" />
					</HierarchicalDataTemplate>
				</ItemsControl.ItemTemplate>
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type TreeViewItem}"
							x:Key="{x:Type TreeViewItem}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type TreeViewItem}">
										<Border
											Name="Bd"
											Padding="5 0 0 0">
											<Grid>
												<Expander
													Name="Exp">
													<FrameworkElement.Resources>
														<ResourceDictionary>
															<Style
																TargetType="{x:Type Expander}"
																x:Key="{x:Type Expander}">
																<Setter
																	Property="Expander.IsExpanded"
																	Value="{Binding Path=topLevel}" />
																<Setter
																	Property="Template">
																	<Setter.Value>
																		<ControlTemplate
																			TargetType="{x:Type Expander}">
																			<StackPanel
																				Orientation="Vertical">
																				<StackPanel
																					Orientation="Horizontal"
																					Margin="0 7 0 0">
																					<ToggleButton
																						Name="toggleBtn"
																						Margin="0 0 5 0"
																						Style="{StaticResource okButtonStyle}"
																						Visibility="{Binding Path=lowerLevel, Converter={StaticResource bVisConverter}}"
																						IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
																						<ContentControl.ContentTemplate>
																							<DataTemplate>
																								<Image
																									Name="rotateMe"
																									Source="..\img\arrow.png"
																									Stretch="None"
																									RenderTransformOrigin="0.5,0.5">
																									<UIElement.RenderTransform>
																										<RotateTransform />
																									</UIElement.RenderTransform>
																								</Image>
																								<DataTemplate.Triggers>
																									<DataTrigger
																										Value="True"
																										Binding="{Binding ElementName=toggleBtn, Path=IsChecked}">
																										<TriggerBase.EnterActions>
																											<BeginStoryboard>
																												<Storyboard>
																													<DoubleAnimation
																														Storyboard.TargetName="rotateMe"
																														Storyboard.TargetProperty="RenderTransform.Angle"
																														To="90"
																														Duration="0:0:0.3" />
																												</Storyboard>
																											</BeginStoryboard>
																										</TriggerBase.EnterActions>
																										<TriggerBase.ExitActions>
																											<BeginStoryboard>
																												<Storyboard>
																													<DoubleAnimation
																														Storyboard.TargetName="rotateMe"
																														Storyboard.TargetProperty="RenderTransform.Angle"
																														To="0"
																														Duration="0:0:0.3" />
																												</Storyboard>
																											</BeginStoryboard>
																										</TriggerBase.ExitActions>
																									</DataTrigger>
																								</DataTemplate.Triggers>
																							</DataTemplate>
																						</ContentControl.ContentTemplate>
																					</ToggleButton>
																					<ContentPresenter
																						Content="{TemplateBinding Header}" />
																				</StackPanel>
																				<ContentPresenter
																					Name="mainContent"
																					Visibility="Collapsed" />
																			</StackPanel>
																			<ControlTemplate.Triggers>
																				<Trigger
																					Property="Expander.IsExpanded"
																					Value="True">
																					<Setter
																						TargetName="mainContent"
																						Property="Visibility"
																						Value="Visible" />
																				</Trigger>
																			</ControlTemplate.Triggers>
																		</ControlTemplate>
																	</Setter.Value>
																</Setter>
															</Style>
														</ResourceDictionary>
													</FrameworkElement.Resources>
													<HeaderedContentControl.Header>
														<ContentPresenter
															ContentSource="Header" />
													</HeaderedContentControl.Header>
													<ItemsPresenter />
												</Expander>
												<Border
													Name="CntPres"
													Visibility="Collapsed"
													BorderThickness="1"
													BorderBrush="#e7efc5"
													Margin="20 5 0 0">
													<StackPanel
														Orientation="Horizontal">
														<CheckBox
															Margin="5 0 0 0"
															Visibility="{Binding Path=IsCheckedVisible, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}"
															IsChecked="{Binding Path=IsChecked, Mode=TwoWay}" />
														<ContentPresenter
															ContentSource="Header" />
													</StackPanel>
												</Border>
											</Grid>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger
												Property="ItemsControl.HasItems"
												Value="False">
												<Setter
													TargetName="Exp"
													Property="Visibility"
													Value="Collapsed" />
												<Setter
													TargetName="CntPres"
													Property="Visibility"
													Value="Visible" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</TreeView>
		</Grid>
		<Border
			Grid.Row="1"
			Padding="5 7 5 7"
			Margin="0 5 0 5"
			BorderBrush="#8e9192"
			BorderThickness="1">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid
				Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="12*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="3*" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<Button
						Grid.Column="0"
						Grid.Row="0"
						Style="{StaticResource btnMainMenu}"
						Margin="0 0 5 0"
						Click="Button_ScrollFirst">
						<Image
							Source="..\img\arrow2-left.png"
							Stretch="None"
							VerticalAlignment="Top" />
					</Button>
					<TextBlock
						Grid.Row="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Style="{StaticResource TextBlock2}"
						Text="{Binding Path=Number}" />
				</Grid>
				<ListBox
					Name="lstImages"
					Grid.Column="1"
					SelectionMode="Multiple"
					ItemsSource="{Binding Path=Preview.PreviewItems}"
					SelectedItem="{Binding Path=FirstSelected}"
					SelectionChanged="SelectedItems">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition />
									<ColumnDefinition
										Width="5" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition
										Height="40" />
								</Grid.RowDefinitions>
								<Image
									Grid.Column="1"
									Grid.Row="0"
									Margin="0"
									MaxWidth="150"
									Source="{Binding Path=BitmapThumbnail}" />
								<Border
									Grid.Column="1"
									Grid.Row="0"
									Background="#00FFFFFF"
									Margin="-7 0 -7 0" />
								<TextBlock
									Grid.Column="1"
									Grid.Row="1"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="10"
									Margin="0 0 0 0"
									Text="{Binding Path=Timestamp}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}">
							<Setter
								Property="common:ListBoxItemBehavior.IsBroughtIntoViewWhenSelected"
								Value="True" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ListBoxItem}">
										<Border
											Name="Border"
											Padding="2"
											SnapsToDevicePixels="True">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger
												Property="ListBoxItem.IsSelected"
												Value="True">
												<Setter
													TargetName="Border"
													Property="Background"
													Value="#c9db53" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ItemsControl.ItemContainerStyle>
				</ListBox>
				<Grid
					Column="2">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="3*" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<Button
						Grid.Column="0"
						Grid.Row="0"
						Style="{StaticResource btnMainMenu}"
						Margin="5 0 0 0"
						Click="Button_ScrollLast">
						<Image
							Source="..\img\arrow2-right.png"
							Stretch="None"
							VerticalAlignment="Top" />
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
