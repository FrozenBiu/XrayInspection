<UserControl
	x:Class="GUI_XRS.CtrlFullscreenImage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS"
	Loaded="UserControl_Loaded"
	Unloaded="UserControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtBlockStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="10 0 10 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="fGrid">
		<TabControl
			Name="tabControl"
			IsSynchronizedWithCurrentItem="True"
			ItemsSource="{Binding RegionImages}"
			SelectedItem="{Binding SelectedRegionImage}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<TextBlock
						Style="{StaticResource txtBlockStyle}"
						FontSize="14"
						Margin="1 1 1 1"
						Text="{Binding Path=XrsImage.ProductName}" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
			<TabControl.ContentTemplate>
				<DataTemplate>
					<Grid>
						<image:XRSImageBox
							UserLoggedIn="True"
							Margin="2"
							Image="{Binding Path=DataContext.XrsImage, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" />
					</Grid>
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>
	</Grid>
</UserControl>
