<UserControl
	x:Class="GUI_XRS.CtrlAI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:image="clr-namespace:XrsImage;assembly=XrsImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="CtrlAI_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:ImageSelectionBoolToBackgroundColorConverter
				x:Key="imageSelectionBoolToBackgroundColorConverter" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Disabled" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<StackPanel
											Orientation="Horizontal"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtBlockStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="10 0 10 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="15*" />
			<RowDefinition
				Height="10*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<image:XRSImageBox
				Name="imagebox"
				Grid.Row="0"
				Grid.Column="0" />
			<Border
				Grid.Row="1"
				Margin="5 5 5 0"
				Visibility="{Binding ShowFineTuningMessage, Converter={StaticResource bVisConverter}}">
				<Border.Background>
					<LinearGradientBrush
						StartPoint="0,0"
						EndPoint="0,1">
						<GradientStop
							Color="#f2e998"
							Offset="0" />
						<GradientStop
							Color="#f4e21d"
							Offset="1" />
					</LinearGradientBrush>
				</Border.Background>
				<StackPanel
					Orientation="Horizontal">
					<Border>
						<Image
							Source="/img/info.png"
							Height="25"
							Margin="2" />
					</Border>
					<Label
						Grid.Row="0"
						Background="#00FFFFFF"
						FontFamily="Helvetica"
						FontSize="15"
						Content="{Binding Path=StrFineTuningMessage.LocalizedText, FallbackValue=Minimale Anzahl an Bilder für Fine-Tuning nicht erreicht}" />
				</StackPanel>
			</Border>
		</Grid>
		<Border
			Grid.Row="1"
			Padding="5 7 5 7"
			Margin="0 5 0 5"
			BorderBrush="#8e9192"
			BorderThickness="1">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="12*" />
				</Grid.ColumnDefinitions>
				<Grid
					Column="0">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<ToggleButton
						Grid.Row="0"
						Style="{StaticResource btnMainMenu}"
						Margin="0 0 5 0"
						IsChecked="{Binding ShowRejectImages, Mode=TwoWay}">
						<ContentControl.Content>
							<Image
								Stretch="Uniform"
								Margin="4,4,2,2"
								MaxHeight="40"
								Source="{Binding ButtonImageRejectsPath}" />
						</ContentControl.Content>
					</ToggleButton>
					<ToggleButton
						Grid.Row="1"
						Style="{StaticResource btnMainMenu}"
						Margin="0 0 5 0"
						IsChecked="{Binding ShowOkImages, Mode=TwoWay}">
						<ContentControl.Content>
							<Image
								Stretch="Uniform"
								Margin="4,4,2,2"
								MaxHeight="40"
								Source="{Binding ButtonImageOkPath}" />
						</ContentControl.Content>
					</ToggleButton>
					<ToggleButton
						Grid.Row="2"
						Style="{StaticResource btnMainMenu}"
						Margin="0 0 5 0"
						IsChecked="{Binding ShowAllImages, Mode=TwoWay}">
						<ContentControl.Content>
							<Image
								Stretch="Uniform"
								Margin="4,4,2,2"
								MaxHeight="40"
								Source="{Binding ButtonImageAllPath}" />
						</ContentControl.Content>
					</ToggleButton>
					<ToggleButton
						Grid.Row="3"
						Style="{StaticResource btnMainMenu}"
						Margin="0 0 5 0"
						IsChecked="{Binding ShowDatasetImages, Mode=TwoWay}">
						<ContentControl.Content>
							<Image
								Stretch="Uniform"
								Margin="4,4,2,2"
								MaxHeight="40"
								Source="{Binding ButtonImageDatasetPath}" />
						</ContentControl.Content>
					</ToggleButton>
					<TextBlock
						Grid.Row="4"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Style="{StaticResource txtBlockStyle}"
						FontSize="35"
						Margin="0 0 5 0"
						Text="{Binding Path=SelectedItemCount}" />
					<Border
						Grid.Row="1"
						Background="#00FFFFFF"
						Visibility="{Binding HistoryisLoading, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
					<Border
						Grid.Row="2"
						Background="#00FFFFFF"
						Visibility="{Binding HistoryisLoading, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
					<Border
						Grid.Row="3"
						Background="#00FFFFFF"
						Visibility="{Binding HistoryisLoading, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
					<Border
						Grid.Row="4"
						Background="#00FFFFFF"
						Visibility="{Binding HistoryisLoading, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
				</Grid>
				<ListBox
					Name="listImages"
					Grid.Column="1"
					SelectionMode="Multiple"
					ItemsSource="{Binding Path=Preview.PreviewItems}"
					SelectedItem="{Binding Path=FirstSelected}"
					SelectionChanged="lstBox_OnSelectionChanged">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition />
									<ColumnDefinition
										Width="5" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition
										Height="40" />
								</Grid.RowDefinitions>
								<Image
									Grid.Column="1"
									Grid.Row="0"
									Margin="0"
									MaxWidth="150"
									Source="{Binding Path=BitmapThumbnail}" />
								<TextBlock
									Grid.Column="1"
									Grid.Row="1"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="10"
									Margin="0 0 0 0"
									Text="{Binding Path=Timestamp}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ListBoxItem}">
										<Border
											Name="Border"
											Padding="2"
											SnapsToDevicePixels="True">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger
												Property="ListBoxItem.IsSelected"
												Value="True">
												<Setter
													TargetName="Border"
													Property="Background"
													Value="{Binding IsMarked, Converter={StaticResource imageSelectionBoolToBackgroundColorConverter}}" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ItemsControl.ItemContainerStyle>
				</ListBox>
			</Grid>
		</Border>
	</Grid>
</UserControl>
