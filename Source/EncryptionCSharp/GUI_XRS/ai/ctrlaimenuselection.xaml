<UserControl
	x:Class="GUI_XRS.CtrlAIMenuSelection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="UserControl_Unloaded">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Border
			Grid.Column="0"
			Width="200"
			Height="100"
			BorderBrush="#FF000000"
			BorderThickness="1"
			CornerRadius="3"
			Background="#00FFFFFF"
			common:MouseCommandBehavior.MouseUpCommand="{Binding ShowThinkXACommand}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Image
					Grid.Row="0"
					Stretch="None"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Source="{Binding ImageSourceThinkXA}" />
				<TextBlock
					Grid.Row="1"
					Text="THiNK XA"
					TextAlignment="Center"
					Margin="0,0,0,5" />
			</Grid>
		</Border>
		<Border
			Grid.Column="2"
			Width="200"
			Height="100"
			BorderBrush="#FF000000"
			BorderThickness="1"
			CornerRadius="3"
			Background="#00FFFFFF"
			common:MouseCommandBehavior.MouseUpCommand="{Binding ShowThinkXOCommand}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Image
					Grid.Row="0"
					Stretch="None"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Source="{Binding ImageSourceThinkXO}" />
				<TextBlock
					Grid.Row="1"
					Text="THiNK XO"
					TextAlignment="Center"
					Margin="0,0,0,5" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
