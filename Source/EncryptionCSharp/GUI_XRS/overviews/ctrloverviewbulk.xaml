			</Grid.RowDefinitions>
			<Button
				Name="btnDetector"
				Grid.Row="9"
				Grid.Column="20"
				Grid.ColumnSpan="5"
				Grid.RowSpan="5"
				Style="{StaticResource overlayButton}"
				Margin="10,22,12,2"
				Click="btnDetector_Click" />
			<Button
				Name="btnSafetySwitch"
				Grid.Row="14"
				Grid.Column="19"
				Grid.ColumnSpan="5"
				Grid.RowSpan="5"
				Style="{StaticResource overlayButton}"
				Margin="7,3,14,20"
				Click="btnSafetySwitch_Click" />
			<Button
				Name="btnSource"
				Grid.Row="24"
				Grid.Column="19"
				Grid.ColumnSpan="5"
				Grid.RowSpan="5"
				Style="{StaticResource overlayButton}"
				Margin="12,4,10,19"
				Click="btnSource_Click" />
			<Image
				Source="..\img\temperature.png"
				Grid.Row="2"
				Grid.Column="2"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2" />
			<Button
				Name="btnTemperatures"
				Grid.Row="1"
				Grid.Column="1"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnTemperatures_Click" />
			<Image
				Source="..\img\powersupply.png"
				Grid.Row="8"
				Grid.Column="2"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2"
				Visibility="{Binding OldWagoConfiguration, Converter={StaticResource bVisConverter}}" />
			<Button
				Name="btnVoltages"
				Grid.Row="7"
				Grid.Column="1"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding OldWagoConfiguration, Converter={StaticResource bVisConverter}}"
				Click="btnVoltages_Click" />
			<Button
				Name="btnConveyor"
				Grid.Row="20"
				Grid.Column="8"
				Grid.ColumnSpan="5"
				Style="{StaticResource overlayButton}"
				Grid.RowSpan="4"
				Margin="10,10,10,0"
				Click="btnConveyor_Click" />
			<Button
				Name="btnSVT"
				Grid.Row="12"
				Grid.Column="36"
				Grid.ColumnSpan="5"
				Style="{StaticResource overlayButton}"
				Grid.RowSpan="5"
				Margin="13,14,10,10"
				Click="btnSVT_Click" />
			<Image
				Source="..\img\errorcontacts.png"
				Grid.Row="14"
				Grid.Column="7"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2"
				Visibility="{Binding ErrorOutputVisible, Converter={StaticResource bVisConverter}}" />
			<Button
				Name="btnErrorOutput"
				Grid.Row="13"
				Grid.Column="6"
				Grid.ColumnSpan="4"
				Grid.RowSpan="5"
				Style="{StaticResource overlayButton}"
				Margin="0,1,0,22"
				Visibility="{Binding ErrorOutputVisible, Converter={StaticResource bVisConverter}}"
				Click="btnErrorOutput_Click" />
			<Image
				Source="..\img\overview.png"
				Grid.Row="2"
				Grid.Column="40"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2" />
			<Button
				Name="btnMachineParameter"
				Grid.Row="1"
				Grid.Column="39"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnMachineParameter_Click" />
			<Button
				Grid.Column="20"
				Grid.ColumnSpan="4"
				Grid.RowSpan="5"
				Style="{StaticResource overlayButton}"
				Grid.Row="1"
				Margin="0,13,0,10"
				Visibility="{Binding BuzzerAvailable, Converter={StaticResource bVisConverter}}"
				Click="btnBuzzer_Click" />
		</Grid>
	</Grid>
</UserControl>
