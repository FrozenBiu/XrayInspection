			</Grid.RowDefinitions>
			<Button
				Name="btnDetector"
				Grid.Row="6"
				Grid.Column="50"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton2}"
				Click="btnDetector_Click">
				<Image
					Source="..\img\filmcamera.png"
					Stretch="UniformToFill">
					<UIElement.RenderTransform>
						<TranslateTransform
							X="13"
							Y="12" />
					</UIElement.RenderTransform>
				</Image>
			</Button>
			<Button
				Name="btnPusher"
				Grid.Row="13"
				Grid.Column="30"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton2}"
				Visibility="{Binding RejectButtonVisible, Converter={StaticResource bVisConverter}}"
				Click="btnPusher_Click">
				<Image
					Source="..\img\rejecter.png"
					Margin="0 0 0 0"
					Stretch="Uniform" />
			</Button>
			<Button
				Name="btnSafetySwitch"
				Grid.Row="14"
				Grid.Column="50"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton2}"
				Margin="0 0 0 0"
				Click="btnSafetySwitch_Click">
				<Image
					Source="..\img\safetyswitch.png"
					Margin="0 0 0 0"
					Stretch="Uniform" />
			</Button>
			<Button
				Name="btnSource"
				Grid.Row="23"
				Grid.Column="46"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton2}"
				Click="btnSource_Click">
				<Image
					Source="..\img\xray.png"
					Margin="7 0 7 0"
					Stretch="Uniform" />
			</Button>
			<Button
				Name="btnTemperatures"
				Grid.Row="1"
				Grid.Column="6"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton2}"
				Click="btnTemperatures_Click">
				<Image
					Source="..\img\temperature.png"
					Margin="13 0 13 0"
					Stretch="Uniform" />
			</Button>
			<Image
				Source="..\img\motor.png"
				Grid.Row="2"
				Grid.Column="68"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2"
				Margin="-1 0 -1 0"
				Stretch="UniformToFill" />
			<Button
				Name="btnConveyor"
				Grid.Row="1"
				Grid.Column="67"
				Grid.ColumnSpan="4"
				Style="{StaticResource overlayButton}"
				Grid.RowSpan="4"
				Click="btnConveyor_Click">
				<UIElement.IsEnabled>
					<MultiBinding
						Converter="{StaticResource productChangeMachineStatesBoolConverter}">
						<Binding
							Path="MachineState.State" />
						<Binding
							Path="DemoMode" />
					</MultiBinding>
				</UIElement.IsEnabled>
				<Grid
					Background="#FFA9A9A9"
					Opacity="0.6"
					Visibility="{Binding ElementName=btnConveyor, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
			</Button>
			<Button
				Name="btnErrorOutput"
				Grid.Row="8"
				Grid.Column="30"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding ErrorOutputVisible, Converter={StaticResource bVisConverter}}"
				Click="btnErrorOutput_Click">
				<Image
					Source="..\img\errorcontacts.png"
					Margin="13 0 13 0"
					Stretch="Uniform"
					Visibility="{Binding ErrorOutputVisible, Converter={StaticResource bVisConverter}}" />
			</Button>
			<Button
				Name="btnMachineParameter"
				Grid.Row="1"
				Grid.Column="72"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnMachineParameter_Click">
				<Image
					Source="..\img\overview.png"
					Margin="12 0 12 0"
					Stretch="Uniform" />
			</Button>
			<Button
				Grid.Row="1"
				Grid.Column="45"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Margin="-0 0 0 0"
				Visibility="{Binding BuzzerAvailable, Converter={StaticResource bVisConverter}}"
				Click="btnBuzzer_Click" />
			<Button
				Name="btnConnectioins"
				Grid.Row="1"
				Grid.Column="11"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding CommunicationsAvailable, Converter={StaticResource bVisConverter}}"
				Click="btnCommunications_Click">
				<Image
					Source="..\img\connections.png"
					Margin="15 0 15 0"
					Stretch="Uniform" />
			</Button>
		</Grid>
	</Grid>
</UserControl>
