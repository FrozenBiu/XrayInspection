<UserControl
	x:Class="GUI_XRS.CtrlOverviewRayconDPlusHyRework" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Background="#00FFFFFF"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<Grid
		MinHeight="300"
		MinWidth="400">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Button}"
					x:Key="overlayButton">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									Name="bBorder"
									BorderBrush="#4C4F4F"
									BorderThickness="1"
									CornerRadius="3">
									<Border.Background>
										<SolidColorBrush
											x:Name="BorderUp"
											Color="Red"
											Opacity="0" />
									</Border.Background>
									<ContentPresenter />
								</Border>
								<FrameworkTemplate.Resources>
									<ResourceDictionary>
										<Storyboard
											x:Key="ButtonDownTimeLine">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="BorderUp"
												Storyboard.TargetProperty="Opacity">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.05"
													Value="0.1" />
											</DoubleAnimationUsingKeyFrames>
										</Storyboard>
										<Storyboard
											x:Key="ButtonUpTimeLine">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="BorderUp"
												Storyboard.TargetProperty="Opacity">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.25"
													Value="0" />
											</DoubleAnimationUsingKeyFrames>
										</Storyboard>
									</ResourceDictionary>
								</FrameworkTemplate.Resources>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsPressed"
										Value="True">
										<TriggerBase.EnterActions>
											<BeginStoryboard
												Storyboard="{StaticResource ButtonDownTimeLine}" />
										</TriggerBase.EnterActions>
										<TriggerBase.ExitActions>
											<BeginStoryboard
												Storyboard="{StaticResource ButtonUpTimeLine}" />
										</TriggerBase.ExitActions>
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											TargetName="bBorder"
											Property="BorderBrush"
											Value="#999999" />
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="True">
										<Setter
											TargetName="bBorder"
											Property="BorderBrush"
											Value="#605f5f" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
				<Style
					TargetType="{x:Type Button}"
					x:Key="overlayButton2">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									Name="bBorder"
									BorderBrush="#605f5f"
									BorderThickness="1"
									CornerRadius="3"
									Background="#FFFFFFFF">
									<Grid>
										<Border
											CornerRadius="3">
											<Border.Background>
												<SolidColorBrush
													x:Name="BorderUp"
													Color="Red"
													Opacity="0" />
											</Border.Background>
										</Border>
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Grid>
								</Border>
								<FrameworkTemplate.Resources>
									<ResourceDictionary>
										<Storyboard
											x:Key="ButtonDownTimeLine">
											<DoubleAnimation
												Storyboard.TargetName="BorderUp"
												Storyboard.TargetProperty="Opacity"
												To="0.15"
												Duration="0:0:0.05" />
										</Storyboard>
										<Storyboard
											x:Key="ButtonUpTimeLine">
											<DoubleAnimation
												Storyboard.TargetName="BorderUp"
												Storyboard.TargetProperty="Opacity"
												To="0"
												Duration="0:0:0.25" />
										</Storyboard>
									</ResourceDictionary>
								</FrameworkTemplate.Resources>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsPressed"
										Value="True">
										<TriggerBase.EnterActions>
											<BeginStoryboard
												Storyboard="{StaticResource ButtonDownTimeLine}" />
										</TriggerBase.EnterActions>
										<TriggerBase.ExitActions>
											<BeginStoryboard
												Storyboard="{StaticResource ButtonUpTimeLine}" />
										</TriggerBase.ExitActions>
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											TargetName="bBorder"
											Property="BorderBrush"
											Value="#999999" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
				<l:BoolToVisibilityCollapsedConverter
					x:Key="bVisConverter" />
				<l:BoolToVisibilityInvertedHiddenConverter
					x:Key="boolToVisibilityInvertedHiddenConverter" />
				<l:ProductChangeMachineStatesBoolConverter
					x:Key="productChangeMachineStatesBoolConverter" />
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Image
			Name="overviewImage"
			Source="..\img\RayconDPlusHYRework.png" />
		<Grid
			Height="{Binding Path=ActualHeight, ElementName=overviewImage}"
			Width="{Binding Path=ActualWidth, ElementName=overviewImage}">
