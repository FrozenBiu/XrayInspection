<UserControl
	x:Class="GUI_XRS.CtrlOverviewSsh" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Background="#00FFFFFF"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<Grid
		MinHeight="400"
		MinWidth="400">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Button}"
					x:Key="overlayButton">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									BorderBrush="#FF808080"
									BorderThickness="1"
									CornerRadius="3">
									<Border.Background>
										<SolidColorBrush
											x:Name="BorderUp"
											Color="Red"
											Opacity="0" />
									</Border.Background>
								</Border>
								<FrameworkTemplate.Resources>
									<ResourceDictionary>
										<Storyboard
											x:Key="ButtonDownTimeLine">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="BorderUp"
												Storyboard.TargetProperty="Opacity">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.05"
													Value="0.1" />
											</DoubleAnimationUsingKeyFrames>
										</Storyboard>
										<Storyboard
											x:Key="ButtonUpTimeLine">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="BorderUp"
												Storyboard.TargetProperty="Opacity">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.25"
													Value="0" />
											</DoubleAnimationUsingKeyFrames>
										</Storyboard>
									</ResourceDictionary>
								</FrameworkTemplate.Resources>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsPressed"
										Value="True">
										<TriggerBase.EnterActions>
											<BeginStoryboard
												Storyboard="{StaticResource ButtonDownTimeLine}" />
										</TriggerBase.EnterActions>
										<TriggerBase.ExitActions>
											<BeginStoryboard
												Storyboard="{StaticResource ButtonUpTimeLine}" />
										</TriggerBase.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
				<Style
					TargetType="{x:Type TextBox}"
					BasedOn="{StaticResource {x:Type TextBox}}"
					x:Key="TextBoxStyle">
					<Setter
						Property="Margin"
						Value="0 0 0 0" />
				</Style>
				<Style
					TargetType="{x:Type TextBox}"
					BasedOn="{StaticResource {x:Type TextBox}}"
					x:Key="disabledTextBox">
					<Style.Resources>
						<ResourceDictionary>
							<LinearGradientBrush
								x:Key="textBoxBackground"
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0.00"
									Color="#adadad" />
								<GradientStop
									Offset="0.02"
									Color="#bababa" />
								<GradientStop
									Offset="0.03"
									Color="#c7c7c7" />
							</LinearGradientBrush>
							<LinearGradientBrush
								x:Key="textBoxBorder"
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0.01"
									Color="#9f9f9f" />
								<GradientStop
									Offset="0.10"
									Color="#bababa" />
								<GradientStop
									Offset="0.9"
									Color="#bababa" />
								<GradientStop
									Offset="1.00"
									Color="#e6e6e6" />
							</LinearGradientBrush>
						</ResourceDictionary>
					</Style.Resources>
					<Setter
						Property="Margin"
						Value="0 0 0 0" />
				</Style>
				<l:BoolToVisibilityCollapsedConverter
					x:Key="bVisConverter" />
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Image
			Name="overviewImage"
			Source="..\img\Sideshooter.png" />
		<Grid
			Height="{Binding Path=ActualHeight, ElementName=overviewImage}"
			Width="{Binding Path=ActualWidth, ElementName=overviewImage}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Button
				Name="btnDetector"
				Grid.Row="14"
				Grid.Column="18"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnDetector_Click" />
			<Button
				Name="btnPusher"
				Grid.Row="13"
				Grid.Column="26"
				Grid.ColumnSpan="4"
				Style="{StaticResource overlayButton}"
				Grid.RowSpan="4"
				Visibility="{Binding RejectButtonVisible, Converter={StaticResource bVisConverter}}"
				Click="btnPusher_Click" />
			<Button
				Name="btnSafetySwitch"
				Grid.Row="14"
				Grid.Column="13"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnSafetySwitch_Click" />
			<Button
				Name="btnSource"
				Grid.Row="6"
				Grid.Column="22"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnSource_Click" />
			<Image
				Source="..\img\arrowsUpDown.png"
				Grid.Row="7"
				Grid.Column="28"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2"
				Visibility="{Binding MoveXrayVisible, Converter={StaticResource bVisConverter}}" />
			<Button
				Name="btnMoveSource"
				Grid.Row="6"
				Grid.Column="27"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding MoveXrayVisible, Converter={StaticResource bVisConverter}}"
				Click="btnMoveSource_Click" />
			<Image
				Source="..\img\temperature.png"
				Grid.Row="2"
				Grid.Column="4"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2" />
			<Button
				Name="btnTemperatures"
				Grid.Row="1"
				Grid.Column="3"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnTemperatures_Click" />
			<Image
				Source="..\img\powersupply.png"
				Grid.Row="2"
				Grid.Column="10"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2"
				Visibility="{Binding OldWagoConfiguration, Converter={StaticResource bVisConverter}}" />
			<Button
				Name="btnVoltages"
				Grid.Row="1"
				Grid.Column="9"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding OldWagoConfiguration, Converter={StaticResource bVisConverter}}"
				Click="btnVoltages_Click" />
			<Button
				Name="btnConveyor"
				Grid.Row="18"
				Grid.Column="26"
				Grid.ColumnSpan="4"
				Style="{StaticResource overlayButton}"
				Grid.RowSpan="4"
				Click="btnConveyor_Click" />
			<Image
				Source="..\img\errorcontacts.png"
				Grid.Row="30"
				Grid.Column="17"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2"
				Visibility="{Binding ErrorOutputVisible, Converter={StaticResource bVisConverter}}" />
			<Button
				Name="btnErrorOutput"
				Grid.Row="29"
				Grid.Column="16"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding ErrorOutputVisible, Converter={StaticResource bVisConverter}}"
				Click="btnErrorOutput_Click" />
			<Image
				Source="..\img\overview.png"
				Grid.Row="2"
				Grid.Column="35"
				Grid.ColumnSpan="2"
				Grid.RowSpan="2" />
			<Button
				Name="btnMachineParameter"
				Grid.Row="1"
				Grid.Column="34"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Click="btnMachineParameter_Click" />
			<Button
				Grid.Row="1"
				Grid.Column="19"
				Grid.ColumnSpan="4"
				Grid.RowSpan="4"
				Style="{StaticResource overlayButton}"
				Visibility="{Binding BuzzerAvailable, Converter={StaticResource bVisConverter}}"
				Click="btnBuzzer_Click" />
		</Grid>
	</Grid>
</UserControl>
