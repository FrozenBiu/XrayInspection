<UserControl
	x:Class="GUI_XRS.CtrlPrintReport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Height="935"
	Width="600"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisCollapsedConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		BorderBrush="#b6b6b6"
		BorderThickness="{Binding BorderThickness}">
		<Grid
			Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					MinHeight="600" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition
					Width="200" />
			</Grid.ColumnDefinitions>
			<Image
				Height="180"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Grid.Row="0"
				Grid.Column="2"
				Source="../img/RAYCON.jpg"
				Visibility="{Binding LogoAvailable, Converter={StaticResource bVisCollapsedConverter}}" />
			<Grid
				Row="0"
				Column="0"
				ColumnSpan="2"
				HorizontalAlignment="Center"
				Visibility="{Binding LogoAvailable, Converter={StaticResource bVisCollapsedConverter}}">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition
						Height="20" />
					<RowDefinition
						Height="20" />
					<RowDefinition
						Height="20" />
				</Grid.RowDefinitions>
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					FontSize="16"
					FontWeight="Bold"
					Foreground="#414141"
					FontFamily="Verdana"
					HorizontalAlignment="Center"
					Text="Product Inspection System RAYCON" />
				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					FontSize="20"
					FontWeight="Bold"
					HorizontalAlignment="Center"
					Text="{Binding ProductName}" />
				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					FontSize="12"
					FontWeight="Bold"
					Text="verwendete Testkarte / used test card:"
					HorizontalAlignment="Center"
					VerticalAlignment="Bottom" />
				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					FontSize="10"
					FontWeight="Bold"
					Text="Glas / Glass:                          Ø2,0   Ø2,5   Ø3,0   Ø3,5    Ø4,0 mm    "
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom" />
				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					FontSize="10"
					FontWeight="Bold"
					Text="Edelstahl / Stainless Steel:  Ø0,8   Ø1,0   Ø1,2   Ø1,59  Ø1,8 mm"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Margin="0 0 0 5" />
			</Grid>
			<Image
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Source="{Binding Path=ProductImage}" />
			<Image
				Height="133"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Grid.Row="2"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Visibility="{Binding LogoAvailable, Converter={StaticResource bVisCollapsedConverter}}"
				Source="{Binding Logo}" />
		</Grid>
	</Border>
</UserControl>
