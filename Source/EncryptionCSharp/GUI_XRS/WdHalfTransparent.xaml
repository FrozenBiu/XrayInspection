<Window
	x:Class="GUI_XRS.WdHalfTransparent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	WindowStartupLocation="Manual"
	Topmost="True"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	WindowState="{Binding WState}"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}"
	Closing="WdHalfTransparent_Closing">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				x:Key="DefaultStyle">
				<Setter
					Property="Background">
					<Setter.Value>
						<LinearGradientBrush
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#d2d2d2" />
							<GradientStop
								Offset="1.00"
								Color="#b8b8b8" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
				<Setter
					Property="BorderBrush"
					Value="#505050" />
				<Setter
					Property="BorderThickness"
					Value="0 0 0 1" />
				<Setter
					Property="Border.CornerRadius"
					Value="7 7 0 0" />
				<Setter
					Property="Foreground"
					Value="#505050" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="21" />
				<Setter
					Property="TextBlock.Padding"
					Value="10 0 0 0" />
			</Style>
			<l:DateTimeToStringConverter
				x:Key="dateTimeToStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="overlay">
		<Panel.Background>
			<LinearGradientBrush
				MappingMode="Absolute"
				StartPoint="0,0"
				EndPoint="1,1"
				SpreadMethod="Repeat">
				<GradientStop
					Offset="0"
					Color="#30000000" />
				<GradientStop
					Offset="1"
					Color="#33000000" />
			</LinearGradientBrush>
		</Panel.Background>
	</Grid>
</Window>
