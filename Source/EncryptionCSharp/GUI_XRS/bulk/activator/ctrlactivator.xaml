<UserControl
	x:Class="GUI_XRS.CtrlActivator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="{x:Type TextBox}">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
				<Setter
					Property="MinWidth"
					Value="50" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxDisabledStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="5"
								BorderThickness="1"
								Background="#00FFFFFF">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
			</Style>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type l:RadioButtonExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
			<RowDefinition
				MinHeight="250" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				MinWidth="500" />
		</Grid.ColumnDefinitions>
		<Border
			Grid.Row="0"
			Grid.ColumnSpan="2"
			Background="#e7efc5"
			BorderBrush="#b6b6b6"
			BorderThickness="0 0 0 1" />
		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Background="#e7efc5"
			BorderBrush="#b6b6b6"
			BorderThickness="0 0 0 1" />
		<Border
			Grid.Row="2"
			Grid.ColumnSpan="2"
			Background="#e7efc5"
			BorderBrush="#b6b6b6"
			BorderThickness="0 0 0 0" />
		<l:RadioButtonExtended
			GroupName="grpMode"
			Grid.Column="0"
			Grid.Row="0"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			IsCheckedReal="{Binding Path=Activator.AlwaysEnabled, Mode=TwoWay}" />
		<Grid
			Row="0"
			Column="1"
			VerticalAlignment="Center"
			HorizontalAlignment="Left">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Text="1"
				VerticalAlignment="Top"
				HorizontalAlignment="Left"
				Margin="5 -2 0 0" />
			<Rectangle
				Grid.Row="0"
				Grid.RowSpan="2"
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Width="2"
				Fill="#FF000000"
				Margin="20 8 0 10" />
			<Rectangle
				Grid.Row="0"
				VerticalAlignment="Top"
				Width="440"
				Height="2"
				Fill="#FF000000"
				Margin="20 8 0 0" />
			<TextBlock
				Grid.Row="1"
				Text="0"
				VerticalAlignment="Top"
				HorizontalAlignment="Left"
				Margin="5 30 0 0" />
		</Grid>
		<l:RadioButtonExtended
			GroupName="grpMode"
			Grid.Column="0"
			Grid.Row="1"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			IsCheckedReal="{Binding Path=Activator.Disabled, Mode=TwoWay}" />
		<Grid
			Row="1"
			Column="1"
			VerticalAlignment="Center"
			HorizontalAlignment="Left">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Text="1"
				VerticalAlignment="Top"
				HorizontalAlignment="Left"
				Margin="5 0 0 30" />
			<Rectangle
				Grid.Row="0"
				Grid.RowSpan="2"
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Width="2"
				Fill="#FF000000"
				Margin="20 10 0 9" />
			<Rectangle
				Grid.Row="1"
				VerticalAlignment="Top"
				Width="440"
				Height="2"
				Fill="#FF000000"
				Margin="20 8 0 0" />
			<TextBlock
				Grid.Row="1"
				Text="0"
				VerticalAlignment="Top"
				HorizontalAlignment="Left"
				Margin="5 -2 0 0" />
		</Grid>
		<l:RadioButtonExtended
			GroupName="grpMode"
			Grid.Column="0"
			Grid.Row="2"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			IsCheckedReal="{Binding Path=Activator.IntervalMode, Mode=TwoWay}" />
		<Grid
			Row="2"
			Column="1"
			VerticalAlignment="Center"
			HorizontalAlignment="Left">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="120" />
				<ColumnDefinition
					Width="120" />
				<ColumnDefinition
					Width="120" />
				<ColumnDefinition
					Width="120" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="120" />
			</Grid.RowDefinitions>
			<StackPanel
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Grid.Column="0"
				Orientation="Horizontal">
				<TextBox
					Text="{Binding Activator.OnTimeMinutes}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding SetOnTimeMinutesCommand}" />
				<TextBlock
					Text="min" />
			</StackPanel>
			<StackPanel
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Grid.Column="1"
				Orientation="Horizontal">
				<TextBox
					Margin="20 20 5 20"
					Text="{Binding Activator.OnTimeSeconds}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding SetOnTimeSecondsCommand}" />
				<TextBlock
					Text="s" />
			</StackPanel>
			<StackPanel
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Grid.Column="2"
				Orientation="Horizontal">
				<TextBox
					Text="{Binding Activator.OffTimeMinutes}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding SetOffTimeMinutesCommand}" />
				<TextBlock
					Text="min" />
			</StackPanel>
			<StackPanel
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Grid.Column="3"
				Orientation="Horizontal">
				<TextBox
					Margin="20 20 5 20"
					Text="{Binding Activator.OffTimeSeconds}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding SetOffTimeSecondsCommand}" />
				<TextBlock
					Text="s" />
			</StackPanel>
			<TextBlock
				Grid.Column="0"
				Grid.Row="1"
				Text="1"
				VerticalAlignment="Top"
				HorizontalAlignment="Left"
				Margin="5 -3 0 0" />
			<Rectangle
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Width="2"
				Fill="#FF000000"
				Margin="20 5 0 0"
				Grid.Column="0"
				Grid.Row="1" />
			<Rectangle
				VerticalAlignment="Top"
				Height="2"
				Fill="#FF000000"
				Margin="20 5 0 0"
				Grid.Column="0"
				Grid.Row="1"
				Grid.ColumnSpan="2" />
			<Rectangle
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Width="2"
				Fill="#FF000000"
				Margin="0 5 0 0"
				Grid.Column="2"
				Grid.Row="1" />
			<Rectangle
				VerticalAlignment="Bottom"
				Height="2"
				Fill="#FF000000"
				Margin="0 5 20 0"
				Grid.Column="2"
				Grid.Row="1"
				Grid.ColumnSpan="2" />
			<TextBlock
				Grid.Column="0"
				Grid.Row="1"
				Text="0"
				VerticalAlignment="Bottom"
				HorizontalAlignment="Left"
				Margin="5 0 0 -9" />
		</Grid>
	</Grid>
</UserControl>
