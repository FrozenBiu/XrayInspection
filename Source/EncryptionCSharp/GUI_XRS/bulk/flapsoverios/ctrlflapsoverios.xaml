<UserControl
	x:Class="GUI_XRS.CtrlFlapsOverIOs" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToStringConverter
				x:Key="bStringConverter" />
			<l:DoubleStringConverterPrec1
				x:Key="doubleStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:VerifyTestMachineStatesBoolConverter
				x:Key="verifyTestMachineStatesBoolConverter" />
			<l:VerifyTestMachineStatesBoolConverter2
				x:Key="verifyTestMachineStatesBoolConverter2" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="boolToVisibilityInvertedHiddenConverter" />
			<l:ValveTestVisibleConverter
				x:Key="valveTestVisibleConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="65 0 50 0" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 0 65 0" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 12">
			<ScrollViewer>
				<StackPanel>
					<Grid
						Visibility="{Binding IsBulkFlaps, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="{Binding RejectAllIsVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="20" />
						</Grid.RowDefinitions>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="6"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 1 0" />
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="6"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 1 0 1" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding StrRejecterEnabled.LocalizedText, FallbackValue=Auswurfeinheit ein}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsChecked="{Binding Path=flapsOverIOs.Enable}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Text="{Binding StrDelay.LocalizedText, FallbackValue=Verzögerung}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding flapsOverIOs.Delay}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetDelayCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP1LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Text="{Binding StrEjectTimeInit.LocalizedText, FallbackValue=Minimale Einschaltzeit}" />
						<TextBox
							Grid.Row="2"
							Grid.Column="1"
							Margin="50 10 50 10"
							IsEnabled="False"
							Style="{StaticResource disabledTextBox}"
							Text="{Binding flapsOverIOs.InitEjectTime}" />
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Text="{Binding StrEjectTimeAdditional.LocalizedText, FallbackValue=Zusätzliche Einschaltzeit}" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding flapsOverIOs.EjectTime}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetEjectTimeCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP1LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Text="{Binding StrImageSize.LocalizedText, FallbackValue=Bildlänge}" />
						<TextBox
							Grid.Row="4"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding flapsOverIOs.ImageSize}"
							IsEnabled="{Binding Path=MinAdminLoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetImageSizeCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinAdminLoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Text="{Binding StrRejectAll.LocalizedText, FallbackValue=Reject mit allen Klappen}" />
						<CheckBox
							Grid.Row="5"
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsChecked="{Binding Path=flapsOverIOs.RejectWithAllFlaps}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}" />
					</Grid>
					<Grid
						Visibility="{Binding IsBulkObjectFlaps, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="20" />
						</Grid.RowDefinitions>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="3"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 1 0" />
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="3"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 1 0 1" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrRejecterEnabled.LocalizedText, FallbackValue=Auswurfeinheit ein}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsChecked="{Binding Path=Rejecter1.Enable}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrDelay.LocalizedText, FallbackValue=Verzögerung}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding Rejecter1.Delay}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetRejecter1DelayCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP1LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrEjectTime.LocalizedText, FallbackValue=Einschaltzeit}" />
						<TextBox
							Grid.Row="2"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding Path=Rejecter1.EjectTime}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetRejecter1EjectTimeCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP1LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
					</Grid>
					<Grid
						Visibility="{Binding IsBulkFlaps, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="20" />
						</Grid.RowDefinitions>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="2"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 1 0" />
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="2"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 1 0 1" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding StrStartValveTest.LocalizedText, FallbackValue=Ventiltest starten}" />
						<Button
							Style="{StaticResource defaultButtonStyle}"
							Grid.Row="0"
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Margin="50 10 50 10"
							Command="{Binding StartValveTestCommand}"
							IsEnabled="{Binding Path=MinOP3LoggedIn}">
							<Image
								Source="/img/play.png"
								Height="40" />
						</Button>
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Text="{Binding StrInterval.LocalizedText, FallbackValue=Intervall (in ms)}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding flapsOverIOs.ValveTestInterval}"
							IsEnabled="{Binding Path=MinOP3LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetValveTestIntervalCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP3LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							BorderBrush="#a8a8a8"
							BorderThickness="1"
							Background="#5f000000">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource valveTestVisibleConverter}">
									<MultiBinding.Bindings>
										<Binding
											Path="flapsOverIOs.Enable" />
										<Binding
											Path="Rejecter1.Enable" />
										<Binding
											Path="MachineMode" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</UIElement.Visibility>
						</Border>
						<Border
							Grid.Row="0"
							Grid.Column="1"
							BorderBrush="#a8a8a8"
							BorderThickness="1"
							Background="#5f000000">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource valveTestVisibleConverter}">
									<MultiBinding.Bindings>
										<Binding
											Path="flapsOverIOs.Enable" />
										<Binding
											Path="Rejecter1.Enable" />
										<Binding
											Path="MachineMode" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</UIElement.Visibility>
						</Border>
						<Border
							Grid.Row="1"
							Grid.Column="0"
							BorderBrush="#a8a8a8"
							BorderThickness="1"
							Background="#5f000000">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource valveTestVisibleConverter}">
									<MultiBinding.Bindings>
										<Binding
											Path="flapsOverIOs.Enable" />
										<Binding
											Path="Rejecter1.Enable" />
										<Binding
											Path="MachineMode" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</UIElement.Visibility>
						</Border>
						<Border
							Grid.Row="1"
							Grid.Column="1"
							BorderBrush="#a8a8a8"
							BorderThickness="1"
							Background="#5f000000">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource valveTestVisibleConverter}">
									<MultiBinding.Bindings>
										<Binding
											Path="flapsOverIOs.Enable" />
										<Binding
											Path="Rejecter1.Enable" />
										<Binding
											Path="MachineMode" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</UIElement.Visibility>
						</Border>
					</Grid>
					<Grid
						Visibility="{Binding IsBulkBinFullVisible, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="20" />
						</Grid.RowDefinitions>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="1"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 1 0" />
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="1"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 1 0 1" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrBinFullTimeout.LocalizedText, FallbackValue=Timeout Behälter voll}" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding Path=Rejecter1.BinFullTimeout}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetBinFullTimeoutCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP1LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
					</Grid>
					<Grid
						Visibility="{Binding IsBulkRejectVerifyVisible, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="4"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 1 0" />
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="4"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 1 0 1" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrRejectVerifyEnabled.LocalizedText, FallbackValue=Auswurfüberwachung ein}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsChecked="{Binding Path=Rejecter1.VerifyEnable}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrRejectVerifyLearn.LocalizedText, FallbackValue=Auswurfüberwachung lernen}" />
						<Button
							Name="btnVerifyLearn"
							Grid.Row="1"
							Grid.Column="1"
							Style="{StaticResource defaultButtonStyle}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Margin="0 10 0 10"
							Command="{Binding Rejecter1.VerifyLearnCommand}">
							<UIElement.IsEnabled>
								<MultiBinding
									Converter="{StaticResource verifyTestMachineStatesBoolConverter2}">
									<Binding
										Path="Rejecter1.MachineState.State" />
									<Binding
										Path="Rejecter1.DemoMode" />
									<Binding
										Path="Rejecter1.VerifyEnable" />
									<Binding
										Path="MinOP1LoggedIn" />
								</MultiBinding>
							</UIElement.IsEnabled>
							<Grid>
								<Image
									Source="..\..\img\learn_enabled.png"
									Stretch="None"
									Visibility="{Binding ElementName=btnVerifyLearn, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
								<Image
									Source="..\..\img\learn_disabled.png"
									Stretch="None"
									Visibility="{Binding ElementName=btnVerifyLearn, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
							</Grid>
						</Button>
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrRejectVerifyTest.LocalizedText, FallbackValue=Auswurfüberwachung testen}" />
						<Button
							Name="btnVerifyTest"
							Grid.Row="2"
							Grid.Column="1"
							Style="{StaticResource defaultButtonStyle}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Margin="0 10 0 10"
							Command="{Binding Rejecter1.VerifyTestCommand}">
							<UIElement.IsEnabled>
								<MultiBinding
									Converter="{StaticResource verifyTestMachineStatesBoolConverter}">
									<Binding
										Path="Rejecter1.MachineState.State" />
									<Binding
										Path="Rejecter1.DemoMode" />
									<Binding
										Path="Rejecter1.VerifyEnable" />
								</MultiBinding>
							</UIElement.IsEnabled>
							<Grid>
								<Image
									Source="..\..\img\play_bright_small.png"
									Stretch="None"
									Visibility="{Binding ElementName=btnVerifyTest, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
								<Image
									Source="..\..\img\play_bright_small_disabled.png"
									Stretch="None"
									Visibility="{Binding ElementName=btnVerifyTest, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
							</Grid>
						</Button>
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Text="{Binding Rejecter1.StrRejectVerifySensorBlockedTimeout.LocalizedText, FallbackValue=Timeout Sensor Auswurfüberwachung blockiert (in ms)}" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Margin="50 10 50 10"
							Text="{Binding Rejecter1.RejectVerifySensorBlockedTimeout}"
							IsEnabled="{Binding Path=MinOP1LoggedIn}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding SetVerifySensorBlockedTimeoutCommand}">
							<FrameworkElement.Style>
								<MultiBinding
									Converter="{StaticResource bTextBoxStyleConverter}">
									<MultiBinding.Bindings>
										<Binding
											RelativeSource="{RelativeSource Self}" />
										<Binding
											Path="MinOP1LoggedIn" />
									</MultiBinding.Bindings>
								</MultiBinding>
							</FrameworkElement.Style>
						</TextBox>
					</Grid>
				</StackPanel>
			</ScrollViewer>
		</Border>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#5f000000"
			Margin="0 0 0 12"
			Visibility="{Binding flapsOverIOs.ValveTestIsRunning, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
	</Grid>
</UserControl>
