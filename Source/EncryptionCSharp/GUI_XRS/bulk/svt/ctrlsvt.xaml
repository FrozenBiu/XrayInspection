<UserControl
	x:Class="GUI_XRS.CtrlSVT" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Loaded="SVT_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToStringConverter
				x:Key="bStringConverter" />
			<l:DoubleStringConverterPrec1
				x:Key="doubleStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="bVisInvertedConverter" />
			<l:TwoBoolValuesToOneConverter
				x:Key="twoBoolValuesConverter" />
			<l:BoolToTextBoxStyleConverter3
				x:Key="bTextBoxStyleConverter2" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="65 0 50 0" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 0 65 0" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 12">
			<ScrollViewer>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="17"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="2"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="3"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="4"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="6"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="7"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="8"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="9"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="10"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 0" />
					<Border
						Grid.Row="13"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0" />
					<Border
						Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding StrRejecterEnabled.LocalizedText, FallbackValue=Auswurfeinheit ein}" />
					<CheckBox
						Grid.Row="0"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=svt.Enable}"
						IsEnabled="{Binding Path=MinOP1LoggedIn}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding StrDelay.LocalizedText, FallbackValue=Verzögerung}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.Delay}"
						IsEnabled="{Binding Path=MinOP1LoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetDelayCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP1LoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Text="{Binding StrEjectTimeInit.LocalizedText, FallbackValue=Minimale Einschaltzeit}" />
					<TextBox
						Grid.Row="2"
						Grid.Column="1"
						Margin="50 10 50 10"
						IsEnabled="False"
						Style="{StaticResource disabledTextBox}"
						Text="{Binding svt.InitEjectTime}" />
					<TextBlock
						Grid.Row="3"
						Grid.Column="0"
						Text="{Binding StrEjectTime.LocalizedText, FallbackValue=Einschaltzeit}" />
					<TextBox
						Grid.Row="3"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.EjectTime}"
						IsEnabled="{Binding Path=MinOP1LoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetEjectTimeCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP1LoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="4"
						Grid.Column="0"
						Text="{Binding StrImageSize.LocalizedText, FallbackValue=Bildlänge}" />
					<TextBox
						Grid.Row="4"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.ImageSize}"
						IsEnabled="{Binding Path=MinAdminLoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetImageSizeCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinAdminLoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="7"
						Grid.Column="0"
						Text="{Binding StrValveWidth.LocalizedText, FallbackValue=Ventilbreite in Pixel}" />
					<TextBox
						Grid.Row="7"
						Grid.Column="1"
						Margin="50 10 50 10"
						IsEnabled="False"
						Style="{StaticResource disabledTextBox}"
						Text="{Binding svt.ValveWidth}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetValveWidthCommand}" />
					<TextBlock
						Grid.Row="8"
						Grid.Column="0"
						Text="{Binding StrNumValves.LocalizedText, FallbackValue=Anzahl Ventile}" />
					<TextBox
						Grid.Row="8"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.NumValves}"
						IsEnabled="{Binding Path=MinServiceLoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetNumValvesCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinServiceLoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="11"
						Grid.Column="0"
						Text="{Binding StrOverlappingLeft.LocalizedText, FallbackValue=Überlappung links}" />
					<TextBox
						Grid.Row="11"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.OverlappingLeft}"
						IsEnabled="{Binding Path=MinOP1LoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetOverlappingLeftCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP1LoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="12"
						Grid.Column="0"
						Text="{Binding StrOverlappingRight.LocalizedText, FallbackValue=Überlappung rechts}" />
					<TextBox
						Grid.Row="12"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.OverlappingRight}"
						IsEnabled="{Binding Path=MinOP1LoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetOverlappingRightCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP1LoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="13"
						Grid.Column="0"
						Text="{Binding StrStartValveTest.LocalizedText, FallbackValue=Ventiltest starten}" />
					<Button
						Style="{StaticResource defaultButtonStyle}"
						Grid.Row="13"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Margin="50 10 50 10"
						Command="{Binding StartValveTestCommand}"
						IsEnabled="{Binding Path=MinOP3LoggedIn}">
						<Image
							Stretch="None"
							VerticalAlignment="Center">
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Image}">
									<Setter
										Property="Source"
										Value="/img/play.png" />
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding Path=svt.SvtTestRunning}">
											<Setter
												Property="Source"
												Value="/img/pause.png" />
										</DataTrigger>
										<DataTrigger
											Value="False"
											Binding="{Binding Path=svt.SvtTestRunning}">
											<Setter
												Property="Source"
												Value="/img/play.png" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Image>
					</Button>
					<TextBlock
						Grid.Row="14"
						Grid.Column="0"
						Text="{Binding StrFirstValve.LocalizedText, FallbackValue=Start - Ventil}" />
					<TextBox
						Grid.Row="14"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.ValveTestStartValve}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetValveTestStartValveCommand}">
						<UIElement.IsEnabled>
							<MultiBinding
								Converter="{StaticResource twoBoolValuesConverter}">
								<Binding
									Path="MinOP3LoggedIn" />
								<Binding
									Path="svt.SvtTestRunning" />
							</MultiBinding>
						</UIElement.IsEnabled>
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter2}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP3LoggedIn" />
									<Binding
										Path="svt.SvtTestRunning" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="15"
						Grid.Column="0"
						Text="{Binding StrLastValve.LocalizedText, FallbackValue=End - Ventil}" />
					<TextBox
						Grid.Row="15"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.ValveTestEndValve}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetValveTestEndValveCommand}">
						<UIElement.IsEnabled>
							<MultiBinding
								Converter="{StaticResource twoBoolValuesConverter}">
								<Binding
									Path="MinOP3LoggedIn" />
								<Binding
									Path="svt.SvtTestRunning" />
							</MultiBinding>
						</UIElement.IsEnabled>
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter2}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP3LoggedIn" />
									<Binding
										Path="svt.SvtTestRunning" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="16"
						Grid.Column="0"
						Text="{Binding StrInterval.LocalizedText, FallbackValue=Intervall (in ms)}" />
					<TextBox
						Grid.Row="16"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.TestInterval}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetTestIntervalCommand}">
						<UIElement.IsEnabled>
							<MultiBinding
								Converter="{StaticResource twoBoolValuesConverter}">
								<Binding
									Path="MinOP3LoggedIn" />
								<Binding
									Path="svt.SvtTestRunning" />
							</MultiBinding>
						</UIElement.IsEnabled>
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter2}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinOP3LoggedIn" />
									<Binding
										Path="svt.SvtTestRunning" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="5"
						Grid.Column="0"
						Text="{Binding Path=StrFirstPixelSecondValve.LocalizedText}" />
					<TextBox
						Grid.Row="5"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.StartPixelSecondValve}"
						IsEnabled="{Binding Path=MinServiceLoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetStartPixelSecondValveCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinServiceLoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<TextBlock
						Grid.Row="6"
						Grid.Column="0"
						Text="{Binding Path=StrEndPixelNextToLastValve.LocalizedText}" />
					<TextBox
						Grid.Row="6"
						Grid.Column="1"
						Margin="50 10 50 10"
						Text="{Binding svt.EndPixelNextToLastValve}"
						IsEnabled="{Binding Path=MinServiceLoggedIn}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding SetEndPixelNextToLastValveCommand}">
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="MinServiceLoggedIn" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
