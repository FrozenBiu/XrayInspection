<UserControl
	x:Class="GUI_XRS.CtrlBrowseImages" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CloseCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Disabled" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<StackPanel
											Orientation="Horizontal"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtBlockStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Border
			Padding="5 7 5 7"
			Margin="0 5 0 5"
			BorderBrush="#8e9192"
			BorderThickness="1">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="12*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Button
					Grid.Column="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 5 0"
					Command="{Binding FirstItemCommand}">
					<Image
						Source="..\..\img\arrow2-left.png"
						Stretch="None" />
				</Button>
				<RepeatButton
					Grid.Column="1"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 5 0"
					Command="{Binding PreviousItemCommand}">
					<Image
						Source="..\..\img\arrow-left.png"
						Stretch="None" />
				</RepeatButton>
				<ListBox
					Name="lstImages"
					Grid.Column="2"
					ItemsSource="{Binding Path=HistoryItems}"
					SelectedItem="{Binding Path=SelectedItem}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="5" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition
										Height="70" />
									<RowDefinition
										Height="40" />
								</Grid.RowDefinitions>
								<Image
									Grid.Column="1"
									Grid.Row="0"
									Margin="0"
									MaxWidth="200"
									Source="{Binding Path=BitmapThumbnail, Mode=OneTime}" />
								<Border
									Grid.Column="1"
									Grid.Row="0"
									Background="#00FFFFFF"
									Margin="-7 0 -7 0" />
								<TextBlock
									Grid.Column="1"
									Grid.Row="1"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="10"
									Margin="0 0 0 0"
									Text="{Binding Path=Timestamp, Mode=OneTime}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}">
							<Setter
								Property="common:ListBoxItemBehavior.IsBroughtIntoViewWhenSelected"
								Value="True" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ListBoxItem}">
										<Border
											Name="Border"
											Padding="2"
											SnapsToDevicePixels="True">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger
												Property="ListBoxItem.IsSelected"
												Value="True">
												<Setter
													TargetName="Border"
													Property="Background"
													Value="#c9db53" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ItemsControl.ItemContainerStyle>
				</ListBox>
				<RepeatButton
					Grid.Column="3"
					Style="{StaticResource btnMainMenu}"
					Margin="5 0 0 0"
					Command="{Binding NextItemCommand}">
					<Image
						Source="..\..\img\arrow-right.png"
						Stretch="None" />
				</RepeatButton>
				<Button
					Grid.Column="4"
					Style="{StaticResource btnMainMenu}"
					Margin="5 0 0 0"
					Command="{Binding LastItemCommand}">
					<Image
						Source="..\..\img\arrow2-right.png"
						Stretch="None" />
				</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>
