<UserControl
	x:Class="GUI_XRS.IPAddressBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Name="ipCtrl"
	Background="#00FFFFFF"
	FontSize="20"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Loaded="ipCtrl_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<!--Unknown connection ID: 2-->
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="styleAddressPart">
				<Setter
					Property="FontSize"
					Value="{Binding Path=FontSize, ElementName=ipCtrl}" />
				<Setter
					Property="TextBox.TextAlignment"
					Value="Center" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Focusable"
					Value="{Binding Path=Focusable, ElementName=ipCtrl}" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Foreground"
					Value="#6e5e5e" />
				<Setter
					Property="Background"
					Value="{Binding Path=Background, ElementName=ipCtrl}" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="Padding"
					Value="1 5 1 5" />
				<Setter
					Property="Margin"
					Value="0 3 0 3" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBoxBase}">
							<Border
								Name="Border"
								CornerRadius="2"
								Padding="2">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="Border"
										Property="Background"
										Value="#FFD3D3D3" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource styleAddressPart}"
				x:Key="styleDot">
				<Setter
					Property="Focusable"
					Value="False" />
			</Style>
			<Style
				TargetType="{x:Type Border}"
				x:Key="{x:Type Border}">
				<Setter
					Property="BorderBrush"
					Value="#bebebe" />
				<Style.Triggers>
					<Trigger
						Property="IsEnabled"
						Value="False">
						<Setter
							Property="Background"
							Value="#FFD3D3D3" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Background="#00FFFFFF">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Border
			CornerRadius="4"
			Grid.ColumnSpan="7"
			Background="#F1F1F1" />
		<Border
			Grid.Column="0"
			CornerRadius="3 0 0 3"
			BorderThickness="2 2 0 2">
			<TextBox
				Name="txtIP1"
				Style="{StaticResource styleAddressPart}" />
		</Border>
		<Border
			Grid.Column="1"
			BorderThickness="0 2 0 2">
			<TextBox
				Text="."
				Style="{StaticResource styleDot}" />
		</Border>
		<Border
			Grid.Column="2"
			BorderThickness="0 2 0 2">
			<TextBox
				Name="txtIP2"
				Style="{StaticResource styleAddressPart}" />
		</Border>
		<Border
			Grid.Column="3"
			BorderThickness="0 2 0 2">
			<TextBox
				Text="."
				Style="{StaticResource styleDot}" />
		</Border>
		<Border
			Grid.Column="4"
			BorderThickness="0 2 0 2">
			<TextBox
				Name="txtIP3"
				Style="{StaticResource styleAddressPart}" />
		</Border>
		<Border
			Grid.Column="5"
			BorderThickness="0 2 0 2">
			<TextBox
				Text="."
				Style="{StaticResource styleDot}" />
		</Border>
		<Border
			Grid.Column="6"
			CornerRadius="0 3 3 0"
			BorderThickness="0 2 2 2">
			<TextBox
				Name="txtIP4"
				Style="{StaticResource styleAddressPart}" />
		</Border>
	</Grid>
</UserControl>
