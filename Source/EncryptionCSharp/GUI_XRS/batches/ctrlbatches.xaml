<UserControl
	x:Class="GUI_XRS.CtrlBatches" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:l="clr-namespace:GUI_XRS" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.LoadedCommand="{Binding InitializeCommand}"
	common:ControlCommandBehavior.ControlCommandParameter="{Binding Path=., RelativeSource={RelativeSource Self}}"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="../MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:DateTimeToStringConverter
				x:Key="dateTimeToStringConverter" />
			<l:NotMinDateTimeBoolConverter
				x:Key="notMinDateTimeBoolConverter" />
			<l:DateTimeVisibilityConverter
				x:Key="dateTimeVisibilityConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="20 0 20 0"
		IsSharedSizeScope="True">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TextBlock
			FontSize="25"
			FontFamily="Helvetica"
			FontWeight="Bold"
			VerticalAlignment="Center"
			Margin="0 1 0 1"
			Text="{Binding ProductManager.SelectedProduct.ProductAndBatchName}">
			<TextBlock
				Text=" -" /> <TextBlock
				Text="{Binding CurrentBatchID, FallbackValue=1}" /></TextBlock>
		<Grid
			Row="1"
			Margin="0 3 0 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupBatchID" />
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupStartTime" />
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupEndTime" />
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupThroughput" />
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupRejects" />
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupRejects2" />
				<ColumnDefinition
					Width="Auto"
					SharedSizeGroup="groupRejects3" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Text="ID"
				Grid.Column="0"
				FontSize="20"
				TextAlignment="Center"
				Margin="4 0 0 0" />
			<TextBlock
				Grid.Column="1"
				FontSize="20"
				TextAlignment="Center"
				Margin="10 0 0 0"
				Text="{Binding StrStartTime.LocalizedText}" />
			<TextBlock
				Grid.Column="2"
				FontSize="20"
				TextAlignment="Center"
				Margin="10 0 0 0"
				Text="{Binding StrEndTime.LocalizedText}" />
			<TextBlock
				Grid.Column="3"
				FontSize="20"
				TextAlignment="Center"
				Margin="10 0 0 0"
				Text="{Binding StrThroughput.LocalizedText}" />
			<TextBlock
				Grid.Column="4"
				FontSize="20"
				TextAlignment="Center"
				Margin="10 0 0 0"
				Text="{Binding StrReject.LocalizedText}" />
		</Grid>
		<ListBox
			Background="#00FFFFFF"
			Grid.Row="2"
			Grid.Column="0"
			Margin="0 1 0 5"
			ItemsSource="{Binding UIBatches}"
			SelectedItem="{Binding SelectedBatch}"
			common:MouseCommandBehavior.MouseDoubleClickCommand="{Binding StartBatchCommand}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupBatchID" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupStartTime" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupEndTime" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupThroughput" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupRejects" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupRejects2" />
							<ColumnDefinition
								Width="*"
								SharedSizeGroup="groupRejects3" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Margin="10 10 10 10"
							FontSize="20"
							FontFamily="Helvetica"
							FontWeight="Bold"
							VerticalAlignment="Center"
							HorizontalAlignment="Center"
							TextWrapping="Wrap"
							MaxWidth="170"
							Text="{Binding BatchID}" />
						<TextBlock
							Grid.Column="1"
							Margin="10 0 10 0"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							Text="{Binding StartTimeD, Converter={StaticResource dateTimeToStringConverter}}"
							Visibility="{Binding StartTimeD, Converter={StaticResource dateTimeVisibilityConverter}}" />
						<TextBlock
							Grid.Column="2"
							Margin="10 0 10 0"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							Text="{Binding EndTimeD, Converter={StaticResource dateTimeToStringConverter}}"
							Visibility="{Binding EndTimeD, Converter={StaticResource dateTimeVisibilityConverter}}" />
						<TextBlock
							Grid.Column="3"
							TextAlignment="Center"
							Margin="10 0 10 0"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							Text="{Binding NProducts}"
							Visibility="{Binding StartTimeD, Converter={StaticResource dateTimeVisibilityConverter}}" />
						<TextBlock
							Grid.Column="4"
							TextAlignment="Center"
							Margin="10 0 10 0"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							Text="{Binding NRejects}"
							Visibility="{Binding StartTimeD, Converter={StaticResource dateTimeVisibilityConverter}}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
			<ItemsControl.ItemContainerStyle>
				<Style
					TargetType="{x:Type ListBoxItem}">
					<Style.Triggers>
						<DataTrigger
							Value="False"
							Binding="{Binding EndTimeD, Converter={StaticResource notMinDateTimeBoolConverter}}">
							<Setter
								Property="Foreground"
								Value="#FF808080" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ItemsControl.ItemContainerStyle>
		</ListBox>
	</Grid>
</UserControl>
