<UserControl
	x:Class="GUI_XRS.CtrlQAParams" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit" xmlns:l="clr-namespace:GUI_XRS" xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="UserControl_Unloaded"
	Loaded="UserControl_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:DateTimeToStringConverter
				x:Key="dateTimeToStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:ParamStateBrushConverterNew
				x:Key="paramStateBrushConverter" />
			<l:IntStringToVisibilityConverter
				x:Key="intStringToVisibilityConverter" />
			<l:ChangeToBrushConverter
				x:Key="changeToBrushConverter" />
			<ControlTemplate
				TargetType="{x:Type Button}"
				x:Key="dataGridSelectAllButtonTemplate">
				<Border
					Name="Border"
					BorderBrush="#E3E7E7"
					BorderThickness="0,0,1,1"
					VerticalAlignment="Stretch"
					Background="#00FFFFFF" />
			</ControlTemplate>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="40" />
				<Setter
					Property="Width"
					Value="40" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="1"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="35"
									Width="35"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="35"
									Width="35"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type tk:DataGridColumnHeader}"
				x:Key="ColumnHeaderStyle">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Setter
					Property="Foreground"
					Value="#FFFFFFFF" />
				<Setter
					Property="Background"
					Value="#FF808080" />
				<Setter
					Property="Padding"
					Value="5 2 5 2" />
				<Setter
					Property="BorderBrush"
					Value="#FF808080" />
				<Setter
					Property="BorderThickness"
					Value="3" />
			</Style>
			<Style
				TargetType="{x:Type tk:DataGridCell}"
				x:Key="{x:Type tk:DataGridCell}">
				<Setter
					Property="FontWeight"
					Value="Normal" />
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="BorderBrush"
					Value="#FF808080" />
				<Setter
					Property="BorderThickness"
					Value="1" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type tk:DataGridCell}">
							<Grid
								Background="{TemplateBinding Background}">
								<ContentPresenter
									VerticalAlignment="Center"
									HorizontalAlignment="Center" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Style.Triggers>
					<Trigger
						Property="tk:DataGridCell.IsSelected"
						Value="True">
						<Setter
							Property="Foreground"
							Value="#FF000000" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style
				TargetType="{x:Type GroupItem}"
				x:Key="{x:Type GroupItem}">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Setter
					Property="Foreground"
					Value="#FFFFFFFF" />
				<Setter
					Property="Background"
					Value="#FF808080" />
				<Setter
					Property="Padding"
					Value="5 2 5 2" />
			</Style>
			<CollectionViewSource
				Source="{Binding SelectedProduct.QAParameters}"
				x:Key="Parameter"
				Filter="CollectionViewSource_Filter">
				<CollectionViewSource.GroupDescriptions>
					<PropertyGroupDescription
						PropertyName="Group" />
				</CollectionViewSource.GroupDescriptions>
			</CollectionViewSource>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="10" />
			<ColumnDefinition
				Width="3*" />
		</Grid.ColumnDefinitions>
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<FrameworkElement
					DataContext="{Binding}"
					x:Key="ProxyElement" />
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<ContentControl
			Visibility="Collapsed"
			Content="{StaticResource ProxyElement}" />
		<Border
			Grid.Row="0"
			Grid.Column="1"
			Grid.RowSpan="2"
			BorderBrush="#b6b6b6"
			BorderThickness="0 0 1 0" />
		<ListBox
			Grid.RowSpan="2"
			IsSynchronizedWithCurrentItem="True"
			Margin="10 10 0 10"
			Grid.IsSharedSizeScope="True"
			Background="#00FFFFFF"
			SelectionMode="Single"
			BorderThickness="1"
			ItemsSource="{Binding ParamProducts}"
			SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
			SelectionChanged="ListBox_SelectionChanged">
			<ItemsControl.ItemContainerStyle>
				<Style
					TargetType="{x:Type ListBoxItem}">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type ListBoxItem}">
								<Border
									Name="Border"
									Padding="2"
									SnapsToDevicePixels="True">
									<ContentPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger
										Property="ListBoxItem.IsSelected"
										Value="True">
										<Setter
											TargetName="Border"
											Value="{DynamicResource SystemColors.HighlightBrushKey}"
											Property="Background" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ItemsControl.ItemContainerStyle>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid
						MinHeight="50"
						Visibility="{Binding ProductNumber, Converter={StaticResource intStringToVisibilityConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="grpNumber" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Column="0"
							Margin="0 0 15 0"
							FontWeight="Bold"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							Text="{Binding Path=ProductNumber}" />
						<TextBlock
							Grid.Column="1"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							Text="{Binding Path=ProductName}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
		<Border
			Grid.Column="2"
			HorizontalAlignment="Stretch"
			BorderBrush="#b6b6b6"
			BorderThickness="0 0 0 1" />
		<Grid
			Column="2"
			HorizontalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="7*" />
				<ColumnDefinition
					Width="7*" />
			</Grid.ColumnDefinitions>
			<TextBlock
				FontWeight="Bold"
				FontSize="20"
				FontFamily="Helvetica"
				TextAlignment="Right"
				VerticalAlignment="Center"
				TextWrapping="Wrap"
				Margin="0 0 2 5"
				Grid.Column="2"
				Text="{Binding SelectedProduct.ProductName}" />
			<TextBlock
				Text=": "
				FontWeight="Bold"
				FontSize="20"
				FontFamily="Helvetica"
				TextAlignment="Right"
				VerticalAlignment="Center"
				TextWrapping="Wrap"
				Margin="0 0 10 5"
				Grid.Column="1" />
			<TextBlock
				FontWeight="Bold"
				FontSize="20"
				FontFamily="Helvetica"
				TextAlignment="Right"
				VerticalAlignment="Center"
				TextWrapping="Wrap"
				Margin="0 0 0 5"
				Grid.Column="0"
				Text="{Binding SelectedProduct.ProductNumber}" />
			<ComboBox
				Margin="20 0 0 5"
				IsSynchronizedWithCurrentItem="True"
				Padding="2"
				Grid.Column="3"
				FontSize="22"
				HorizontalAlignment="Left"
				ScrollViewer.PanningMode="None"
				ItemsSource="{Binding ChkPointInfos}"
				SelectedValue="{Binding SelectedCheckpoint, Mode=TwoWay}"
				Visibility="{Binding IsCheckpointAvailable, Converter={StaticResource bVisConverter}}"
				SelectionChanged="ComboBox_SelectionChanged">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Text="{Binding Name}"
							Visibility="{Binding Available, Converter={StaticResource bVisConverter}}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ComboBox>
		</Grid>
		<tk:DataGrid
			Name="dgParams"
			Grid.Row="1"
			Grid.Column="2"
			AutoGenerateColumns="False"
			IsReadOnly="True"
			Background="#dfdfdf"
			BorderThickness="2"
			RowBackground="#00FFFFFF"
			CanUserAddRows="False"
			CanUserDeleteRows="False"
			BorderBrush="#FF808080"
			HeadersVisibility="All"
			RowHeaderWidth="40"
			CanUserReorderColumns="False"
			CanUserResizeColumns="False"
			CanUserResizeRows="False"
			CanUserSortColumns="False"
			VerticalScrollBarVisibility="Visible"
			l:DataGridAttachedProps.SelectAllButtonTemplate="{StaticResource dataGridSelectAllButtonTemplate}"
			HorizontalContentAlignment="Center"
			HorizontalAlignment="Center"
			ItemsSource="{Binding Source={StaticResource Parameter}}"
			Loaded="DataGrid_Loaded">
			<tk:DataGrid.RowHeaderStyle>
				<Style
					TargetType="{x:Type tk:DataGridRowHeader}">
					<Setter
						Property="Content"
						Value="{Binding ParamName}" />
					<Setter
						Property="FontWeight"
						Value="Bold" />
					<Setter
						Property="Background"
						Value="#FF808080" />
					<Setter
						Property="Padding"
						Value="5 2 5 2" />
					<Setter
						Property="Foreground"
						Value="#FFFFFFFF" />
				</Style>
			</tk:DataGrid.RowHeaderStyle>
			<ItemsControl.GroupStyle>
				<GroupStyle>
					<GroupStyle.ContainerStyle>
						<Style
							TargetType="{x:Type GroupItem}">
							<Setter
								Property="HorizontalContentAlignment"
								Value="Stretch" />
							<Setter
								Property="Background"
								Value="#FF808080" />
							<Setter
								Property="BorderBrush"
								Value="#FF9ACD32" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type GroupItem}">
										<Expander
											IsExpanded="False">
											<FrameworkElement.Resources>
												<ResourceDictionary>
													<Style
														TargetType="{x:Type Expander}"
														x:Key="{x:Type Expander}">
														<Setter
															Property="Template">
															<Setter.Value>
																<ControlTemplate
																	TargetType="{x:Type Expander}">
																	<StackPanel
																		Orientation="Vertical">
																		<StackPanel
																			Orientation="Horizontal"
																			Margin="0 7 0 0">
																			<ToggleButton
																				Name="toggleBtn"
																				Margin="2 0 5 2"
																				Style="{StaticResource okButtonStyle}"
																				IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
																				<ContentControl.ContentTemplate>
																					<DataTemplate>
																						<Image
																							Name="rotateMe"
																							Source="..\img\arrow.png"
																							Stretch="None"
																							RenderTransformOrigin="0.5,0.5">
																							<UIElement.RenderTransform>
																								<RotateTransform />
																							</UIElement.RenderTransform>
																						</Image>
																						<DataTemplate.Triggers>
																							<DataTrigger
																								Value="True"
																								Binding="{Binding ElementName=toggleBtn, Path=IsChecked}">
																								<TriggerBase.EnterActions>
																									<BeginStoryboard>
																										<Storyboard>
																											<DoubleAnimation
																												Storyboard.TargetName="rotateMe"
																												Storyboard.TargetProperty="RenderTransform.Angle"
																												To="90"
																												Duration="0:0:0.3" />
																										</Storyboard>
																									</BeginStoryboard>
																								</TriggerBase.EnterActions>
																								<TriggerBase.ExitActions>
																									<BeginStoryboard>
																										<Storyboard>
																											<DoubleAnimation
																												Storyboard.TargetName="rotateMe"
																												Storyboard.TargetProperty="RenderTransform.Angle"
																												To="0"
																												Duration="0:0:0.3" />
																										</Storyboard>
																									</BeginStoryboard>
																								</TriggerBase.ExitActions>
																							</DataTrigger>
																						</DataTemplate.Triggers>
																					</DataTemplate>
																				</ContentControl.ContentTemplate>
																			</ToggleButton>
																			<ContentPresenter
																				Content="{TemplateBinding Header}" />
																		</StackPanel>
																		<ContentPresenter
																			Name="mainContent"
																			Visibility="Collapsed" />
																	</StackPanel>
																	<ControlTemplate.Triggers>
																		<Trigger
																			Property="Expander.IsExpanded"
																			Value="True">
																			<Setter
																				TargetName="mainContent"
																				Property="Visibility"
																				Value="Visible" />
																		</Trigger>
																	</ControlTemplate.Triggers>
																</ControlTemplate>
															</Setter.Value>
														</Setter>
													</Style>
												</ResourceDictionary>
											</FrameworkElement.Resources>
											<HeaderedContentControl.Header>
												<Border
													HorizontalAlignment="Stretch"
													Background="#dfdfdf"
													Padding="10">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition
																Width="*" />
															<ColumnDefinition />
															<ColumnDefinition />
														</Grid.ColumnDefinitions>
														<TextBlock
															Grid.Column="0"
															FontSize="16"
															FontWeight="Bold"
															Foreground="#FF000000"
															Text="{Binding Name}" />
														<TextBlock
															Text=", Num: "
															Grid.Column="1"
															FontSize="16"
															FontWeight="Bold"
															Foreground="#FF000000" />
														<TextBlock
															Grid.Column="2"
															FontSize="16"
															FontWeight="Bold"
															Foreground="#FF000000"
															Text="{Binding ItemCount}" />
													</Grid>
												</Border>
											</HeaderedContentControl.Header>
											<ItemsPresenter />
										</Expander>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</GroupStyle.ContainerStyle>
				</GroupStyle>
			</ItemsControl.GroupStyle>
			<tk:DataGrid.Columns>
				<tk:DataGridTextColumn
					Width="3*"
					MinWidth="110"
					HeaderStyle="{StaticResource ColumnHeaderStyle}"
					Binding="{Binding Values[0]}"
					Header="{Binding DataContext.StrCurrentValues.LocalizedText, Source={StaticResource ProxyElement}}">
					<tk:DataGridColumn.CellStyle>
						<Style
							BasedOn="{StaticResource tk:DataGridCell}"
							TargetType="{x:Type tk:DataGridCell}">
							<Setter
								Property="Background"
								Value="{Binding ParamStates[0], Converter={StaticResource paramStateBrushConverter}}" />
						</Style>
					</tk:DataGridColumn.CellStyle>
				</tk:DataGridTextColumn>
				<tk:DataGridTextColumn
					Width="3*"
					MinWidth="140"
					Binding="{Binding Values[1]}"
					Header="{Binding DataContext.ChkPointInfos[0], Source={StaticResource ProxyElement}}"
					Visibility="{Binding DataContext.ChkPointInfos[0].Available, Converter={StaticResource bVisConverter}, Source={StaticResource ProxyElement}}">
					<tk:DataGridColumn.HeaderStyle>
						<Style
							BasedOn="{StaticResource ColumnHeaderStyle}"
							TargetType="{x:Type tk:DataGridColumnHeader}">
							<Style.Triggers>
								<DataTrigger
									Value="True"
									Binding="{Binding IsSelected}">
									<Setter
										Property="BorderBrush"
										Value="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</tk:DataGridColumn.HeaderStyle>
					<tk:DataGridColumn.HeaderTemplate>
						<DataTemplate>
							<DockPanel>
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Name}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Date, Converter={StaticResource dateTimeToStringConverter}}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Username}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Foreground="#FFFF0000"
									Visibility="{Binding IsChanged, Converter={StaticResource bVisConverter}}">
									<TextBlock.Text>
										<MultiBinding
											StringFormat=" {0}: {1}">
											<Binding
												Path="DataContext.StrDifferent.LocalizedText"
												Source="{StaticResource ProxyElement}" />
											<Binding
												Path="NumChanged" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</DockPanel>
						</DataTemplate>
					</tk:DataGridColumn.HeaderTemplate>
					<tk:DataGridColumn.CellStyle>
						<Style
							BasedOn="{StaticResource tk:DataGridCell}"
							TargetType="{x:Type tk:DataGridCell}">
							<Setter
								Property="Background"
								Value="{Binding ParamStates[1], Converter={StaticResource paramStateBrushConverter}}" />
						</Style>
					</tk:DataGridColumn.CellStyle>
				</tk:DataGridTextColumn>
				<tk:DataGridTextColumn
					Width="3*"
					MinWidth="140"
					Binding="{Binding Values[2]}"
					Header="{Binding DataContext.ChkPointInfos[1], Source={StaticResource ProxyElement}}"
					Visibility="{Binding DataContext.ChkPointInfos[1].Available, Converter={StaticResource bVisConverter}, Source={StaticResource ProxyElement}}">
					<tk:DataGridColumn.HeaderStyle>
						<Style
							BasedOn="{StaticResource ColumnHeaderStyle}"
							TargetType="{x:Type tk:DataGridColumnHeader}">
							<Style.Triggers>
								<DataTrigger
									Value="True"
									Binding="{Binding IsSelected}">
									<Setter
										Property="BorderBrush"
										Value="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</tk:DataGridColumn.HeaderStyle>
					<tk:DataGridColumn.HeaderTemplate>
						<DataTemplate>
							<DockPanel>
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Name}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Date, Converter={StaticResource dateTimeToStringConverter}}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Username}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Foreground="#FFFF0000"
									Visibility="{Binding IsChanged, Converter={StaticResource bVisConverter}}">
									<TextBlock.Text>
										<MultiBinding
											StringFormat=" {0}: {1}">
											<Binding
												Path="DataContext.StrDifferent.LocalizedText"
												Source="{StaticResource ProxyElement}" />
											<Binding
												Path="NumChanged" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</DockPanel>
						</DataTemplate>
					</tk:DataGridColumn.HeaderTemplate>
					<tk:DataGridColumn.CellStyle>
						<Style
							BasedOn="{StaticResource tk:DataGridCell}"
							TargetType="{x:Type tk:DataGridCell}">
							<Setter
								Property="Background"
								Value="{Binding ParamStates[2], Converter={StaticResource paramStateBrushConverter}}" />
						</Style>
					</tk:DataGridColumn.CellStyle>
				</tk:DataGridTextColumn>
				<tk:DataGridTextColumn
					Width="3*"
					MinWidth="140"
					Binding="{Binding Values[3]}"
					Header="{Binding DataContext.ChkPointInfos[2], Source={StaticResource ProxyElement}}"
					Visibility="{Binding DataContext.ChkPointInfos[2].Available, Converter={StaticResource bVisConverter}, Source={StaticResource ProxyElement}}">
					<tk:DataGridColumn.HeaderStyle>
						<Style
							BasedOn="{StaticResource ColumnHeaderStyle}"
							TargetType="{x:Type tk:DataGridColumnHeader}">
							<Style.Triggers>
								<DataTrigger
									Value="True"
									Binding="{Binding IsSelected}">
									<Setter
										Property="BorderBrush"
										Value="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</tk:DataGridColumn.HeaderStyle>
					<tk:DataGridColumn.HeaderTemplate>
						<DataTemplate>
							<DockPanel>
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Name}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Date, Converter={StaticResource dateTimeToStringConverter}}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Text="{Binding Username}"
									Foreground="{Binding IsChanged, Converter={StaticResource changeToBrushConverter}}" />
								<TextBlock
									HorizontalAlignment="Center"
									DockPanel.Dock="Top"
									Foreground="#FFFF0000"
									Visibility="{Binding IsChanged, Converter={StaticResource bVisConverter}}">
									<TextBlock.Text>
										<MultiBinding
											StringFormat=" {0}: {1}">
											<Binding
												Path="DataContext.StrDifferent.LocalizedText"
												Source="{StaticResource ProxyElement}" />
											<Binding
												Path="NumChanged" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</DockPanel>
						</DataTemplate>
					</tk:DataGridColumn.HeaderTemplate>
					<tk:DataGridColumn.CellStyle>
						<Style
							BasedOn="{StaticResource tk:DataGridCell}"
							TargetType="{x:Type tk:DataGridCell}">
							<Setter
								Property="Background"
								Value="{Binding ParamStates[3], Converter={StaticResource paramStateBrushConverter}}" />
						</Style>
					</tk:DataGridColumn.CellStyle>
				</tk:DataGridTextColumn>
			</tk:DataGrid.Columns>
		</tk:DataGrid>
	</Grid>
</UserControl>
