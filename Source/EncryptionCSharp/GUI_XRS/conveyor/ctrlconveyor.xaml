<UserControl
	x:Class="GUI_XRS.CtrlConveyor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<l:SpeedInMPerSecLocalizedStringConverter
				x:Key="speedInMPerSecLocalizedStringConverter" />
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxDisabledStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="5"
								BorderThickness="1"
								Background="#00FFFFFF">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="0 0 0 0" />
			</Style>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type l:RadioButtonExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 0 65 0" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 12">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="5*" />
					<ColumnDefinition
						Width="4*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition
						Height="{Binding SpeedUnitEnabled, Converter={StaticResource boolGridLengthStarConverter}}" />
					<RowDefinition />
					<RowDefinition
						Height="{Binding SpeedUnitEnabled, Converter={StaticResource boolGridLengthStarConverter}}" />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="5"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="0"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="2"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="2"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="3"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="3"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=StrConveyorSpeed.LocalizedText, FallbackValue=Förderbandgeschwindigkeit}" /> (<TextBlock
						Text="{Binding Path=SpeedAbbr, FallbackValue=m / s}" /><TextBlock
						Text=")"
						Margin="0 0 20 0" /></TextBlock>
				<Grid
					Row="0"
					Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button
						Name="btnLowerSpeed"
						Grid.Column="0"
						Margin="5 20 5 20"
						Width="50"
						Height="{Binding ElementName=txtSpeed, Path=ActualHeight}"
						Command="{Binding LowerSpeedCommand}"
						Visibility="{Binding SpeedEnabled, Converter={StaticResource bVisConverter}}">
						<Image
							Source="/img/minus2.png" />
					</Button>
					<TextBox
						Name="txtSpeed"
						Grid.Row="0"
						Grid.Column="1"
						Margin="0 20 0 20"
						IsEnabled="{Binding Path=SpeedEnabled}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeSpeedCommand}">
						<TextBox.Text>
							<MultiBinding
								Converter="{StaticResource speedInMPerSecLocalizedStringConverter}">
								<Binding
									Path="Conveyor.Speed"
									Mode="TwoWay"
									UpdateSourceTrigger="PropertyChanged" />
								<Binding
									Path="SpeedMetric" />
							</MultiBinding>
						</TextBox.Text>
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="SpeedEnabled" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<Button
						Name="btnHigherSpeed"
						Grid.Column="2"
						Margin="5 20 5 20"
						Width="50"
						Height="{Binding ElementName=txtSpeed, Path=ActualHeight}"
						Command="{Binding HigherSpeedCommand}"
						Visibility="{Binding SpeedEnabled, Converter={StaticResource bVisConverter}}">
						<Image
							Source="/img/plus2.png" />
					</Button>
				</Grid>
				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=StrRatedConveyorSpeed.LocalizedText, FallbackValue=Nenngeschwindigkeit Förderband}" /> (<TextBlock
						Text="{Binding Path=SpeedAbbr, FallbackValue=m / s}" /><TextBlock
						Text=")"
						Margin="0 0 20 0" /></TextBlock>
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					Margin="45 20 45 20"
					IsEnabled="{Binding Path=RatedSpeedEnabled}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMaxSpeedCommand}">
					<TextBox.Text>
						<MultiBinding
							Converter="{StaticResource speedInMPerSecLocalizedStringConverter}">
							<Binding
								Path="Conveyor.RatedSpeed"
								Mode="TwoWay"
								UpdateSourceTrigger="PropertyChanged" />
							<Binding
								Path="SpeedMetric" />
						</MultiBinding>
					</TextBox.Text>
					<FrameworkElement.Style>
						<MultiBinding
							Converter="{StaticResource bTextBoxStyleConverter}">
							<MultiBinding.Bindings>
								<Binding
									RelativeSource="{RelativeSource Self}" />
								<Binding
									Path="RatedSpeedEnabled" />
							</MultiBinding.Bindings>
						</MultiBinding>
					</FrameworkElement.Style>
				</TextBox>
				<TextBlock
					Margin="20 0 20 0"
					Grid.Row="2"
					Grid.Column="0"
					Text="{Binding Path=StrSpeedUnit.LocalizedText, FallbackValue=Einheit Geschwindigkeit}" />
				<Grid
					Row="2"
					Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height=" 1.7*" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock
						Margin="0 0 2 0"
						Text="m/s"
						Grid.Column="0"
						Grid.Row="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Top" />
					<l:RadioButtonExtended
						GroupName="rbSpeedUnit"
						Grid.Column="0"
						Grid.Row="0"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						IsCheckedReal="{Binding Path=ShowSpeedMetric, Mode=TwoWay}"
						Height="{Binding ElementName=txtSpeed, Path=ActualHeight}" />
					<TextBlock
						Margin="0 0 2 0"
						Text="m/min"
						Grid.Column="1"
						Grid.Row="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Top" />
					<l:RadioButtonExtended
						GroupName="rbSpeedUnit"
						Grid.Column="1"
						Grid.Row="0"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						IsCheckedReal="{Binding Path=ShowSpeedMetricMin, Mode=TwoWay}"
						Height="{Binding ElementName=txtSpeed, Path=ActualHeight}" />
					<TextBlock
						Margin="0 0 2 0"
						Text="ft/min"
						Grid.Column="2"
						Grid.Row="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Top" />
					<l:RadioButtonExtended
						GroupName="rbSpeedUnit"
						Grid.Column="2"
						Grid.Row="0"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						IsCheckedReal="{Binding Path=ShowSpeedAmerican, Mode=TwoWay}"
						Height="{Binding ElementName=txtSpeed, Path=ActualHeight}" />
				</Grid>
				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=StrConveyorDistance.LocalizedText, FallbackValue=Föderband Distanz}" /> (<TextBlock
						Text="{Binding Path=DistanceAbbr, FallbackValue=m}" /><TextBlock
						Text=")"
						Margin="0 0 20 0" /></TextBlock>
				<Grid
					Row="3"
					Column="1">
					<TextBox
						Margin="45 20 45 20"
						Style="{StaticResource disabledTextBox}"
						Text="{Binding Path=ConveyorDistance}" />
				</Grid>
				<Grid
					Row="4"
					Column="0">
					<TextBlock
						Margin="0 0 20 0"
						Text="{Binding Path=StrResetConveyorDistance.LocalizedText, FallbackValue=Rücksetzen Förderband Distanz}" />
				</Grid>
				<Grid
					Row="4"
					Column="1">
					<Button
						Style="{StaticResource defaultButtonStyle}"
						Command="{Binding ResetConveyorDistanceCommand}">
						<Image
							Source="../img/delete.png"
							Height="40" />
					</Button>
				</Grid>
			</Grid>
		</Border>
		<Border
			Margin="0 0 0 12"
			Background="#5f000000"
			Visibility="{Binding MachineCalibrating, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
	</Grid>
</UserControl>
