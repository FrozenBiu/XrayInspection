<UserControl
	x:Class="GUI_XRS.CtrlDualEnergy" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:image="clr-namespace:XrsImage;assembly=XrsImage" xmlns:seso="clr-namespace:SesoPlot;assembly=Sesoplot"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="UserControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:MessageHeightConverter
				x:Key="messHeightConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisCollapsedConverter" />
			<l:IntGridLengthAutoConverter
				x:Key="intGridLengthAutoConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtThresholdStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Left" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
			</Style>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="45" />
				<Setter
					Property="Width"
					Value="45" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="3"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="40"
									Width="40"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="40"
									Width="40"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="ButtonDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="ButtonUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				x:Key="toleranceSliderStyle">
				<Style.Resources>
					<ResourceDictionary />
				</Style.Resources>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="chartGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="2*" />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="1"
			Text="HighEnergy"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Margin="5" />
		<TextBlock
			Grid.Column="1"
			VerticalAlignment="Top"
			HorizontalAlignment="Center"
			FontSize="18"
			FontWeight="Bold"
			Text="{Binding Path=StrMaterialCurve.LocalizedText, FallbackValue=Materialkurve}" />
		<seso:SesoPlot
			Name="plot"
			Grid.Column="1"
			MajorTicksX="200"
			MajorTicksY="200"
			MinorTicksX="50"
			MinorTicksY="50"
			DrawMinorGridLinesHorizontal="True"
			DrawMinorGridLinesVertical="True"
			Margin="0,-20,0,0"
			MaximumXLimit="9500"
			MaximumYLimit="9500"
			MinimumX="{Binding MinX}"
			MinimumY="{Binding MinY}"
			MaximumX="{Binding MaxX}"
			MaximumY="{Binding MaxY}">
			<seso:SesoPlot.Graphs>
				<seso:Graph
					GraphType="Scatter"
					Stroke="#FF008000"
					StrokeThickness="0.5"
					Points="{Binding PointsGood}" />
				<seso:Graph
					GraphType="Scatter"
					Stroke="#FFFF0000"
					StrokeThickness="0.5"
					Points="{Binding PointsBad}" />
				<seso:Graph
					GraphType="Scatter"
					Stroke="#FF000000"
					StrokeThickness="0.5"
					Points="{Binding PointsSelected}" />
				<seso:Graph
					GraphType="Linear"
					Stroke="#FF0000FF"
					StrokeThickness="2"
					Points="{Binding PointsMaterialCurveGraph}" />
			</seso:SesoPlot.Graphs>
		</seso:SesoPlot>
		<TextBlock
			Grid.Column="1"
			Text="LowEnergy"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Center" />
		<Grid
			Column="0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding MultiLaneDualGridVisible, Converter={StaticResource intGridLengthAutoConverter}}" />
				<RowDefinition
					Height="35" />
				<RowDefinition
					Height="16*" />
				<RowDefinition
					Height="6*" />
			</Grid.RowDefinitions>
			<TabControl
				Name="tabCtrl"
				Grid.Row="0"
				IsSynchronizedWithCurrentItem="True"
				ItemsSource="{Binding ShownLanesDual}"
				SelectedItem="{Binding SelectedXriLaneDual}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Style="{StaticResource txtThresholdStyle}"
							FontSize="14"
							Margin="1 1 1 1"
							Text="{Binding Path=LaneName}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
				<TabControl.ContentTemplate>
					<DataTemplate>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition
									Height="25*" />
							</Grid.RowDefinitions>
						</Grid>
					</DataTemplate>
				</TabControl.ContentTemplate>
			</TabControl>
			<TextBlock
				Grid.Row="1"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				FontWeight="Bold"
				FontSize="18"
				Margin="10,5,0,0"
				Text="{Binding Path=StrActualImage.LocalizedText, FallbackValue=Aktuelles Bild}" />
			<image:XRSImageBox
				Name="imagebox"
				Grid.Column="0"
				Grid.Row="2"
				UserLoggedIn="True"
				BoxSelectionMode="DrawRetrainRectangle"
				Image="{Binding Path=DataContext.Image, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" />
			<StackPanel
				VerticalAlignment="Top"
				Margin="10"
				Grid.Row="3">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="30" />
						<RowDefinition
							Height="50" />
						<RowDefinition
							Height="50" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition
							Width="2*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						FontWeight="Bold"
						FontSize="18"
						Text="{Binding Path=StrSensitivity.LocalizedText, FallbackValue=Empfindlichkeit}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Top"
						HorizontalAlignment="Left"
						FontSize="14"
						Margin="0,7,0,0"
						Text="{Binding Path=StrUpperMaterialCurve.LocalizedText, FallbackValue=Obere Materiallinie}" />
					<Grid
						Row="1"
						Column="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Button
							Grid.Column="0"
							Width="35"
							Height="35"
							VerticalAlignment="Top"
							HorizontalAlignment="Right"
							Command="{Binding DecTolMaxMaterialCurveCommand}">
							<Image
								Source="/img/minus2.png" />
						</Button>
						<TextBox
							Grid.Column="1"
							Width="90"
							Height="35"
							VerticalAlignment="Top"
							FontSize="20"
							TextAlignment="Center"
							common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeToleranceMaxCommand}"
							Text="{Binding ToleranceMaxSlider, StringFormat={}{0:0}}" />
						<Button
							Grid.Column="2"
							Width="35"
							Height="35"
							VerticalAlignment="Top"
							HorizontalAlignment="Left"
							Command="{Binding IncTolMaxMaterialCurveCommand}">
							<Image
								Source="/img/plus2.png" />
						</Button>
					</Grid>
					<TextBlock
						Grid.Row="2"
						VerticalAlignment="Top"
						HorizontalAlignment="Left"
						FontSize="14"
						Margin="0,7,0,0"
						Text="{Binding Path=StrLowerMaterialCurve.LocalizedText, FallbackValue=Untere Materiallinie}" />
					<Grid
						Row="2"
						Column="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Button
							Grid.Column="0"
							Width="35"
							Height="35"
							VerticalAlignment="Top"
							HorizontalAlignment="Right"
							Command="{Binding DecTolMinMaterialCurveCommand}">
							<Image
								Source="/img/minus2.png" />
						</Button>
						<TextBox
							Grid.Column="1"
							Width="90"
							Height="35"
							VerticalAlignment="Top"
							FontSize="20"
							TextAlignment="Center"
							common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeToleranceMinCommand}"
							Text="{Binding ToleranceMinSlider, StringFormat={}{0:0}}" />
						<Button
							Grid.Column="2"
							Width="35"
							Height="35"
							VerticalAlignment="Top"
							HorizontalAlignment="Left"
							Command="{Binding IncTolMinMaterialCurveCommand}">
							<Image
								Source="/img/plus2.png" />
						</Button>
					</Grid>
				</Grid>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
