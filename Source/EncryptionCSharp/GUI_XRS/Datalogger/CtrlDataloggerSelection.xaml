<UserControl
	x:Class="GUI_XRS.Datalogger.CtrlDataloggerSelection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:datalogger="clr-namespace:GUI_XRS.Datalogger"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<l:SpeedInMPerSecLocalizedStringConverter
				x:Key="speedInMPerSecLocalizedStringConverter" />
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="0 0 0 0" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 12">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="3"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="0"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="0">
					<TextBlock
						Text="Manual"
						Margin="20 0 20 0" />
				</TextBlock>
				<Grid
					Row="0"
					Column="1">
					<Button
						Style="{StaticResource defaultButtonStyle}"
						Margin="5"
						Command="{Binding DataloggerManualCommand}">
						<Image
							Source="../img/dataplotter.png"
							Height="40" />
					</Button>
				</Grid>
				<TextBlock
					Grid.Row="1"
					Grid.Column="0">
					<TextBlock
						Text="Automatic"
						Margin="20 0 20 0" />
				</TextBlock>
				<Grid
					Row="1"
					Column="1">
					<Button
						Style="{StaticResource defaultButtonStyle}"
						Margin="5"
						Command="{Binding DataloggerAutomaticCommand}">
						<Image
							Source="../img/dataplotter.png"
							Height="40" />
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
