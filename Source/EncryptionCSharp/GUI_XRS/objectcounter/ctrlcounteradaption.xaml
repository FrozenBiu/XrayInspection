<UserControl
	x:Class="GUI_XRS.CtrlCounterAdaption" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS"
	Unloaded="CtrlCounterAdaption_Unloaded"
	Loaded="UserControl_Loaded">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<image:XRSImageBox
			Name="imageboxOriginal" />
		<image:XRSImageBox
			Name="imageboxDebug"
			Grid.Column="1" />
	</Grid>
</UserControl>
