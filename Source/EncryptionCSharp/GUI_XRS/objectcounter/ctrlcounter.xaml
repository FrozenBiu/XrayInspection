<UserControl
	x:Class="GUI_XRS.CtrlCounter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="CtrlCounter_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="{x:Type TextBox}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#cfcfcf" />
							<GradientStop
								Offset="0.02"
								Color="#e9e9e9" />
							<GradientStop
								Offset="0.03"
								Color="#f1f1f1" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#bebebe" />
							<GradientStop
								Offset="0.10"
								Color="#d8d8d8" />
							<GradientStop
								Offset="0.9"
								Color="#d8d8d8" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="Margin"
					Value="1 1 1 1" />
				<Setter
					Property="Padding"
					Value="10 0 10 0" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontSize"
					Value="28" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="TextBox.TextAlignment"
					Value="Right" />
				<Setter
					Property="Foreground"
					Value="#5e5e5e" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="3"
								BorderThickness="2"
								Padding="{TemplateBinding Padding}"
								BorderBrush="{DynamicResource textBoxBorder}"
								Background="{DynamicResource textBoxBackground}">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<ScrollViewer
		VerticalScrollBarVisibility="Auto">
		<Grid
			Margin="12 5 12 5">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Border
				Grid.Row="0"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1"
				Margin="0 0 0 12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="2*" />
						<ColumnDefinition
							Width="3*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							MinHeight="70" />
						<RowDefinition
							MinHeight="70" />
						<RowDefinition
							MinHeight="70" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="3"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						BorderBrush="#e1e1e1"
						BorderThickness="0 1 0 0" />
					<Border
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="2"
						Grid.Column="0" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding Path=StrMinCount.LocalizedText, FallbackValue=Minimale Anzahl}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.MinCount, Mode=TwoWay}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMinCountCommand}" />
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Text="{Binding Path=StrMaxCount.LocalizedText, FallbackValue=Maximale Anzahl}" />
					<TextBox
						Grid.Row="2"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.MaxCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMaxCountCommand}" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding Path=StrCurrentCount.LocalizedText, FallbackValue=Aktuelle Anzahl}" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource disabledTextBox}"
						IsEnabled="False"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.CurrentCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</Grid>
			</Border>
			<Border
				Grid.Row="1"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1"
				Margin="0 0 0 12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="2*" />
						<ColumnDefinition
							Width="3*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							MinHeight="70" />
						<RowDefinition
							MinHeight="70" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="2"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						BorderBrush="#e1e1e1"
						BorderThickness="0 1 0 0" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding Path=StrMinSize.LocalizedText, FallbackValue=Minimale Objektgröße}" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.MinSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMinSizeCommand}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding Path=StrMaxSize.LocalizedText, FallbackValue=Maximale Objektgröße}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.MaxSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMaxSizeCommand}" />
				</Grid>
			</Border>
			<Border
				Grid.Row="2"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1"
				Margin="0 0 0 12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="2*" />
						<ColumnDefinition
							Width="3*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							MinHeight="70" />
						<RowDefinition
							MinHeight="70" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="2"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						BorderBrush="#e1e1e1"
						BorderThickness="0 1 0 0" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding Path=StrLowThreshold.LocalizedText, FallbackValue=Schwellwert - Minimum}" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.LowThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeLowThresholdCommand}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding Path=StrHighThreshold.LocalizedText, FallbackValue=Schwellwert - Maximum}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.HighThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeHighThresholdCommand}" />
				</Grid>
			</Border>
			<Border
				Grid.Row="3"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="2*" />
						<ColumnDefinition
							Width="3*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							MinHeight="70" />
						<RowDefinition
							MinHeight="70" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="2"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						BorderBrush="#e1e1e1"
						BorderThickness="0 1 0 0" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding Path=StrUnmaskForContEnabled.LocalizedText, FallbackValue=Objekt für Filter ausschließen}" />
					<CheckBox
						Grid.Row="0"
						Grid.Column="1"
						HorizontalAlignment="Center"
						IsChecked="{Binding Path=ChangeUnmaskForCont}"
						IsEnabled="{Binding IsCountType}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding Path=StrFilterSize.LocalizedText, FallbackValue=Glättung}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Margin="65 0 65 0"
						Text="{Binding Path=ObjCounter.FilterSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeFilterSizeCommand}" />
				</Grid>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>
