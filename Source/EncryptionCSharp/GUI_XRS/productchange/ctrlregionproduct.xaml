<UserControl
	x:Class="GUI_XRS.CtrlRegionProduct" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.LoadedCommand="{Binding InitializeCommand}"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:LaneStringConverter
				x:Key="laneStringConverter" />
			<l:StringToVisibilityConverter
				x:Key="stringToVisibilityConverter" />
			<l:SubProductIndexToBrushConverter
				x:Key="subProductIndexToBrushConverter" />
			<l:SubProductIndexToStrokeDashConverter
				x:Key="subProductIndexToStrokeDashConverter" />
			<l:RefVisibilityCollapsedConverter
				x:Key="refVisibilityCollapsedConverter" />
			<l:StringToVisibilityHiddenConverter
				x:Key="stringToVisibilityHiddenConverter" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="ListBox.SelectionMode"
					Value="Single" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="True" />
				<Setter
					Property="Grid.IsSharedSizeScope"
					Value="True" />
			</Style>
			<Style
				TargetType="{x:Type Button}"
				x:Key="transpEditButton">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								BorderBrush="#FFFFFFFF"
								BorderThickness="2"
								CornerRadius="3">
								<Image
									Source="../img/editproduct_bw.png" />
								<Border.Background>
									<SolidColorBrush
										x:Name="BorderUp"
										Color="White"
										Opacity="0" />
								</Border.Background>
							</Border>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="ButtonDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderUp"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="0.3" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="ButtonUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderUp"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="20 0 20 0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="3*" />
			<RowDefinition
				Height="20*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="2*" />
		</Grid.ColumnDefinitions>
		<Border
			Grid.Row="0"
			Grid.RowSpan="3"
			BorderThickness="0 0 1 0"
			BorderBrush="#b6b6b6"
			Margin="-20 0 -1 0" />
		<TextBlock
			Name="tbCurrentAppl"
			Grid.Row="0"
			VerticalAlignment="Center"
			FontSize="25"
			FontWeight="Bold"
			FontFamily="Helvetica"
			Text="{Binding Path=ProductManager.SelectedProduct.ProductName}" />
		<ListBox
			Name="lstSubProducts"
			Grid.Row="1"
			Background="#E7EFC5"
			SelectionMode="Single"
			Grid.IsSharedSizeScope="True"
			IsSynchronizedWithCurrentItem="True"
			BorderThickness="1 1 0 0"
			Margin="0 0 0 0"
			BorderBrush="#b6b6b6"
			SelectedItem="{Binding Path=ProductManager.SelectedSubProduct}"
			ItemsSource="{Binding Path=RegionProduct}"
			SelectionChanged="ListBox_SelectionChanged">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid
						MinHeight="50"
						Visibility="{Binding ProductNumber, Converter={StaticResource stringToVisibilityHiddenConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupNumber" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupStroke" />
							<ColumnDefinition
								Width="*"
								SharedSizeGroup="groupName" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							FontWeight="Bold"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							Margin="2 0 0 0"
							Text="{Binding Path=ProductNumber}" />
						<TextBlock
							Grid.Column="2"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							Text="{Binding Path=ProductName}" />
						<Rectangle
							Grid.Column="1"
							Margin="10 0 10 0"
							Height="13"
							Width="39"
							StrokeThickness="1"
							Stroke="{Binding SubProductIndex, Converter={StaticResource subProductIndexToBrushConverter}}"
							StrokeDashArray="{Binding SubProductIndex, Converter={StaticResource subProductIndexToStrokeDashConverter}}"
							Visibility="{Binding IsRectangleRegion, Converter={StaticResource bVisConverter}}" />
						<Path
							Grid.Column="1"
							Margin="10 0 10 0"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Stroke="{Binding SubProductIndex, Converter={StaticResource subProductIndexToBrushConverter}}"
							StrokeDashArray="{Binding SubProductIndex, Converter={StaticResource subProductIndexToStrokeDashConverter}}"
							Visibility="{Binding IsPolygonalRegion, Converter={StaticResource bVisConverter}}">
							<Path.Data>
								<PathGeometry>
									<PathFigure
										IsClosed="True">
										<LineSegment
											Point="0 0" />
										<LineSegment
											Point="13 7" />
										<LineSegment
											Point="26 0" />
										<LineSegment
											Point="39 14" />
										<LineSegment
											Point="0 14" />
									</PathFigure>
								</PathGeometry>
							</Path.Data>
						</Path>
						<Ellipse
							Grid.Column="1"
							Margin="10 0 10 0"
							Height="13"
							Width="39"
							StrokeThickness="1"
							Stroke="{Binding SubProductIndex, Converter={StaticResource subProductIndexToBrushConverter}}"
							StrokeDashArray="{Binding SubProductIndex, Converter={StaticResource subProductIndexToStrokeDashConverter}}"
							Visibility="{Binding IsEllipticRegion, Converter={StaticResource bVisConverter}}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
		<Border
			Grid.Row="1"
			Margin="0"
			Background="#60000000"
			Visibility="{Binding DataContext.RegionEditable, Converter={StaticResource bVisConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=l:CtrlRegionProduct}}" />
		<StackPanel
			Grid.Row="2"
			Orientation="Horizontal"
			HorizontalAlignment="Center"
			Margin="2"
			Visibility="{Binding RegionNotEditable, Converter={StaticResource bVisConverter}}">
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Margin="5 8 5 5"
				Command="{Binding AddRegionCommand}">
				<Image
					Source="/img/addProduct.png"
					Height="40" />
			</Button>
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Margin="5 8 5 5"
				Command="{Binding RemoveRegionCommand}">
				<Image
					Source="/img/deleteProduct.png"
					Height="40" />
			</Button>
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Margin="5 8 5 5"
				Command="{Binding RenameRegionCommand}">
				<Image
					Source="/img/editProduct.png"
					Height="40" />
			</Button>
		</StackPanel>
		<DockPanel
			Grid.Row="2"
			HorizontalAlignment="Stretch"
			Margin="2"
			Visibility="{Binding RegionEditable, Converter={StaticResource bVisConverter}}">
			<Button
				DockPanel.Dock="Left"
				HorizontalAlignment="Left"
				Style="{StaticResource okButtonStyle}"
				Margin="5 8 5 5"
				Command="{Binding CommitRegionSelectCommand}">
				<Image
					Source="/img/ok.png"
					Stretch="None" />
			</Button>
			<Button
				DockPanel.Dock="Right"
				HorizontalAlignment="Right"
				Style="{StaticResource cancelButtonStyle}"
				Margin="5 8 5 5"
				Command="{Binding AbortRegionSelectCommand}">
				<Image
					Source="/img/cancel.png"
					Stretch="None" />
			</Button>
		</DockPanel>
		<image:XRSImageBox
			Name="imagebox"
			Grid.Column="1"
			Grid.RowSpan="3"
			Margin="10 2 10 2"
			RegionIndex="{Binding DataContext.ProductManager.SelectedSubProduct.SubProductIndex, FallbackValue=-1, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=l:CtrlRegionProduct}}"
			Image="{Binding DataContext.CurrentImage, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=l:CtrlRegionProduct}}" />
		<Border
			Grid.Column="1"
			Grid.RowSpan="3"
			Margin="10 2 10 2"
			Background="#60000000"
			Visibility="{Binding DataContext.RegionNotEditable, Converter={StaticResource bVisConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=l:CtrlRegionProduct}}">
			<Button
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				Height="70"
				Width="70"
				Background="#00FFFFFF"
				BorderThickness="5"
				BorderBrush="#FFFFFFFF"
				Style="{StaticResource transpEditButton}"
				Visibility="{Binding DataContext.ProductManager.SelectedSubProduct, Converter={StaticResource refVisibilityCollapsedConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=l:CtrlRegionProduct}}"
				Command="{Binding MakeRegionEditableCommand}" />
		</Border>
		<Border
			Grid.Column="0"
			Grid.Row="2"
			Grid.ColumnSpan="1"
			BorderThickness="0 1 0 0"
			BorderBrush="#b6b6b6" />
	</Grid>
</UserControl>
