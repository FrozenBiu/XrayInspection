<UserControl
	x:Class="GUI_XRS.CtrlChoseRegionType" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Loaded="UserControl_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:RegionTypeStringConverter
				x:Key="regionTypeStringConverter" />
			<l:RegionTypesStringConverter
				x:Key="regionTypesStringConverter" />
			<l:RegionTypeRectangleVisibleConverter
				x:Key="regionTypeRectangleVisibleConverter" />
			<l:RegionTypePolygonVisibleConverter
				x:Key="regionTypePolygonVisibleConverter" />
			<l:RegionTypeEllipseVisibleConverter
				x:Key="regionTypeEllipseVisibleConverter" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="ListBox.SelectionMode"
					Value="Single" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="True" />
				<Setter
					Property="Grid.IsSharedSizeScope"
					Value="True" />
			</Style>
			<image:XRSRegionTypes
				x:Key="RegionTypes">
				<image:XRSRegionType>Rectangle</image:XRSRegionType>
				<image:XRSRegionType>Polygon</image:XRSRegionType>
				<image:XRSRegionType>Ellipse</image:XRSRegionType>
			</image:XRSRegionTypes>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="3*" />
			<RowDefinition
				Height="20*" />
		</Grid.RowDefinitions>
		<TextBlock
			Grid.Row="0"
			VerticalAlignment="Center"
			FontSize="25"
			FontWeight="Bold"
			FontFamily="Helvetica"
			Margin="20 0 20 0"
			Text="{Binding Path=ProductManager.SelectedProduct.ProductName}" />
		<ListBox
			Grid.Row="1"
			Background="#00FFFFFF"
			SelectionMode="Single"
			BorderBrush="#b6b6b6"
			Margin="20 10 20 10"
			Padding="10"
			ItemsSource="{Binding Source={StaticResource RegionTypes}}"
			SelectedItem="{Binding Path=SelectedRegionType}"
			common:MouseCommandBehavior.MouseDoubleClickCommand="{Binding AddOrEditRegionCommand}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid
						MinHeight="50">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="groupStroke" />
							<ColumnDefinition
								Width="*"
								SharedSizeGroup="groupName" />
						</Grid.ColumnDefinitions>
						<Rectangle
							Grid.Column="0"
							Margin="10 0 10 0"
							Height="13"
							Width="39"
							StrokeThickness="1"
							Stroke="#FF008000"
							Visibility="{Binding Path=., Converter={StaticResource regionTypeRectangleVisibleConverter}}" />
						<Path
							Grid.Column="0"
							Margin="10 0 10 0"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Stroke="#FF008000"
							Visibility="{Binding Path=., Converter={StaticResource regionTypePolygonVisibleConverter}}">
							<Path.Data>
								<PathGeometry>
									<PathFigure
										IsClosed="True">
										<LineSegment
											Point="0 0" />
										<LineSegment
											Point="13 7" />
										<LineSegment
											Point="26 0" />
										<LineSegment
											Point="39 14" />
										<LineSegment
											Point="0 14" />
									</PathFigure>
								</PathGeometry>
							</Path.Data>
						</Path>
						<Ellipse
							Grid.Column="0"
							Margin="10 0 10 0"
							Height="13"
							Width="39"
							StrokeThickness="1"
							Stroke="#FF008000"
							Visibility="{Binding Path=., Converter={StaticResource regionTypeEllipseVisibleConverter}}" />
						<TextBlock
							Grid.Column="1"
							FontWeight="Bold"
							FontSize="20"
							FontFamily="Helvetica"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							Margin="2 0 0 0"
							Text="{Binding Path=., Converter={StaticResource regionTypeStringConverter}}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
