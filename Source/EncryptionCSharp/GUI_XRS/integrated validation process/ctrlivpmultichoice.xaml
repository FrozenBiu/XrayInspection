<UserControl
	x:Class="GUI_XRS.CtrlIVPMultiChoice" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="Multichoice_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="22" />
				<Setter
					Property="Margin"
					Value="20 10 20 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TextBlock
			FontSize="25"
			Text="{Binding Path=StrChoose.LocalizedText, FallbackValue=Subprodukt auswählen}" />
		<ListBox
			Grid.Row="1"
			SelectionMode="Single"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			Background="#00FFFFFF"
			HorizontalAlignment="Stretch"
			Margin="20 15 20 5"
			HorizontalContentAlignment="Stretch"
			FontSize="20"
			ItemsSource="{Binding SelectionList}"
			SelectedItem="{Binding SelectedItem}">
			<ItemsControl.ItemContainerStyle>
				<!--Unknown connection ID: 2-->
				<Style
					TargetType="{x:Type ListBoxItem}" />
			</ItemsControl.ItemContainerStyle>
		</ListBox>
	</Grid>
</UserControl>
