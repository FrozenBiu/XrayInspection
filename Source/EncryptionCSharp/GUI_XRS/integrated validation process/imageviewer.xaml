<Window
	x:Class="GUI_XRS.ImageViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	WindowStartupLocation="Manual"
	ResizeMode="NoResize"
	WindowStyle="None"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS"
	WindowState="{Binding WState}"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}"
	Closing="Window_Closing">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid"
		Row="1">
		<Border
			BorderBrush="#ffffff"
			BorderThickness="0 1 0 0">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0.00"
						Color="#dedede" />
					<GradientStop
						Offset="1.00"
						Color="#eceaea" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="5" />
					<RowDefinition />
					<RowDefinition
						Height="80" />
				</Grid.RowDefinitions>
				<ScrollViewer
					Grid.Row="1"
					HorizontalScrollBarVisibility="Visible"
					VerticalScrollBarVisibility="Visible">
					<Grid
						Name="contentGrid">
						<Image
							Name="imageCert" />
					</Grid>
				</ScrollViewer>
				<Border
					Name="mainContent"
					Grid.Row="2"
					Margin="30 5 30 0"
					BorderBrush="#7e7e7e"
					BorderThickness="0 1 0 0">
					<Border
						BorderBrush="#ffffff"
						BorderThickness="0 1 0 0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="20" />
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="50" />
								<ColumnDefinition />
								<ColumnDefinition
									Width="20" />
								<ColumnDefinition
									Width="Auto" />
							</Grid.ColumnDefinitions>
							<Button
								Name="btnBack"
								Style="{StaticResource defaultButtonStyle}"
								Grid.Column="2"
								HorizontalAlignment="Left"
								Visibility="{Binding BackVisibility}"
								Click="btnBack_Click">
								<Image
									Source="..\img/return.png"
									Stretch="None" />
							</Button>
						</Grid>
					</Border>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>
