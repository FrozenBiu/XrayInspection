<UserControl
	x:Class="GUI_XRS.CtrlIVPProcess" xmlns:Integrated_Validation_Process="clr-namespace:GUI_XRS.Integrated_Validation_Process" xmlns:XrsImage="clr-namespace:XrsImage;assembly=XrsImage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit" xmlns:d3="http://research.microsoft.com/DynamicDataDisplay/1.0"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="IVP_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:ImageSelectionBoolToBackgroundColorConverter
				x:Key="imageSelectionBoolToBackgroundColorConverter" />
			<l:IVPMaterialStringConverter
				x:Key="materialStringConverter" />
			<l:IVPOneMaterialStringConverter
				x:Key="materialStringConverter2" />
			<l:IVPTestCardSizeStringConverter
				x:Key="testCardStringConverter" />
			<l:IVPSingleTestCardSizeStringConverter
				x:Key="testCardStringConverter2" />
			<l:UserRightsBoolConverter
				x:Key="userRightsBoolConverter" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Disabled" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<StackPanel
											Orientation="Horizontal"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="20" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type WebBrowser}"
				x:Key="webbrowserstyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Visibility"
					Value="Hidden" />
			</Style>
			<Style
				x:Key="TextBlock2">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="20" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
				<Setter
					Property="HorizontalAlignment"
					Value="Center" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Center" />
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding Widescreen}">
						<Setter
							Property="FontSize"
							Value="20" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding Widescreen}">
						<Setter
							Property="FontSize"
							Value="14" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style
				x:Key="NumberButtonStyle">
				<Setter
					Property="Height"
					Value="60" />
				<Setter
					Property="Width"
					Value="60" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Grid>
								<Ellipse
									Name="BorderUp"
									Height="60"
									Width="60"
									StrokeThickness="1"
									Fill="#9ac007"
									HorizontalAlignment="Center" />
								<ContentPresenter
									HorizontalAlignment="Center" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="BorderUp"
										Property="UIElement.Opacity"
										Value="0" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="True">
									<Setter
										TargetName="BorderUp"
										Property="UIElement.Opacity"
										Value="0.8" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				x:Key="TransparentButton">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="Foreground"
					Value="#00FFFFFF" />
				<Setter
					Property="BorderBrush"
					Value="#00FFFFFF" />
			</Style>
			<Style
				TargetType="{x:Type Button}"
				x:Key="overlayButton">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								Name="bBorder"
								BorderBrush="#00000000"
								BorderThickness="1"
								CornerRadius="3">
								<ContentPresenter />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid"
		VerticalAlignment="Stretch">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			Column="0"
			Margin="12 24 12 24"
			Visibility="{Binding button3Enabled, Converter={StaticResource bVisConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="2*" />
			</Grid.ColumnDefinitions>
			<Grid
				Background="#dfdfdf">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="2*" />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="11"
					BorderBrush="#b6b6b6"
					BorderThickness="1 0 1 1" />
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="1 1 1 0" />
				<TextBlock
					Grid.Row="0"
					Style="{StaticResource TextBlock2}"
					HorizontalAlignment="Center"
					Text="{Binding StrConvey.LocalizedText, FallbackValue=Bitte Produkt mit Verunreinigungen fördern}" />
				<TextBlock
					Grid.Row="1"
					Style="{StaticResource TextBlock2}"
					Text="{Binding TestsampleToConvey}" />
				<TextBlock
					Grid.Row="2"
					Style="{StaticResource TextBlock2}"
					Text="{Binding ProductsConveyed}" />
				<TextBlock
					Grid.Row="3"
					Style="{StaticResource TextBlock2}"
					Text="{Binding StringNumberContaminations}" />
				<Border
					Grid.Row="4"
					BorderBrush="#FF808080"
					Grid.Column="3"
					Visibility="{Binding DoorLockAvailable, Converter={StaticResource bVisConverter}}">
					<Button
						Name="btnUnlockBin"
						Style="{StaticResource defaultButtonStyle}"
						common:ButtonBehavior.OpenContextMenuWhenClicked="True"
						VerticalAlignment="Center"
						Command="{Binding UnlockBinCommand}">
						<FrameworkElement.ContextMenu>
							<ContextMenu
								Style="{StaticResource messageSystemContextMenuStyle}"
								Margin="0 0 80 50"
								ItemsSource="{Binding UnlockBinItem}"
								Visibility="{Binding ContextUnlockBinVisibility, Converter={StaticResource bVisConverter}}">
								<ItemsControl.ItemContainerStyle>
									<Style
										BasedOn="{StaticResource contextMenuItemStyle}"
										TargetType="{x:Type MenuItem}">
										<Setter
											Property="MenuItem.Command"
											Value="{Binding ClickCmd}" />
										<Setter
											Property="Header"
											Value="{Binding LocalizedText}" />
									</Style>
								</ItemsControl.ItemContainerStyle>
							</ContextMenu>
						</FrameworkElement.ContextMenu>
						<Image
							Source="/img/unlock.png"
							Stretch="Uniform"
							Height="40"
							Width="40"
							VerticalAlignment="Center" />
					</Button>
				</Border>
			</Grid>
			<XrsImage:XRSImageBox
				Name="imagebox"
				Grid.Column="1"
				Image="{Binding Path=DataContext.CurrentImage, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}"
				UserLoggedIn="{Binding Path=DataContext.CurrentUser.Rights, Converter={StaticResource userRightsBoolConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
			<Grid
				Column="1"
				Width="200"
				Height="100"
				Background="#00FFFFFF"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Margin="20 20 0 0"
				Visibility="{Binding Check, Converter={StaticResource bVisConverter}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Button
					Grid.Column="0"
					Style="{StaticResource okButtonStyle}"
					Click="OkButton_Click">
					<Image
						Source="..\img\ok.png"
						Stretch="None" />
				</Button>
				<Button
					Grid.Column="1"
					Style="{StaticResource cancelButtonStyle}"
					Click="BadButton_Click_1">
					<Image
						Source="..\img\cancel.png"
						Stretch="None" />
				</Button>
			</Grid>
		</Grid>
		<Grid
			Row="0"
			Column="0"
			Background="#dfdfdf"
			Margin="12 24 12 24"
			VerticalAlignment="Stretch"
			Visibility="{Binding button2Enabled, Converter={StaticResource bVisConverter}}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="2*" />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="1 1 1 0" />
				<Border
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="1 0 1 1" />
				<TextBlock
					Grid.Row="0"
					Width="400"
					Background="#00FFFFFF"
					FontSize="25"
					TextAlignment="Center"
					Text="{Binding StrStartValidation.LocalizedText, FallbackValue=Validierung starten}" />
				<ListView
					Name="listTestsamples"
					Background="#00FFFFFF"
					Foreground="#5e5e5e"
					Margin="0 0 0 0 "
					Grid.Row="1"
					Focusable="False"
					IsEnabled="False"
					HorizontalAlignment="Center"
					ItemsSource="{Binding TestsamplesList}">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<Style
								TargetType="{x:Type TextBlock}"
								x:Key="{x:Type TextBlock}">
								<Setter
									Property="FontSize"
									Value="20" />
								<Setter
									Property="TextWrapping"
									Value="Wrap" />
							</Style>
							<Style
								TargetType="{x:Type GridViewColumnHeader}"
								x:Key="{x:Type GridViewColumnHeader}">
								<Setter
									Property="Visibility"
									Value="Collapsed" />
							</Style>
						</ResourceDictionary>
					</FrameworkElement.Resources>
					<Control.Template>
						<ControlTemplate
							TargetType="{x:Type ListView}">
							<Border
								Name="Border"
								BorderThickness="1">
								<ItemsPresenter />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="Border"
										Property="Background"
										Value="#00FFFFFF" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Control.Template>
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListViewItem}">
							<Style.Triggers>
								<DataTrigger
									Value="True"
									Binding="{Binding Widescreen}">
									<Setter
										Property="Margin"
										Value="5 5 5 10  " />
								</DataTrigger>
								<DataTrigger
									Value="False"
									Binding="{Binding Widescreen}">
									<Setter
										Property="Margin"
										Value="5 0 5 0" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ItemsControl.ItemContainerStyle>
					<ListView.View>
						<GridView>
							<GridViewColumn
								Width="150"
								DisplayMemberBinding="{Binding Description, Converter={StaticResource materialStringConverter2}}" />
							<GridViewColumn
								Width="150"
								DisplayMemberBinding="{Binding Value}" />
							<GridViewColumn
								DisplayMemberBinding="{Binding TestcardSize, Converter={StaticResource testCardStringConverter2}}" />
						</GridView>
					</ListView.View>
				</ListView>
			</Grid>
		</Grid>
		<Grid
			Row="0"
			Margin="12 24 12 24"
			VerticalAlignment="Stretch"
			Visibility="{Binding button1Enabled, Converter={StaticResource bVisConverter}}">
			<ScrollViewer
				VerticalScrollBarVisibility="Visible"
				HorizontalScrollBarVisibility="Visible">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1.2*"
							MinWidth="300" />
						<ColumnDefinition
							Width="2*"
							MinWidth="500" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="70" />
						<RowDefinition
							Height="3*"
							MinHeight="50" />
						<RowDefinition
							Height="3*"
							MinHeight="50" />
						<RowDefinition
							Height="3*"
							MinHeight="50" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="11"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="1 1 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 1 1" />
					<Border
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 1" />
					<Border
						Grid.Row="2"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 1" />
					<Border
						Grid.Row="3"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 1" />
					<Border
						Grid.Row="4"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 1" />
					<Border
						Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 1" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding StrOrderNumber.LocalizedText, FallbackValue=Auftragsnummer}" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Grid.ColumnSpan="1"
						Margin="20 0 0 0"
						FontSize="22"
						Width="250"
						HorizontalAlignment="Left"
						Text="{Binding OrderNumber}"
						MouseUp="TextBox_MouseUp" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="20 0 20 0"
						VerticalAlignment="Center"
						Text="{Binding StrProductInformation.LocalizedText, FallbackValue=Produktinformationen}" />
					<ListView
						Name="listProduct"
						Background="#00FFFFFF"
						Foreground="#5e5e5e"
						Margin="20 10 20 10 "
						Grid.Row="1"
						Grid.Column="1"
						Focusable="False"
						IsEnabled="False"
						HorizontalAlignment="Left"
						ItemsSource="{Binding ProductList}">
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<Style
									TargetType="{x:Type TextBlock}"
									x:Key="{x:Type TextBlock}">
									<Setter
										Property="FontSize"
										Value="20" />
									<Setter
										Property="TextWrapping"
										Value="Wrap" />
								</Style>
								<Style
									TargetType="{x:Type GridViewColumnHeader}"
									x:Key="{x:Type GridViewColumnHeader}">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</Style>
							</ResourceDictionary>
						</FrameworkElement.Resources>
						<Control.Template>
							<ControlTemplate
								TargetType="{x:Type ListView}">
								<Border
									Name="Border"
									BorderThickness="1">
									<ItemsPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											TargetName="Border"
											Property="Background"
											Value="#00FFFFFF" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Control.Template>
						<ListView.View>
							<GridView>
								<GridViewColumn
									Width="250"
									DisplayMemberBinding="{Binding Description}" />
								<GridViewColumn
									DisplayMemberBinding="{Binding Value}" />
							</GridView>
						</ListView.View>
					</ListView>
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="20 0 20 0"
						VerticalAlignment="Center"
						Text="{Binding StrCustomerInformation.LocalizedText, FallbackValue=Kundeninformationen}"
						Visibility="{Binding Path=CustomerListVisible, Converter={StaticResource bVisConverter}}" />
					<ListView
						Name="listCustomerInformation"
						Background="#00FFFFFF"
						Foreground="#5e5e5e"
						Margin="20 10 20 10 "
						Grid.Row="2"
						Grid.Column="1"
						Focusable="False"
						IsEnabled="False"
						HorizontalAlignment="Left"
						Visibility="{Binding Path=CustomerListVisible, Converter={StaticResource bVisConverter}}"
						ItemsSource="{Binding CustomerList}">
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<Style
									TargetType="{x:Type TextBlock}"
									x:Key="{x:Type TextBlock}">
									<Setter
										Property="FontSize"
										Value="20" />
									<Setter
										Property="TextWrapping"
										Value="Wrap" />
								</Style>
								<Style
									TargetType="{x:Type GridViewColumnHeader}"
									x:Key="{x:Type GridViewColumnHeader}">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</Style>
							</ResourceDictionary>
						</FrameworkElement.Resources>
						<Control.Template>
							<ControlTemplate
								TargetType="{x:Type ListView}">
								<Border
									Name="Border"
									BorderThickness="1">
									<ItemsPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											TargetName="Border"
											Property="Background"
											Value="#00FFFFFF" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Control.Template>
						<ListView.View>
							<GridView>
								<GridViewColumn
									Width="250"
									DisplayMemberBinding="{Binding Description}" />
								<GridViewColumn
									DisplayMemberBinding="{Binding Value}" />
							</GridView>
						</ListView.View>
					</ListView>
					<TextBlock
						Grid.Row="3"
						Grid.Column="0"
						Margin="20 0 20 0"
						VerticalAlignment="Center"
						Text="{Binding StrManufacturerInformation.LocalizedText, FallbackValue=Herstellerinformationen}" />
					<ListView
						Name="listManufacturerInformation"
						Opacity="0.9"
						Background="#00FFFFFF"
						Foreground="#5e5e5e"
						Margin="20 10 20 10 "
						Grid.Row="3"
						Grid.Column="1"
						Focusable="False"
						IsEnabled="False"
						HorizontalAlignment="Left"
						ItemsSource="{Binding ManufacturerList}">
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<Style
									TargetType="{x:Type TextBlock}"
									x:Key="{x:Type TextBlock}">
									<Setter
										Property="FontSize"
										Value="20" />
									<Setter
										Property="TextWrapping"
										Value="Wrap" />
								</Style>
								<Style
									TargetType="{x:Type GridViewColumnHeader}"
									x:Key="{x:Type GridViewColumnHeader}">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</Style>
							</ResourceDictionary>
						</FrameworkElement.Resources>
						<Control.Template>
							<ControlTemplate
								TargetType="{x:Type ListView}">
								<Border
									Name="Border"
									BorderThickness="1">
									<ItemsPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											TargetName="Border"
											Property="Background"
											Value="#00FFFFFF" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Control.Template>
						<ListView.View>
							<GridView>
								<GridViewColumn
									Width="250"
									DisplayMemberBinding="{Binding Description}" />
								<GridViewColumn
									DisplayMemberBinding="{Binding Value}" />
							</GridView>
						</ListView.View>
					</ListView>
				</Grid>
			</ScrollViewer>
		</Grid>
		<Grid
			Name="pdfViewGrid"
			Row="0"
			Margin="25 5 25 10"
			Background="#e7efc5"
			Visibility="{Binding button4Enabled, Converter={StaticResource bVisConverter}}">
			<StackPanel>
				<Popup
					AllowsTransparency="False"
					Placement="RelativePoint"
					IsOpen="{Binding button4Enabled}"
					Height="{Binding ActualHeight, ElementName=pdfViewGrid}"
					Width="{Binding ActualWidth, ElementName=pdfViewGrid}"
					PlacementTarget="{Binding ElementName=pdfViewGrid}">
					<WebBrowser
						Name="webbrowser" />
				</Popup>
			</StackPanel>
		</Grid>
		<Border
			Grid.Row="1"
			Padding="5 7 5 7"
			Margin="0 0 0 0"
			BorderBrush="#8e9192"
			BorderThickness="1"
			VerticalAlignment="Bottom">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Button
					Name="arrowLeft"
					Grid.Column="0"
					Grid.Row="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 0 0"
					Click="arrowLeft_Click">
					<Image
						Source="..\img\arrow2-left.png"
						Stretch="None"
						VerticalAlignment="Top" />
				</Button>
				<Grid
					Column="1"
					VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Button
						Grid.Row="0"
						Style="{StaticResource NumberButtonStyle}"
						Content="1"
						FontSize="40"
						IsEnabled="{Binding button1Enabled}" />
					<TextBlock
						Grid.Row="1"
						HorizontalAlignment="Center"
						FontSize="16"
						Margin="0 0 0 0 "
						Text="{Binding StrData.LocalizedText, FallbackValue=Daten}" />
				</Grid>
				<Grid
					Column="2"
					VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Button
						Grid.Row="0"
						Style="{StaticResource NumberButtonStyle}"
						Content="2"
						FontSize="40"
						IsEnabled="{Binding button2Enabled}" />
					<TextBlock
						Grid.Row="1"
						HorizontalAlignment="Center"
						FontSize="16"
						Margin="0 0 0 0 "
						Text="{Binding StrRequest.LocalizedText, FallbackValue=Auffoderung}" />
				</Grid>
				<Grid
					Column="3"
					VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Button
						Grid.Row="0"
						Style="{StaticResource NumberButtonStyle}"
						FontSize="40"
						Content="3"
						IsEnabled="{Binding button3Enabled}" />
					<TextBlock
						Grid.Row="1"
						HorizontalAlignment="Center"
						FontSize="16"
						Margin="0 0 0 0 "
						Text="{Binding StrValidation.LocalizedText, FallbackValue=Validierung}" />
				</Grid>
				<Grid
					Column="4"
					VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Button
						Name="button4"
						Grid.Row="0"
						Style="{StaticResource NumberButtonStyle}"
						Content="4"
						FontSize="40"
						IsEnabled="{Binding button4Enabled}" />
					<TextBlock
						Grid.Row="1"
						HorizontalAlignment="Center"
						FontSize="16"
						Margin="0 0 0 0 "
						Text="{Binding StrResult.LocalizedText, FallbackValue=Ergebnis}" />
				</Grid>
				<Button
					Grid.Column="5"
					Grid.Row="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 0 0"
					IsEnabled="{Binding ButtonNextEnabled}"
					Click="arrowRight_Click">
					<Image
						Stretch="None"
						VerticalAlignment="Top">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Image}">
								<Style.Triggers>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											Property="Source"
											Value="..\img\play_big_disabled.png" />
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="True">
										<Setter
											Property="Source"
											Value="..\img\play_big.png" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Image>
				</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>
