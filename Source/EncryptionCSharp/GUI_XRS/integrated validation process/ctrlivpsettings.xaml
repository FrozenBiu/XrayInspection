<UserControl
	x:Class="GUI_XRS.CtrlIVPSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="IVP_Unloaded"
	Loaded="IVP_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToStringConverter
				x:Key="bStringConverter" />
			<l:DoubleStringConverterPrec1
				x:Key="doubleStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="65 0 50 0" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 0 65 0" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle2">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackgroundEnabled"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#cfcfcf" />
							<GradientStop
								Offset="0.02"
								Color="#e9e9e9" />
							<GradientStop
								Offset="0.03"
								Color="#f1f1f1" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorderEnabled"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#bebebe" />
							<GradientStop
								Offset="0.10"
								Color="#d8d8d8" />
							<GradientStop
								Offset="0.9"
								Color="#d8d8d8" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBackgroundDisabled"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorderDisabled"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="3"
								BorderThickness="2"
								Padding="{TemplateBinding Padding}">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Border}">
										<Style.Triggers>
											<Trigger
												Property="IsEnabled"
												Value="True">
												<Setter
													Property="Background"
													Value="{DynamicResource textBoxBackgroundEnabled}" />
												<Setter
													Property="BorderBrush"
													Value="{DynamicResource textBoxBorderEnabled}" />
											</Trigger>
											<Trigger
												Property="IsEnabled"
												Value="False">
												<Setter
													Property="Background"
													Value="{DynamicResource textBoxBackgroundDisabled}" />
												<Setter
													Property="BorderBrush"
													Value="{DynamicResource textBoxBorderDisabled}" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type l:RadioButtonExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<ScrollViewer
		VerticalScrollBarVisibility="Visible"
		Margin="12 24 12 24">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<Border
				Grid.Row="0"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1">
				<ScrollViewer>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								MinHeight="80" />
							<RowDefinition>
								<FrameworkContentElement.Style>
									<Style
										TargetType="{x:Type RowDefinition}">
										<Setter
											Property="Height"
											Value="Auto" />
										<Setter
											Property="MinHeight"
											Value="80" />
										<Style.Triggers>
											<DataTrigger
												Value="False"
												Binding="{Binding ProductToConveyVisible}">
												<Setter
													Property="Height"
													Value="0" />
												<Setter
													Property="MinHeight"
													Value="0" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkContentElement.Style>
							</RowDefinition>
							<RowDefinition
								MinHeight="80" />
							<RowDefinition>
								<FrameworkContentElement.Style>
									<Style
										TargetType="{x:Type RowDefinition}">
										<Setter
											Property="Height"
											Value="Auto" />
										<Setter
											Property="MinHeight"
											Value="80" />
										<Style.Triggers>
											<DataTrigger
												Value="True"
												Binding="{Binding IsManually}">
												<Setter
													Property="Height"
													Value="0" />
												<Setter
													Property="MinHeight"
													Value="0" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkContentElement.Style>
							</RowDefinition>
							<RowDefinition
								MinHeight="80" />
							<RowDefinition
								MinHeight="80" />
							<RowDefinition
								MinHeight="80" />
						</Grid.RowDefinitions>
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="11"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 1 0" />
						<Border
							Grid.Row="0"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 0 1" />
						<Border
							Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 0 1" />
						<Border
							Grid.Row="2"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 0 1" />
						<Border
							Grid.Row="3"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 0 1" />
						<Border
							Grid.Row="4"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 0 1" />
						<Border
							Grid.Row="5"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							BorderBrush="#b6b6b6"
							BorderThickness="0 0 0 1" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="20 0 20 0"
							Text="{Binding Path=StrOnOff.LocalizedText, FallbackValue=Erinnerung Validierung ein/aus}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsChecked="{Binding Path=OnOff}" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="20 0 20 0"
							Text="{Binding Path=StrNumberTestsamples.LocalizedText, FallbackValue=Anzahl Produktförderungen mit Testkarte}"
							Visibility="{Binding Path=ProductToConveyVisible, Converter={StaticResource bVisConverter}}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Grid.ColumnSpan="1"
							Margin="55 0 55 0"
							FontSize="22"
							Text="{Binding NumberSamples}"
							Visibility="{Binding Path=ProductToConveyVisible, Converter={StaticResource bVisConverter}}"
							MouseUp="TextBox_MouseUp_1" />
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="20 0 20 0"
							Text="{Binding Path=StrSettings.LocalizedText, FallbackValue=Einstellungen}" />
						<Grid
							Row="2"
							Column="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>
							<l:RadioButtonExtended
								GroupName="timeSetting"
								Grid.Column="0"
								Margin="0 10 0 0"
								IsCheckedReal="{Binding Path=IsIntervall}" />
							<l:RadioButtonExtended
								GroupName="timeSetting"
								Grid.Column="1"
								Margin="0 10 0 0"
								IsCheckedReal="{Binding Path=IsManually}" />
							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="0 0 0 10"
								HorizontalAlignment="Center"
								Text="{Binding Path=StrIntervall.LocalizedText, FallbackValue=Intervall}" />
							<TextBlock
								Grid.Row="1"
								Grid.Column="1"
								Margin="0 0 0 10"
								HorizontalAlignment="Center"
								Text="{Binding Path=StrManually.LocalizedText, FallbackValue=Manuell}" />
						</Grid>
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Margin="20 0 20 0"
							Text="{Binding Path=StrIntervallInMonths.LocalizedText, FallbackValue=Intervall in Monaten}" />
						<Grid
							Row="3"
							Column="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Button
								Name="btnLowerSpeed"
								Grid.Column="0"
								Margin="55 20 0 20"
								Width="50"
								Height="50"
								Command="{Binding LowerIntervallCommand}"
								IsEnabled="{Binding Path=MinusValid}">
								<Image
									Source="/img/minus2.png" />
							</Button>
							<TextBox
								Name="txtSpeed"
								Grid.Row="0"
								Grid.Column="1"
								Margin="5 20 5 20"
								Text="{Binding Path=Intervall}" />
							<Button
								Name="btnHigherSpeed"
								Grid.Column="2"
								Margin="0 20 55 20"
								Width="50"
								Height="50"
								Command="{Binding HigherIntervallCommand}">
								<Image
									Source="/img/plus2.png" />
							</Button>
						</Grid>
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Margin="20 0 20 0"
							Text="{Binding Path=StrDate.LocalizedText, FallbackValue=Nächste Validerung}" />
						<TextBox
							Grid.Row="4"
							Grid.Column="1"
							Margin="55 0 55 0"
							FontSize="22"
							Style="{StaticResource TextBoxStyle2}"
							Text="{Binding IVPDate}"
							IsEnabled="{Binding IsManually}"
							MouseUp="TextBox_MouseUp" />
						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Margin="20 0 20 0"
							Text="{Binding Path=StrLastDate.LocalizedText, FallbackValue=Letzte Herstellervalidierung}" />
						<TextBox
							Grid.Row="5"
							Grid.Column="1"
							Margin="55 0 55 0"
							FontSize="22"
							IsEnabled="False"
							Style="{StaticResource TextBoxStyle2}"
							Text="{Binding IVPDateLast}" />
						<TextBlock
							Grid.Row="6"
							Grid.Column="0"
							Text="{Binding Path=StrRejectAll.LocalizedText, FallbackValue=Alle Produkte ausscheiden}" />
						<CheckBox
							Grid.Row="6"
							Grid.Column="1"
							Grid.ColumnSpan="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsChecked="{Binding Path=RejectAll}" />
					</Grid>
				</ScrollViewer>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>
