<UserControl
	x:Class="GUI_XRS.CtrlIVPCertificatesOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="IVPControl_Unloaded"
	Loaded="IVPControl_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="bVisHiddenConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="FontFamily"
					Value="Helvetica" />
				<Setter
					Property="HorizontalAlignment"
					Value="Left" />
				<Setter
					Property="VerticalAlignment"
					Value="Bottom" />
				<Setter
					Property="Margin"
					Value="20 3 20 1" />
			</Style>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="Background"
					Value="#E7EFC5" />
				<Setter
					Property="ListBox.SelectionMode"
					Value="Single" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="True" />
				<Setter
					Property="Margin"
					Value="20 1 20 5" />
			</Style>
			<Style
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource defaultButtonStyle}"
				x:Key="{x:Type Button}">
				<Setter
					Property="Margin"
					Value="5 5 5 5" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<ListBox
			Name="ListBoxDocuments"
			Grid.Column="0"
			Grid.Row="1"
			SelectionMode="Multiple"
			Grid.IsSharedSizeScope="True"
			IsSynchronizedWithCurrentItem="True"
			Margin="12 24 12 24"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ItemsSource="{Binding Documents}"
			SelectionChanged="SelectedItems">
			<ItemsControl.ItemContainerStyle>
				<!--Unknown connection ID: 3-->
				<Style
					TargetType="{x:Type ListBoxItem}">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type ListBoxItem}">
								<Border
									Name="Border"
									Padding="2"
									SnapsToDevicePixels="True">
									<ContentPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger
										Property="ListBoxItem.IsSelected"
										Value="True">
										<Setter
											TargetName="Border"
											Value="{DynamicResource SystemColors.HighlightBrushKey}"
											Property="Background" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ItemsControl.ItemContainerStyle>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel
						Orientation="Horizontal">
						<Grid
							MinHeight="30">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="35" />
								<ColumnDefinition
									Width="Auto"
									SharedSizeGroup="groupNumber" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock
								Grid.Column="0"
								FontSize="20"
								FontFamily="Helvetica"
								FontWeight="Bold"
								Margin="5 10 5 10"
								Text="{Binding Index}" />
							<TextBlock
								Grid.Column="1"
								FontSize="20"
								FontFamily="Helvetica"
								FontWeight="Normal"
								Margin="10 10 10 10"
								Text="{Binding DisplayedName}" />
						</Grid>
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
