<UserControl
	x:Class="GUI_XRS.CtrlIVPCertificatesContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="IVPControl_Unloaded"
	Loaded="IVPControl_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToStringConverter
				x:Key="bStringConverter" />
			<l:DoubleStringConverterPrec1
				x:Key="doubleStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="TextBlockStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="20" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="65 0 50 0" />
				<Setter
					Property="FontSize"
					Value="20" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 0 65 0" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<Image
			Name="image" />
		<ScrollViewer>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<StackPanel
					Grid.Row="0"
					Visibility="{Binding Path=ProductDataVisible, Converter={StaticResource bVisConverter}}">
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="20 20 20 20"
						HorizontalAlignment="Left"
						Style="{StaticResource TextBlockStyle}"
						Text="{Binding Path=StrProductInformation.LocalizedText, FallbackValue=Produktinformationen}" />
					<GroupBox
						BorderThickness="0 0 0 0">
						<ItemsControl
							ItemsSource="{Binding Path=ProductItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border
										BorderBrush="#b6b6b6"
										BorderThickness="1 0.5 1 1 ">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="*" />
												<ColumnDefinition
													Width="*" />
											</Grid.ColumnDefinitions>
											<Border
												Grid.Row="0"
												Grid.Column="0"
												Grid.RowSpan="11"
												Background="#e7efc5"
												BorderBrush="#b6b6b6"
												BorderThickness="0 0 1 0" />
											<Border
												Grid.Row="0"
												Grid.Column="1"
												Grid.ColumnSpan="14"
												BorderBrush="#b6b6b6"
												Background="#d1d1d1"
												BorderThickness="0 0 0 0" />
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource TextBlockStyle}"
												Margin="20 0 20 0"
												Text="{Binding Path=Description}" />
											<!--Unknown connection ID: 3-->
											<TextBox
												Grid.Column="1"
												Style="{StaticResource TextBoxStyle}"
												Margin="65 20 65 20"
												BorderBrush="#b6b6b6"
												Text="{Binding Path=Value}" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</GroupBox>
				</StackPanel>
				<StackPanel
					Grid.Row="1">
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="20 40 20 20"
						HorizontalAlignment="Left"
						Style="{StaticResource TextBlockStyle}"
						Text="{Binding Path=StrCustomerInformation.LocalizedText, FallbackValue=Kundeninformationen}" />
					<GroupBox
						BorderThickness="0 0 0 0">
						<ItemsControl
							ItemsSource="{Binding Path=CustomerItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border
										BorderBrush="#b6b6b6"
										BorderThickness="1 0.5 1 1 ">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="*" />
												<ColumnDefinition
													Width="*" />
											</Grid.ColumnDefinitions>
											<Border
												Grid.Row="0"
												Grid.Column="0"
												Grid.RowSpan="11"
												Background="#e7efc5"
												BorderBrush="#b6b6b6"
												BorderThickness="0 0 1 0" />
											<Border
												Grid.Row="0"
												Grid.Column="1"
												Grid.ColumnSpan="14"
												BorderBrush="#b6b6b6"
												Background="#d1d1d1"
												BorderThickness="0 0 0 0" />
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource TextBlockStyle}"
												Margin="20 0 20 0"
												Text="{Binding Path=Description}" />
											<!--Unknown connection ID: 4-->
											<TextBox
												Grid.Column="1"
												Style="{StaticResource TextBoxStyle}"
												Margin="65 20 65 20"
												BorderBrush="#b6b6b6"
												Text="{Binding Path=Value}" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</GroupBox>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
