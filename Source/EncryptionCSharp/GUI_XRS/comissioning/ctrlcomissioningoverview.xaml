<UserControl
	x:Class="GUI_XRS.CtrlComissioningOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:ComplianceBoolToBackgroundColorConverter
				x:Key="complianceBoolToBackgroundColorConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 20 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type tk:DataGridColumnHeader}"
				x:Key="{x:Type tk:DataGridColumnHeader}">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Setter
					Property="Foreground"
					Value="#FFFFFFFF" />
				<Setter
					Property="Background"
					Value="#FF9ACD32" />
				<Setter
					Property="Padding"
					Value="1 1 1 1" />
			</Style>
			<Style
				TargetType="{x:Type tk:DataGridCell}"
				x:Key="{x:Type tk:DataGridCell}">
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type tk:DataGridCell}">
							<Grid
								Background="{TemplateBinding Background}">
								<ContentPresenter
									VerticalAlignment="Center"
									HorizontalAlignment="Center" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Style.Triggers>
					<Trigger
						Property="tk:DataGridCell.IsSelected"
						Value="True">
						<Setter
							Property="Foreground"
							Value="#FF000000" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Grid.Row="0"
		BorderBrush="#a8a8a8"
		BorderThickness="1"
		Background="#FFFFFFFF"
		Margin="0 0 0 12">
		<ScrollViewer
			VerticalScrollBarVisibility="Auto"
			HorizontalScrollBarVisibility="Auto">
			<Grid>
				<tk:DataGrid
					Name="OveviewComissionParamsDataGrid"
					Grid.Row="1"
					IsReadOnly="True"
					Margin="5,5,20,5"
					Background="#FFFFFFFF"
					HorizontalAlignment="Left"
					HeadersVisibility="Column"
					FontSize="16"
					AutoGenerateColumns="False"
					CanUserAddRows="False"
					CanUserResizeColumns="False"
					CanUserResizeRows="False"
					CanUserDeleteRows="False"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					BorderBrush="#FFA9A9A9"
					BorderThickness="1.5 1.5 1.5 1.5">
					<tk:DataGrid.Columns>
						<tk:DataGridTextColumn
							Header="Status"
							Width="Auto"
							Binding="{Binding StrStatus}">
							<tk:DataGridColumn.CellStyle>
								<Style
									BasedOn="{StaticResource tk:DataGridCell}"
									TargetType="{x:Type tk:DataGridCell}">
									<Setter
										Property="Background"
										Value="{Binding DefaultRedCell, Converter={StaticResource complianceBoolToBackgroundColorConverter}}" />
								</Style>
							</tk:DataGridColumn.CellStyle>
						</tk:DataGridTextColumn>
						<tk:DataGridTextColumn
							Header="ID"
							Width="Auto"
							Binding="{Binding StrID}">
							<tk:DataGridColumn.CellStyle>
								<Style
									BasedOn="{StaticResource tk:DataGridCell}"
									TargetType="{x:Type tk:DataGridCell}">
									<Setter
										Property="Background"
										Value="{Binding DifferentCellRed, Converter={StaticResource complianceBoolToBackgroundColorConverter}}" />
								</Style>
							</tk:DataGridColumn.CellStyle>
						</tk:DataGridTextColumn>
						<tk:DataGridTextColumn
							Header="Pathes"
							Width="Auto"
							Binding="{Binding StrPathes}">
							<tk:DataGridColumn.CellStyle>
								<Style
									BasedOn="{StaticResource tk:DataGridCell}"
									TargetType="{x:Type tk:DataGridCell}">
									<Setter
										Property="Background"
										Value="{Binding DifferentCellRed, Converter={StaticResource complianceBoolToBackgroundColorConverter}}" />
								</Style>
							</tk:DataGridColumn.CellStyle>
						</tk:DataGridTextColumn>
						<tk:DataGridTextColumn
							Header="Comissioning"
							Width="Auto"
							Binding="{Binding StrValuesComissioning}">
							<tk:DataGridColumn.CellStyle>
								<Style
									BasedOn="{StaticResource tk:DataGridCell}"
									TargetType="{x:Type tk:DataGridCell}">
									<Setter
										Property="Background"
										Value="{Binding DifferentCellRed, Converter={StaticResource complianceBoolToBackgroundColorConverter}}" />
								</Style>
							</tk:DataGridColumn.CellStyle>
						</tk:DataGridTextColumn>
						<tk:DataGridTextColumn
							Header="Actual Values"
							Width="Auto"
							Binding="{Binding StrValuesActual}">
							<tk:DataGridColumn.CellStyle>
								<Style
									BasedOn="{StaticResource tk:DataGridCell}"
									TargetType="{x:Type tk:DataGridCell}">
									<Setter
										Property="Background"
										Value="{Binding DifferentCellRed, Converter={StaticResource complianceBoolToBackgroundColorConverter}}" />
								</Style>
							</tk:DataGridColumn.CellStyle>
						</tk:DataGridTextColumn>
					</tk:DataGrid.Columns>
				</tk:DataGrid>
			</Grid>
		</ScrollViewer>
	</Border>
</UserControl>
