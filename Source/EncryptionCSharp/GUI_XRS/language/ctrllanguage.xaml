<UserControl
	x:Class="GUI_XRS.CtrlLanguage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding DeregisterLocalizedTextCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
			</Style>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="HorizontalScrollBarVisibility"
					Value="Disabled" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<WrapPanel
											Orientation="Horizontal"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="130" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				Text="{Binding Path=StrCurrentLanguage.LocalizedText, FallbackValue=Aktuelle Sprache:}" />
			<Image
				Grid.Column="1"
				Margin="10"
				Height="75"
				Source="{Binding Path=SelectedLanguage.Flag}" />
		</Grid>
		<Border
			Grid.Row="1"
			Padding="5 7 5 7"
			Margin="0 5 0 5"
			BorderBrush="#8e9192"
			BorderThickness="1">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<ListBox
				IsSynchronizedWithCurrentItem="True"
				ItemsSource="{Binding Path=Languages}"
				SelectedItem="{Binding Path=SelectedLanguage}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Border
								Grid.Column="0"
								Grid.Row="0"
								Background="#00FFFFFF"
								Margin="-7 0 -7 0" />
							<Image
								Width="112"
								Margin="10"
								Source="{Binding Path=Flag}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
				<ItemsControl.ItemContainerStyle>
					<Style
						TargetType="{x:Type ListBoxItem}">
						<Setter
							Property="common:ListBoxItemBehavior.IsBroughtIntoViewWhenSelected"
							Value="True" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type ListBoxItem}">
									<Border
										Name="Border"
										Padding="2"
										SnapsToDevicePixels="True">
										<ContentPresenter />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger
											Property="ListBoxItem.IsSelected"
											Value="True">
											<Setter
												TargetName="Border"
												Property="Background"
												Value="#c9db53" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ItemsControl.ItemContainerStyle>
			</ListBox>
		</Border>
	</Grid>
</UserControl>
