<UserControl
	x:Class="GUI_XRS.CtrlEdgeSubButtons" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="CtrlEdgeSubButtons_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:EdgeModes
				x:Key="EdgeModes">
				<l:EdgeFilterMode>Remove</l:EdgeFilterMode>
				<l:EdgeFilterMode>RemoveLines</l:EdgeFilterMode>
				<l:EdgeFilterMode>RemoveElliptic</l:EdgeFilterMode>
			</l:EdgeModes>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="14" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="Margin"
					Value="2 0 0 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="0"
			Style="{StaticResource txtStyle}"
			Margin="0 0 5 0"
			Text="{Binding StrThreshold.LocalizedText, FallbackValue=Threshold}" />
		<TextBox
			Grid.Column="1"
			FontSize="22"
			Text="{Binding EdgeThreshold}"
			common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeEdgeThresholdCommand}" />
		<TextBlock
			Grid.Column="2"
			Text="Mode"
			Style="{StaticResource txtStyle}"
			HorizontalAlignment="Right"
			Margin="10 0 5 0" />
		<ComboBox
			Grid.Column="3"
			FontSize="22"
			HorizontalAlignment="Left"
			ScrollViewer.PanningMode="None"
			ItemsSource="{Binding Source={StaticResource EdgeModes}}"
			SelectedItem="{Binding Path=SelectedEdgeMode, Mode=TwoWay}" />
		<TextBlock
			Grid.Column="4"
			Margin="10 0 0 0"
			Text="Multiple"
			Style="{StaticResource txtStyle}"
			Visibility="{Binding MultipleVisible, Converter={StaticResource bVisConverter}}" />
		<CheckBox
			Grid.Column="5"
			Margin="5 0 0 0"
			IsChecked="{Binding MultipleEnabled}"
			Visibility="{Binding MultipleVisible, Converter={StaticResource bVisConverter}}" />
	</Grid>
</UserControl>
