<UserControl
	x:Class="GUI_XRS.CtrlAutokVSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 20 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type l:RadioButtonExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Margin="12 24 12 24"
		BorderBrush="#a8a8a8"
		BorderThickness="1"
		Background="#d1d1d1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding IsAutokVVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
				<RowDefinition
					Name="EcoModeRowVisible"
					Height="{Binding IsAutokVVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
				<RowDefinition
					Height="{Binding IsManualkVVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Border
				Grid.Row="0"
				Grid.Column="0"
				Grid.RowSpan="4"
				Background="#e7efc5"
				BorderBrush="#b6b6b6"
				BorderThickness="0 0 1 0" />
			<Border
				Grid.Row="0"
				Grid.ColumnSpan="2"
				BorderBrush="#b6b6b6"
				BorderThickness="0 0 0 1" />
			<Border
				Grid.Row="1"
				Grid.ColumnSpan="2"
				BorderBrush="#b6b6b6"
				BorderThickness="0 0 0 1" />
			<Border
				Grid.Row="2"
				Grid.ColumnSpan="2"
				BorderBrush="#b6b6b6"
				BorderThickness="0 0 0 1" />
			<TextBlock
				Grid.Row="0">
				<Run
					Text="Auto KV Full Power" />
			</TextBlock>
			<l:RadioButtonExtended
				GroupName="autokV"
				Grid.Column="1"
				Grid.Row="0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsCheckedReal="{Binding Path=FullPowerModeEnabled, Mode=TwoWay}" />
			<TextBlock
				Grid.Row="1">
				<Run
					Text="Auto KV Eco Mode" />
			</TextBlock>
			<l:RadioButtonExtended
				GroupName="autokV"
				Grid.Column="1"
				Grid.Row="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsCheckedReal="{Binding Path=EcoModeEnabled, Mode=TwoWay}" />
			<TextBlock
				Grid.Row="2">
				<Run
					Text="Manual KV" />
			</TextBlock>
			<l:RadioButtonExtended
				GroupName="autokV"
				Grid.Column="1"
				Grid.Row="2"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsCheckedReal="{Binding Path=ManualModeEnabled, Mode=TwoWay}" />
			<Grid
				Row="3"
				Column="0">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock
					Grid.Row="0">
					<TextBlock
						Text="{Binding Path=StrVoltage.LocalizedText, FallbackValue=Röntgenspannung}" /> <TextBlock
						Text="[kV]"
						Margin="0 0 0 0" /></TextBlock>
				<TextBlock
					Grid.Row="1">
					<TextBlock
						Text="{Binding Path=StrCurrent.LocalizedText, FallbackValue=Röntgenstrom}" /> <TextBlock
						Text="[mA]"
						Margin="0 0 0 0" /></TextBlock>
			</Grid>
			<Grid
				Row="3"
				Column="1">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBox
					Grid.Row="0"
					Grid.Column="1"
					Margin="100 5 100 10"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeVoltageSetpointCommand}"
					Text="{Binding Path=VoltageSetpointDisplay}" />
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					Margin="100 5 100 10"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeCurrentSetpointCommand}"
					Text="{Binding Path=CurrentSetpointDisplay}" />
			</Grid>
			<Grid
				Row="4"
				Column="0"
				ColumnSpan="3"
				Background="#5f000000"
				Visibility="{Binding ManualkVDeactivation, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
		</Grid>
	</Border>
</UserControl>
