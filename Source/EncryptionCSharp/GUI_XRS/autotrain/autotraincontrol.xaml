<UserControl
	x:Class="GUI_XRS.AutotrainControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS"
	Unloaded="AutotrainControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
				<Setter
					Property="FontSize"
					Value="30" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Center" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid
			Name="mainGrid">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Text="{Binding AutotrainText}" />
			<TextBlock
				Grid.Row="1"
				Text="{Binding ProductText}" />
			<image:XRSImageBox
				Name="imagebox"
				Grid.Row="2"
				UserLoggedIn="True"
				Image="{Binding Path=DataContext.Image, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" />
		</Grid>
	</Grid>
</UserControl>
