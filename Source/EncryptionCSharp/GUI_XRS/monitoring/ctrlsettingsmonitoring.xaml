<UserControl
	x:Class="GUI_XRS.CtrlSettingsMonitoring" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToStringConverter
				x:Key="bStringConverter" />
			<l:DoubleStringConverterPrec1
				x:Key="doubleStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 20 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="65 0 50 0" />
				<Setter
					Property="FontSize"
					Value="20" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="20 0 20 0" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<ScrollViewer
		Margin="12 24 12 24">
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="{Binding BackgroundMonitoringVisibility, Converter={StaticResource boolGridLengthStarConverter}}" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="11"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="14"
					Grid.RowSpan="9"
					BorderBrush="#b6b6b6"
					BorderThickness="0 1 0 0 " />
				<Border
					Grid.Row="2"
					Grid.Column="0"
					Grid.ColumnSpan="14"
					Grid.RowSpan="9"
					BorderBrush="#b6b6b6"
					BorderThickness="0 1 0 0 " />
				<Border
					Grid.Row="3"
					Grid.Column="0"
					Grid.ColumnSpan="14"
					Grid.RowSpan="9"
					BorderBrush="#b6b6b6"
					BorderThickness="0 1 0 0 " />
				<Border
					Grid.Row="4"
					Grid.Column="0"
					Grid.ColumnSpan="14"
					Grid.RowSpan="9"
					BorderBrush="#b6b6b6"
					BorderThickness="0 1 0 0 " />
				<Border
					Grid.Row="5"
					Grid.Column="0"
					Grid.ColumnSpan="14"
					Grid.RowSpan="9"
					BorderBrush="#b6b6b6"
					BorderThickness="0 1 0 0 " />
				<Border
					Grid.Row="6"
					Grid.Column="0"
					Grid.ColumnSpan="14"
					Grid.RowSpan="9"
					BorderBrush="#b6b6b6"
					BorderThickness="0 1 0 0 " />
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrMonitoringMessagesOnOff.LocalizedText, FallbackValue=Monitoring aktiv}" />
				<CheckBox
					Grid.Row="0"
					Grid.Column="1"
					HorizontalAlignment="Center"
					IsChecked="{Binding Path=MonitoringOnOff}" />
				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrBackgroundMonitoring.LocalizedText, FallbackValue=Hintergrundüberwachung aktiv}" />
				<CheckBox
					Grid.Row="1"
					Grid.Column="1"
					HorizontalAlignment="Center"
					IsChecked="{Binding Path=BackgroundMonitoring}" />
				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrLevelMonitoring.LocalizedText, FallbackValue=Message Level}" />
				<ComboBox
					Grid.Row="2"
					Margin="75 0"
					Grid.Column="1"
					FontSize="22"
					ScrollViewer.PanningMode="None">
					<ComboBoxItem
						Content="{Binding Path=StrInfo.LocalizedText, FallbackValue=Info}"
						IsSelected="{Binding IsInfo, Mode=TwoWay}" />
					<ComboBoxItem
						Content="{Binding Path=StrWarning.LocalizedText, FallbackValue=Warnung}"
						IsSelected="{Binding IsWarning, Mode=TwoWay}" />
					<ComboBoxItem
						Content="{Binding Path=StrError.LocalizedText, FallbackValue=Fehler}"
						IsSelected="{Binding IsError, Mode=TwoWay}" />
				</ComboBox>
				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrLevelMonitoring90Per.LocalizedText, FallbackValue=Level Message 90% erreicht}" />
				<ComboBox
					Grid.Row="3"
					Margin="75 0"
					Grid.Column="1"
					FontSize="22"
					ScrollViewer.PanningMode="None">
					<ComboBoxItem
						Content="{Binding Path=StrInfo.LocalizedText, FallbackValue=Info}"
						IsSelected="{Binding IsInfo90Per, Mode=TwoWay}" />
					<ComboBoxItem
						Content="{Binding Path=StrWarning.LocalizedText, FallbackValue=Warnung}"
						IsSelected="{Binding IsWarning90Per, Mode=TwoWay}" />
				</ComboBox>
				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrTimeSpanRepetitionMessage.LocalizedText, FallbackValue=Zeitspanne für die Überprüfung der Zähler und Betriebsstunden [h]}" />
				<TextBox
					Grid.Row="4"
					Grid.Column="1"
					HorizontalAlignment="Stretch"
					Margin="65 0 65 10"
					Text="{Binding Path=TimeSpanRepetitionMessage}"
					MouseUp="TextBox_MouseUp" />
				<TextBlock
					Grid.Row="5"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrResetLimits.LocalizedText, FallbackValue=Grenzwerte zurücksetzen}" />
				<Button
					Grid.Row="5"
					Grid.Column="1"
					Style="{StaticResource defaultButtonStyle}"
					Click="ButtonResetLimits_Click">
					<Image
						Source="../img/delete.png"
						Height="40" />
				</Button>
				<TextBlock
					Grid.Row="6"
					Grid.Column="0"
					Margin="20 0 20 0"
					Text="{Binding Path=StrResetCounts.LocalizedText, FallbackValue=Zähler zurücksetzen}" />
				<Button
					Grid.Row="6"
					Grid.Column="1"
					Style="{StaticResource defaultButtonStyle}"
					Click="ButtonResetCounter_Click">
					<Image
						Source="../img/settings_delete.png"
						Height="40" />
				</Button>
			</Grid>
		</Border>
	</ScrollViewer>
</UserControl>
