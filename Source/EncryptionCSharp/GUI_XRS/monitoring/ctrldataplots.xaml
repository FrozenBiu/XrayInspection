<UserControl
	x:Class="GUI_XRS.CtrlDataPlots" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:seso="clr-namespace:SesoPlot;assembly=Sesoplot"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Loaded="DataPlot_Loaded"
	Unloaded="DataPlot_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="graphesValveActivity">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="70" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="40" />
			<RowDefinition />
			<RowDefinition
				Height="20" />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			ColumnSpan="2"
			Column="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<ComboBox
				Grid.Column="2"
				Margin="10 0 0 0"
				Width="180"
				FontSize="16"
				ScrollViewer.PanningMode="None"
				ItemsSource="{Binding DataComboBox}"
				SelectedItem="{Binding Path=SelectionComboBox, Mode=TwoWay}"
				SelectionChanged="ComboBox_SelectionChanged" />
			<TextBlock
				FontWeight="Bold"
				VerticalAlignment="Center"
				Margin="10 0 0 0"
				Grid.Column="1"
				HorizontalAlignment="Left"
				FontSize="16"
				Text="{Binding Path=Name}" />
			<TextBlock
				Text="Start:"
				Grid.Column="3"
				FontSize="16"
				VerticalAlignment="Center"
				Margin="10 0 0 0" />
			<TextBox
				Grid.Column="4"
				Width="110"
				FontSize="16"
				Margin="5 0 0 0"
				Text="{Binding Path=TextDate1}"
				MouseDown="date1_Clicked" />
			<TextBlock
				Text="End:"
				Grid.Column="5"
				FontSize="16"
				VerticalAlignment="Center"
				Margin="10 0 0 0" />
			<TextBox
				Grid.Column="6"
				Width="110"
				FontSize="16"
				Margin="5 0 0 0"
				Text="{Binding Path=TextDate2}"
				MouseDown="date2_Clicked" />
			<Button
				Grid.Column="7"
				Margin="10,0,0,0"
				Content="Init"
				Height="40"
				Width="40"
				VerticalAlignment="Center"
				Click="Button_ResetTime" />
		</Grid>
		<StackPanel
			VerticalAlignment="Center"
			Grid.Column="0"
			Grid.Row="1"
			Visibility="{Binding Path=ZoomPanelVisible, Converter={StaticResource bVisConverter}}">
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Margin="0 0 0 10"
				Click="UpButton_Click">
				<ContentControl.Content>
					<Image
						Source="/img/arrow-up.png"
						Stretch="None" />
				</ContentControl.Content>
			</Button>
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Margin="0 0 0 10"
				Command="{Binding ZoomInYCommand}">
				<ContentControl.Content>
					<Image
						Source="/img/zoomIn.png"
						Stretch="None" />
				</ContentControl.Content>
			</Button>
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Command="{Binding ZoomOutYCommand}">
				<ContentControl.Content>
					<Image
						Source="/img/zoomOut.png"
						Stretch="None" />
				</ContentControl.Content>
			</Button>
			<Button
				Style="{StaticResource defaultButtonStyle}"
				Margin="0 10 0 10"
				Click="DownButton_Click">
				<ContentControl.Content>
					<Image
						Source="/img/arrow-down.png"
						Stretch="None" />
				</ContentControl.Content>
			</Button>
		</StackPanel>
		<Grid
			Column="1"
			Row="1"
			Background="#FFFFFFFF"
			Margin="2,0,5,0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="20" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Margin="25,0,0,0"
				FontWeight="Bold"
				Text="{Binding Path=Unit}" />
			<seso:SesoPlot
				Name="dataplot"
				Grid.Row="1"
				Margin="20,-45,-10,-10"
				MinimumX="0"
				ZoomModeX="ToZero"
				MinimumY="0"
				MaximumYLimit="5000000"
				ZoomModeY="ToZero"
				DrawMinorGridLinesHorizontal="False"
				DrawMinorGridLinesVertical="False"
				XAxisType="MonitoringPlot"
				IsScrolliewerDisabled="False"
				MaximumX="{Binding Path=MaxX}"
				MajorTicksX="{Binding Path=TicksX}"
				MinorTicksX="{Binding Path=TicksXMinor}"
				MaximumXLimit="{Binding Path=MaxX}"
				ZoomFactorX="{Binding ZoomFactorX, Mode=TwoWay}"
				MaximumY="{Binding MaxY, Mode=TwoWay}"
				MajorTicksY="{Binding TicksY}"
				ZoomFactorY="{Binding ZoomFactorY, Mode=TwoWay}">
				<seso:SesoPlot.Graphs>
					<seso:Graph
						Stroke="#FF008000"
						StrokeThickness="2"
						Points="{Binding Data2}" />
					<seso:Graph
						Stroke="#FFFF0000"
						StrokeThickness="2"
						Points="{Binding Data1}" />
					<seso:Graph
						Stroke="#B8E409"
						StrokeThickness="2"
						Points="{Binding Data3}" />
					<seso:Graph
						Stroke="#0088CF"
						StrokeThickness="2"
						Points="{Binding Data4}" />
					<seso:Graph
						Stroke="#544496"
						StrokeThickness="2"
						Points="{Binding Data5}" />
				</seso:SesoPlot.Graphs>
			</seso:SesoPlot>
		</Grid>
		<Grid
			Name="legendValveActivity"
			Column="1"
			Row="2"
			Background="#FFFFFFFF"
			Margin="2,0,5,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<Line
				X1="0"
				Y1="0"
				X2="20"
				Y2="0"
				Stroke="#FF008000"
				StrokeThickness="4"
				Margin="10,4,0,0"
				VerticalAlignment="Center"
				Grid.Row="0"
				Grid.Column="1" />
			<TextBlock
				VerticalAlignment="Center"
				Margin="20,0,0,0"
				Grid.Column="0"
				Text="{Binding Path=NameData1}" />
			<Line
				X1="0"
				Y1="0"
				X2="20"
				Y2="0"
				Stroke="#FFFF0000"
				StrokeThickness="4"
				Margin="10,4,0,0"
				VerticalAlignment="Center"
				Grid.Row="0"
				Grid.Column="3"
				Visibility="{Binding Path=LimitVisible, Converter={StaticResource bVisConverter}}" />
			<TextBlock
				VerticalAlignment="Center"
				Margin="20,0,0,0"
				Grid.Column="2"
				Text="{Binding Path=StrLimit.LocalizedText, FallbackValue=Grenzwert}"
				Visibility="{Binding Path=LimitVisible, Converter={StaticResource bVisConverter}}" />
			<Line
				X1="0"
				Y1="0"
				X2="20"
				Y2="0"
				Stroke="#B8E409"
				StrokeThickness="4"
				Margin="10,4,0,0"
				VerticalAlignment="Center"
				Grid.Row="0"
				Grid.Column="5"
				Visibility="{Binding Path=Col2, Converter={StaticResource bVisConverter}}" />
			<TextBlock
				VerticalAlignment="Center"
				Margin="20,0,0,0"
				Grid.Column="4"
				Text="{Binding Path=NameData2}"
				Visibility="{Binding Path=Col2, Converter={StaticResource bVisConverter}}" />
			<Line
				X1="0"
				Y1="0"
				X2="20"
				Y2="0"
				Stroke="#0088CF"
				StrokeThickness="4"
				Margin="10,4,0,0"
				VerticalAlignment="Center"
				Grid.Row="0"
				Grid.Column="7"
				Visibility="{Binding Path=Col3, Converter={StaticResource bVisConverter}}" />
			<TextBlock
				VerticalAlignment="Center"
				Margin="20,0,0,0"
				Grid.Column="6"
				Text="{Binding Path=NameData3}"
				Visibility="{Binding Path=Col3, Converter={StaticResource bVisConverter}}" />
			<Line
				X1="0"
				Y1="0"
				X2="20"
				Y2="0"
				Stroke="#544496"
				StrokeThickness="4"
				Margin="10,4,0,0"
				VerticalAlignment="Center"
				Grid.Row="0"
				Grid.Column="9"
				Visibility="{Binding Path=Col4, Converter={StaticResource bVisConverter}}" />
			<TextBlock
				VerticalAlignment="Center"
				Margin="20,0,0,0"
				Grid.Column="8"
				Text="{Binding Path=NameData4}"
				Visibility="{Binding Path=Col4, Converter={StaticResource bVisConverter}}" />
		</Grid>
	</Grid>
</UserControl>
