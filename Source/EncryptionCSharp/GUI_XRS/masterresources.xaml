						Offset="0.00"
						Color="#52d62a" />
					<GradientStop
						Offset="1.00"
						Color="#358a06" />
				</LinearGradientBrush>
				<LinearGradientBrush
					x:Key="EllipseDownFill"
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="1.00"
						Color="#52d62a" />
					<GradientStop
						Offset="0.00"
						Color="#358a06" />
				</LinearGradientBrush>
			</ResourceDictionary>
		</Style.Resources>
		<Setter
			Property="Height"
			Value="60" />
		<Setter
			Property="Width"
			Value="60" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid>
						<Ellipse
							Name="EllipseFrame"
							StrokeThickness="3"
							Fill="{StaticResource EllipseDarkStroke}" />
						<Ellipse
							Name="BorderUp"
							Height="55"
							Width="55"
							StrokeThickness="1"
							Stroke="{DynamicResource EllipseStroke}"
							Fill="{DynamicResource EllipseUpFill}" />
						<Ellipse
							Name="BorderDown"
							Height="55"
							Width="55"
							StrokeThickness="1"
							Opacity="0"
							Stroke="{DynamicResource EllipseStroke}"
							Fill="{DynamicResource EllipseDownFill}" />
						<ContentPresenter
							Name="Contents" />
						<Ellipse
							Name="Shape"
							Fill="#ffffff"
							Opacity="0.07"
							Margin="0 0 0 32" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="BorderDown"
								Property="UIElement.Opacity"
								Value="1" />
							<Setter
								TargetName="Contents"
								Property="Margin"
								Value="4,4,2,2" />
							<TriggerBase.EnterActions>
								<BeginStoryboard
									Storyboard="{StaticResource ButtonDownTimeLine}" />
							</TriggerBase.EnterActions>
							<TriggerBase.ExitActions>
								<BeginStoryboard
									Storyboard="{StaticResource ButtonUpTimeLine}" />
							</TriggerBase.ExitActions>
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								TargetName="EllipseFrame"
								Property="Fill"
								Value="{StaticResource EllipseGreyStroke}" />
							<Setter
								TargetName="BorderUp"
								Property="StrokeThickness"
								Value="0" />
							<Setter
								TargetName="Shape"
								Property="UIElement.Opacity"
								Value="0" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="True">
							<Setter
								TargetName="EllipseFrame"
								Property="Fill"
								Value="{StaticResource EllipseDarkStroke}" />
							<Setter
								TargetName="BorderUp"
								Property="StrokeThickness"
								Value="1" />
							<Setter
								TargetName="Shape"
								Property="UIElement.Opacity"
								Value="0.07" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
