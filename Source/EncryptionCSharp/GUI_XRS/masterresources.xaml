		<Setter
			Property="FrameworkElement.OverridesDefaultStyle"
			Value="True" />
		<Setter
			Property="UIElement.Opacity"
			Value="0.4" />
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type ContextMenu}"
					x:Key="{x:Type ContextMenu}">
					<Setter
						Property="Visibility"
						Value="Collapsed" />
				</Style>
				<Storyboard
					x:Key="ScrollBarFadeIn"
					AutoReverse="False"
					RepeatBehavior="1x">
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						BeginTime="0:0:0"
						Duration="0:0:0.2"
						From="0.4"
						To="0.9" />
				</Storyboard>
				<Storyboard
					x:Key="ScrollBarFadeOut"
					AutoReverse="False"
					RepeatBehavior="1x">
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						BeginTime="0:0:0"
						Duration="0:0:0.2"
						From="0.9"
						To="0.4" />
				</Storyboard>
			</ResourceDictionary>
		</Style.Resources>
		<Style.Triggers>
			<Trigger
				Property="ScrollBar.Orientation"
				Value="Horizontal">
				<Setter
					Property="Width"
					Value="Auto" />
				<Setter
					Property="Height"
					Value="40" />
				<Setter
					Property="Template"
					Value="{StaticResource HorizontalScrollBar}" />
			</Trigger>
			<Trigger
				Property="ScrollBar.Orientation"
				Value="Vertical">
				<Setter
					Property="Width"
					Value="40" />
				<Setter
					Property="Height"
					Value="Auto" />
				<Setter
					Property="Template"
					Value="{StaticResource VerticalScrollBar}" />
			</Trigger>
			<EventTrigger
				RoutedEvent="GotMouseCapture">
				<BeginStoryboard
					Storyboard="{StaticResource ScrollBarFadeIn}" />
			</EventTrigger>
			<EventTrigger
				RoutedEvent="LostMouseCapture">
				<BeginStoryboard
					Storyboard="{StaticResource ScrollBarFadeOut}" />
			</EventTrigger>
		</Style.Triggers>
	</Style>
