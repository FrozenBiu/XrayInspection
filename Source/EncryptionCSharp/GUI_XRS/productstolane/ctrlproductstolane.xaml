<UserControl
	x:Class="GUI_XRS.CtrlProductsToLane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type ListBoxItem}"
				x:Key="ListboxItemStyle">
				<Setter
					Property="Margin"
					Value="1,2,1,1" />
				<Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBoxItem}">
							<Grid>
								<Border
									Background="{TemplateBinding Background}" />
								<Border
									Background="#BEFFFFFF"
									Margin="3,1">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition />
											<RowDefinition />
										</Grid.RowDefinitions>
										<Border
											Margin="2,1,2,0"
											Grid.Row="0"
											Background="#57FFFFFF" />
									</Grid>
								</Border>
								<ContentPresenter
									Margin="8,5" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ListBoxItem.IsSelected"
									Value="True">
									<Setter
										Property="Background"
										Value="#FFADD8E6" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="ListBoxStyle">
				<Setter
					Property="ItemContainerStyle"
					Value="{DynamicResource ListboxItemStyle}" />
				<Setter
					Property="Margin"
					Value="3,3,2,1" />
			</Style>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:LaneStringConverter
				x:Key="laneStringConverter" />
			<l:StringToVisibilityConverter
				x:Key="stringToVisibilityConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Border
			Margin="20,0,20,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="20*" />
					<RowDefinition
						Height="70" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="4*" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="5*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Name="tbCurrentAppl"
					Grid.Row="0"
					VerticalAlignment="Center"
					FontSize="25"
					FontWeight="Bold"
					FontFamily="Helvetica"
					Margin="0 2 0 2"
					Text="{Binding Path=ProductManager.CurrentLoadedProduct.ProductAndBatchName}" />
				<Button
					Grid.Row="2"
					Grid.Column="2"
					Style="{StaticResource defaultButtonStyle}"
					Margin="20 5 0 5"
					HorizontalAlignment="Left"
					Command="{Binding DeleteSubLaneProductCommand}"
					Visibility="{Binding SelectedSubLane.ProductName, Converter={StaticResource stringToVisibilityConverter}}">
					<Image
						Source="/img/deleteProduct.png"
						Stretch="None" />
				</Button>
				<ListBox
					Style="{StaticResource ListBoxStyle}"
					Grid.Column="0"
					Grid.Row="1"
					BorderBrush="#b6b6b6"
					Background="#00FFFFFF"
					SelectionMode="Single"
					Grid.IsSharedSizeScope="True"
					IsSynchronizedWithCurrentItem="True"
					SelectedItem="{Binding Path=ProductManager.SelectedProduct}"
					ItemsSource="{Binding Path=ProductManager.ProductList}">
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}" />
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid
								MinHeight="50"
								Visibility="{Binding IsSingleProduct, Converter={StaticResource bVisConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto"
										SharedSizeGroup="groupNumber" />
									<ColumnDefinition
										Width="Auto"
										SharedSizeGroup="groupNumber" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition />
								</Grid.RowDefinitions>
								<TextBlock
									Grid.Column="0"
									FontWeight="Bold"
									FontSize="20"
									FontFamily="Helvetica"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding Path=ProductNumber}" />
								<TextBlock
									Grid.Column="1"
									FontSize="20"
									FontFamily="Helvetica"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding Path=ProductName}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ListBox>
				<Button
					Grid.Column="1"
					Grid.Row="1"
					Style="{StaticResource defaultButtonStyle}"
					Command="{Binding AssignCommand}">
					<Image
						Source="/img/arrow-right.png"
						Width="40"
						Margin="10,7,10,8"
						HorizontalAlignment="Center" />
				</Button>
				<ListBox
					Grid.Column="2"
					Grid.Row="1"
					BorderBrush="#b6b6b6"
					Background="#00FFFFFF"
					SelectionMode="Single"
					Grid.IsSharedSizeScope="True"
					IsSynchronizedWithCurrentItem="True"
					SelectedItem="{Binding Path=SelectedSubLane}"
					ItemsSource="{Binding LaneProduct.SubProducts}">
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}" />
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid
								MinHeight="50"
								Visibility="{Binding LaneActive, Converter={StaticResource bVisConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="Auto"
										SharedSizeGroup="groupNumber" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									FontSize="18"
									FontFamily="Helvetica"
									FontWeight="Bold"
									VerticalAlignment="Center"
									Margin="0 0 10 0">
									<TextBlock
										Text="{Binding Lane, Converter={StaticResource laneStringConverter}}" />:</TextBlock>
								<TextBlock
									Grid.Column="1"
									Margin="0 0 15 0"
									FontWeight="Bold"
									FontSize="20"
									FontFamily="Helvetica"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding Path=ProductNumber}" />
								<TextBlock
									Grid.Column="2"
									FontSize="20"
									FontFamily="Helvetica"
									VerticalAlignment="Center"
									Text="{Binding Path=ProductName}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>
	</Grid>
</UserControl>
