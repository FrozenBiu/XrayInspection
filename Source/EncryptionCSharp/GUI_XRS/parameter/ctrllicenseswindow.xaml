<UserControl
	x:Class="GUI_XRS.CtrlLicensesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:local="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Loaded="Window_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid"
		Margin="12 24 12 24">
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<ScrollViewer
			Name="scrollviewer"
			VerticalScrollBarVisibility="Visible"
			Grid.Row="0"
			HorizontalScrollBarVisibility="Hidden">
			<Border
				Name="border"
				Grid.Row="0"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#FFFFFFFF">
				<Grid
					Width="{Binding ActualWidth, ElementName=mainGrid}">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock
						Text="Licenses"
						FontSize="24"
						Margin="12"
						Grid.Row="0" />
					<TextBlock
						FontSize="20"
						Margin="12 24 0 0"
						Grid.Row="1">
						<Span>Used Libraries:</Span>
						<LineBreak />
						<Span>Dynamik Data Display, 0.3.0.0</Span>
						<LineBreak />
						<Span>
							<Run
								Text="OpenCV, " /> <Run
								Text="{Binding OpenCVVersion}" /></Span>
						<LineBreak />
						<Span>PDFSharp, 1.50.5147.0</Span>
						<LineBreak />
						<Span>SharpZipLib, 0.86.0.518</Span>
						<LineBreak />
						<Span>DotNetZip, 1.16.0</Span>
						<LineBreak />
						<TextBlock
							FontSize="20"
							Text="Libtorch, 2.2.0"
							Visibility="{Binding IsAIBox, Converter={StaticResource bVisConverter}}" />
						<LineBreak />
					</TextBlock>
					<TextBlock
						Text="OpenCV"
						Grid.Row="2"
						FontSize="18"
						Margin="12 0 0 0" />
					<TextBlock
						Name="LicenseApache"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="3"
						TextWrapping="Wrap"
						TextOptions.TextFormattingMode="Display" />
					<TextBlock
						Text="PDFSharp"
						FontSize="18"
						Grid.Row="4"
						Margin="12 24 0 0" />
					<TextBlock
						Name="LicenseMIT"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="5"
						TextWrapping="Wrap"
						TextOptions.TextFormattingMode="Display" />
					<TextBlock
						Text="Dynamik Data Display"
						FontSize="18"
						Grid.Row="6"
						Margin="12 24 0 0" />
					<TextBlock
						Name="LicenseMSRL"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="7"
						TextWrapping="Wrap"
						TextOptions.TextFormattingMode="Display" />
					<TextBlock
						Text="SharpZipLib"
						FontSize="18"
						Grid.Row="8"
						Margin="12 24 0 0" />
					<TextBlock
						Name="LicenseGNU"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="9"
						TextWrapping="Wrap"
						TextOptions.TextFormattingMode="Display" />
					<TextBlock
						Text="Exception for SharpZibLib"
						FontSize="18"
						Grid.Row="10"
						Margin="12 10 0 0" />
					<TextBlock
						Name="ExceptionSharpZipLib"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="11"
						TextWrapping="Wrap"
						TextOptions.TextFormattingMode="Display" />
					<TextBlock
						Text="DotNetZip"
						FontSize="18"
						Grid.Row="12"
						Margin="12 24 0 0" />
					<TextBlock
						Name="LicenseMsPL"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="13"
						TextWrapping="Wrap"
						TextOptions.TextFormattingMode="Display" />
					<TextBlock
						Text="Libtorch"
						FontSize="18"
						Grid.Row="14"
						Margin="12 24 0 0"
						Visibility="{Binding Path=IsAIBox, Converter={StaticResource bVisConverter}}" />
					<TextBlock
						Name="LicenseLibtorch"
						FontSize="16"
						Margin="12 5 0 0"
						Grid.Row="15"
						TextWrapping="Wrap"
						Visibility="{Binding Path=IsAIBox, Converter={StaticResource bVisConverter}}" />
					<TextBlock
						Text="Source code on request"
						FontSize="20"
						Margin="12 24 0 0"
						Grid.Row="16"
						TextWrapping="Wrap" />
				</Grid>
			</Border>
		</ScrollViewer>
	</Grid>
</UserControl>
