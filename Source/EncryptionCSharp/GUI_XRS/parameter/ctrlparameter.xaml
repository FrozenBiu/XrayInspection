								Value="#414141" />
							<Setter
								Property="TextBox.TextWrapping"
								Value="Wrap" />
							<Setter
								Property="Focusable"
								Value="False" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type TextBox}">
										<Border
											CornerRadius="5"
											BorderThickness="1"
											Background="#00FFFFFF">
											<ScrollViewer
												Name="PART_ContentHost"
												Margin="0"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<Grid
					Visibility="{Binding Path=IsOperatingHoursVisible, Converter={StaticResource bVisConverter}}">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TreeView
						Name="treePar2"
						BorderThickness="0 0 0 0"
						BorderBrush="#eff2f3"
						ItemsSource="{Binding ParameterOperatingHours}">
						<ItemsControl.ItemTemplate>
							<HierarchicalDataTemplate
								ItemsSource="{Binding ChildrenItem}">
								<Grid
									Visibility="{Binding Path=IsOperatingHoursVisible, Converter={StaticResource bVisConverter}}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<Border
										Style="{StaticResource NameBorderStyle}"
										Grid.Column="0"
										Width=" 227"
										VerticalAlignment="Center"
										HorizontalAlignment="Left">
										<TextBlock
											Style="{StaticResource TextBlockBoldStyle}"
											Text="{Binding Operatinghours}" />
									</Border>
									<Grid
										Margin="0,0,0,0"
										Column="1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<ColumnDefinition />
											<ColumnDefinition />
											<ColumnDefinition />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource TextBlockStyle}"
											TextWrapping="Wrap"
											Width="175"
											VerticalAlignment="Center"
											HorizontalAlignment="Left"
											Text="{Binding StrforDateTimeOperatingHours}" />
										<TextBlock
											Grid.Column="1"
											Style="{StaticResource TextBlockStyle}"
											TextWrapping="Wrap"
											Width="85"
											VerticalAlignment="Center"
											HorizontalAlignment="Left"
											Text="{Binding StrforVoltageOperatingHours}" />
										<TextBlock
											Grid.Column="2"
											Style="{StaticResource TextBlockStyle}"
											TextWrapping="Wrap"
											Width="85"
											VerticalAlignment="Center"
											HorizontalAlignment="Left"
											Text="{Binding StrforCurrentOperatingHours}" />
										<TextBlock
											Grid.Column="3"
											Style="{StaticResource TextBlockStyle}"
											TextWrapping="Wrap"
											Width="85"
											VerticalAlignment="Center"
											HorizontalAlignment="Left"
											Text="{Binding StrforOperatingHours}" />
										<TextBlock
											Grid.Column="4"
											Style="{StaticResource TextBlockStyle}"
											TextWrapping="Wrap"
											Width="150"
											VerticalAlignment="Top"
											HorizontalAlignment="Left"
											Text="{Binding StrforOperatingHoursTotal}" />
									</Grid>
								</Grid>
							</HierarchicalDataTemplate>
						</ItemsControl.ItemTemplate>
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<Style
									TargetType="{x:Type TreeViewItem}"
									x:Key="{x:Type TreeViewItem}">
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type TreeViewItem}">
												<Border
													Name="Bd"
													Padding="45 0 0 0"
													Visibility="{Binding Path=IsOperatingHoursVisible, Converter={StaticResource bVisConverter}}">
													<Grid>
														<Expander
															Name="Exp">
															<FrameworkElement.Resources>
																<ResourceDictionary>
																	<Style
																		TargetType="{x:Type Expander}"
																		x:Key="{x:Type Expander}">
																		<Setter
																			Property="Template">
																			<Setter.Value>
																				<ControlTemplate
																					TargetType="{x:Type Expander}">
																					<StackPanel
																						Orientation="Vertical">
																						<StackPanel
																							Orientation="Horizontal"
																							Margin="0 7 0 0">
																							<ToggleButton
																								Name="toggleBtn"
																								Margin="0 0 5 0"
																								Style="{StaticResource okButtonStyle}"
																								IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
																								<ContentControl.ContentTemplate>
																									<DataTemplate>
																										<Image
																											Name="rotateMe"
																											Source="..\img\arrow.png"
																											Stretch="None"
																											RenderTransformOrigin="0.5,0.5">
																											<UIElement.RenderTransform>
																												<RotateTransform />
																											</UIElement.RenderTransform>
																										</Image>
																										<DataTemplate.Triggers>
																											<DataTrigger
																												Value="True"
																												Binding="{Binding ElementName=toggleBtn, Path=IsChecked}">
																												<TriggerBase.EnterActions>
																													<BeginStoryboard>
																														<Storyboard>
																															<DoubleAnimation
																																Storyboard.TargetName="rotateMe"
																																Storyboard.TargetProperty="RenderTransform.Angle"
																																To="90"
																																Duration="0:0:0.3" />
																														</Storyboard>
																													</BeginStoryboard>
																												</TriggerBase.EnterActions>
																												<TriggerBase.ExitActions>
																													<BeginStoryboard>
																														<Storyboard>
																															<DoubleAnimation
																																Storyboard.TargetName="rotateMe"
																																Storyboard.TargetProperty="RenderTransform.Angle"
																																To="0"
																																Duration="0:0:0.3" />
																														</Storyboard>
																													</BeginStoryboard>
																												</TriggerBase.ExitActions>
																											</DataTrigger>
																										</DataTemplate.Triggers>
																									</DataTemplate>
																								</ContentControl.ContentTemplate>
																							</ToggleButton>
																							<ContentPresenter
																								Content="{TemplateBinding Header}" />
																						</StackPanel>
																						<ContentPresenter
																							Name="mainContent"
																							Visibility="Collapsed" />
																					</StackPanel>
																					<ControlTemplate.Triggers>
																						<Trigger
																							Property="Expander.IsExpanded"
																							Value="True">
																							<Setter
																								TargetName="mainContent"
																								Property="Visibility"
																								Value="Visible" />
																						</Trigger>
																					</ControlTemplate.Triggers>
																				</ControlTemplate>
																			</Setter.Value>
																		</Setter>
																	</Style>
																</ResourceDictionary>
															</FrameworkElement.Resources>
															<HeaderedContentControl.Header>
																<ContentPresenter
																	ContentSource="Header" />
															</HeaderedContentControl.Header>
															<ItemsPresenter />
														</Expander>
														<Border
															Name="CntPres"
															MinHeight="46"
															Visibility="Collapsed"
															BorderThickness="1"
															BorderBrush="#9399a0"
															Margin="5 -1 0 0">
															<Border.Background>
																<LinearGradientBrush
																	StartPoint="0,0"
																	EndPoint="0,1">
																	<GradientStop
																		Offset="0.00"
																		Color="#e7eaea" />
																	<GradientStop
																		Offset="1.00"
																		Color="#c9cccd" />
																</LinearGradientBrush>
															</Border.Background>
															<StackPanel
																Orientation="Horizontal">
																<CheckBox
																	Margin="5 0 0 0"
																	Visibility="{Binding Path=IsCheckedVisible, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}"
																	IsChecked="{Binding Path=IsChecked, Mode=TwoWay}" />
																<ContentPresenter
																	ContentSource="Header" />
															</StackPanel>
														</Border>
													</Grid>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger
														Property="ItemsControl.HasItems"
														Value="False">
														<Setter
															TargetName="Exp"
															Property="Visibility"
															Value="Collapsed" />
														<Setter
															TargetName="CntPres"
															Property="Visibility"
															Value="Visible" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ResourceDictionary>
						</FrameworkElement.Resources>
					</TreeView>
					<Border
						Name="licensesButton"
						Grid.Column="0"
						Grid.Row="1"
						Width="80"
						Height="80"
						BorderBrush="#FF000000"
						BorderThickness="1"
						CornerRadius="3"
						Background="#00FFFFFF"
						HorizontalAlignment="Left"
						Margin="80 30 0 0"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ShowLicensesCommand}">
						<Image
							Source="../img/info.png"
							Stretch="None" />
					</Border>
				</Grid>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>
