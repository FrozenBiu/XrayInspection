									<Setter
										Property="Margin"
										Value="0" />
									<Setter
										Property="Background"
										Value="#00FFFFFF" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
						<Style
							TargetType="{x:Type TextBlock}"
							x:Key="TextBlockStyle">
							<Setter
								Property="VerticalAlignment"
								Value="Center" />
							<Setter
								Property="FontFamily"
