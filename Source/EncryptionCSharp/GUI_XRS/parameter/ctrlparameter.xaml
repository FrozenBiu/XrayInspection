							<Setter
								Property="Margin"
								Value="0 5 0 5" />
							<Setter
								Property="TextWrapping"
								Value="Wrap" />
						</Style>
						<Style
							TargetType="{x:Type TextBlock}"
							BasedOn="{StaticResource TextBlockStyle}"
							x:Key="TextBlockBoldStyle">
							<Setter
								Property="FontWeight"
								Value="Bold" />
						</Style>
						<Style
							TargetType="{x:Type TextBox}"
							x:Key="TextBoxStyle">
							<Setter
								Property="Visibility"
								Value="{Binding TextBoxVisibility}" />
							<Setter
								Property="MinHeight"
								Value="35" />
							<Setter
								Property="Margin"
								Value="0 2 0 2" />
							<Setter
								Property="FontFamily"
								Value="Arial" />
							<Setter
								Property="FontSize"
								Value="14" />
							<Setter
								Property="VerticalAlignment"
								Value="Center" />
							<Setter
								Property="Foreground"
								Value="#ffffff" />
							<Setter
								Property="TextBox.TextWrapping"
								Value="Wrap" />
							<Setter
								Property="Focusable"
								Value="False" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type TextBox}">
										<Border
											CornerRadius="5"
											BorderThickness="1"
											BorderBrush="#d3d6d6">
											<Border.Background>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="0,1">
													<GradientStop
														Offset="0"
														Color="#434343" />
													<GradientStop
														Offset="0.2"
														Color="#585858" />
													<GradientStop
														Offset="1"
														Color="#636666" />
												</LinearGradientBrush>
											</Border.Background>
											<ScrollViewer
												Name="PART_ContentHost"
												Margin="0"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
						<Style
							TargetType="{x:Type TextBox}"
							x:Key="TextBoxDisabledStyle">
							<Setter
								Property="Visibility"
								Value="{Binding TextBoxVisibility}" />
							<Setter
								Property="MinHeight"
								Value="35" />
							<Setter
								Property="Margin"
