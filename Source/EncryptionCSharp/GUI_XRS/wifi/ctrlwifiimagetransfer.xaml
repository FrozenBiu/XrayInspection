<UserControl
	x:Class="GUI_XRS.CtrlWifiImageTransfer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="CtrlWifiImageTransfer_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="30" />
				<Setter
					Property="Width"
					Value="30" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="1"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="25"
									Width="25"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="25"
									Width="25"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="30 0 30 0" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<BooleanToVisibilityConverter
				x:Key="bVisConverter" />
			<l:AutolearnMachineStatesBoolConverter
				x:Key="autolearnMachineStatesBoolConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="boolToVisibilityInvertedHiddenConverter" />
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:SavingPngToNetworkModesToStringConverter
				x:Key="savingPngToNetworkModesToStringConverter" />
			<l:SavingPngToNetworkModeToStringConverter
				x:Key="savingPngToNetworkModeToStringConverter" />
			<l:SavingPngToNetworkLocationsToStringConverter
				x:Key="savingPngToNetworkLocationsToStringConverter" />
			<l:SavingPngToNetworkLocationToStringConverter
				x:Key="savingPngToNetworkLocationToStringConverter" />
			<l:SavingPngToNetworkStorageModesToStringConverter
				x:Key="savingPngToNetworkStorageModesToStringConverter" />
			<l:SavingPngToNetworkStorageModeToStringConverter
				x:Key="savingPngToNetworkStorageModeToStringConverter" />
			<l:SavingPngToNetworkModes
				x:Key="Modes">
				<l:SavingPngMode>BadImages</l:SavingPngMode>
				<l:SavingPngMode>GoodImages</l:SavingPngMode>
				<l:SavingPngMode>GoodandBadImages</l:SavingPngMode>
			</l:SavingPngToNetworkModes>
			<l:SavingPngLocations
				x:Key="LocationModes">
				<l:SavingPngLocation>Disabled</l:SavingPngLocation>
				<l:SavingPngLocation>NetworkFolder</l:SavingPngLocation>
				<l:SavingPngLocation>LocalFolderFTP</l:SavingPngLocation>
				<l:SavingPngLocation>NetworkAndLocalFolderFTP</l:SavingPngLocation>
			</l:SavingPngLocations>
			<l:SavingPngStorageModes
				x:Key="StorageModes">
				<l:SavingPngStorageMode>Disabled</l:SavingPngStorageMode>
				<l:SavingPngStorageMode>OperatingDays</l:SavingPngStorageMode>
				<l:SavingPngStorageMode>MaxCapacity</l:SavingPngStorageMode>
			</l:SavingPngStorageModes>
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<l:BoolGridLengthDobuleStarConverter
				x:Key="boolGridLengthDoubleStarConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Margin="12 24 12 24"
		BorderBrush="#a8a8a8"
		BorderThickness="1"
		Background="#d1d1d1">
		<Grid>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="{Binding IsNetworkDriveVisible, Converter={StaticResource boolGridLengthDoubleStarConverter}}" />
					<RowDefinition
						Height="{Binding IsNetworkDriveVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
					<RowDefinition
						Height="{Binding IsNetworkDriveVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
					<RowDefinition
						Height="{Binding IsOperatingDaysVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="3"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="1"
					Grid.Column="0"
					Grid.RowSpan="3"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="2"
					Grid.Column="0"
					Grid.RowSpan="3"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="0"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="2"
					Grid.ColumnSpan="2"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Text="{Binding Path=StrEnableImageTransfer.LocalizedText, FallbackValue=Bildtransfer}" />
				<ComboBox
					Grid.Row="0"
					Grid.Column="1"
					Margin="20 10 20 10"
					FontSize="22"
					ScrollViewer.PanningMode="None"
					ItemsSource="{Binding Source={StaticResource LocationModes}, Converter={StaticResource savingPngToNetworkLocationsToStringConverter}}"
					SelectedItem="{Binding Path=SelectedLocation, Mode=TwoWay, Converter={StaticResource savingPngToNetworkLocationToStringConverter}}" />
				<Grid
					Row="1"
					Column="0">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock
						Grid.Row="2"
						Text="{Binding Path=StrNetworkPath.LocalizedText, FallbackValue=Netzwerkpfad}" />
					<TextBlock
						Grid.Row="3"
						Text="\\servername\folder$\"
						Foreground="#FF808080" />
				</Grid>
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					TextAlignment="Left"
					MinLines="5"
					Margin="20 10 20 10"
					FontSize="22"
					Text="{Binding Path=StoragePath}"
					IsEnabled="{Binding Path=EditAllowed}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeStoragePathCommand}">
					<FrameworkElement.Style>
						<MultiBinding
							Converter="{StaticResource bTextBoxStyleConverter}">
							<MultiBinding.Bindings>
								<Binding
									RelativeSource="{RelativeSource Self}" />
								<Binding
									Path="EditAllowed" />
							</MultiBinding.Bindings>
						</MultiBinding>
					</FrameworkElement.Style>
				</TextBox>
				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Text="{Binding Path=StrImageMode.LocalizedText, FallbackValue=Bild Modus}" />
				<ComboBox
					Grid.Row="2"
					Grid.Column="1"
					Margin="20 10 20 10"
					FontSize="22"
					ScrollViewer.PanningMode="None"
					ItemsSource="{Binding Source={StaticResource Modes}, Converter={StaticResource savingPngToNetworkModesToStringConverter}}"
					SelectedItem="{Binding Path=SelectedMode, Mode=TwoWay, Converter={StaticResource savingPngToNetworkModeToStringConverter}}" />
				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Text="{Binding Path=StrSavingMode.LocalizedText, FallbackValue=Speicher Modus}" />
				<ComboBox
					Grid.Row="3"
					Grid.Column="1"
					Margin="20 10 20 10"
					FontSize="22"
					ScrollViewer.PanningMode="None"
					ItemsSource="{Binding Source={StaticResource StorageModes}, Converter={StaticResource savingPngToNetworkStorageModesToStringConverter}}"
					SelectedItem="{Binding Path=SelectedStorageMode, Mode=TwoWay, Converter={StaticResource savingPngToNetworkStorageModeToStringConverter}}" />
				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Text="{Binding Path=StrCount.LocalizedText, FallbackValue=Anzahl}" />
				<TextBox
					Grid.Row="4"
					Grid.Column="1"
					TextAlignment="Left"
					MinLines="1"
					Margin="20 10 20 10"
					FontSize="22"
					Text="{Binding Path=OperatingDays}"
					IsEnabled="{Binding Path=EditAllowed}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeOperatingDaysCommand}">
					<FrameworkElement.Style>
						<MultiBinding
							Converter="{StaticResource bTextBoxStyleConverter}">
							<MultiBinding.Bindings>
								<Binding
									RelativeSource="{RelativeSource Self}" />
								<Binding
									Path="EditAllowed" />
							</MultiBinding.Bindings>
						</MultiBinding>
					</FrameworkElement.Style>
				</TextBox>
			</Grid>
			<Grid
				Name="subGrid"
				Background="#e7efc5"
				Margin="0,0,0,0"
				VerticalAlignment="Stretch"
				Visibility="{Binding FileListVisible, Converter={StaticResource bVisConverter}}">
				<TreeView
					Name="listTree"
					Grid.Row="0"
					BorderThickness="0 0 0 0"
					VerticalAlignment="Top">
					<ItemsControl.ItemTemplate>
						<HierarchicalDataTemplate
							DataType="x:Type self:Data"
							ItemsSource="{Binding Items}">
							<TextBlock
								Background="#e7efc5"
								Text="{Binding name}" />
						</HierarchicalDataTemplate>
					</ItemsControl.ItemTemplate>
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<Style
								TargetType="{x:Type TreeViewItem}"
								x:Key="{x:Type TreeViewItem}">
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type TreeViewItem}">
											<Border
												Name="Bd"
												Padding="5 0 0 0">
												<Grid>
													<Expander
														Name="Exp">
														<FrameworkElement.Resources>
															<ResourceDictionary>
																<Style
																	TargetType="{x:Type Expander}"
																	x:Key="{x:Type Expander}">
																	<Setter
																		Property="Expander.IsExpanded"
																		Value="{Binding Path=topLevel}" />
																	<Setter
																		Property="Template">
																		<Setter.Value>
																			<ControlTemplate
																				TargetType="{x:Type Expander}">
																				<StackPanel
																					Orientation="Vertical">
																					<StackPanel
																						Orientation="Horizontal"
																						Margin="0 7 0 0">
																						<ToggleButton
																							Name="toggleBtn"
																							Margin="0 0 5 0"
																							Style="{StaticResource okButtonStyle}"
																							Visibility="{Binding Path=lowerLevel, Converter={StaticResource bVisConverter}}"
																							IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
																							<ContentControl.ContentTemplate>
																								<DataTemplate>
																									<Image
																										Name="rotateMe"
																										Source="..\img\arrow.png"
																										Stretch="None"
																										RenderTransformOrigin="0.5,0.5">
																										<UIElement.RenderTransform>
																											<RotateTransform />
																										</UIElement.RenderTransform>
																									</Image>
																									<DataTemplate.Triggers>
																										<DataTrigger
																											Value="True"
																											Binding="{Binding ElementName=toggleBtn, Path=IsChecked}">
																											<TriggerBase.EnterActions>
																												<BeginStoryboard>
																													<Storyboard>
																														<DoubleAnimation
																															Storyboard.TargetName="rotateMe"
																															Storyboard.TargetProperty="RenderTransform.Angle"
																															To="90"
																															Duration="0:0:0.3" />
																													</Storyboard>
																												</BeginStoryboard>
																											</TriggerBase.EnterActions>
																											<TriggerBase.ExitActions>
																												<BeginStoryboard>
																													<Storyboard>
																														<DoubleAnimation
																															Storyboard.TargetName="rotateMe"
																															Storyboard.TargetProperty="RenderTransform.Angle"
																															To="0"
																															Duration="0:0:0.3" />
																													</Storyboard>
																												</BeginStoryboard>
																											</TriggerBase.ExitActions>
																										</DataTrigger>
																									</DataTemplate.Triggers>
																								</DataTemplate>
																							</ContentControl.ContentTemplate>
																						</ToggleButton>
																						<ContentPresenter
																							Content="{TemplateBinding Header}" />
																					</StackPanel>
																					<ContentPresenter
																						Name="mainContent"
																						Visibility="Collapsed" />
																				</StackPanel>
																				<ControlTemplate.Triggers>
																					<Trigger
																						Property="Expander.IsExpanded"
																						Value="True">
																						<Setter
																							TargetName="mainContent"
																							Property="Visibility"
																							Value="Visible" />
																					</Trigger>
																				</ControlTemplate.Triggers>
																			</ControlTemplate>
																		</Setter.Value>
																	</Setter>
																</Style>
															</ResourceDictionary>
														</FrameworkElement.Resources>
														<HeaderedContentControl.Header>
															<ContentPresenter
																ContentSource="Header" />
														</HeaderedContentControl.Header>
														<ItemsPresenter />
													</Expander>
													<Border
														Name="CntPres"
														Visibility="Collapsed"
														BorderThickness="1"
														BorderBrush="#e7efc5"
														Margin="20 5 0 0">
														<StackPanel
															Orientation="Horizontal">
															<CheckBox
																Margin="5 0 0 0"
																Visibility="{Binding Path=IsCheckedVisible, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}"
																IsChecked="{Binding Path=IsChecked, Mode=TwoWay}" />
															<ContentPresenter
																ContentSource="Header" />
														</StackPanel>
													</Border>
												</Grid>
											</Border>
											<ControlTemplate.Triggers>
												<Trigger
													Property="ItemsControl.HasItems"
													Value="False">
													<Setter
														TargetName="Exp"
														Property="Visibility"
														Value="Collapsed" />
													<Setter
														TargetName="CntPres"
														Property="Visibility"
														Value="Visible" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</TreeView>
			</Grid>
		</Grid>
	</Border>
</UserControl>
