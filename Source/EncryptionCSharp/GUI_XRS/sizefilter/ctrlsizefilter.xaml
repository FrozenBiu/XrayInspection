<UserControl
	x:Class="GUI_XRS.CtrlSizeFilter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="CtrlSizeFilter_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="55" />
				<Setter
					Property="Width"
					Value="55" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="3"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="50"
									Width="50"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="50"
									Width="50"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="ButtonDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="ButtonUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="{x:Type TextBox}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#cfcfcf" />
							<GradientStop
								Offset="0.02"
								Color="#e9e9e9" />
							<GradientStop
								Offset="0.03"
								Color="#f1f1f1" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#bebebe" />
							<GradientStop
								Offset="0.10"
								Color="#d8d8d8" />
							<GradientStop
								Offset="0.9"
								Color="#d8d8d8" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="Margin"
					Value="1 1 1 1" />
				<Setter
					Property="Padding"
					Value="10 0 10 0" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontSize"
					Value="28" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="TextBox.TextAlignment"
					Value="Center" />
				<Setter
					Property="Foreground"
					Value="#5e5e5e" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="3"
								BorderThickness="2"
								Padding="{TemplateBinding Padding}"
								BorderBrush="{DynamicResource textBoxBorder}"
								Background="{DynamicResource textBoxBackground}">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<BooleanToVisibilityConverter
				x:Key="bVisConverter" />
			<l:AutolearnMachineStatesBoolConverter
				x:Key="autolearnMachineStatesBoolConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="boolToVisibilityInvertedHiddenConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<ScrollViewer>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid
				Row="0"
				Height="{Binding ImageBoxHeight}">
				<image:XRSImageBox
					Name="imagebox"
					Margin="40 2 40 2" />
				<Border
					Margin="0 0 200 -5"
					BorderThickness="0 0 0 0"
					BorderBrush="#FF808080"
					Visibility="{Binding HighSpeedMachineActive, Converter={StaticResource bVisConverter}}">
					<Button
						Name="btnHighSpeedImage"
						Style="{StaticResource defaultButtonBigStyleActive}"
						Margin="10"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Command="{Binding HighSpeedImageCommand}">
						<UIElement.IsEnabled>
							<MultiBinding
								Converter="{StaticResource autolearnMachineStatesBoolConverter}">
								<Binding
									Path="machineState.State" />
								<Binding
									Path="DemoMode" />
							</MultiBinding>
						</UIElement.IsEnabled>
						<Grid>
							<Image
								Source="../img/objectxriimage.png"
								Stretch="Uniform"
								Height="50"
								Width="50"
								VerticalAlignment="Center"
								Visibility="{Binding ElementName=btnHighSpeedImage, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
							<Image
								Source="..\img\objectxriimage_disabled.png"
								Stretch="Uniform"
								Height="40"
								Width="40"
								VerticalAlignment="Center"
								Visibility="{Binding ElementName=btnHighSpeedImage, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
						</Grid>
					</Button>
				</Border>
				<ToggleButton
					Name="toggleBtn"
					Style="{StaticResource okButtonStyle}"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Margin="12 0 0 5"
					IsChecked="{Binding Path=IsExpanded, Mode=TwoWay}">
					<ContentControl.ContentTemplate>
						<DataTemplate>
							<Image
								Name="rotateMe"
								Source="../img/arrow90.png"
								Stretch="None"
								RenderTransformOrigin="0.5,0.5">
								<UIElement.RenderTransform>
									<RotateTransform />
								</UIElement.RenderTransform>
							</Image>
							<DataTemplate.Triggers>
								<DataTrigger
									Value="True"
									Binding="{Binding ElementName=toggleBtn, Path=IsChecked}">
									<TriggerBase.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetName="rotateMe"
													Storyboard.TargetProperty="RenderTransform.Angle"
													To="180"
													Duration="0:0:0.0" />
											</Storyboard>
										</BeginStoryboard>
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetName="rotateMe"
													Storyboard.TargetProperty="RenderTransform.Angle"
													To="0"
													Duration="0:0:0.0" />
											</Storyboard>
										</BeginStoryboard>
									</TriggerBase.ExitActions>
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ContentControl.ContentTemplate>
				</ToggleButton>
			</Grid>
			<Border
				Grid.Row="1"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1"
				Margin="0 12 0 12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="2*" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="40" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="3"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="4"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="3"
						BorderBrush="#e1e1e1"
						BorderThickness="0 1 0 0" />
					<Border
						Grid.Row="2"
						Grid.Column="0" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding Path=StrCurrentWidth.LocalizedText, FallbackValue=Aktuelle Breite}" />
					<TextBox
						Name="tbCurrentHeight"
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource disabledTextBox}"
						IsEnabled="False"
						FontWeight="Normal"
						Text="{Binding Path=CurrentHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding Path=StrMinWidth.LocalizedText, FallbackValue=Minimale Breite}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Text="{Binding Path=MinHeight, Mode=TwoWay}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMinHeightCommand}" />
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Text="{Binding Path=StrMaxWidth.LocalizedText, FallbackValue=Maximale Breite}" />
					<TextBox
						Grid.Row="2"
						Grid.Column="1"
						Text="{Binding Path=MaxHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMaxHeightCommand}" />
				</Grid>
			</Border>
			<Border
				Grid.Row="2"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1"
				Margin="0 0 0 12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="2*" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="40" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="3"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="4"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="3"
						BorderBrush="#e1e1e1"
						BorderThickness="0 1 0 0" />
					<Border
						Grid.Row="2"
						Grid.Column="0" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="{Binding Path=StrCurrentHeight.LocalizedText, FallbackValue=Aktuelle Höhe}" />
					<TextBox
						Name="tbCurrentWidth"
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource disabledTextBox}"
						IsEnabled="False"
						FontWeight="Normal"
						Text="{Binding Path=CurrentWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding Path=StrMinHeight.LocalizedText, FallbackValue=Minimale Höhe}" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Text="{Binding Path=MinWidth, Mode=TwoWay}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMinWidthCommand}" />
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Text="{Binding Path=StrMaxHeight.LocalizedText, FallbackValue=Maximale Höhe}" />
					<TextBox
						Grid.Row="2"
						Grid.Column="1"
						Text="{Binding Path=MaxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMaxWidthCommand}" />
				</Grid>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>
