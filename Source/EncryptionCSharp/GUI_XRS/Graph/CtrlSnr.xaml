<UserControl
	x:Class="GUI_XRS.Graph.CtrlSnr" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:GUI_XRS" xmlns:s="clr-namespace:SNRPlotLibrary;assembly=SNRplotLibrary" xmlns:sesopl="clr-namespace:SesoPlot;assembly=Sesoplot"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:graph="clr-namespace:GUI_XRS.Graph"
	Unloaded="UserControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type s:CheckBoxExtended}"
				x:Key="{x:Type s:CheckBoxExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type s:CheckBoxExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="55" />
				<Setter
					Property="Width"
					Value="55" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="3"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="50"
									Width="50"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="50"
									Width="50"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="ButtonDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="ButtonUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<SolidColorBrush
				Color="#888"
				x:Key="StandardBorderBrush" />
			<SolidColorBrush
				Color="#FFF"
				x:Key="StandardBackgroundBrush" />
			<SolidColorBrush
				Color="#DDD"
				x:Key="HoverBorderBrush" />
			<SolidColorBrush
				Color="Gray"
				x:Key="SelectedBackgroundBrush" />
			<SolidColorBrush
				Color="White"
				x:Key="SelectedForegroundBrush" />
			<SolidColorBrush
				Color="#888"
				x:Key="DisabledForegroundBrush" />
			<SolidColorBrush
				Color="#888"
				x:Key="NormalBrush" />
			<SolidColorBrush
				Color="#888"
				x:Key="NormalBorderBrush" />
			<SolidColorBrush
				Color="#888"
				x:Key="HorizontalNormalBrush" />
			<SolidColorBrush
				Color="#888"
				x:Key="HorizontalNormalBorderBrush" />
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="1,0.001"
				x:Key="ListBoxBackgroundBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="White"
							Offset="0.0" />
						<GradientStop
							Color="White"
							Offset="0.6" />
						<GradientStop
							Color="#DDDDDD"
							Offset="1.2" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="StandardBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FFF"
							Offset="0.0" />
						<GradientStop
							Color="#CCC"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<SolidColorBrush
				Color="#444"
				x:Key="GlyphBrush" />
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="PressedBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#BBB"
							Offset="0.0" />
						<GradientStop
							Color="#EEE"
							Offset="0.1" />
						<GradientStop
							Color="#EEE"
							Offset="0.9" />
						<GradientStop
							Color="#FFF"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<Style
				TargetType="{x:Type RepeatButton}"
				x:Key="ScrollBarPageButton">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="IsTabStop"
					Value="False" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type RepeatButton}">
							<Border
								Background="#00FFFFFF" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type Thumb}"
				x:Key="ScrollBarThumb">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="IsTabStop"
					Value="False" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Thumb}">
							<Border
								CornerRadius="5"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<ControlTemplate
				TargetType="{x:Type ScrollBar}"
				x:Key="VerticalScrollBar">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							MaxHeight="0" />
						<RowDefinition
							Height="0.00001*" />
						<RowDefinition
							MaxHeight="0" />
					</Grid.RowDefinitions>
					<Border
						Grid.RowSpan="3"
						Background="#00FFFFFF" />
					<Track
						Name="PART_Track"
						Grid.Row="1"
						IsDirectionReversed="True">
						<Track.DecreaseRepeatButton>
							<RepeatButton
								Command="ScrollBar.PageUpCommand"
								Style="{StaticResource ScrollBarPageButton}" />
						</Track.DecreaseRepeatButton>
						<Track.Thumb>
							<Thumb
								Margin="1 1 2 1"
								Style="{StaticResource ScrollBarThumb}"
								Background="{StaticResource HorizontalNormalBrush}"
								BorderBrush="{StaticResource HorizontalNormalBorderBrush}" />
						</Track.Thumb>
						<Track.IncreaseRepeatButton>
							<RepeatButton
								Command="ScrollBar.PageDownCommand"
								Style="{StaticResource ScrollBarPageButton}" />
						</Track.IncreaseRepeatButton>
					</Track>
				</Grid>
			</ControlTemplate>
			<ControlTemplate
				TargetType="{x:Type ScrollBar}"
				x:Key="HorizontalScrollBar">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							MaxWidth="0" />
						<ColumnDefinition
							Width="0.00001*" />
						<ColumnDefinition
							MaxWidth="0" />
					</Grid.ColumnDefinitions>
					<Border
						Grid.ColumnSpan="3"
						Background="#00FFFFFF" />
					<Track
						Name="PART_Track"
						Grid.Column="1"
						IsDirectionReversed="False">
						<Track.DecreaseRepeatButton>
							<RepeatButton
								Command="ScrollBar.PageLeftCommand"
								Style="{StaticResource ScrollBarPageButton}" />
						</Track.DecreaseRepeatButton>
						<Track.Thumb>
							<Thumb
								Margin="1 1 2 1"
								Style="{StaticResource ScrollBarThumb}"
								Background="{StaticResource HorizontalNormalBrush}"
								BorderBrush="{StaticResource HorizontalNormalBorderBrush}" />
						</Track.Thumb>
						<Track.IncreaseRepeatButton>
							<RepeatButton
								Command="ScrollBar.PageRightCommand"
								Style="{StaticResource ScrollBarPageButton}" />
						</Track.IncreaseRepeatButton>
					</Track>
				</Grid>
			</ControlTemplate>
			<Style
				TargetType="{x:Type ScrollBar}"
				x:Key="{x:Type ScrollBar}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="UIElement.Opacity"
					Value="0.4" />
				<Style.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type ContextMenu}"
							x:Key="{x:Type ContextMenu}">
							<Setter
								Property="Visibility"
								Value="Collapsed" />
						</Style>
						<Storyboard
							x:Key="ScrollBarFadeIn"
							AutoReverse="False"
							RepeatBehavior="1x">
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								BeginTime="0:0:0"
								Duration="0:0:0.2"
								From="0.4"
								To="0.9" />
						</Storyboard>
						<Storyboard
							x:Key="ScrollBarFadeOut"
							AutoReverse="False"
							RepeatBehavior="1x">
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								BeginTime="0:0:0"
								Duration="0:0:0.2"
								From="0.9"
								To="0.4" />
						</Storyboard>
					</ResourceDictionary>
				</Style.Resources>
				<Style.Triggers>
					<Trigger
						Property="ScrollBar.Orientation"
						Value="Horizontal">
						<Setter
							Property="Width"
							Value="Auto" />
						<Setter
							Property="Height"
							Value="40" />
						<Setter
							Property="Template"
							Value="{StaticResource HorizontalScrollBar}" />
					</Trigger>
					<Trigger
						Property="ScrollBar.Orientation"
						Value="Vertical">
						<Setter
							Property="Width"
							Value="40" />
						<Setter
							Property="Height"
							Value="Auto" />
						<Setter
							Property="Template"
							Value="{StaticResource VerticalScrollBar}" />
					</Trigger>
					<EventTrigger
						RoutedEvent="GotMouseCapture">
						<BeginStoryboard
							Storyboard="{StaticResource ScrollBarFadeIn}" />
					</EventTrigger>
					<EventTrigger
						RoutedEvent="LostMouseCapture">
						<BeginStoryboard
							Storyboard="{StaticResource ScrollBarFadeOut}" />
					</EventTrigger>
				</Style.Triggers>
			</Style>
			<Style
				TargetType="{x:Type ScrollViewer}"
				x:Key="{x:Type ScrollViewer}">
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ScrollViewer}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition
										Height="Auto" />
								</Grid.RowDefinitions>
								<ScrollContentPresenter
									Grid.RowSpan="2"
									Grid.ColumnSpan="2" />
								<ScrollBar
									Name="PART_VerticalScrollBar"
									Grid.Column="1"
									HorizontalAlignment="Right"
									Value="{TemplateBinding VerticalOffset}"
									Maximum="{TemplateBinding ScrollableHeight}"
									ViewportSize="{TemplateBinding ViewportHeight}"
									Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
								<ScrollBar
									Name="PART_HorizontalScrollBar"
									Orientation="Horizontal"
									Grid.Row="1"
									Grid.Column="1"
									Value="{TemplateBinding HorizontalOffset}"
									Maximum="{TemplateBinding ScrollableWidth}"
									ViewportSize="{TemplateBinding ViewportWidth}"
									Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Style.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type ContextMenu}"
							x:Key="{x:Type ContextMenu}">
							<Setter
								Property="Visibility"
								Value="Collapsed" />
						</Style>
					</ResourceDictionary>
				</Style.Resources>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="GMain"
		Margin="0,0,0,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="66" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid
			Name="GSesoplot"
			Column="1"
			Margin="0,5,5,5"
			Background="#FFFFFFFF">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="379*" />
				<ColumnDefinition
					Width="617*" />
			</Grid.ColumnDefinitions>
			<UserControl
				Name="usercontrolSNRPlot"
				Grid.ColumnSpan="2">
				<sesopl:SesoPlot
					Name="sesoplot"
					Margin="0, 5, 5, 5"
					MinimumY="0"
					MaximumY="200"
					MajorTicksY="10"
					MinorTicksY="2" />
			</UserControl>
			<Grid
				Name="GLegendDualEnergy"
				HorizontalAlignment="Left"
				Visibility="Collapsed"
				Height="40"
				VerticalAlignment="Bottom"
				Margin="2,0,0,0"
				ColumnSpan="2">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
