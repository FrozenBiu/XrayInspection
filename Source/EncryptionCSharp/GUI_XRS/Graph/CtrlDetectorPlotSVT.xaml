<UserControl
	x:Class="GUI_XRS.Graph.CtrlDetectorPlotSVT" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:sesoSVT="clr-namespace:SesoPlot;assembly=Sesoplot"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:graph="clr-namespace:GUI_XRS.Graph"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Loaded="SVTPlot_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="TextBlockStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="Foreground"
					Value="#414141" />
				<Setter
					Property="FontSize"
					Value="14" />
				<Setter
					Property="Margin"
					Value="0 2 0 2" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Visibility"
					Value="{Binding TextBoxVisibility}" />
				<Setter
					Property="MinHeight"
					Value="35" />
				<Setter
					Property="Margin"
					Value="0 2 0 2" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontSize"
					Value="14" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Foreground"
					Value="#ffffff" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="5"
								BorderThickness="1"
								BorderBrush="#d3d6d6">
								<Border.Background>
									<LinearGradientBrush
										StartPoint="0,0"
										EndPoint="0,1">
										<GradientStop
											Offset="0"
											Color="#434343" />
										<GradientStop
											Offset="0.2"
											Color="#585858" />
										<GradientStop
											Offset="1"
											Color="#636666" />
									</LinearGradientBrush>
								</Border.Background>
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				BasedOn="{StaticResource TextBlockStyle}"
				x:Key="TextBlockBoldStyle">
				<Setter
					Property="FontWeight"
					Value="Bold" />
			</Style>
			<Style
				x:Key="okButtonStyle">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="EllipseDarkStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#4a4a4a" />
							<GradientStop
								Offset="0.30"
								Color="#4d4d4d" />
							<GradientStop
								Offset="0.70"
								Color="#2a2a2a" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseStroke"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#98e781" />
							<GradientStop
								Offset="0.60"
								Color="#358a06" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseUpFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#b8e409" />
							<GradientStop
								Offset="1.00"
								Color="#98bd08" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="EllipseDownFill"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="1.00"
								Color="#b8e409" />
							<GradientStop
								Offset="0.00"
								Color="#98bd08" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="45" />
				<Setter
					Property="Width"
					Value="45" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid>
								<Ellipse
									StrokeThickness="3"
									Fill="{StaticResource EllipseDarkStroke}" />
								<Ellipse
									Name="BorderUp"
									Height="40"
									Width="40"
									StrokeThickness="1"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseUpFill}" />
								<Ellipse
									Name="BorderDown"
									Height="40"
									Width="40"
									StrokeThickness="1"
									Opacity="0"
									Stroke="{DynamicResource EllipseStroke}"
									Fill="{DynamicResource EllipseDownFill}" />
								<ContentPresenter
									Name="Contents" />
								<Ellipse
									Fill="#ffffff"
									Opacity="0.07"
									Margin="0 0 0 25" />
							</Grid>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="ButtonDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="ButtonUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="BorderDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="Contents"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="BorderDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="Contents"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource ButtonUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<l:BoolToStringConverter
				x:Key="boolToStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisibilityCollapsedConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="bVisibilityInvertedHiddenConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid
			Visibility="{Binding ParameterAccessible, Converter={StaticResource bVisibilityCollapsedConverter}}">
			<Expander
				ExpandDirection="Right"
				Margin="4 2 2 2">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type Expander}"
							x:Key="{x:Type Expander}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type Expander}">
										<Grid
											MaxWidth="300">
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="Auto" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>
											<ToggleButton
												Name="toggleBtn"
												Style="{StaticResource okButtonStyle}"
												IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
												<ContentControl.ContentTemplate>
													<DataTemplate>
														<Image
															Name="rotateMe"
															Source="../img/arrow.png"
															Stretch="None"
															RenderTransformOrigin="0.5,0.5">
															<UIElement.RenderTransform>
																<RotateTransform />
															</UIElement.RenderTransform>
														</Image>
														<DataTemplate.Triggers>
															<DataTrigger
																Value="True"
																Binding="{Binding ElementName=toggleBtn, Path=IsChecked}">
																<TriggerBase.EnterActions>
																	<BeginStoryboard>
																		<Storyboard>
																			<DoubleAnimation
																				Storyboard.TargetName="rotateMe"
																				Storyboard.TargetProperty="RenderTransform.Angle"
																				To="180"
																				Duration="0:0:0.0" />
																		</Storyboard>
																	</BeginStoryboard>
																</TriggerBase.EnterActions>
																<TriggerBase.ExitActions>
																	<BeginStoryboard>
																		<Storyboard>
																			<DoubleAnimation
																				Storyboard.TargetName="rotateMe"
																				Storyboard.TargetProperty="RenderTransform.Angle"
																				To="0"
																				Duration="0:0:0.0" />
																		</Storyboard>
																	</BeginStoryboard>
																</TriggerBase.ExitActions>
															</DataTrigger>
														</DataTemplate.Triggers>
													</DataTemplate>
												</ContentControl.ContentTemplate>
											</ToggleButton>
											<ContentPresenter
												Name="contentExpander"
												Visibility="Collapsed"
												Grid.Column="1" />
										</Grid>
										<ControlTemplate.Triggers>
											<Trigger
												Property="Expander.IsExpanded"
												Value="False">
												<Setter
													TargetName="contentExpander"
													Property="Visibility"
													Value="Visible" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid
						Row="0"
						Margin="20 20 5 20">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Border
							MinHeight="46"
							Visibility="Visible"
							BorderThickness="1"
							BorderBrush="#9399a0"
							Grid.Row="0">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#e7eaea" />
									<GradientStop
										Offset="1.00"
										Color="#c9cccd" />
								</LinearGradientBrush>
							</Border.Background>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition
										Width="100" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource TextBlockBoldStyle}"
									Text="Number Valves"
									Margin="5 5" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource TextBoxStyle}"
									Width="80"
									Text="{Binding Path=NumberValves}"
									MouseUp="NumberValves_MouseUp" />
							</Grid>
						</Border>
						<Border
							MinHeight="46"
							Visibility="Visible"
							BorderThickness="1"
							BorderBrush="#9399a0"
							Grid.Row="1">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#e7eaea" />
									<GradientStop
										Offset="1.00"
										Color="#c9cccd" />
								</LinearGradientBrush>
							</Border.Background>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition
										Width="100" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Text="Overlapping Right"
									Style="{StaticResource TextBlockBoldStyle}"
									Margin="5 5" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource TextBoxStyle}"
									Width="80"
									Text="{Binding Path=OverlappingRight}"
									MouseUp="OverlappingRight_MouseUp" />
							</Grid>
						</Border>
						<Border
							MinHeight="46"
							Visibility="Visible"
							BorderThickness="1"
							BorderBrush="#9399a0"
							Grid.Row="2">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#e7eaea" />
									<GradientStop
										Offset="1.00"
										Color="#c9cccd" />
								</LinearGradientBrush>
							</Border.Background>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition
										Width="100" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Text="Overlapping Left"
									Style="{StaticResource TextBlockBoldStyle}"
									Margin="5 5" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource TextBoxStyle}"
									Width="80"
									Text="{Binding Path=OverlappingLeft}"
									MouseUp="OverlappingLeft_MouseUp" />
							</Grid>
						</Border>
						<Border
							MinHeight="46"
							Visibility="Visible"
							BorderThickness="1"
							BorderBrush="#9399a0"
							Grid.Row="4">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#e7eaea" />
									<GradientStop
										Offset="1.00"
										Color="#c9cccd" />
								</LinearGradientBrush>
							</Border.Background>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition
										Width="100" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Text="Endpixel Next To Last Valve"
									Style="{StaticResource TextBlockBoldStyle}"
									Margin="5 5" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource TextBoxStyle}"
									Width="80"
									Text="{Binding Path=EndPixelNextToLastFlap}"
									MouseUp="EndPixelLastValve_MouseUp" />
							</Grid>
						</Border>
						<Border
							MinHeight="46"
							Visibility="Visible"
							BorderThickness="1"
							BorderBrush="#9399a0"
							Grid.Row="3">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#e7eaea" />
									<GradientStop
										Offset="1.00"
										Color="#c9cccd" />
								</LinearGradientBrush>
							</Border.Background>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition
										Width="100" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Text="Startpixel Second Valve"
									Style="{StaticResource TextBlockBoldStyle}"
									Margin="10 5" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource TextBoxStyle}"
									Width="80"
									Text="{Binding Path=StartPixelSecondFlap}"
									MouseUp="StartPixelSecondValve_MouseUp" />
							</Grid>
						</Border>
					</Grid>
					<ScrollViewer
						HorizontalScrollBarVisibility="Auto"
						VerticalScrollBarVisibility="Auto"
						Grid.Row="1">
						<l:CtrlParameter
							Name="parameterControl"
							Margin="0,0,0,40"
							IsEnabled="True" />
					</ScrollViewer>
				</Grid>
			</Expander>
		</Grid>
		<Grid
			Name="chartGridSVT"
			Column="1"
			Background="#FFFFFFFF"
			Margin="5">
			<sesoSVT:SesoPlot
				Name="plotSVT"
				Margin="5"
				MajorTicksX="64"
				DrawMinorGridLinesHorizontal="False"
				DrawMinorGridLinesVertical="False"
				MinimumX="-10"
				MaximumYLimit="20000"
				MaximumX="{Binding NPixel}"
				MaximumY="{Binding MaxY, Mode=TwoWay}"
				MajorTicksY="{Binding TicksY}"
				MinorTicksX="{Binding TicksX}"
				ZoomFactorX="{Binding ZoomFactorX, Mode=TwoWay}"
				MaximumXLimit="{Binding NPixel}"
				MinimumY="{Binding MinY, Mode=TwoWay}"
				ZoomModeX="{Binding ZoomMode}">
				<sesoSVT:SesoPlot.Graphs>
					<sesoSVT:Graph
						GraphType="Linear"
						Stroke="#FF008000"
						StrokeThickness="2"
						Points="{Binding PlotPoints}" />
					<sesoSVT:Graph
						GraphType="Bar"
						Stroke="#FF0000FF"
						StrokeThickness="2"
						Points="{Binding ValveLines1}" />
					<sesoSVT:Graph
						GraphType="Linear"
						Stroke="#FF808080"
						StrokeDashArray="2 4"
						StrokeThickness="2"
						Points="{Binding IgnoreLeftPoints}" />
					<sesoSVT:Graph
						GraphType="Linear"
						Stroke="#FF808080"
						StrokeDashArray="2 4"
						StrokeThickness="2"
						Points="{Binding IgnoreRightPoints}" />
					<sesoSVT:Graph
						GraphType="Bar"
						Stroke="#FF0000FF"
						StrokeThickness="1"
						StrokeDashArray="4 4"
						Points="{Binding ValveLines2}" />
				</sesoSVT:SesoPlot.Graphs>
			</sesoSVT:SesoPlot>
			<Grid
				Name="gridDtParameters"
				VerticalAlignment="Top"
				HorizontalAlignment="Stretch"
				Height="100"
				Margin="70 15 0 0"
				Background="#00FFFFFF">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type TextBlock}"
							x:Key="{x:Type TextBlock}">
							<Setter
								Property="FontSize"
								Value="{Binding MachineParametersFontSize}" />
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					TextAlignment="Right"
					Foreground="#FF000000"
					Text="OverlappingLeft = " />
				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Foreground="#FF000000"
					Text="{Binding Path=OverlappingLeft}" />
				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					TextAlignment="Right"
					Foreground="#FF000000"
					Text="OverlappingRight = " />
				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Foreground="#FF000000"
					Text="{Binding Path=OverlappingRight}" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="4"
					TextAlignment="Right"
					Foreground="#FF000000"
					Text="Width = " />
				<TextBlock
					Grid.Row="0"
					Grid.Column="5"
					Foreground="#FF000000"
					Text="{Binding Path=WidthValve}" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="2"
					TextAlignment="Right"
					Foreground="#FF000000"
					Text="IgnoredLeftPixel = " />
				<TextBlock
					Grid.Row="0"
					Grid.Column="3"
					Foreground="#FF000000"
					Text="{Binding Path=IgnoredLeftPixelDB}" />
				<TextBlock
					Grid.Row="1"
					Grid.Column="2"
					TextAlignment="Right"
					Foreground="#FF000000"
					Text="IgnoredRightPixel = " />
				<TextBlock
					Grid.Row="1"
					Grid.Column="3"
					Foreground="#FF000000"
					Text="{Binding Path=IgnoredRightPixelDB}" />
			</Grid>
		</Grid>
	</Grid>
</UserControl>
