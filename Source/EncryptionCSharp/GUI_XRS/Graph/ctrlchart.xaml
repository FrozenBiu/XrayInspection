<UserControl
	x:Class="GUI_XRS.CtrlChart" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:d3="http://research.microsoft.com/DynamicDataDisplay/1.0"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Loaded="CtrlChart_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Pen
				Thickness="2"
				x:Key="GreenPen">
				<Pen.Brush>
					<SolidColorBrush
						Color="Green" />
				</Pen.Brush>
			</Pen>
			<Pen
				Thickness="2"
				x:Key="IgnorePen">
				<Pen.DashStyle>
					<DashStyle
						Dashes="2,8" />
				</Pen.DashStyle>
				<Pen.Brush>
					<SolidColorBrush
						Color="Gray" />
				</Pen.Brush>
			</Pen>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<d3:ChartPlotter
			Name="plotter"
			Margin="10,10,20,10">
			<d3:LineGraph
				LinePen="{StaticResource GreenPen}"
				DataSource="{Binding DateTimeSource}"
				Visibility="{Binding GraphVisible, Converter={StaticResource bVisConverter}}" />
			<d3:LineGraph
				LinePen="{StaticResource GreenPen}"
				DataSource="{Binding IntSource}"
				Visibility="{Binding GraphVisible, Converter={StaticResource bVisConverter}}" />
			<d3:LineGraph
				LinePen="{StaticResource IgnorePen}"
				DataSource="{Binding IgnoreLeftSource}" />
			<d3:LineGraph
				LinePen="{StaticResource IgnorePen}"
				DataSource="{Binding IgnoreRightSource}" />
		</d3:ChartPlotter>
	</Grid>
</UserControl>
