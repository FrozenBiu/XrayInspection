<Window
	x:Class="GUI_XRS.WdAuditRequired" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage"
	WindowStyle="None"
	AllowsTransparency="True"
	ResizeMode="NoResize"
	Background="#00FFFFFF"
	WindowStartupLocation="Manual"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	WindowState="{Binding WState}"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}"
	IsEnabled="{Binding Path=MainEnabled}"
	Closing="Window_Closing">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisCollapsedConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="styleTxt">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="22" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Left" />
				<Setter
					Property="Margin"
					Value="20 10 25 10" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<l:IntToVisibilityConverter
				x:Key="intToVisibilityConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:IntSecondsToMinutesSecondsStringeConverter
				x:Key="intSecondsToMinutesSecondsStringeConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<l:MachineTypeEntryOrHigherGridLengthAuditCheckFixedValueConverter
				x:Key="machineTypeEntryOrHigherGridLengthAuditCheckFixedValueConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="overlay">
		<Grid
			Name="subWindowContent">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding Source={StaticResource MainWindowHeaderHeight}}" />
				<RowDefinition />
				<RowDefinition
					Height="{Binding Source={StaticResource MainWindowFooterHeight}}" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition>
					<ColumnDefinition.Width>
						<MultiBinding
							Converter="{StaticResource machineTypeEntryOrHigherGridLengthAuditCheckFixedValueConverter}">
							<Binding
								Path="MachineType" />
							<Binding
								Source="{StaticResource MainWindowMainMenuWidth}" />
							<Binding
								Path="IsPreAuditMenu" />
						</MultiBinding>
					</ColumnDefinition.Width>
				</ColumnDefinition>
			</Grid.ColumnDefinitions>
			<Border
				Background="#00FFFFFF"
				Grid.Row="2"
				BorderBrush="#8e9192"
				BorderThickness="0,1,0,0"
				DockPanel.Dock="Bottom"
				Height="{Binding Source={StaticResource MainWindowFooterHeight}}">
				<Grid
					Background="#00FFFFFF">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="200" />
						<ColumnDefinition
							Width="200" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Border
						BorderThickness="1 0 1 0"
						Grid.Column="1"
						Padding="10 0 10 0">
						<Border.BorderBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="1,0">
								<GradientStop
									Offset="0.5"
									Color="#8e9192" />
								<GradientStop
									Offset="0.5"
									Color="#e3e7ea" />
								<GradientStop
									Offset="1.0"
									Color="#e3e7ea" />
							</LinearGradientBrush>
						</Border.BorderBrush>
						<Button
							Name="btnChangeUser"
							Margin="0 0 0 0"
							Click="btnChangeUser_Click">
							<StackPanel
								Orientation="Horizontal"
								VerticalAlignment="Center"
								HorizontalAlignment="Center">
								<Image
									Source="../img/changeuser_small.png"
									Stretch="None"
									Margin="0 0 7 0" />
								<TextBlock
									Name="tbUser"
									VerticalAlignment="Center"
									Text="{Binding Path=AccessManager.CurrentUser.Username}" />
							</StackPanel>
						</Button>
					</Border>
					<Border
						Grid.Column="0"
						Style="{StaticResource styleBgLines}"
						Visibility="{Binding UserLogAvailable, Converter={StaticResource bVisCollapsedConverter}}" />
					<Border
						Grid.Column="1"
						Style="{StaticResource styleBgLines}"
						Visibility="{Binding UserLogAvailable, Converter={StaticResource bVisCollapsedConverter}}" />
					<Border
						Grid.Column="2"
						Style="{StaticResource styleBgLines}"
						Visibility="{Binding UserLogAvailable, Converter={StaticResource bVisCollapsedConverter}}" />
					<Border
						Grid.Column="3"
						Style="{StaticResource styleBgLines}"
						Visibility="{Binding UserLogAvailable, Converter={StaticResource bVisCollapsedConverter}}" />
				</Grid>
			</Border>
			<Grid
				Row="1">
				<Border
					BorderBrush="#ffffff"
					BorderThickness="0 1 0 0">
					<Border.Background>
						<LinearGradientBrush
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#d2d2d2" />
							<GradientStop
								Offset="1.00"
								Color="#eceaea" />
						</LinearGradientBrush>
					</Border.Background>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="{Binding ContNumberVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
							<RowDefinition
								Height="{Binding ContNumberVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
							<RowDefinition />
							<RowDefinition
								Height="{Binding RemainingTimeVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
							<RowDefinition />
							<RowDefinition
								MinHeight="83" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="{Binding Path=ImageBoxWidth}" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="{Binding NumbersColumnWidth}" />
						</Grid.ColumnDefinitions>
						<image:XRSImageBox
							Grid.RowSpan="6"
							Image="{Binding Path=DataContext.CurrentImage, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" />
						<Border
							Grid.Row="1"
							Grid.Column="1"
							Grid.RowSpan="5"
							Background="#e7efc5"
							BorderBrush="#b6b6b6"
							BorderThickness="2 2 1 2"
							Margin="2 2 0 2" />
						<Border
							Grid.Row="1"
							Grid.Column="2"
							Grid.RowSpan="5"
							Background="#d1d1d1"
							BorderBrush="#b6b6b6"
							BorderThickness="0 2 2 2"
							Margin="0 2 2 2" />
						<Border
							Grid.Row="2"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							BorderThickness="0 0 0 1"
							Margin="2 0 2 0"
							BorderBrush="#b6b6b6" />
						<Border
							Grid.Row="4"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							BorderThickness="0 0 0 1"
							Margin="2 0 2 0"
							BorderBrush="#b6b6b6" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							TextAlignment="Center"
							FontSize="26"
							Text="{Binding Path=AuditRequired.StrAuditNeeded.LocalizedText, FallbackValue=Audit Check fällig!}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="1"
							Grid.Column="1"
							TextAlignment="Right"
							Text="{Binding Path=StrTarget.LocalizedText, FallbackValue=Vorgabe Anzahl Vernunreinigungen}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="1"
							Grid.Column="2"
							Text="{Binding Path=AuditRequired.NContaminations}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="2"
							Grid.Column="1"
							TextAlignment="Right"
							Text="{Binding Path=StrDetectedContaminations.LocalizedText, FallbackValue=gefundene Verunreinigungen}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="2"
							Grid.Column="2"
							Text="{Binding Path=CurrentImage.ContaminationCount}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="3"
							Grid.Column="1"
							Grid.ColumnSpan="1"
							TextAlignment="Right"
							Text="{Binding Path=StrRemainingProducts.LocalizedText, FallbackValue=Verbleibende Produkte}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="3"
							Grid.Column="2"
							Text="{Binding Path=NRemainingProducts}" />
						<TextBlock
							Margin="20 0 25 0"
							Style="{StaticResource styleTxt}"
							Grid.Column="1"
							Grid.Row="4"
							TextAlignment="Right"
							Visibility="{Binding Path=RemainingTimeVisible, Converter={StaticResource bVisConverter}}"
							Text="{Binding Path=StrRemainingTime.LocalizedText, FallbackValue=Verbleibende Zeit}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="4"
							Grid.Column="2"
							Text="{Binding Path=AuditRequired.RemainingTime, Converter={StaticResource intSecondsToMinutesSecondsStringeConverter}}" />
						<TextBlock
							Margin="20 0 25 0"
							Style="{StaticResource styleTxt}"
							Grid.Column="1"
							Grid.Row="5"
							TextAlignment="Right"
							Text="{Binding Path=StrUserID.LocalizedText, FallbackValue=Benutzer - ID}" />
						<TextBlock
							Style="{StaticResource styleTxt}"
							Grid.Row="5"
							Grid.Column="2"
							Text="{Binding Path=AccessManager.CurrentUser.ID}" />
						<Grid
							Row="6"
							Column="1"
							ColumnSpan="2"
							VerticalAlignment="Bottom"
							Margin="0 3 0 20">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Button
								Grid.Column="0"
								Style="{StaticResource okButtonStyle}"
								Command="{Binding TestOkCommand}"
								Visibility="{Binding Path=CommitSuccessVisible}">
								<Image
									Source="..\img\ok.png"
									Stretch="None" />
							</Button>
							<Button
								Grid.Column="1"
								Style="{StaticResource okButtonStyle}"
								Command="{Binding StartTestCommand}"
								Visibility="{Binding Path=StartTestVisible}">
								<Image
									Source="..\img\ok.png"
									Stretch="None" />
							</Button>
							<Button
								Grid.Column="1"
								Style="{StaticResource cancelButtonStyle}"
								Command="{Binding AbortTestCommand}"
								Visibility="{Binding Path=CancelTestVisible}">
								<Image
									Source="..\img\cancel.png"
									Stretch="None" />
							</Button>
							<Button
								Grid.Column="1"
								Style="{StaticResource cancelButtonStyle}"
								Command="{Binding TestFailedCommand}"
								Visibility="{Binding Path=CommitFailureVisible}">
								<Image
									Source="..\img\cancel.png"
									Stretch="None" />
							</Button>
							<Border
								BorderBrush="#FF808080"
								Grid.Column="3"
								Visibility="{Binding DoorLockAvailable, Converter={StaticResource bVisCollapsedConverter}}">
								<Button
									Name="btnUnlockBin"
									Style="{StaticResource defaultButtonStyle}"
									common:ButtonBehavior.OpenContextMenuWhenClicked="True"
									VerticalAlignment="Top"
									Command="{Binding UnlockBinCommand}">
									<FrameworkElement.ContextMenu>
										<ContextMenu
											Style="{StaticResource messageSystemContextMenuStyle}"
											Margin="0 0 100 50"
											ItemsSource="{Binding Path=UnlockBinItem}"
											Visibility="{Binding Path=ContextUnlockBinVisibility, Converter={StaticResource bVisConverter}}">
											<ItemsControl.ItemContainerStyle>
												<Style
													BasedOn="{StaticResource contextMenuItemStyle}"
													TargetType="{x:Type MenuItem}">
													<Setter
														Property="MenuItem.Command"
														Value="{Binding ClickCmd}" />
													<Setter
														Property="Header"
														Value="{Binding Path=LocalizedText}" />
												</Style>
											</ItemsControl.ItemContainerStyle>
										</ContextMenu>
									</FrameworkElement.ContextMenu>
									<Image
										Source="/img/unlock.png"
										Stretch="Uniform"
										Height="40"
										Width="40"
										VerticalAlignment="Center" />
								</Button>
							</Border>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>
