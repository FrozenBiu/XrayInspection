<UserControl
	x:Class="GUI_XRS.CtrlMoveSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="CtrlMoveSource_Unloaded">
	<Grid
		Margin="50 10 50 10"
		VerticalAlignment="Center"
		HorizontalAlignment="Center">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type TextBlock}"
					x:Key="{x:Type TextBlock}">
					<Setter
						Property="VerticalAlignment"
						Value="Center" />
					<Setter
						Property="FontFamily"
						Value="Arial" />
					<Setter
						Property="FontWeight"
						Value="Bold" />
					<Setter
						Property="FontSize"
						Value="18" />
					<Setter
						Property="Foreground"
						Value="#272727" />
					<Setter
						Property="TextBlock.TextAlignment"
						Value="Center" />
					<Setter
						Property="Margin"
						Value="0 0 0 5" />
					<Setter
						Property="TextWrapping"
						Value="Wrap" />
				</Style>
				<Style
					TargetType="{x:Type TextBox}"
					BasedOn="{StaticResource {x:Type TextBox}}"
					x:Key="TextBoxStyle">
					<Setter
						Property="Margin"
						Value="30 0 30 0" />
				</Style>
				<Style
					TargetType="{x:Type TextBox}"
					BasedOn="{StaticResource {x:Type TextBox}}"
					x:Key="disabledTextBox">
					<Style.Resources>
						<ResourceDictionary>
							<LinearGradientBrush
								x:Key="textBoxBackground"
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0.00"
									Color="#adadad" />
								<GradientStop
									Offset="0.02"
									Color="#bababa" />
								<GradientStop
									Offset="0.03"
									Color="#c7c7c7" />
							</LinearGradientBrush>
							<LinearGradientBrush
								x:Key="textBoxBorder"
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0.01"
									Color="#9f9f9f" />
								<GradientStop
									Offset="0.10"
									Color="#bababa" />
								<GradientStop
									Offset="0.9"
									Color="#bababa" />
								<GradientStop
									Offset="1.00"
									Color="#e6e6e6" />
							</LinearGradientBrush>
						</ResourceDictionary>
					</Style.Resources>
					<Setter
						Property="Margin"
						Value="30 0 30 0" />
				</Style>
				<Style
					TargetType="{x:Type l:RadioButtonExtended}"
					x:Key="{x:Type l:RadioButtonExtended}">
					<Style.Resources>
						<ResourceDictionary>
							<LinearGradientBrush
								x:Key="BorderUpBackground"
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0"
									Color="#828282" />
								<GradientStop
									Offset="0.3"
									Color="#696969" />
								<GradientStop
									Offset="0.5"
									Color="#5f5f5f" />
								<GradientStop
									Offset="1"
									Color="#494949" />
							</LinearGradientBrush>
							<LinearGradientBrush
								x:Key="BorderDownBackground"
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0"
									Color="#494949" />
								<GradientStop
									Offset="0.3"
									Color="#5f5f5f" />
								<GradientStop
									Offset="0.5"
									Color="#696969" />
								<GradientStop
									Offset="1"
									Color="#828282" />
							</LinearGradientBrush>
						</ResourceDictionary>
					</Style.Resources>
					<Setter
						Property="Height"
						Value="50" />
					<Setter
						Property="Width"
						Value="50" />
					<Setter
						Property="Margin"
						Value="0 5 0 5" />
					<Setter
						Property="UIElement.SnapsToDevicePixels"
						Value="True" />
					<Setter
						Property="FrameworkElement.OverridesDefaultStyle"
						Value="True" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type l:RadioButtonExtended}">
								<BulletDecorator
									Background="#00FFFFFF">
									<BulletDecorator.Bullet>
										<Border
											Width="{TemplateBinding Width}"
											Height="{TemplateBinding Height}"
											CornerRadius="3"
											BorderBrush="#4b4b4b"
											BorderThickness="1">
											<Grid>
												<Border
													Name="CheckBoxUp"
													Background="{DynamicResource BorderUpBackground}"
													CornerRadius="2"
													BorderBrush="#c5c5c5"
													BorderThickness="0 1 0 0" />
												<Border
													Name="CheckBoxDown"
													Background="{DynamicResource BorderDownBackground}"
													CornerRadius="2"
													BorderBrush="#9b9b9b"
													BorderThickness="0 1 0 0"
													Opacity="0" />
												<Image
													Name="CheckMarkDisabled"
													Source="..\img\checkmark_disabled.png"
													Stretch="None" />
												<Image
													Name="CheckMarkEnabled"
													Source="..\img\checkmark_enabled.png"
													Stretch="None" />
											</Grid>
										</Border>
									</BulletDecorator.Bullet>
									<ContentPresenter />
								</BulletDecorator>
								<FrameworkTemplate.Resources>
									<ResourceDictionary>
										<Storyboard
											x:Key="CheckBoxDownTimeLine">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="CheckBoxDown"
												Storyboard.TargetProperty="Opacity">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.05"
													Value="1" />
											</DoubleAnimationUsingKeyFrames>
											<ThicknessAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="CheckMarkDisabled"
												Storyboard.TargetProperty="Margin">
												<SplineThicknessKeyFrame
													KeyTime="00:00:00.025"
													Value="4,4,2,2" />
											</ThicknessAnimationUsingKeyFrames>
											<ThicknessAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="CheckMarkEnabled"
												Storyboard.TargetProperty="Margin">
												<SplineThicknessKeyFrame
													KeyTime="00:00:00.025"
													Value="4,4,2,2" />
											</ThicknessAnimationUsingKeyFrames>
										</Storyboard>
										<Storyboard
											x:Key="CheckBoxUpTimeLine">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="CheckBoxDown"
												Storyboard.TargetProperty="Opacity">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.25"
													Value="0" />
											</DoubleAnimationUsingKeyFrames>
											<ThicknessAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="CheckMarkDisabled"
												Storyboard.TargetProperty="Margin">
												<SplineThicknessKeyFrame
													KeyTime="00:00:00.25"
													Value="3,3,3,3" />
											</ThicknessAnimationUsingKeyFrames>
											<ThicknessAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="CheckMarkEnabled"
												Storyboard.TargetProperty="Margin">
												<SplineThicknessKeyFrame
													KeyTime="00:00:00.25"
													Value="3,3,3,3" />
											</ThicknessAnimationUsingKeyFrames>
										</Storyboard>
									</ResourceDictionary>
								</FrameworkTemplate.Resources>
								<ControlTemplate.Triggers>
									<Trigger
										Property="ToggleButton.IsChecked"
										Value="false">
										<Setter
											TargetName="CheckMarkEnabled"
											Property="Visibility"
											Value="Collapsed" />
									</Trigger>
									<Trigger
										Property="ToggleButton.IsChecked"
										Value="true">
										<Setter
											TargetName="CheckMarkDisabled"
											Property="Visibility"
											Value="Collapsed" />
									</Trigger>
									<Trigger
										Property="IsPressed"
										Value="True">
										<Setter
											TargetName="CheckBoxDown"
											Property="UIElement.Opacity"
											Value="1" />
										<Setter
											TargetName="CheckMarkDisabled"
											Property="Margin"
											Value="4,4,2,2" />
										<Setter
											TargetName="CheckMarkEnabled"
											Property="Margin"
											Value="4,4,2,2" />
										<TriggerBase.EnterActions>
											<BeginStoryboard
												Storyboard="{StaticResource CheckBoxDownTimeLine}" />
										</TriggerBase.EnterActions>
										<TriggerBase.ExitActions>
											<BeginStoryboard
												Storyboard="{StaticResource CheckBoxUpTimeLine}" />
										</TriggerBase.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
				<l:BoolToTextBoxStyleConverter2
					x:Key="bTextBoxStyleConverter" />
				<l:HalfOfIntConverter
					x:Key="halfOfIntConverter" />
				<l:PointCollectionConverter
					x:Key="pointCollectionConverter" />
				<l:ProductHeightLabelMarginConverter
					x:Key="productHeightLabelMarginConverter" />
				<l:LengthPrecisionConverter
					x:Key="lengthPrecisionConverter" />
				<l:BoolToVisibilityCollapsedConverter
					x:Key="bVisConverter" />
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				Width="200" />
			<ColumnDefinition
				Width="150" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="220" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="80" />
			</Grid.RowDefinitions>
			<StackPanel
				VerticalAlignment="Center"
				Margin="0 0 0 0">
				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Orientation="Horizontal">
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="20 0 0 0">
						<TextBlock
							HorizontalAlignment="Center"
							Text="{Binding StrProductHeight.LocalizedText, FallbackValue=Product height}" /> ( <TextBlock
							Text="{Binding Path=LengthAbbr, FallbackValue=mm}" /> <TextBlock
							Text=")"
							Margin="0 0 20 0" /></TextBlock>
				</StackPanel>
				<TextBox
					VerticalAlignment="Center"
					IsEnabled="{Binding Path=WritableHeight}"
					common:MouseCommandBehavior.MouseUpCommand="{Binding SetProductHeightCommand}">
					<FrameworkElement.Style>
						<MultiBinding
							Converter="{StaticResource bTextBoxStyleConverter}">
							<MultiBinding.Bindings>
								<Binding
									RelativeSource="{RelativeSource Self}" />
								<Binding
									Path="WritableHeight" />
							</MultiBinding.Bindings>
						</MultiBinding>
					</FrameworkElement.Style>
					<TextBox.Text>
						<MultiBinding
							Converter="{StaticResource lengthPrecisionConverter}">
							<Binding
								Path="ProductHeight"
								Mode="OneWay"
								UpdateSourceTrigger="PropertyChanged" />
							<Binding
								Path="LengthMetric" />
						</MultiBinding>
					</TextBox.Text>
				</TextBox>
			</StackPanel>
			<l:CtrlBar
				Name="bar"
				Grid.Column="1"
				VerticalAlignment="Bottom"
				Margin="0 0 60 26" />
			<StackPanel
				Grid.Row="1"
				Grid.Column="0"
				Orientation="Horizontal"
				HorizontalAlignment="Center"
				Visibility="{Binding LengthUnitEnabled, Converter={StaticResource bVisConverter}}">
				<TextBlock
					Margin="0 0 10 0"
					Text="mm" />
				<l:RadioButtonExtended
					GroupName="rbLengthUnit"
					IsCheckedReal="{Binding Path=LengthMetric, Mode=TwoWay}" />
			</StackPanel>
			<StackPanel
				Grid.Row="1"
				Grid.Column="1"
				Orientation="Horizontal"
				HorizontalAlignment="Center"
				Visibility="{Binding LengthUnitEnabled, Converter={StaticResource bVisConverter}}">
				<TextBlock
					Margin="0 0 10 0"
					Text="in" />
				<l:RadioButtonExtended
					Margin="0 0 20 0"
					GroupName="rbLengthUnit"
					IsCheckedReal="{Binding Path=LengthAmerican, Mode=OneWay}" />
			</StackPanel>
		</Grid>
		<Rectangle
			Grid.Column="1"
			Height="400"
			Width="200"
			Stroke="#FF000000"
			VerticalAlignment="Bottom" />
		<Rectangle
			RadiusX="5"
			RadiusY="5"
			Grid.Column="1"
			Width="50"
			VerticalAlignment="Bottom"
			Margin="0 0 0 110"
			Height="{Binding ProductHeightInScreenPx, FallbackValue=50}">
			<Shape.Fill>
				<LinearGradientBrush>
					<GradientStop
						Offset="0.0"
						Color="Gray" />
					<GradientStop
						Offset="1.0"
						Color="DarkGray" />
				</LinearGradientBrush>
			</Shape.Fill>
		</Rectangle>
		<Rectangle
			Grid.Column="1"
			Height="20"
			Width="110"
			Margin="0 0 0 90"
			VerticalAlignment="Bottom">
			<Shape.Fill>
				<LinearGradientBrush
					StartPoint="0.5,0"
					EndPoint="0.5,1">
					<GradientStop
						Color="White"
						Offset="1.0" />
					<GradientStop
						Color="#FFE3E3E3"
						Offset="0.0" />
				</LinearGradientBrush>
			</Shape.Fill>
		</Rectangle>
		<Image
			Grid.Column="2"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Left"
			Source="..\img\xraySsh.png"
			Height="20"
			Margin="{Binding XRayMargin, FallbackValue=100 0 0 150}" />
		<Polygon
			VerticalAlignment="Bottom"
			Grid.Column="2"
			Margin="100 0 0 0"
			Fill="#4000FF00"
			Points="{Binding TrianglePoints, Converter={StaticResource pointCollectionConverter}}" />
	</Grid>
</UserControl>
