<UserControl
	x:Class="GUI_XRS.CtrlBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<LinearGradientBrush
				StartPoint="0, 0"
				EndPoint="1, 1"
				x:Key="GrayToHalfTransparentBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FF7F7F7F"
							Offset="0.0" />
						<GradientStop
							Color="#7F7F7F7F"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="boolVisibilityCollapsedConverter" />
			<l:BarItemBorderThicknessConverter
				x:Key="barItemBorderThicknessConverter" />
			<l:BarItemMarkerLengthConverter
				x:Key="barItemMarkerLengthConverter" />
			<l:BarItemActiveBrushConverter
				x:Key="barItemActiveBrushConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		SnapsToDevicePixels="True"
		Margin="0 5 0 5">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="25" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Canvas
			Name="cnvNumbers" />
		<Rectangle
			Grid.Column="1"
			Stroke="#FF000000"
			StrokeThickness="1"
			Width="25"
			HorizontalAlignment="Right" />
		<ItemsControl
			Grid.Column="1"
			HorizontalAlignment="Right"
			Margin="0 1 0 1"
			ItemsSource="{Binding BarItems}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="{Binding ItemHeight, FallbackValue=5.2}" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="6" />
							<ColumnDefinition
								Width="24" />
						</Grid.ColumnDefinitions>
						<Rectangle
							Grid.Column="0"
							Stroke="#FF000000"
							StrokeThickness="1"
							Height="1"
							VerticalAlignment="Top"
							HorizontalAlignment="Right"
							Margin="0 0 1 0"
							Width="{Binding Path=., Converter={StaticResource barItemMarkerLengthConverter}}"
							Visibility="{Binding IsMarker, Converter={StaticResource boolVisibilityCollapsedConverter}}" />
						<Rectangle
							Grid.Column="1"
							StrokeThickness="0"
							Margin="0 0 1 0"
							Height="{Binding ItemHeight, FallbackValue=5.2}"
							Fill="{Binding Active, Converter={StaticResource barItemActiveBrushConverter}}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
