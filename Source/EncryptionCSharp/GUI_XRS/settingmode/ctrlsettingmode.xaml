<UserControl
	x:Class="GUI_XRS.CtrlSettingMode" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<l:BoolGridLengthAutoConverter
				x:Key="boolGridLengthAutoConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:SpeedInMPerSecLocalizedStringConverter
				x:Key="speedInMPerSecLocalizedStringConverter" />
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxDisabledStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="5"
								BorderThickness="1"
								Background="#00FFFFFF">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="0" />
			</Style>
			<Style
				TargetType="{x:Type Label}"
				x:Key="{x:Type Label}">
				<Setter
					Property="Background"
					Value="#aa999999" />
				<Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="20" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="BorderThickness"
					Value="0 1 0 0" />
				<Setter
					Property="BorderBrush"
					Value="#b6b6b6" />
				<Setter
					Property="Padding"
					Value="10 3 3 3" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<ScrollViewer>
		<Grid
			Margin="0 5 0 5"
			Background="#00FFFFFF">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Label
				Content="{Binding StrConveyor.LocalizedText}" />
			<Grid
				Row="1"
				Background="#aad1d1d1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="5*" />
					<ColumnDefinition
						Width="4*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="3"
					Background="#aae7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=ConveyorViewModel.StrConveyorSpeed.LocalizedText, FallbackValue=Förderbandgeschwindigkeit}" /> (<TextBlock
						Text="{Binding Path=ConveyorViewModel.SpeedAbbr, FallbackValue=m / s}" /><TextBlock
						Text=")"
						Margin="0 0 20 0" /></TextBlock>
				<Grid
					Row="0"
					Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button
						Grid.Column="0"
						Margin="5 20 5 20"
						Width="50"
						Height="50"
						Command="{Binding ConveyorViewModel.LowerSpeedCommand}"
						Visibility="{Binding ConveyorViewModel.SpeedEnabled, Converter={StaticResource bVisConverter}}">
						<Image
							Source="/img/minus2.png" />
					</Button>
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Margin="0 20 0 20"
						IsEnabled="{Binding Path=ConveyorViewModel.SpeedEnabled}"
						common:MouseCommandBehavior.MouseUpCommand="{Binding ConveyorViewModel.ChangeSpeedCommand}">
						<TextBox.Text>
							<MultiBinding
								Converter="{StaticResource speedInMPerSecLocalizedStringConverter}">
								<Binding
									Path="ConveyorViewModel.Conveyor.Speed"
									Mode="TwoWay"
									UpdateSourceTrigger="PropertyChanged" />
								<Binding
									Path="ConveyorViewModel.SpeedMetric" />
							</MultiBinding>
						</TextBox.Text>
						<FrameworkElement.Style>
							<MultiBinding
								Converter="{StaticResource bTextBoxStyleConverter}">
								<MultiBinding.Bindings>
									<Binding
										RelativeSource="{RelativeSource Self}" />
									<Binding
										Path="ConveyorViewModel.SpeedEnabled" />
								</MultiBinding.Bindings>
							</MultiBinding>
						</FrameworkElement.Style>
					</TextBox>
					<Button
						Grid.Column="2"
						Margin="5 20 5 20"
						Width="50"
						Height="50"
						Command="{Binding ConveyorViewModel.HigherSpeedCommand}"
						Visibility="{Binding ConveyorViewModel.SpeedEnabled, Converter={StaticResource bVisConverter}}">
						<Image
							Source="/img/plus2.png" />
					</Button>
				</Grid>
				<Border
					Background="#5f000000"
					Grid.Row="0"
					Grid.ColumnSpan="2"
					Visibility="{Binding ConveyorViewModel.MachineCalibrating, FallbackValue=Collapsed, Converter={StaticResource bVisConverter}}" />
				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="20 0 25 0"
					Text="{Binding Path=VibroViewModel.StrVibroInManualMode.LocalizedText, FallbackValue=Manueller Modus}" />
				<CheckBox
					Grid.Row="1"
					Grid.Column="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsChecked="{Binding Path=ConveyorViewModel.Conveyor.InManualMode}" />
			</Grid>
		</Grid>
	</ScrollViewer>
</UserControl>
