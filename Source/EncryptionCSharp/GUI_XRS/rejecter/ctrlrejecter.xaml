													HorizontalAlignment="Right"
													Margin="0 0 45 0"
													Text="{Binding StrAboveMaxImageSize.LocalizedText, FallbackValue=Above max. image size}" />
												<CheckBox
													Grid.Row="5"
													Grid.Column="1"
													HorizontalAlignment="Left"
													Margin="-25 10 0 10"
													IsChecked="{Binding OversizeEnabled}" />
												<TextBlock
													Grid.Row="6"
													Grid.Column="0"
													Style="{StaticResource tbStyle}"
													MaxWidth="{StaticResource maxTxtTypeWidth}"
													FontSize="16"
													HorizontalAlignment="Right"
													Margin="0 0 45 0"
													Text="{Binding StrBelowMinImageSize.LocalizedText, FallbackValue=Below min. image size}" />
												<CheckBox
													Grid.Row="6"
													Grid.Column="1"
													HorizontalAlignment="Left"
													Margin="-25 10 0 10"
													IsChecked="{Binding UndersizeEnabled}" />
											</Grid>
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="3"
												Grid.Column="0"
												Text="{Binding Path=StrPriority.LocalizedText, FallbackValue=Priorität}"
												Visibility="{Binding PriorityVisible, Converter={StaticResource bVisConverter}}" />
											<ComboBox
												Grid.Row="3"
												Grid.Column="1"
												HorizontalContentAlignment="Right"
												Margin="65 20 65 20"
												ScrollViewer.PanningMode="None"
												ItemsSource="{Binding Source={StaticResource Priorities}, Converter={StaticResource rejectPrioritiesStringConverter}}"
												SelectedItem="{Binding Path=Priority, Mode=TwoWay, Converter={StaticResource rejectPriorityStringConverter}}"
												Visibility="{Binding PriorityVisible, Converter={StaticResource bVisConverter}}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="4"
												Grid.Column="0"
												Text="{Binding Path=StrBinFullTimeout.LocalizedText, FallbackValue=Timeout Behälter voll}" />
