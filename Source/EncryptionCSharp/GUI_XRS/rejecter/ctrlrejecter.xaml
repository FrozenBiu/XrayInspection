												Grid.Row="5"
												Grid.Column="1"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												IsChecked="{Binding Path=BeltStopOnContaminant}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="6"
												Grid.Column="0"
												Text="{Binding Path=StrProductSubGroup.LocalizedText, FallbackValue=Sub - Produktgruppe}" />
