												Grid.Row="6"
												Grid.Column="1"
												HorizontalContentAlignment="Right"
												Margin="65 20 65 20"
												ScrollViewer.PanningMode="None"
												ItemsSource="{Binding Path=ImageGroups, Converter={StaticResource imageGroupsStringConverter}}"
												SelectedItem="{Binding Path=ImageGroup, Mode=TwoWay, Converter={StaticResource imageGroupStringConverter}}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="7"
												Grid.Column="0"
												Text="{Binding Path=StrMode.LocalizedText, FallbackValue=Modus}" />
											<ComboBox
												Grid.Row="7"
												Grid.Column="1"
												HorizontalContentAlignment="Right"
												Margin="65 20 65 20"
												ScrollViewer.PanningMode="None"
												ItemsSource="{Binding Path=Modes, Converter={StaticResource rejectModesStringConverter}}"
												SelectedItem="{Binding Path=Mode, Mode=TwoWay, Converter={StaticResource rejectModeStringConverter}}"
												IsEnabled="{Binding ObjectBasedFlapsVisible, Converter={StaticResource InverseBoolConverter}}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="9"
												Grid.Column="0"
												Text="{Binding StrRejectVerifyEnabled.LocalizedText, FallbackValue=Auswurfüberwachung ein}" />
											<CheckBox
												Grid.Row="9"
												Grid.Column="1"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												IsChecked="{Binding Path=VerifyEnable}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="10"
												Grid.Column="0"
												Text="{Binding StrRejectVerifyLearn.LocalizedText, FallbackValue=Auswurfüberwachung lernen}" />
											<Button
												Name="btnVerifyLearn"
												Grid.Row="10"
												Grid.Column="1"
												Style="{StaticResource defaultButtonStyle}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0 10 0 10"
												Command="{Binding VerifyLearnCommand}">
												<UIElement.IsEnabled>
													<MultiBinding
														Converter="{StaticResource verifyTestMachineStatesBoolConverter}">
														<Binding
															Path="MachineState.State" />
														<Binding
															Path="DemoMode" />
														<Binding
															Path="VerifyEnable" />
													</MultiBinding>
												</UIElement.IsEnabled>
												<Grid>
													<Image
														Source="..\img\learn_enabled.png"
														Stretch="None"
														Visibility="{Binding ElementName=btnVerifyLearn, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
													<Image
														Source="..\img\learn_disabled.png"
														Stretch="None"
														Visibility="{Binding ElementName=btnVerifyLearn, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
												</Grid>
											</Button>
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="11"
												Grid.Column="0"
												Text="{Binding StrRejectVerifyTest.LocalizedText, FallbackValue=Auswurfüberwachung testen}" />
											<Button
												Name="btnVerifyTest"
												Grid.Row="11"
												Grid.Column="1"
												Style="{StaticResource defaultButtonStyle}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0 10 0 10"
												Command="{Binding VerifyTestCommand}">
												<UIElement.IsEnabled>
													<MultiBinding
														Converter="{StaticResource verifyTestMachineStatesBoolConverter}">
														<Binding
															Path="MachineState.State" />
														<Binding
															Path="DemoMode" />
														<Binding
															Path="VerifyEnable" />
													</MultiBinding>
												</UIElement.IsEnabled>
												<Grid>
													<Image
														Source="..\img\play_bright_small.png"
														Stretch="None"
														Visibility="{Binding ElementName=btnVerifyTest, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
													<Image
														Source="..\img\play_bright_small_disabled.png"
														Stretch="None"
														Visibility="{Binding ElementName=btnVerifyTest, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
												</Grid>
											</Button>
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="12"
												Grid.Column="0"
												Text="{Binding Path=StrRejectVerifySensorBlockedTimeout.LocalizedText, FallbackValue=Timeout Sensor Auswurfüberwachung blockiert (in ms)}" />
											<!--Unknown connection ID: 6-->
											<TextBox
												Grid.Row="12"
												Grid.Column="1"
												Margin="65 20 65 20"
												Text="{Binding Path=RejectVerifySensorBlockedTimeout}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="14"
												Grid.Column="0"
												Text="{Binding StrTrainInOutDelay.LocalizedText, FallbackValue=Train in-out delay}" />
											<Button
												Grid.Row="14"
												Grid.Column="1"
												Style="{StaticResource defaultButtonStyle}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0 10 0 10"
												Command="{Binding MSLearnCommand}">
												<Image
													Source="..\img\learn.png"
													Stretch="Uniform"
													Height="40"
													Width="40" />
											</Button>
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="15"
												Grid.Column="0"
												Text="{Binding StrDebounceTime.LocalizedText, FallbackValue=Debounce time}" />
											<!--Unknown connection ID: 7-->
											<TextBox
												Grid.Row="15"
												Grid.Column="1"
												Margin="65 20 65 20"
												Text="{Binding Path=DebounceTime}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="17"
												Grid.Column="0"
												Text="{Binding StrEncoderCorrectionTime.LocalizedText, FallbackValue=Encoder function correction time (in ms)}" />
											<!--Unknown connection ID: 8-->
											<TextBox
												Grid.Row="17"
												Grid.Column="1"
												Margin="65 20 65 20"
												Text="{Binding Path=CorrectionTime}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="19"
												Grid.Column="0"
												Text="{Binding StrUnlockBin.LocalizedText, FallbackValue=Unlock bin}" />
											<Button
												Grid.Row="19"
												Grid.Column="1"
												Style="{StaticResource defaultButtonStyle}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0 10 0 10"
												Command="{Binding UnlockBinCommand}">
												<Image
													Source="..\img\unlock.png"
													Stretch="Uniform"
													Height="40"
													Width="40" />
											</Button>
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="20"
												Grid.Column="0"
												Text="{Binding StrUnlockBinTimeout.LocalizedText, FallbackValue=Timeout unlock bin (in s)}" />
											<!--Unknown connection ID: 9-->
											<TextBox
												Grid.Row="20"
												Grid.Column="1"
												Margin="65 20 65 20"
												Text="{Binding Path=BinUnlockTimeout}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="22"
												Grid.Column="0"
												Text="{Binding StrTestAirPressureMonitoing.LocalizedText, FallbackValue=Luftdrucküberwachung testen}" />
											<Button
												Name="btnTestAirPressure"
												Grid.Row="22"
												Grid.Column="1"
												Style="{StaticResource defaultButtonStyle}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0 10 0 10"
												Command="{Binding TestAirPressureMonitoringCommand}">
												<UIElement.IsEnabled>
													<MultiBinding
														Converter="{StaticResource autolearnMachineStatesBoolConverter}">
														<Binding
															Path="MachineState.State" />
														<Binding
															Path="DemoMode" />
													</MultiBinding>
												</UIElement.IsEnabled>
												<Grid>
													<Image
														Source="..\img\play_bright_small.png"
														Stretch="None"
														Visibility="{Binding ElementName=btnTestAirPressure, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
													<Image
														Source="..\img\play_bright_small_disabled.png"
														Stretch="None"
														Visibility="{Binding ElementName=btnTestAirPressure, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
												</Grid>
											</Button>
										</Grid>
									</Grid>
								</Border>
							</DataTemplate>
						</TabControl.ContentTemplate>
					</TabControl>
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
