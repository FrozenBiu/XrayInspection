											<TextBox
												Grid.Row="4"
												Grid.Column="1"
												Margin="65 20 65 20"
												Text="{Binding Path=BinFullTimeout}" />
											<TextBlock
												Style="{StaticResource tbStyle}"
												Grid.Row="5"
												Grid.Column="0"
												Text="{Binding StrBeltStopOnContaminant.LocalizedText, FallbackValue=Förderbandstopp bei Verunreinigung}" />
