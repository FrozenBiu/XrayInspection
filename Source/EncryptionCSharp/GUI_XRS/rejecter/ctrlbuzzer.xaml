<UserControl
	x:Class="GUI_XRS.CtrlBuzzer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="tbStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 20 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<TabControl
			SelectedIndex="0"
			ItemsSource="{Binding Buzzers}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<TextBlock
						Style="{StaticResource tbStyle}"
						FontSize="14"
						Margin="1 1 1 1">
						<TextBlock
							Text="{Binding StrBuzzer.LocalizedText, FallbackValue=Hupe}" />
					</TextBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
			<TabControl.ContentTemplate>
				<DataTemplate>
					<Border
						Grid.Row="0"
						BorderBrush="#a8a8a8"
						BorderThickness="1"
						Background="#d1d1d1"
						Margin="0 0 0 0">
						<ScrollViewer
							HorizontalScrollBarVisibility="Disabled">
							<Grid>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="2*" />
										<ColumnDefinition
											Width="3*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition
											Height="20" />
										<RowDefinition />
									</Grid.RowDefinitions>
									<Border
										Grid.Row="0"
										Grid.Column="0"
										Grid.RowSpan="3"
										Background="#e7efc5"
										BorderBrush="#b6b6b6"
										BorderThickness="0 0 1 0" />
									<Border
										Grid.Row="0"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										BorderBrush="#b6b6b6"
										BorderThickness="0 0 0 1" />
									<Border
										Grid.Row="1"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										BorderBrush="#b6b6b6"
										BorderThickness="0 0 0 1" />
									<Border
										Grid.Row="2"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										BorderBrush="#b6b6b6"
										BorderThickness="0 0 0 1" />
									<Border
										Grid.Row="4"
										Grid.Column="0"
										Grid.RowSpan="1"
										Background="#e7efc5"
										BorderBrush="#b6b6b6"
										BorderThickness="0 0 1 0" />
									<Border
										Grid.Row="4"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										BorderBrush="#b6b6b6"
										BorderThickness="0 1 0 1" />
									<TextBlock
										Style="{StaticResource tbStyle}"
										Grid.Row="0"
										Grid.Column="0"
										Text="{Binding StrBuzzerEnabled.LocalizedText, FallbackValue=Hupe ein}" />
									<CheckBox
										Grid.Row="0"
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										IsChecked="{Binding Path=Enable}" />
									<TextBlock
										Style="{StaticResource tbStyle}"
										Grid.Row="1"
										Grid.Column="0"
										Text="{Binding Path=StrLength.LocalizedText, FallbackValue=Einschaltdauer}" />
									<!--Unknown connection ID: 1-->
									<TextBox
										Grid.Row="1"
										Grid.Column="1"
										Margin="65 20 65 20"
										Text="{Binding Path=Length}" />
									<TextBlock
										Style="{StaticResource tbStyle}"
										Grid.Row="2"
										Grid.Column="0"
										Text="{Binding Path=StrDelay.LocalizedText, FallbackValue=Verzögerung}" />
									<!--Unknown connection ID: 2-->
									<TextBox
										Grid.Row="2"
										Grid.Column="1"
										Margin="65 20 65 20"
										Text="{Binding Path=Delay}" />
									<TextBlock
										Style="{StaticResource tbStyle}"
										Grid.Row="4"
										Grid.Column="0"
										Text="{Binding Path=StrTurnOnBuzzerIfError.LocalizedText, FallbackValue=Bei Fehler}" />
									<CheckBox
										Grid.Row="4"
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										IsChecked="{Binding Path=TurnOnIfError}" />
								</Grid>
							</Grid>
						</ScrollViewer>
					</Border>
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>
	</Grid>
</UserControl>
