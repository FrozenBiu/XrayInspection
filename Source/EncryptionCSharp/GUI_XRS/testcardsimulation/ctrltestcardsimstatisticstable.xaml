<UserControl
	x:Class="GUI_XRS.CtrlTestcardSimStatisticsTable" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type tk:DataGridColumnHeader}"
				x:Key="{x:Type tk:DataGridColumnHeader}">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Setter
					Property="Foreground"
					Value="#FFFFFFFF" />
				<Setter
					Property="Background"
					Value="#FF9ACD32" />
				<Setter
					Property="Padding"
					Value="1 1 1 1" />
			</Style>
			<Style
				TargetType="{x:Type tk:DataGridCell}"
				x:Key="{x:Type tk:DataGridCell}">
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type tk:DataGridCell}">
							<Grid
								Background="{TemplateBinding Background}">
								<ContentPresenter
									VerticalAlignment="Center"
									HorizontalAlignment="Center" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Style.Triggers>
					<Trigger
						Property="tk:DataGridCell.IsSelected"
						Value="True">
						<Setter
							Property="Foreground"
							Value="#FFF0F8FF" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="30" />
				<RowDefinition
					Height="9*" />
				<RowDefinition
					Height="30" />
				<RowDefinition
					Height="9*" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Margin="13,0,0,0"
				FontWeight="Bold"
				FontSize="24"
				Text="{Binding Path=StrVA.LocalizedText, FallbackValue=VA}" />
			<tk:DataGrid
				Name="vasensDataGrid"
				Grid.Row="1"
				IsReadOnly="True"
				Margin="13,0,0,0"
				Background="#FFFFFFFF"
				HorizontalAlignment="Left"
				HeadersVisibility="Column"
				FontSize="16"
				Width="1250"
				AutoGenerateColumns="False"
				CanUserAddRows="False"
				CanUserResizeColumns="False"
				CanUserResizeRows="False"
				BorderBrush="#FFA9A9A9"
				BorderThickness="1.5 1.5 1.5 1.5">
				<tk:DataGrid.Columns>
					<tk:DataGridTextColumn
						Header="Nr"
						Width="45"
						Binding="{Binding Nr}" />
					<tk:DataGridTextColumn
						Header="ImageName"
						Width="230"
						Binding="{Binding ImageName}" />
					<tk:DataGridTextColumn
						Header="0.3"
						Width="1*"
						Binding="{Binding VA0_3}" />
					<tk:DataGridTextColumn
						Header="0.4"
						Width="1*"
						Binding="{Binding VA0_4}" />
					<tk:DataGridTextColumn
						Header="0.5"
						Width="1*"
						Binding="{Binding VA0_5}" />
					<tk:DataGridTextColumn
						Header="0.6"
						Width="1*"
						Binding="{Binding VA0_6}" />
					<tk:DataGridTextColumn
						Header="0.8"
						Width="1*"
						Binding="{Binding VA0_8}" />
					<tk:DataGridTextColumn
						Header="1.0"
						Width="1*"
						Binding="{Binding VA1_0}" />
					<tk:DataGridTextColumn
						Header="1.2"
						Width="1*"
						Binding="{Binding VA1_2}" />
					<tk:DataGridTextColumn
						Header="1.6"
						Width="1*"
						Binding="{Binding VA1_6}" />
					<tk:DataGridTextColumn
						Header="1.8"
						Width="1*"
						Binding="{Binding VA1_8}" />
				</tk:DataGrid.Columns>
			</tk:DataGrid>
			<TextBlock
				Grid.Row="2"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Margin="13,0,0,0"
				FontWeight="Bold"
				FontSize="24"
				Text="{Binding Path=StrGlass.LocalizedText, FallbackValue=Glas}" />
			<tk:DataGrid
				Name="glasssensDataGrid"
				Grid.Row="3"
				IsReadOnly="True"
				Margin="13,0,0,0"
				Background="#FFFFFFFF"
				HorizontalAlignment="Left"
				HeadersVisibility="Column"
				FontSize="16"
				Width="1250"
				AutoGenerateColumns="False"
				CanUserAddRows="False"
				CanUserResizeColumns="False"
				CanUserResizeRows="False"
				BorderBrush="#FFA9A9A9"
				BorderThickness="1.5 1.5 1.5 1.5">
				<tk:DataGrid.Columns>
					<tk:DataGridTextColumn
						Header="Nr"
						Width="45"
						Binding="{Binding Nr}" />
					<tk:DataGridTextColumn
						Header="ImageName"
						Width="230"
						Binding="{Binding ImageName}" />
					<tk:DataGridTextColumn
						Header="0.6"
						Width="1*"
						Binding="{Binding GL0_6}" />
					<tk:DataGridTextColumn
						Header="0.8"
						Width="1*"
						Binding="{Binding GL0_8}" />
					<tk:DataGridTextColumn
						Header="1.0"
						Width="1*"
						Binding="{Binding GL1_0}" />
					<tk:DataGridTextColumn
						Header="1.2"
						Width="1*"
						Binding="{Binding GL1_2}" />
					<tk:DataGridTextColumn
						Header="1.5"
						Width="1*"
						Binding="{Binding GL1_5}" />
					<tk:DataGridTextColumn
						Header="2.0"
						Width="1*"
						Binding="{Binding GL2_0}" />
					<tk:DataGridTextColumn
						Header=" 2.5"
						Width="1*"
						Binding="{Binding GL2_5}" />
					<tk:DataGridTextColumn
						Header="3.0"
						Width="1*"
						Binding="{Binding GL3_0}" />
					<tk:DataGridTextColumn
						Header="3.5"
						Width="1*"
						Binding="{Binding GL3_5}" />
					<tk:DataGridTextColumn
						Header="4.0"
						Width="1*"
						Binding="{Binding GL4_0}" />
					<tk:DataGridTextColumn
						Header="6.0"
						Width="1*"
						Binding="{Binding GL6_0}" />
					<tk:DataGridTextColumn
						Header="7.0"
						Width="1*"
						Binding="{Binding GL7_0}" />
					<tk:DataGridTextColumn
						Header="8.0"
						Width="1*"
						Binding="{Binding GL8_0}" />
					<tk:DataGridTextColumn
						Header="9.0"
						Width="1*"
						Binding="{Binding GL9_0}" />
					<tk:DataGridTextColumn
						Header="10.0"
						Width="1*"
						Binding="{Binding GL10_0}" />
				</tk:DataGrid.Columns>
			</tk:DataGrid>
		</Grid>
	</Grid>
</UserControl>
