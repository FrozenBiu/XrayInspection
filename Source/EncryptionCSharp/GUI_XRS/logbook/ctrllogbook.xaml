<UserControl
	x:Class="GUI_XRS.CtrlLogbook" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<StackPanel
											Orientation="Vertical"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Left" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
			</Style>
			<l:DateTimeToStringConverter
				x:Key="dateTimeToStringConverter" />
			<l:KeyToLocalizedStringConverter
				x:Key="keyToLocalizedStringConverter" />
			<l:StringToVisibilityConverter
				x:Key="stringToVisibilityConverter" />
			<l:MessageTypeToBrushConverter
				x:Key="messageTypeToBrushConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Border
			Padding="5 7 5 7"
			Margin="0 5 0 5"
			BorderBrush="#8e9192"
			BorderThickness="1">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="50" />
					<RowDefinition />
					<RowDefinition
						Height="50" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<RepeatButton
					Grid.Row="0"
					Grid.Column="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 5 0 0"
					Command="{Binding PreviousItemCommand}">
					<Image
						Source="..\img\arrow-up.png"
						Stretch="None" />
				</RepeatButton>
				<Button
					Grid.Row="0"
					Grid.Column="1"
					Style="{StaticResource btnMainMenu}"
					Margin="0 5 0 0"
					Command="{Binding FirstItemCommand}">
					<Image
						Source="..\img\arrow2-up.png"
						Stretch="None" />
				</Button>
				<ListBox
					Grid.Row="1"
					Grid.ColumnSpan="2"
					ItemsSource="{Binding Path=Logbook.ShownLogbookEntries, Mode=OneTime}"
					SelectedItem="{Binding Path=SelectedEntry}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid
								Background="{Binding Path=Type, Converter={StaticResource messageTypeToBrushConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto"
										MinWidth="50" />
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<TextBlock
									Style="{StaticResource txtStyle}"
									Grid.Column="0"
									Margin="3 3 5 3"
									Text="{Binding ID}" />
								<TextBlock
									Style="{StaticResource txtStyle}"
									Grid.Column="1"
									Margin="3 3 5 3"
									Text="{Binding Path=EntryTime, Converter={StaticResource dateTimeToStringConverter}}" />
								<TextBlock
									Grid.Column="2"
									Style="{StaticResource txtStyle}"
									Text="{Binding LogbookText}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}">
							<Setter
								Property="common:ListBoxItemBehavior.IsBroughtIntoViewWhenSelected"
								Value="True" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ListBoxItem}">
										<Border
											Name="Border"
											Padding="2"
											SnapsToDevicePixels="True">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger
												Property="ListBoxItem.IsSelected"
												Value="True">
												<Setter
													TargetName="Border"
													Property="Background"
													Value="#FF000000" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ItemsControl.ItemContainerStyle>
				</ListBox>
				<RepeatButton
					Grid.Row="2"
					Grid.Column="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 0 5"
					Command="{Binding NextItemCommand}">
					<Image
						Source="..\img\arrow-down.png"
						Stretch="None" />
				</RepeatButton>
				<Button
					Grid.Row="2"
					Grid.Column="1"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 0 5"
					Command="{Binding LastItemCommand}">
					<Image
						Source="..\img\arrow2-down.png"
						Stretch="None" />
				</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>
