<Window
	x:Class="GUI_XRS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:image="clr-namespace:XrsImage;assembly=XRSImage" xmlns:System="clr-namespace:System;assembly=mscorlib"
	Name="mainWindow"
	Icon="..\img\overview.png"
	Title="Raycon XRS"
	ResizeMode="NoResize"
	WindowStartupLocation="Manual"
	WindowStyle="None"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	WindowState="{Binding WState}"
	common:MouseCommandBehavior.MouseUpCommand="{Binding SignalUserActivityCommand}"
	common:ControlCommandBehavior.ClosingCommand="{Binding CloseCommand}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}"
	Loaded="GUI_loaded"
	ButtonBase.Click="mainWindow_Click"
	ContentRendered="mainWindow_ContentRendered">
	<UIElement.InputBindings>
		<KeyBinding
			Modifiers="Ctrl"
			Key="B"
			Command="{Binding DoBackupCommand}" />
	</UIElement.InputBindings>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityHiddenConverter
				x:Key="bVisConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisCollapsedConverter" />
			<l:IntToVisibilityConverter
				x:Key="visConverter" />
			<l:IntToVisibilityConverter1
				x:Key="vis1Converter" />
			<l:IntToCountMessageConverter
				x:Key="cntConverter" />
			<l:MachineStatesToVisibilityConverter
				x:Key="machVisConverter" />
			<l:MessageHeightConverter
				x:Key="messHeightConverter" />
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:ComplianceBoolToBrushConverter
				x:Key="complianceBoolToBrushConverter" />
			<l:BoolToBrushConverter
				x:Key="boolBrushConverter" />
			<l:TwoBoolBrushConverter
				x:Key="twoBoolBrushConverter" />
			<l:MessageTypeToButtonStyleConverter
				x:Key="messageTypeToButtonStyleConverter" />
			<l:WorstMessageTypeToBrushConverter
				x:Key="worstMessageTypeToBrushConverter" />
			<l:LaneStringConverter
				x:Key="laneStringConverter" />
			<l:UserRightsBoolConverter
				x:Key="userRightsBoolConverter" />
			<l:MachineTypeEntryOrHigherVisibilityConverter
				x:Key="machineTypeEntryOrHigherVisibilityConverter" />
			<l:MachineStateXrayStarterVisibilityConverter
				x:Key="machineStateXrayStarterVisibilityConverter" />
			<l:ResetButtonVisibilityConverter
				x:Key="resetButtonVisibilityConverter" />
			<l:AutolearnMachineStatesBoolConverter
				x:Key="autolearnMachineStatesBoolConverter" />
			<l:ProductChangeMachineStatesBoolConverter
				x:Key="productChangeMachineStatesBoolConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="boolToVisibilityInvertedHiddenConverter" />
			<l:StandBulkModeProductChangeMachineStatesBoolConverter
				x:Key="standBulkModeProductChangeMachineStatesBoolConverter" />
			<l:AutolearnMachineStatesBoolConverter2
				x:Key="autolearnMachineStatesBoolConverter2" />
			<l:MachineStatesToVisibilityConverterWithBulk
				x:Key="machineStateBulkConverter" />
			<l:AutolearnMachineStatesBoolConverterWithRefProd
				x:Key="autolearnMachineStatesBoolConverterWithRefProd" />
			<l:MachineStatesBoolConverterColorMessage
				x:Key="machineStatesBoolConverterColorMessage" />
			<l:AutolearnMachineStatesTextBoxStyleConverter
				x:Key="autolearnMachineStatesTextBoxStyleConverter" />
			<l:AutolearnMachineStatesSliderStyleConverter
				x:Key="autolearnMachineStatesSlideStyleConverter" />
			<Visibility
				x:Key="vis">Hidden</Visibility>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtThresholdStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Left" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxDisabledStyle">
				<Setter
					Property="Margin"
					Value="5 20 5 20" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="5"
								BorderThickness="1"
								Background="#00FFFFFF">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="SliderDeactivatedBrush">
				<GradientStop
					Offset="0.00"
					Color="#adadad" />
				<GradientStop
					Offset="0.02"
					Color="#bababa" />
				<GradientStop
					Offset="0.03"
					Color="#c7c7c7" />
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="SliderDeactivatedBorder">
				<GradientStop
					Offset="0.01"
					Color="#9f9f9f" />
				<GradientStop
					Offset="0.10"
					Color="#bababa" />
				<GradientStop
					Offset="0.9"
					Color="#bababa" />
				<GradientStop
					Offset="1.00"
					Color="#e6e6e6" />
			</LinearGradientBrush>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Setter
					Property="Height"
					Value="80" />
				<Setter
					Property="Width"
					Value="195" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="HorizontalAlignment"
					Value="Left" />
			</Style>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="NormalBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FFF"
							Offset="0.0" />
						<GradientStop
							Color="#CCC"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="1,0"
				x:Key="HorizontalNormalBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FFF"
							Offset="0.0" />
						<GradientStop
							Color="#CCC"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="LightBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FFF"
							Offset="0.0" />
						<GradientStop
							Color="#EEE"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="1,0"
				x:Key="HorizontalLightBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FFF"
							Offset="0.0" />
						<GradientStop
							Color="#EEE"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="DarkBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#FFF"
							Offset="0.0" />
						<GradientStop
							Color="#AAA"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1"
				x:Key="PressedBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="#BBB"
							Offset="0.0" />
						<GradientStop
							Color="#EEE"
							Offset="0.1" />
						<GradientStop
							Color="#EEE"
							Offset="0.9" />
						<GradientStop
							Color="#FFF"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<SolidColorBrush
				Color="#888"
				x:Key="DisabledForegroundBrush" />
			<SolidColorBrush
				Color="#EEE"
				x:Key="DisabledBackgroundBrush" />
			<SolidColorBrush
				Color="#FFF"
				x:Key="WindowBackgroundBrush" />
			<SolidColorBrush
				Color="#DDD"
				x:Key="SelectedBackgroundBrush" />
			<SolidColorBrush
				Color="#444"
				x:Key="GlyphBrush" />
			<SolidColorBrush
				Color="#DDD"
				x:Key="LightColorBrush" />
			<Style
				TargetType="{x:Type RepeatButton}"
				x:Key="SliderButtonStyle">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="IsTabStop"
					Value="False" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type RepeatButton}">
							<Border
								Background="#00FFFFFF" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type Thumb}"
				x:Key="SliderThumbStyleActivated">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Thumb}">
							<Ellipse
								Name="Ellipse"
								StrokeThickness="1"
								Fill="{StaticResource NormalBrush}"
								Stroke="{StaticResource NormalBorderBrush}" />
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="Ellipse"
										Property="Fill"
										Value="{StaticResource DarkBrush}" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="Ellipse"
										Property="Fill"
										Value="{StaticResource DisabledBackgroundBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type Thumb}"
				x:Key="SliderThumbStyleDeactivated">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Thumb}">
							<Ellipse
								Name="Ellipse"
								StrokeThickness="1"
								Fill="{StaticResource SliderDeactivatedBrush}"
								Stroke="{StaticResource SliderDeactivatedBorder}" />
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="Ellipse"
										Property="Fill"
										Value="{StaticResource SliderDeactivatedBrush}" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="Ellipse"
										Property="Fill"
										Value="{StaticResource SliderDeactivatedBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<ControlTemplate
				TargetType="{x:Type Slider}"
				x:Key="VerticalSliderActivated">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="Auto"
							MinWidth="{TemplateBinding MinWidth}" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<TickBar
						Name="TopTick"
						SnapsToDevicePixels="True"
						Placement="Left"
						Width="4"
						Visibility="Collapsed"
						Fill="{StaticResource GlyphBrush}" />
					<Border
						Name="TrackBackground"
						Margin="0"
						CornerRadius="2"
						Width="10"
						Grid.Column="1"
						BorderThickness="1"
						Background="{StaticResource HorizontalLightBrush}"
						BorderBrush="{StaticResource HorizontalNormalBorderBrush}" />
					<Track
						Name="PART_Track"
						Grid.Column="1">
						<Track.DecreaseRepeatButton>
							<RepeatButton
								Command="Slider.DecreaseLarge"
								Style="{StaticResource SliderButtonStyle}" />
						</Track.DecreaseRepeatButton>
						<Track.Thumb>
							<Thumb
								Style="{StaticResource SliderThumbStyleActivated}" />
						</Track.Thumb>
						<Track.IncreaseRepeatButton>
							<RepeatButton
								Command="Slider.IncreaseLarge"
								Style="{StaticResource SliderButtonStyle}" />
						</Track.IncreaseRepeatButton>
					</Track>
					<TickBar
						Name="BottomTick"
						SnapsToDevicePixels="True"
						Grid.Column="2"
						Fill="{TemplateBinding Foreground}"
						Placement="Right"
						Width="4"
						Visibility="Collapsed" />
				</Grid>
				<ControlTemplate.Triggers>
					<Trigger
						Property="Slider.TickPlacement"
						Value="TopLeft">
						<Setter
							TargetName="TopTick"
							Property="Visibility"
							Value="Visible" />
					</Trigger>
					<Trigger
						Property="Slider.TickPlacement"
						Value="BottomRight">
						<Setter
							TargetName="BottomTick"
							Property="Visibility"
							Value="Visible" />
					</Trigger>
					<Trigger
						Property="Slider.TickPlacement"
						Value="Both">
						<Setter
							TargetName="TopTick"
							Property="Visibility"
							Value="Visible" />
						<Setter
							TargetName="BottomTick"
							Property="Visibility"
							Value="Visible" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
			<ControlTemplate
				TargetType="{x:Type Slider}"
				x:Key="VerticalSliderDeactivated">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="Auto"
							MinWidth="{TemplateBinding MinWidth}" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<TickBar
						Name="TopTick"
						SnapsToDevicePixels="True"
						Placement="Left"
						Width="4"
						Visibility="Collapsed"
						Fill="{StaticResource GlyphBrush}" />
					<Border
						Name="TrackBackground"
						Margin="0"
						CornerRadius="2"
						Width="10"
						Grid.Column="1"
						BorderThickness="1"
						Background="{StaticResource SliderDeactivatedBrush}"
						BorderBrush="{StaticResource SliderDeactivatedBorder}" />
					<Track
						Name="PART_Track"
						Grid.Column="1">
						<Track.DecreaseRepeatButton>
							<RepeatButton
								Command="Slider.DecreaseLarge"
								Style="{StaticResource SliderButtonStyle}" />
						</Track.DecreaseRepeatButton>
						<Track.Thumb>
							<Thumb
								Style="{StaticResource SliderThumbStyleDeactivated}" />
						</Track.Thumb>
						<Track.IncreaseRepeatButton>
							<RepeatButton
								Command="Slider.IncreaseLarge"
								Style="{StaticResource SliderButtonStyle}" />
						</Track.IncreaseRepeatButton>
					</Track>
					<TickBar
						Name="BottomTick"
						SnapsToDevicePixels="True"
						Grid.Column="2"
						Fill="{TemplateBinding Foreground}"
						Placement="Right"
						Width="4"
						Visibility="Collapsed" />
				</Grid>
				<ControlTemplate.Triggers>
					<Trigger
						Property="Slider.TickPlacement"
						Value="TopLeft">
						<Setter
							TargetName="TopTick"
							Property="Visibility"
							Value="Visible" />
					</Trigger>
					<Trigger
						Property="Slider.TickPlacement"
						Value="BottomRight">
						<Setter
							TargetName="BottomTick"
							Property="Visibility"
							Value="Visible" />
					</Trigger>
					<Trigger
						Property="Slider.TickPlacement"
						Value="Both">
						<Setter
							TargetName="TopTick"
							Property="Visibility"
							Value="Visible" />
						<Setter
							TargetName="BottomTick"
							Property="Visibility"
							Value="Visible" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
			<Style
				TargetType="{x:Type Slider}"
				x:Key="activatedSliderStyle">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Style.Triggers>
					<Trigger
						Property="Slider.Orientation"
						Value="Vertical">
						<Setter
							Property="MinWidth"
							Value="21" />
						<Setter
							Property="MinHeight"
							Value="104" />
						<Setter
							Property="Template"
							Value="{StaticResource VerticalSliderActivated}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style
				TargetType="{x:Type Slider}"
				x:Key="deactivatedSliderStyle">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Style.Triggers>
					<Trigger
						Property="Slider.Orientation"
						Value="Vertical">
						<Setter
							Property="MinWidth"
							Value="21" />
						<Setter
							Property="MinHeight"
							Value="104" />
						<Setter
							Property="Template"
							Value="{StaticResource VerticalSliderDeactivated}" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<DockPanel
			LastChildFill="True">
			<Border
				BorderBrush="#8e9192"
				BorderThickness="0,0,0,1"
				DockPanel.Dock="Top"
				Height="{Binding Source={StaticResource MainWindowHeaderHeight}}">
				<Border.Background>
					<LinearGradientBrush
						StartPoint="0,0"
						EndPoint="0,1">
						<GradientStop
							Offset="0.00"
							Color="#98bd08" />
						<GradientStop
							Offset="1.00"
							Color="#b8e409" />
					</LinearGradientBrush>
				</Border.Background>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel
						Orientation="Horizontal"
						Grid.Column="0">
						<Image
							Margin="20 0 20 0"
							Stretch="None"
							Source="{Binding Path=SelectedBranding.CompanyLogo}" />
						<Label
							Width="400"
							VerticalContentAlignment="Center"
							FontSize="16"
							FontWeight="Bold"
							Foreground="#414141"
							FontFamily="Verdana"
							Content="{Binding Path=SelectedBranding.MachineDescription}" />
					</StackPanel>
					<Button
						Name="buttonScreenshot"
						Style="{StaticResource okButtonStyle}"
						Width="50"
						Height="50"
						Grid.Column="1"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Opacity="0"
						MouseDoubleClick="buttonScreenshot_Click" />
				</Grid>
			</Border>
			<Border
				BorderBrush="#8e9192"
				BorderThickness="0,1,0,0"
				DockPanel.Dock="Bottom"
				Height="{Binding Source={StaticResource MainWindowFooterHeight}}">
				<Border.Background>
					<LinearGradientBrush
						StartPoint="0,0"
						EndPoint="0,1">
						<GradientStop
							Offset="0.00"
							Color="#d2d2d2" />
						<GradientStop
							Offset="1.00"
							Color="#b8b8b8" />
					</LinearGradientBrush>
				</Border.Background>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="200" />
						<ColumnDefinition
							Width="200" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Border
						BorderBrush="#e3e7ea"
						BorderThickness="0 0 1 0"
						Grid.Column="0">
						<TextBlock
							TextAlignment="Center"
							VerticalAlignment="Center"
							Foreground="#383838"
							FontFamily="Verdana"
							FontSize="15"
							Text="{Binding Path=Time}"
							common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeTimeCommand}" />
					</Border>
					<Border
						BorderThickness="1 0 1 0"
						Grid.Column="1"
						Padding="10 0 10 0">
						<Border.BorderBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="1,0">
								<GradientStop
									Offset="0.5"
									Color="#8e9192" />
								<GradientStop
									Offset="0.5"
									Color="#e3e7ea" />
								<GradientStop
									Offset="1.0"
									Color="#e3e7ea" />
							</LinearGradientBrush>
						</Border.BorderBrush>
						<Button
							Name="btnChangeUser"
							Command="{Binding ChangeUserCommand}"
							Visibility="{Binding Path=FirstApplicationLoaded, Converter={StaticResource bVisConverter}}">
							<StackPanel
								Orientation="Horizontal"
								VerticalAlignment="Center"
								HorizontalAlignment="Center">
								<Image
									Source="..\img\changeuser_small.png"
									Stretch="None"
									Margin="0 0 7 0" />
								<TextBlock
									Name="tbUser"
									VerticalAlignment="Center"
									Text="{Binding Path=CurrentUser.Username}" />
							</StackPanel>
						</Button>
					</Border>
					<Border
						BorderBrush="#8e9192"
						BorderThickness="1 0 0 0"
						Grid.Column="2"
						Padding="0 0 0 0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="40" />
								<ColumnDefinition
