													Text="{Binding Path=DataContext.ComplVASensitivity, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
													Visibility="{Binding Path=DataContext.ComplSensitivityVisible, Converter={StaticResource bVisCollapsedConverter}, FallbackValue=Collapsed, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
												<TextBlock
													FontWeight="Bold"
													Grid.Row="2"
													Grid.Column="1"
													FontSize="14"
													FontFamily="Helvetica"
													Margin="15 0 0 0"
													Text="{Binding Path=DataContext.ComplGlassSensitivity, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
													Visibility="{Binding Path=DataContext.ComplSensitivityVisible, Converter={StaticResource bVisCollapsedConverter}, FallbackValue=Collapsed, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
												<TextBlock
													FontWeight="Bold"
													Grid.Row="0"
													Grid.Column="2"
													FontSize="14"
													FontFamily="Helvetica"
													Margin="15 0 0 0"
													Text="{Binding Path=DataContext.StrActTestcardSim.LocalizedText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
													Foreground="{Binding Path=DataContext.ComplTextForeground, Converter={StaticResource complianceBoolToBrushConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
												<TextBlock
													FontWeight="Bold"
													Grid.Row="1"
													Grid.Column="2"
													FontSize="14"
													FontFamily="Helvetica"
													Margin="15 0 0 0"
													Text="{Binding Path=DataContext.SimulatedVASensitivity, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
													Foreground="{Binding Path=DataContext.ComplTextVAForeground, Converter={StaticResource complianceBoolToBrushConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
												<TextBlock
													FontWeight="Bold"
													Grid.Row="2"
													Grid.Column="2"
													FontSize="14"
													FontFamily="Helvetica"
													Margin="15 0 0 0"
													Text="{Binding Path=DataContext.SimulatedGlassSensitivity, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
													Foreground="{Binding Path=DataContext.ComplTextGlassForeground, Converter={StaticResource complianceBoolToBrushConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
											</Grid>
										</Grid>
									</Grid>
									<image:XRSImageBoxBulk
										Grid.Row="1"
										UserLoggedIn="{Binding Path=DataContext.CurrentUser.Rights, Converter={StaticResource userRightsBoolConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
										Visibility="{Binding Path=DataContext.IsImageBoxVisibleBigImage, Converter={StaticResource bVisCollapsedConverter}, FallbackValue=Collapsed, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
										Images="{Binding Path=DataContext.Images, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" />
									<image:XRSImageBox
										Grid.Row="1"
										Image="{Binding Path=DataContext.Image, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}"
										UserLoggedIn="{Binding Path=DataContext.CurrentUser.Rights, Converter={StaticResource userRightsBoolConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}"
										Visibility="{Binding Path=DataContext.IsImageBoxVisible, Converter={StaticResource bVisCollapsedConverter}, FallbackValue=Collapsed, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" />
								</Grid>
							</DataTemplate>
						</TabControl.ContentTemplate>
					</TabControl>
					<Grid
						ColumnSpan="2">
						<Grid.RowDefinitions>
							<RowDefinition>
								<RowDefinition.Height>
									<MultiBinding
										Converter="{StaticResource messHeightConverter}">
										<Binding
											Path="ProductManager.CurrentLoadedProduct.ProductType" />
										<Binding
											Path="MultiLaneView" />
										<Binding
											Path="ProductManager.CurrentLoadedProduct.SubProducts.Count" />
									</MultiBinding>
								</RowDefinition.Height>
							</RowDefinition>
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid
							Row="1"
							Background="#dddddd">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource machineStateBulkConverter}">
									<Binding
										Path="machineState.State" />
									<Binding
										Path="BulkModeActive" />
									<Binding
										Path="IsImageBoxVisible" />
									<Binding
										Path="IsImageBoxVisibleBigImage" />
								</MultiBinding>
							</UIElement.Visibility>
							<Label
								Margin="0 0 0 0"
								Grid.Row="1"
								VerticalAlignment="Center"
								HorizontalAlignment="Center">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Label}">
										<Setter
											Property="Foreground"
											Value="#FF000000" />
										<Style.Triggers>
											<DataTrigger
												Value="True">
												<DataTrigger.Binding>
													<MultiBinding
														Converter="{StaticResource machineStatesBoolConverterColorMessage}">
														<Binding
															Path="machineState.State" />
														<Binding
															Path="BulkModeActive" />
														<Binding
															Path="BulkOnOff" />
													</MultiBinding>
												</DataTrigger.Binding>
												<Setter
													Property="Foreground"
													Value="#FFFF0000" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
								<ContentControl.Content>
									<TextBlock
										TextWrapping="Wrap"
										FontSize="30"
										FontWeight="Bold"
										Text="{Binding Path=machineState.StartMessage.Message.LocalizedText}" />
								</ContentControl.Content>
							</Label>
						</Grid>
					</Grid>
					<Border
						Grid.Column="2"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Margin="0 0 60 15"
						BorderThickness="0 0 0 0"
						BorderBrush="#FF808080"
						Visibility="{Binding HighSpeedMachineActiveVisible2, Converter={StaticResource bVisCollapsedConverter}}">
						<Button
							Name="btnHighSpeedImage2"
							Style="{StaticResource defaultButtonBigStyleActive}"
							Margin="5 0 5 5"
							Command="{Binding HighSpeedImageCommand}">
							<UIElement.IsEnabled>
								<MultiBinding
									Converter="{StaticResource autolearnMachineStatesBoolConverter2}">
									<Binding
										Path="machineState.State" />
									<Binding
										Path="DemoMode" />
								</MultiBinding>
							</UIElement.IsEnabled>
							<Grid>
								<Image
									Source="../img/objectxriimage.png"
									Stretch="Uniform"
									Height="50"
									Width="50"
									VerticalAlignment="Center"
									Visibility="{Binding ElementName=btnHighSpeedImage2, Path=IsEnabled, Converter={StaticResource bVisConverter}}" />
								<Image
									Source="..\img\objectxriimage_disabled.png"
									Stretch="Uniform"
									Height="40"
									Width="40"
									VerticalAlignment="Center"
									Visibility="{Binding ElementName=btnHighSpeedImage2, Path=IsEnabled, Converter={StaticResource boolToVisibilityInvertedHiddenConverter}}" />
							</Grid>
						</Button>
					</Border>
				</Grid>
			</Border>
		</DockPanel>
	</Grid>
</Window>
