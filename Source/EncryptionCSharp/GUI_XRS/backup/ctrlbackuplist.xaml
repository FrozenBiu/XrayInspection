<UserControl
	x:Class="GUI_XRS.CtrlBackupList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<Grid>
		<Border
			Margin="20,0,20,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="3*" />
					<RowDefinition
						Height="20*" />
				</Grid.RowDefinitions>
				<ListBox
					Name="lstProducts"
					Grid.Row="1"
					Background="#00FFFFFF"
					SelectionMode="Multiple"
					IsSynchronizedWithCurrentItem="True"
					ScrollViewer.PanningMode="None"
					ItemsSource="{Binding Path=ProductManager.ProductList}"
					SelectionChanged="SelectedItems">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid
								MinHeight="50">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Margin="0 0 15 0"
									FontWeight="Bold"
									FontSize="20"
									FontFamily="Helvetica"
									VerticalAlignment="Center"
									Text="{Binding Path=ProductNumber}" />
								<TextBlock
									Grid.Column="1"
									FontSize="20"
									FontFamily="Helvetica"
									VerticalAlignment="Center"
									Text="{Binding Path=ProductName}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>
	</Grid>
</UserControl>
