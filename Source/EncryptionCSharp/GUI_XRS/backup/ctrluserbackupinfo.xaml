<UserControl
	x:Class="GUI_XRS.CtrlUserBackupInfo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS"
	Unloaded="UserControl_Unloaded">
	<Grid>
		<Grid>
			<Border
				Margin="20,0,20,0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="2*" />
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="20*" />
					</Grid.RowDefinitions>
					<TextBlock
						Name="tbCurrentUser"
						Grid.Row="0"
						VerticalAlignment="Center"
						FontSize="25"
						FontWeight="Bold"
						FontFamily="Helvetica"
						Text="{Binding Path=CurrentUser.Username}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Text="{Binding Path=UserID.LocalizedText, FallbackValue=Benutzer ID}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Margin="200,0,0,0"
						Text="{Binding Path=UserName.LocalizedText, FallbackValue=Benutzername}" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Bottom"
						FontSize="18"
						Margin="400,0,0,0"
						Text="{Binding Path=UserGroup.LocalizedText, FallbackValue=Benutzergruppe}" />
					<ScrollViewer
						Grid.Row="2">
						<ItemsControl
							Name="lstUsers"
							Background="#00FFFFFF"
							BorderThickness="1"
							BorderBrush="#FF808080"
							ItemsSource="{Binding Path=UserList}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid
										MinHeight="50">
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="200" />
											<ColumnDefinition
												Width="200" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock
											Name="tbID"
											Grid.Column="0"
											FontSize="20"
											FontFamily="Helvetica"
											VerticalAlignment="Center"
											TextWrapping="Wrap"
											Margin="5"
											Text="{Binding Path=ID}" />
										<TextBlock
											Name="tbUsername"
											Grid.Column="1"
											FontSize="20"
											FontFamily="Helvetica"
											VerticalAlignment="Center"
											TextWrapping="Wrap"
											Margin="5"
											Text="{Binding Path=Username}" />
										<TextBlock
											Name="tbGroup"
											Grid.Column="2"
											FontSize="20"
											FontFamily="Helvetica"
											VerticalAlignment="Center"
											TextWrapping="Wrap"
											Margin="5"
											Text="{Binding Path=Userlevel}" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
