<UserControl
	x:Class="GUI_XRS.CtrlBackupInfo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False" xmlns:gui_xrs="clr-namespace:GUI_XRS"
	common:ControlCommandBehavior.LoadedCommand="{Binding GetInfosCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 10 20 10" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<DataTemplate
				x:Key="lstTemplate">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Style="{StaticResource txtStyle}"
						Text="{Binding Path=InfoText}" />
					<TextBlock
						Grid.Column="1"
						HorizontalAlignment="Left"
						Style="{StaticResource txtStyle}"
						Text="{Binding Path=InfoValue}" />
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="10">
		<Border
			BorderThickness="1"
			BorderBrush="#FF808080">
			<ScrollViewer>
				<ItemsControl
					ItemTemplate="{StaticResource lstTemplate}"
					Background="#00FFFFFF"
					Margin="5"
					ItemsSource="{Binding Path=Infos}" />
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
