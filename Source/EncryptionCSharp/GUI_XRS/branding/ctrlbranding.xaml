<UserControl
	x:Class="GUI_XRS.CtrlBranding" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CloseCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<ItemsControl
			Background="#00FFFFFF"
			ItemsSource="{Binding Path=Brandings}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<RadioButton
						Margin="20"
						GroupName="Brandings"
						IsChecked="{Binding Path=IsActiveBranding}">
						<ContentControl.Content>
							<TextBlock
								FontFamily="Arial"
								FontWeight="Bold"
								FontSize="18"
								Foreground="#272727"
								TextAlignment="Right"
								Margin="20 0 25 0"
								TextWrapping="Wrap"
								Text="{Binding Path=CompanyName}" />
						</ContentControl.Content>
					</RadioButton>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
