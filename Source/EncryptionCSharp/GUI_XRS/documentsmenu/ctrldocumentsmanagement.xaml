<UserControl
	x:Class="GUI_XRS.CtrlDocumentsManagement" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="bVisHiddenConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="FontFamily"
					Value="Helvetica" />
				<Setter
					Property="HorizontalAlignment"
					Value="Left" />
				<Setter
					Property="VerticalAlignment"
					Value="Bottom" />
				<Setter
					Property="Margin"
					Value="20 3 20 1" />
			</Style>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="Background"
					Value="#E7EFC5" />
				<Setter
					Property="ListBox.SelectionMode"
					Value="Single" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="True" />
				<Setter
					Property="Margin"
					Value="20 1 20 5" />
			</Style>
			<Style
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource defaultButtonStyle}"
				x:Key="{x:Type Button}">
				<Setter
					Property="Margin"
					Value="5 5 5 5" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="0"
			Grid.Row="0"
			Text="Local:" />
		<ListBox
			Name="ListBoxDocuments"
			Grid.Column="0"
			Grid.Row="1"
			SelectionMode="Single"
			Grid.IsSharedSizeScope="True"
			IsSynchronizedWithCurrentItem="True"
			Margin="20,1,20,5"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ItemsSource="{Binding DocumentsLocal}"
			SelectedItem="{Binding Path=SelectedLocalDocument}">
			<ItemsControl.ItemContainerStyle>
				<!--Unknown connection ID: 2-->
				<Style
					TargetType="{x:Type ListBoxItem}" />
			</ItemsControl.ItemContainerStyle>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel
						Orientation="Horizontal">
						<Grid
							MinHeight="30">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="35" />
								<ColumnDefinition
									Width="Auto"
									SharedSizeGroup="groupNumber" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock
								Grid.Column="0"
								FontSize="20"
								FontFamily="Helvetica"
								FontWeight="Bold"
								Margin="5 10 5 10"
								Text="{Binding Index}" />
							<TextBlock
								Grid.Column="1"
								FontSize="20"
								FontFamily="Helvetica"
								FontWeight="Normal"
								Margin="10 10 10 10"
								Text="{Binding DisplayedName}" />
						</Grid>
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
		<Grid
			Column="1"
			Row="1">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Button
				Grid.Row="1"
				VerticalAlignment="Bottom"
				Command="{Binding AddFileToUSBCommand}"
				IsEnabled="{Binding ShowUSBConnected}">
				<ContentControl.Content>
					<Grid>
						<Image
							Source="/img/arrow-right.png"
							Stretch="None"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisConverter}}" />
						<Image
							Source="/img/arrow-right_disabled.png"
							Stretch="None"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisHiddenConverter}}" />
					</Grid>
				</ContentControl.Content>
			</Button>
			<Button
				Grid.Row="2"
				VerticalAlignment="Top"
				Command="{Binding AddFileToLocalCommand}"
				IsEnabled="{Binding ShowUSBConnected}">
				<ContentControl.Content>
					<Grid>
						<Image
							Source="/img/arrow-left.png"
							Stretch="None"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisConverter}}" />
						<Image
							Source="/img/arrow-left_disabled.png"
							Stretch="None"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisHiddenConverter}}" />
					</Grid>
				</ContentControl.Content>
			</Button>
			<Grid
				Column="1"
				Row="4">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Image
					Grid.Row="0"
					VerticalAlignment="Top"
					Source="/img/usb.png"
					Stretch="None"
					Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisConverter}}" />
				<Image
					Grid.Row="0"
					VerticalAlignment="Top"
					Source="/img/usb_disabled.png"
					Stretch="None"
					Visibility="{Binding ShowUSBNotConnected, Converter={StaticResource bVisConverter}}" />
			</Grid>
		</Grid>
		<TextBlock
			Grid.Column="2"
			Grid.Row="0"
			Text="USB:" />
		<ListBox
			Grid.Row="1"
			Grid.Column="2"
			SelectionMode="Single"
			Grid.IsSharedSizeScope="True"
			IsSynchronizedWithCurrentItem="True"
			Margin="20,1,20,5"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ItemsSource="{Binding DocumentsUSB}"
			SelectedItem="{Binding Path=SelectedUSBDocument}">
			<ItemsControl.ItemContainerStyle>
				<!--Unknown connection ID: 3-->
				<Style
					TargetType="{x:Type ListBoxItem}" />
			</ItemsControl.ItemContainerStyle>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel
						Orientation="Horizontal">
						<Grid
							MinHeight="30">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="35" />
								<ColumnDefinition
									Width="Auto"
									SharedSizeGroup="groupNumber" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock
								Grid.Column="0"
								FontSize="20"
								FontFamily="Helvetica"
								FontWeight="Bold"
								Margin="5 10 5 10"
								Text="{Binding Index}" />
							<TextBlock
								Grid.Column="1"
								FontSize="20"
								FontFamily="Helvetica"
								FontWeight="Normal"
								Margin="10 10 10 10"
								Text="{Binding DisplayedName}" />
						</Grid>
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
		<StackPanel
			Grid.Row="2"
			Grid.Column="0"
			Orientation="Horizontal"
			Margin="30 5 20 5">
			<Button
				HorizontalAlignment="Left"
				CommandParameter="local"
				Command="{Binding DeleteLocalFileCommand}"
				Visibility="{Binding DeleteAllowed, Converter={StaticResource bVisConverter}}">
				<ContentControl.Content>
					<Image
						Source="/img/deleteDocument.png"
						Height="40" />
				</ContentControl.Content>
			</Button>
			<Button
				HorizontalAlignment="Left"
				CommandParameter="local"
				Command="{Binding RenameLocalFileCommand}">
				<ContentControl.Content>
					<Image
						Source="/img/renameDocument.png"
						Height="40" />
				</ContentControl.Content>
			</Button>
		</StackPanel>
		<StackPanel
			Grid.Row="2"
			Grid.Column="2"
			Orientation="Horizontal"
			Margin="30 5 20 5">
			<Button
				HorizontalAlignment="Left"
				CommandParameter="usb"
				Command="{Binding DeleteLocalFileCommand}"
				IsEnabled="{Binding ShowUSBConnected}"
				Visibility="{Binding DeleteAllowed, Converter={StaticResource bVisConverter}}">
				<ContentControl.Content>
					<Grid>
						<Image
							Source="/img/deleteDocument.png"
							Height="40"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisConverter}}" />
						<Image
							Source="/img/deleteDocument_disabled.png"
							Height="40"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisHiddenConverter}}" />
					</Grid>
				</ContentControl.Content>
			</Button>
			<Button
				HorizontalAlignment="Left"
				CommandParameter="usb"
				Command="{Binding RenameLocalFileCommand}"
				IsEnabled="{Binding ShowUSBConnected}">
				<ContentControl.Content>
					<Grid>
						<Image
							Source="/img/renameDocument.png"
							Height="40"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisConverter}}" />
						<Image
							Source="/img/renameDocument_disabled.png"
							Height="40"
							Visibility="{Binding ShowUSBConnected, Converter={StaticResource bVisHiddenConverter}}" />
					</Grid>
				</ContentControl.Content>
			</Button>
		</StackPanel>
	</Grid>
</UserControl>
