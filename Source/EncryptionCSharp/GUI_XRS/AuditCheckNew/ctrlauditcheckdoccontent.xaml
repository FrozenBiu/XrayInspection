<UserControl
	x:Class="GUI_XRS.CtrlAuditCheckDocContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS" xmlns:tk="http://schemas.microsoft.com/wpf/2008/toolkit"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Unloaded="IVPControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToTextBoxStyleConverter2
				x:Key="bTextBoxStyleConverter" />
			<l:BoolToStringConverter
				x:Key="bStringConverter" />
			<l:DoubleStringConverterPrec1
				x:Key="doubleStringConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="TextBoxStyle">
				<Setter
					Property="Margin"
					Value="65 0 50 0" />
				<Setter
					Property="FontSize"
					Value="20" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 0 65 0" />
			</Style>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type l:RadioButtonExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="Background"
					Value="#E7EFC5" />
				<Setter
					Property="ListBox.SelectionMode"
					Value="Single" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="True" />
				<Setter
					Property="Margin"
					Value="20 1 20 5" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<ScrollViewer>
			<Border
				Grid.Row="0"
				BorderBrush="#a8a8a8"
				BorderThickness="1"
				Background="#d1d1d1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							MinHeight="150" />
						<RowDefinition
							MinHeight="80" />
						<RowDefinition
							MinHeight="80" />
						<RowDefinition>
							<FrameworkContentElement.Style>
								<Style
									TargetType="{x:Type RowDefinition}">
									<Setter
										Property="Height"
										Value="Auto" />
									<Setter
										Property="MinHeight"
										Value="80" />
									<Style.Triggers>
										<DataTrigger
											Value="False"
											Binding="{Binding IsManually}">
											<Setter
												Property="Height"
												Value="0" />
											<Setter
												Property="MinHeight"
												Value="0" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkContentElement.Style>
						</RowDefinition>
						<RowDefinition
							MinHeight="80" />
						<RowDefinition
							MinHeight="80" />
						<RowDefinition
							MinHeight="80" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="11"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="14"
						Grid.RowSpan="9"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0 " />
					<Border
						Grid.Row="2"
						Grid.Column="0"
						Grid.ColumnSpan="14"
						Grid.RowSpan="9"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0 " />
					<Border
						Grid.Row="3"
						Grid.Column="0"
						Grid.ColumnSpan="14"
						Grid.RowSpan="9"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0 " />
					<Border
						Grid.Row="4"
						Grid.Column="0"
						Grid.ColumnSpan="14"
						Grid.RowSpan="9"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0 " />
					<Border
						Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="14"
						Grid.RowSpan="9"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0 " />
					<Border
						Grid.Row="6"
						Grid.Column="0"
						Grid.ColumnSpan="14"
						Grid.RowSpan="9"
						BorderBrush="#b6b6b6"
						BorderThickness="0 1 0 0 " />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding Path=StrData.LocalizedText, FallbackValue=Daten}" />
					<TextBox
						Name="DataTextBox"
						Grid.Row="0"
						Grid.Column="1"
						Grid.ColumnSpan="1"
						Margin="30 10 30 10"
						FontSize="22"
						VerticalAlignment="Stretch"
						Text="{Binding Path=Data}"
						MouseDown="TextBox_MouseDown" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding Path=StrTimeNextDoc.LocalizedText, FallbackValue=Beginn neues Dokument}" />
					<Grid
						Row="1"
						Column="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height=" 3*" />
							<RowDefinition />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Column="0"
							Grid.Row="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							FontSize="16"
							Margin="5 5 5 5 "
							Text="{Binding Path=StrDaily.LocalizedText, FallbackValue=täglich}" />
						<l:RadioButtonExtended
							GroupName="rbSpeedUnit"
							Grid.Column="0"
							Grid.Row="0"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							IsCheckedReal="{Binding Path=IsDaily, Mode=TwoWay}" />
						<TextBlock
							Grid.Column="1"
							Grid.Row="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							FontSize="16"
							Margin="5 5 5 5 "
							Text="{Binding Path=StrWeekly.LocalizedText, FallbackValue=wöchentlich}" />
						<l:RadioButtonExtended
							GroupName="rbSpeedUnit"
							Grid.Column="1"
							Grid.Row="0"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							IsCheckedReal="{Binding Path=IsWeekly, Mode=TwoWay}" />
						<TextBlock
							Grid.Column="2"
							Grid.Row="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							FontSize="16"
							Margin="5 5 5 5 "
							Text="{Binding Path=StrCustomIntervall.LocalizedText, FallbackValue=Intervall}" />
						<l:RadioButtonExtended
							GroupName="rbSpeedUnit"
							Grid.Column="2"
							Grid.Row="0"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							IsCheckedReal="{Binding Path=IsManually, Mode=TwoWay}" />
					</Grid>
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding Path=StrNextDate.LocalizedText, FallbackValue=Datum neues Dokument}" />
					<TextBox
						Grid.Row="2"
						Grid.Column="1"
						Grid.ColumnSpan="1"
						Margin="30 0 30 0"
						FontSize="22"
						IsEnabled="False"
						Style="{StaticResource disabledTextBox}"
						Text="{Binding Path=NextDate}" />
					<TextBlock
						Grid.Row="3"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding Path=StrInterval.LocalizedText, StringFormat={}{0} (d), FallbackValue=Intervall (d)}" />
					<TextBox
						Grid.Row="3"
						Grid.Column="1"
						Grid.ColumnSpan="1"
						Margin="30 0 30 0"
						FontSize="22"
						Text="{Binding Path=IntervalDays}"
						MouseDown="TextBox_MouseDown_Number" />
					<TextBlock
						Grid.Row="4"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding Path=StrNewDoc.LocalizedText, FallbackValue=Neues Dokument beginnen}" />
					<Button
						Style="{StaticResource defaultButtonStyle}"
						Grid.Column="1"
						Grid.Row="4"
						Click="Button_Click">
						<Image
							Source="../img/Auditcheck_addDoc.png"
							Height="40" />
					</Button>
					<Grid
						Row="5"
						Column="1"
						Margin="30 0 30 0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="3*" />
							<ColumnDefinition
								MinWidth="40"
								Width="*" />
						</Grid.ColumnDefinitions>
						<TextBox
							Grid.Column="0"
							FontSize="22"
							IsEnabled="False"
							Style="{StaticResource disabledTextBox}"
							Margin="0 0 10 0"
							Text="{Binding Path=ImageName}" />
						<Button
							Style="{StaticResource defaultButtonStyle}"
							Grid.Column="1"
							Margin="0"
							Click="Button_Cancel_Click">
							<Image
								Source="../img/cancel.png"
								Height="40"
								Width="40" />
						</Button>
					</Grid>
					<TextBlock
						Grid.Row="5"
						Grid.Column="0"
						Margin="20 0 20 0"
						Text="{Binding Path=StrFileNameLogo.LocalizedText, FallbackValue=Dateiname Logo}" />
					<TextBlock
						Grid.Row="6"
						Grid.Column="0"
						Margin="20 0 20 0">
						<TextBlock.Text>
							<MultiBinding
								StringFormat=" {0} ({1} 40 KB) ">
								<Binding
									Path="StrUploadLogo.LocalizedText" />
								<Binding
									Path="StrMaximum.LocalizedText" />
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
					<Grid
						Column="1"
						Row="6">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Button
							Style="{StaticResource defaultButtonStyle}"
							Grid.Row="1"
							Margin="0 10"
							Click="Button_Import_Click">
							<Image
								Source="../img/arrow2-up.png"
								Height="40" />
						</Button>
						<ListBox
							Name="ListBoxDocuments"
							Grid.Row="1"
							SelectionMode="Single"
							IsSynchronizedWithCurrentItem="True"
							Margin="30 10 30 10"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ItemsSource="{Binding ImagesUSB}"
							SelectedItem="{Binding Path=SelectedImage}"
							Visibility="{Binding Path=USBListVisible, Converter={StaticResource bVisConverter}}">
							<ItemsControl.ItemContainerStyle>
								<!--Unknown connection ID: 8-->
								<Style
									TargetType="{x:Type ListBoxItem}" />
							</ItemsControl.ItemContainerStyle>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<StackPanel
										Orientation="Horizontal">
										<Grid
											MinHeight="30">
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="35" />
												<ColumnDefinition
													Width="Auto" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition
													Height="Auto" />
											</Grid.RowDefinitions>
											<TextBlock
												Grid.Column="0"
												FontSize="20"
												FontFamily="Helvetica"
												FontWeight="Bold"
												Margin="5 10 5 10"
												Text="{Binding Index}" />
											<TextBlock
												Grid.Column="1"
												FontSize="20"
												FontFamily="Helvetica"
												FontWeight="Normal"
												Margin="10 10 10 10"
												Text="{Binding DisplayedName}" />
										</Grid>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ListBox>
					</Grid>
				</Grid>
			</Border>
		</ScrollViewer>
	</Grid>
</UserControl>
