<UserControl
	x:Class="GUI_XRS.CtrlAuditCheckSavedEntries" xmlns:d3="http://research.microsoft.com/DynamicDataDisplay/1.0" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Loaded="Control_Loaded"
	Unloaded="Control_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
			<l:BoolToVisibilityInvertedHiddenConverter
				x:Key="bVisHiddenConverter" />
			<l:AuditCheckEntryToBrushConverter
				x:Key="AuditToBrushConverter" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="VerticalScrollBarVisibility"
					Value="Auto" />
				<Setter
					Property="CanContentScroll"
					Value="True" />
				<Setter
					Property="Selector.IsSynchronizedWithCurrentItem"
					Value="true" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								BorderBrush="#dfdfdf"
								BorderThickness="0 0 0 1"
								CornerRadius="4">
								<Border
									Background="#e7efc5"
									BorderBrush="#8f8f8f"
									BorderThickness="1"
									CornerRadius="3">
									<ScrollViewer
										Margin="0"
										Focusable="False"
										PanningMode="None">
										<StackPanel
											Orientation="Vertical"
											IsItemsHost="True" />
									</ScrollViewer>
								</Border>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="txtStyle">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Left" />
				<Setter
					Property="Margin"
					Value="10 0 10 0" />
			</Style>
			<Style
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource defaultButtonStyle}"
				x:Key="{x:Type Button}">
				<Setter
					Property="Margin"
					Value="5 5 5 5" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Row="1">
		<Border
			Padding="5 7 5 7"
			Margin="10 5"
			BorderBrush="#8e9192"
			BorderThickness="1">
			<Border.Background>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Color="#d2d2d2"
						Offset="0" />
					<GradientStop
						Color="#b0b0b0"
						Offset="1" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="50" />
					<RowDefinition
						Height="50" />
					<RowDefinition />
					<RowDefinition
						Height="50" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Grid
					Row="0"
					ColumnSpan="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<ComboBox
						Grid.Column="0"
						FontSize="22"
						Margin="0 0 10 0 "
						ScrollViewer.PanningMode="None"
						ItemsSource="{Binding Modes}"
						SelectedItem="{Binding Path=SelectedMode, Mode=TwoWay}" />
					<ComboBox
						Grid.Column="1"
						FontSize="22"
						Margin="10 0 20 0"
						ScrollViewer.PanningMode="None"
						ItemsSource="{Binding DataModes}"
						SelectedItem="{Binding Path=SelectedDataMode, Mode=TwoWay}" />
					<ComboBox
						Grid.Column="2"
						FontSize="22"
						Margin="10 0 20 0"
						ScrollViewer.PanningMode="None"
						ItemsSource="{Binding DataModes}"
						SelectedItem="{Binding Path=SelectedDataMode2, Mode=TwoWay}"
						Visibility="{Binding Path=DateVisible, Converter={StaticResource bVisConverter}}" />
				</Grid>
				<RepeatButton
					Grid.Row="1"
					Grid.Column="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 5 0 0"
					Command="{Binding PreviousItemCommand}">
					<Image
						Source="..\img\arrow-up.png"
						Stretch="None" />
				</RepeatButton>
				<Button
					Grid.Row="1"
					Grid.Column="1"
					Style="{StaticResource btnMainMenu}"
					Margin="0 5 0 0"
					Command="{Binding FirstItemCommand}">
					<Image
						Source="..\img\arrow2-up.png"
						Stretch="None" />
				</Button>
				<ScrollViewer
					Grid.ColumnSpan="2"
					Grid.Row="2"
					HorizontalScrollBarVisibility="Visible"
					Margin="0"
					Focusable="False"
					PanningMode="None">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*"
								MinHeight="40" />
							<RowDefinition
								Height="20*" />
						</Grid.RowDefinitions>
						<Border
							BorderThickness="1"
							Grid.Row="0">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Color="#d2d2d2"
										Offset="0" />
									<GradientStop
										Color="#b0b0b0"
										Offset="1" />
								</LinearGradientBrush>
							</Border.Background>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="140" />
									<ColumnDefinition
										Width="140" />
									<ColumnDefinition
										Width="140" />
									<ColumnDefinition
										Width="140" />
									<ColumnDefinition
										Width="100" />
									<ColumnDefinition
										Width="285" />
									<ColumnDefinition
										Width="140" />
									<ColumnDefinition
										Width="140" />
								</Grid.ColumnDefinitions>
								<Border
									Grid.Row="0"
									Grid.Column="1"
									Grid.ColumnSpan="1"
									BorderBrush="#b6b6b6"
									BorderThickness="1 0 1 0" />
								<Border
									Grid.Row="0"
									Grid.Column="3"
									Grid.ColumnSpan="1"
									BorderBrush="#b6b6b6"
									BorderThickness="1 0 1 0" />
								<Border
									Grid.Row="0"
									Grid.Column="5"
									Grid.ColumnSpan="1"
									BorderBrush="#b6b6b6"
									BorderThickness="1 0 1 0" />
								<Border
									Grid.Row="0"
									Grid.Column="7"
									Grid.ColumnSpan="1"
									BorderBrush="#b6b6b6"
									BorderThickness="1 0 0 0" />
								<TextBlock
									Grid.Column="0"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrStartTime.LocalizedText, FallbackValue=Startzeit}" />
								<TextBlock
									Grid.Column="1"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrEndTime.LocalizedText, FallbackValue=Endzeit}" />
								<TextBlock
									Grid.Column="2"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrUser.LocalizedText, FallbackValue=Benutzer}" />
								<TextBlock
									Grid.Column="3"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrProducts.LocalizedText, FallbackValue=Produkt}" />
								<TextBlock
									Grid.Column="4"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrConvey.LocalizedText, FallbackValue=Anzahl}" />
								<TextBlock
									Grid.Column="5"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrTestballs.LocalizedText, FallbackValue=Testkörper}" />
								<TextBlock
									Grid.Column="6"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrResult.LocalizedText, FallbackValue=Ergebnis}" />
								<TextBlock
									Grid.Column="7"
									FontSize="20"
									FontWeight="SemiBold"
									Style="{StaticResource txtStyle}"
									Text="{Binding Path=StrEndResult.LocalizedText, FallbackValue=Endergebnis}" />
							</Grid>
						</Border>
						<ListBox
							Grid.Row="1"
							Background="#e7efc5"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ScrollViewer.VerticalScrollBarVisibility="Visible"
							ItemsSource="{Binding Path=Entries}"
							SelectedItem="{Binding Path=SelectedEntry, Mode=TwoWay}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid
										Background="{Binding Path=endresult, Converter={StaticResource AuditToBrushConverter}}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="140" />
											<ColumnDefinition
												Width="140" />
											<ColumnDefinition
												Width="140" />
											<ColumnDefinition
												Width="140" />
											<ColumnDefinition
												Width="100" />
											<ColumnDefinition
												Width="285" />
											<ColumnDefinition
												Width="140" />
											<ColumnDefinition
												Width="140" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource txtStyle}"
											VerticalAlignment="Top"
											Text="{Binding startDate}" />
										<TextBlock
											Grid.Column="1"
											Style="{StaticResource txtStyle}"
											VerticalAlignment="Top"
											Text="{Binding endDate}" />
										<Grid
											Column="2">
											<Grid.RowDefinitions>
												<RowDefinition
													Height="20" />
												<RowDefinition
													Height="20" />
											</Grid.RowDefinitions>
											<TextBlock
												Grid.Row="0"
												Style="{StaticResource txtStyle}"
												Text="{Binding userName}" />
											<TextBlock
												Grid.Row="1"
												Style="{StaticResource txtStyle}"
												Text="{Binding userId}" />
										</Grid>
										<Grid
											Column="3">
											<Grid.RowDefinitions>
												<RowDefinition
													Height="20" />
												<RowDefinition
													Height="20" />
												<RowDefinition
													Height="20" />
											</Grid.RowDefinitions>
											<TextBlock
												Grid.Row="0"
												Style="{StaticResource txtStyle}"
												Text="{Binding productName}" />
											<TextBlock
												Grid.Row="1"
												Style="{StaticResource txtStyle}"
												Text="{Binding productNumber}" />
											<TextBlock
												Grid.Row="2"
												Style="{StaticResource txtStyle}"
												Text="{Binding batchNumber}" />
										</Grid>
										<TextBlock
											Grid.Column="4"
											Style="{StaticResource txtStyle}"
											VerticalAlignment="Top"
											Text="{Binding numberConveyed}" />
										<Grid
											Column="5">
											<Grid.RowDefinitions>
												<RowDefinition
													Height="20" />
												<RowDefinition
													Height="20" />
												<RowDefinition
													Height="20" />
												<RowDefinition>
													<FrameworkContentElement.Style>
														<Style
															TargetType="{x:Type RowDefinition}">
															<Setter
																Property="Height"
																Value="20" />
															<Style.Triggers>
																<DataTrigger
																	Value=""
																	Binding="{Binding testcard4}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding testcard4}"
																	Value="{x:Null}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkContentElement.Style>
												</RowDefinition>
												<RowDefinition>
													<FrameworkContentElement.Style>
														<Style
															TargetType="{x:Type RowDefinition}">
															<Setter
																Property="Height"
																Value="20" />
															<Style.Triggers>
																<DataTrigger
																	Value=""
																	Binding="{Binding testcard5}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding testcard4}"
																	Value="{x:Null}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkContentElement.Style>
												</RowDefinition>
											</Grid.RowDefinitions>
											<TextBlock
												Grid.Row="0"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcard1}" />
											<TextBlock
												Grid.Row="1"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcard2}" />
											<TextBlock
												Grid.Row="2"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcard3}" />
											<TextBlock
												Grid.Row="3"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcard4}" />
											<TextBlock
												Grid.Row="4"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcard5}" />
										</Grid>
										<Grid
											Column="6">
											<Grid.RowDefinitions>
												<RowDefinition />
												<RowDefinition />
												<RowDefinition />
												<RowDefinition>
													<FrameworkContentElement.Style>
														<Style
															TargetType="{x:Type RowDefinition}">
															<Setter
																Property="Height"
																Value="20" />
															<Style.Triggers>
																<DataTrigger
																	Value=""
																	Binding="{Binding testcard4}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding testcard4}"
																	Value="{x:Null}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkContentElement.Style>
												</RowDefinition>
												<RowDefinition>
													<FrameworkContentElement.Style>
														<Style
															TargetType="{x:Type RowDefinition}">
															<Setter
																Property="Height"
																Value="20" />
															<Style.Triggers>
																<DataTrigger
																	Value=""
																	Binding="{Binding testcard5}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding testcard4}"
																	Value="{x:Null}">
																	<Setter
																		Property="Height"
																		Value="0" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkContentElement.Style>
												</RowDefinition>
											</Grid.RowDefinitions>
											<TextBlock
												Grid.Row="0"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcardResult1}" />
											<TextBlock
												Grid.Row="1"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcardResult2}" />
											<TextBlock
												Grid.Row="2"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcardResult3}" />
											<TextBlock
												Grid.Row="3"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcardResult4}" />
											<TextBlock
												Grid.Row="4"
												Style="{StaticResource txtStyle}"
												Text="{Binding testcardResult5}" />
										</Grid>
										<TextBlock
											Grid.Column="7"
											Style="{StaticResource txtStyle}"
											VerticalAlignment="Top"
											Text="{Binding endresult}" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemContainerStyle>
								<Style
									TargetType="{x:Type ListBoxItem}">
									<Setter
										Property="common:ListBoxItemBehavior.IsBroughtIntoViewWhenSelected"
										Value="True" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type ListBoxItem}">
												<Border
													Name="Border"
													Padding="2"
													SnapsToDevicePixels="True">
													<ContentPresenter />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger
														Property="ListBoxItem.IsSelected"
														Value="True">
														<Setter
															TargetName="Border"
															Property="Background"
															Value="#FF000000" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ItemsControl.ItemContainerStyle>
						</ListBox>
					</Grid>
				</ScrollViewer>
				<RepeatButton
					Grid.Row="3"
					Grid.Column="0"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 0 5"
					Command="{Binding NextItemCommand}">
					<Image
						Source="..\img\arrow-down.png"
						Stretch="None" />
				</RepeatButton>
				<Button
					Grid.Row="3"
					Grid.Column="1"
					Style="{StaticResource btnMainMenu}"
					Margin="0 0 0 5"
					Command="{Binding LastItemCommand}">
					<Image
						Source="..\img\arrow2-down.png"
						Stretch="None" />
				</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>
