<Window
	x:Class="GUI_XRS.AuditCheckNew.SignatureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:GUI_XRS.AuditCheckNew"
	Name="signatureBox"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	WindowStartupLocation="Manual"
	Topmost="True"
	WindowState="{Binding WState}"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				x:Key="DefaultStyle">
				<Setter
					Property="Background">
					<Setter.Value>
						<LinearGradientBrush
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#d2d2d2" />
							<GradientStop
								Offset="1.00"
								Color="#b8b8b8" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
				<Setter
					Property="BorderBrush"
					Value="#505050" />
				<Setter
					Property="BorderThickness"
					Value="0 0 0 1" />
				<Setter
					Property="Border.CornerRadius"
					Value="7 7 0 0" />
				<Setter
					Property="Foreground"
					Value="#505050" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="21" />
				<Setter
					Property="TextBlock.Padding"
					Value="10 0 0 0" />
			</Style>
			<Style
				BasedOn="{StaticResource DefaultStyle}"
				x:Key="OkStyle">
				<Setter
					Property="Background">
					<Setter.Value>
						<LinearGradientBrush
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#52d62a" />
							<GradientStop
								Offset="1.00"
								Color="#358a06" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				BasedOn="{StaticResource DefaultStyle}"
				x:Key="WarningStyle">
				<Setter
					Property="Background">
					<Setter.Value>
						<LinearGradientBrush
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#f4cb98" />
							<GradientStop
								Offset="1.00"
								Color="#f7941d" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				BasedOn="{StaticResource DefaultStyle}"
				x:Key="ErrorStyle">
				<Setter
					Property="Background">
					<Setter.Value>
						<LinearGradientBrush
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#cf6565" />
							<GradientStop
								Offset="1.00"
								Color="#c53131" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
				<Setter
					Property="Foreground"
					Value="#d2d2d2" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="overlay">
		<Panel.Background>
			<LinearGradientBrush
				MappingMode="Absolute"
				StartPoint="0,0"
				EndPoint="1,1"
				SpreadMethod="Repeat">
				<GradientStop
					Offset="0"
					Color="#191919" />
				<GradientStop
					Offset="0.3"
					Color="#191919" />
				<GradientStop
					Offset="0.3"
					Color="Transparent" />
				<GradientStop
					Offset="1"
					Color="Transparent" />
				<Brush.Transform>
					<ScaleTransform
						ScaleX="2"
						ScaleY="2" />
				</Brush.Transform>
			</LinearGradientBrush>
		</Panel.Background>
	</Grid>
</Window>
