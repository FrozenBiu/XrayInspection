<Window
	x:Class="GUI_XRS.Keyboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	Name="windowKeyboard"
	Title="TouchScreenKeyboard"
	WindowStartupLocation="Manual"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	ResizeMode="NoResize"
	Topmost="True"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	WindowState="{Binding WState}"
	Width="{Binding WindowWidth, Mode=TwoWay}"
	Height="{Binding WindowHeight, Mode=TwoWay}"
	Left="{Binding WLeft, Mode=TwoWay}"
	Top="{Binding WTop, Mode=TwoWay}"
	common:ControlCommandBehavior.TextInputCommand="{Binding AddCharToPasswordCommand}"
	common:ControlCommandBehavior.UnloadedCommand="{Binding CleanUpCommand}"
	Loaded="Window_Loaded"
	ButtonBase.Click="Window_Click"
	MouseUp="Window_MouseUp">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource mainButtonStyle}"
				x:Key="{x:Type Button}" />
			<Style
				TargetType="{x:Type RepeatButton}"
				BasedOn="{StaticResource mainButtonStyle}"
				x:Key="{x:Type RepeatButton}" />
			<Style
				TargetType="{x:Type l:SelectionBindingTextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="{x:Type l:SelectionBindingTextBox}" />
			<Style
				TargetType="{x:Type ToggleButton}"
				BasedOn="{StaticResource mainButtonStyle}"
				x:Key="capsButton">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<Image
								Source="..\img\caps.png"
								Stretch="None" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger
						Property="ToggleButton.IsChecked"
						Value="True">
						<Setter
							Property="ContentTemplate">
							<Setter.Value>
								<DataTemplate>
									<Image
										Source="..\img\caps_active.png"
										Stretch="None" />
								</DataTemplate>
							</Setter.Value>
						</Setter>
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type ToggleButton}">
									<Grid>
										<Border
											Name="BorderUp"
											BorderThickness="1.5"
											CornerRadius="5"
											BorderBrush="#5f5f5f">
											<Border.Background>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="0,1">
													<GradientStop
														Offset="0.00"
														Color="#c2c2c2" />
													<GradientStop
														Offset="0.10"
														Color="#8b8d8d" />
													<GradientStop
														Offset="1.00"
														Color="#646767" />
												</LinearGradientBrush>
											</Border.Background>
											<Border
												Margin="3"
												CornerRadius="3">
												<Border.Background>
													<LinearGradientBrush
														StartPoint="0,0"
														EndPoint="0,1">
														<GradientStop
															Offset="0.00"
															Color="#9c9e9e" />
														<GradientStop
															Offset="1.00"
															Color="#646767" />
													</LinearGradientBrush>
												</Border.Background>
											</Border>
										</Border>
										<Border
											Name="BorderDown"
											BorderThickness="1.5"
											CornerRadius="5"
											BorderBrush="#5f5f5f"
											Opacity="0">
											<Border.Background>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="0,1">
													<GradientStop
														Offset="0.00"
														Color="#c2c2c2" />
													<GradientStop
														Offset="0.40"
														Color="#8b8d8d" />
													<GradientStop
														Offset="1.00"
														Color="#646767" />
												</LinearGradientBrush>
											</Border.Background>
										</Border>
										<ContentPresenter
											Name="Contents" />
									</Grid>
									<FrameworkTemplate.Resources>
										<ResourceDictionary>
											<Storyboard
												x:Key="ButtonDownTimeLine">
												<DoubleAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="BorderDown"
													Storyboard.TargetProperty="Opacity">
													<SplineDoubleKeyFrame
														KeyTime="00:00:00.05"
														Value="1" />
												</DoubleAnimationUsingKeyFrames>
												<ThicknessAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="Contents"
													Storyboard.TargetProperty="Margin">
													<SplineThicknessKeyFrame
														KeyTime="00:00:00.025"
														Value="4,4,2,2" />
												</ThicknessAnimationUsingKeyFrames>
											</Storyboard>
											<Storyboard
												x:Key="ButtonUpTimeLine">
												<DoubleAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="BorderDown"
													Storyboard.TargetProperty="Opacity">
													<SplineDoubleKeyFrame
														KeyTime="00:00:00.25"
														Value="0" />
												</DoubleAnimationUsingKeyFrames>
												<ThicknessAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="Contents"
													Storyboard.TargetProperty="Margin">
													<SplineThicknessKeyFrame
														KeyTime="00:00:00.25"
														Value="3,3,3,3" />
												</ThicknessAnimationUsingKeyFrames>
											</Storyboard>
										</ResourceDictionary>
									</FrameworkTemplate.Resources>
									<ControlTemplate.Triggers>
										<Trigger
											Property="IsPressed"
											Value="True">
											<Setter
												TargetName="BorderDown"
												Property="UIElement.Opacity"
												Value="1" />
											<Setter
												TargetName="Contents"
												Property="Margin"
												Value="4,4,2,2" />
											<TriggerBase.EnterActions>
												<BeginStoryboard
													Storyboard="{StaticResource ButtonDownTimeLine}" />
											</TriggerBase.EnterActions>
											<TriggerBase.ExitActions>
												<BeginStoryboard
													Storyboard="{StaticResource ButtonUpTimeLine}" />
											</TriggerBase.ExitActions>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style
				TargetType="{x:Type ToggleButton}"
				BasedOn="{StaticResource mainButtonStyle}"
				x:Key="symButton">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<TextBlock
								Text="Sym"
								FontSize="26" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger
						Property="ToggleButton.IsChecked"
						Value="True">
						<Setter
							Property="ContentTemplate">
							<Setter.Value>
								<DataTemplate>
									<TextBlock
										Text="Sym"
										FontSize="26"
										Foreground="#FFFFFFFF"
										TextAlignment="Center"
										VerticalAlignment="Center" />
								</DataTemplate>
							</Setter.Value>
						</Setter>
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type ToggleButton}">
									<Grid>
										<Border
											Name="BorderUp"
											BorderThickness="1.5"
											CornerRadius="5"
											BorderBrush="#5f5f5f">
											<Border.Background>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="0,1">
													<GradientStop
														Offset="0.00"
														Color="#c2c2c2" />
													<GradientStop
														Offset="0.10"
														Color="#8b8d8d" />
													<GradientStop
														Offset="1.00"
														Color="#646767" />
												</LinearGradientBrush>
											</Border.Background>
											<Border
												Margin="3"
												CornerRadius="3">
												<Border.Background>
													<LinearGradientBrush
														StartPoint="0,0"
														EndPoint="0,1">
														<GradientStop
															Offset="0.00"
															Color="#9c9e9e" />
														<GradientStop
															Offset="1.00"
															Color="#646767" />
													</LinearGradientBrush>
												</Border.Background>
											</Border>
										</Border>
										<Border
											Name="BorderDown"
											BorderThickness="1.5"
											CornerRadius="5"
											BorderBrush="#5f5f5f"
											Opacity="0">
											<Border.Background>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="0,1">
													<GradientStop
														Offset="0.00"
														Color="#c2c2c2" />
													<GradientStop
														Offset="0.40"
														Color="#8b8d8d" />
													<GradientStop
														Offset="1.00"
														Color="#646767" />
												</LinearGradientBrush>
											</Border.Background>
										</Border>
										<ContentPresenter
											Name="Contents" />
									</Grid>
									<FrameworkTemplate.Resources>
										<ResourceDictionary>
											<Storyboard
												x:Key="ButtonDownTimeLine">
												<DoubleAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="BorderDown"
													Storyboard.TargetProperty="Opacity">
													<SplineDoubleKeyFrame
														KeyTime="00:00:00.05"
														Value="1" />
												</DoubleAnimationUsingKeyFrames>
												<ThicknessAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="Contents"
													Storyboard.TargetProperty="Margin">
													<SplineThicknessKeyFrame
														KeyTime="00:00:00.025"
														Value="4,4,2,2" />
												</ThicknessAnimationUsingKeyFrames>
											</Storyboard>
											<Storyboard
												x:Key="ButtonUpTimeLine">
												<DoubleAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="BorderDown"
													Storyboard.TargetProperty="Opacity">
													<SplineDoubleKeyFrame
														KeyTime="00:00:00.25"
														Value="0" />
												</DoubleAnimationUsingKeyFrames>
												<ThicknessAnimationUsingKeyFrames
													BeginTime="00:00:00"
													Storyboard.TargetName="Contents"
													Storyboard.TargetProperty="Margin">
													<SplineThicknessKeyFrame
														KeyTime="00:00:00.25"
														Value="3,3,3,3" />
												</ThicknessAnimationUsingKeyFrames>
											</Storyboard>
										</ResourceDictionary>
									</FrameworkTemplate.Resources>
									<ControlTemplate.Triggers>
										<Trigger
											Property="IsPressed"
											Value="True">
											<Setter
												TargetName="BorderDown"
												Property="UIElement.Opacity"
												Value="1" />
											<Setter
												TargetName="Contents"
												Property="Margin"
												Value="4,4,2,2" />
											<TriggerBase.EnterActions>
												<BeginStoryboard
													Storyboard="{StaticResource ButtonDownTimeLine}" />
											</TriggerBase.EnterActions>
											<TriggerBase.ExitActions>
												<BeginStoryboard
													Storyboard="{StaticResource ButtonUpTimeLine}" />
											</TriggerBase.ExitActions>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Trigger>
				</Style.Triggers>
			</Style>
			<l:BoolToVisibilityCollapsedConverter
				x:Key="boolToVisibilityCollapsedConverter" />
			<l:KeyboardTypeBoxConverter
				x:Key="keyboardTypeBoxConverter" />
			<l:BoolToVisibilityHiddenConverter
				x:Key="boolToVisibilityHiddenConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="{Binding Source={StaticResource MainWindowHeaderHeight}}" />
			<RowDefinition />
			<RowDefinition
				Height="{Binding Source={StaticResource MainWindowFooterHeight}}" />
		</Grid.RowDefinitions>
		<Grid
			Row="1"
			Background="#FFD3D3D3" />
		<ScrollViewer
			Grid.Row="1">
			<DockPanel
				Name="mainPanel"
				LastChildFill="True">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<l:StringToVisibilityHiddenConverter
							x:Key="stringToVisibilityHiddenConverter" />
						<Style
							TargetType="{x:Type Button}"
							BasedOn="{StaticResource mainButtonStyle}"
							x:Key="{x:Type Button}">
							<Setter
								Property="Command"
								Value="{Binding AddToDisplayCommand}" />
							<Setter
								Property="CommandParameter"
								Value="{Binding Path=Content, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="Visibility"
								Value="{Binding Path=Content, FallbackValue=Visible, RelativeSource={RelativeSource Self}, Converter={StaticResource stringToVisibilityHiddenConverter}}" />
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<Grid
					DockPanel.Dock="Bottom">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						BorderBrush="#8e9192"
						BorderThickness="0 0 0 1"
						Background="#e7efc5">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="2*" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<Grid
								Name="displayPanel"
								HorizontalAlignment="Center"
								Width="400"
								Column="1">
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>
								<TextBlock
									Grid.Row="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="3 3 3 3"
									FontSize="20"
									TextWrapping="Wrap"
									Text="{Binding Description}" />
								<TextBox
									Style="{StaticResource disabledTextBox}"
									Grid.Row="1"
									HorizontalAlignment="Stretch"
									TextAlignment="Center"
									VerticalAlignment="Center"
									Margin="3 3 3 3"
									IsEnabled="False"
									FontSize="20"
									Text="{Binding OldValue}"
									Visibility="{Binding IsNotPasswordKeyboard, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
								<l:SelectionBindingTextBox
									Name="inputBox"
									Grid.Row="2"
									HorizontalAlignment="Stretch"
									TextAlignment="Center"
									VerticalAlignment="Center"
									Margin="3 3 3 3"
									Focusable="True"
									FontSize="20"
									AcceptsReturn="True"
									Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									BindableSelectionStart="{Binding InputBoxSelectionStart, Mode=TwoWay}"
									BindableSelectionLength="{Binding InputBoxSelectionLength, Mode=TwoWay}"
									Visibility="{Binding IsNotPasswordKeyboard, Converter={StaticResource boolToVisibilityCollapsedConverter}}"
									DataObject.Pasting="txtInput_Pasting" />
								<PasswordBox
									Name="passwordBox"
									Grid.Row="2"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									VerticalAlignment="Center"
									Margin="3 3 3 3"
									Focusable="False"
									FontSize="14"
									Visibility="{Binding IsPasswordKeyboard, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
							</Grid>
							<TextBlock
								Grid.Column="2"
								Foreground="#FFFF0000"
								FontSize="20"
								TextWrapping="Wrap"
								FontWeight="Bold"
								Margin="0,10,0,10"
								Text="{Binding StrWrongPasswordEntered.LocalizedText}"
								Visibility="{Binding WrongPasswordEntered, Converter={StaticResource boolToVisibilityHiddenConverter}}" />
						</Grid>
					</Border>
					<Border
						Grid.ColumnSpan="3"
						Grid.Row="1"
						BorderBrush="#ffffff"
						BorderThickness="0 1 0 0"
						Visibility="{Binding NoWidescreen, Mode=OneWay, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
						<Border.Background>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Offset="0.00"
									Color="#dedede" />
								<GradientStop
									Offset="1.00"
									Color="#eceaea" />
							</LinearGradientBrush>
						</Border.Background>
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<l:StringToVisibilityHiddenConverter
									x:Key="stringToVisibilityHiddenConverter" />
								<Style
									TargetType="{x:Type Button}"
									BasedOn="{StaticResource mainButtonStyle}"
									x:Key="{x:Type Button}">
									<Setter
										Property="Command"
										Value="{Binding AddToDisplayCommand}" />
									<Setter
										Property="CommandParameter"
										Value="{Binding Path=Content, RelativeSource={RelativeSource Self}}" />
									<Setter
										Property="Visibility"
										Value="{Binding Path=Content, FallbackValue=Visible, RelativeSource={RelativeSource Self}, Converter={StaticResource stringToVisibilityHiddenConverter}}" />
								</Style>
							</ResourceDictionary>
						</FrameworkElement.Resources>
						<StackPanel
							Orientation="Vertical"
							Height="375"
							VerticalAlignment="Center">
							<StackPanel
								Orientation="Horizontal"
								Width="760"
								Margin="10 0 0 0">
								<Button
									Margin="0 0 0 0"
									Content="{Binding Key1.CurrentChar}" />
								<Button
									Content="{Binding Key2.CurrentChar}" />
								<Button
									Content="{Binding Key3.CurrentChar}" />
								<Button
									Content="{Binding Key4.CurrentChar}" />
								<Button
									Content="{Binding Key5.CurrentChar}" />
								<Button
									Content="{Binding Key6.CurrentChar}" />
								<Button
									Content="{Binding Key7.CurrentChar}" />
								<Button
									Content="{Binding Key8.CurrentChar}" />
								<Button
									Content="{Binding Key9.CurrentChar}" />
								<Button
									Content="{Binding Key0.CurrentChar}" />
							</StackPanel>
							<StackPanel
								Orientation="Horizontal"
								Width="750"
								Margin="0 10 0 0">
								<Button
									Margin="0 0 0 0"
									Content="{Binding KeyQ.CurrentChar}" />
								<Button
									Content="{Binding KeyW.CurrentChar}" />
								<Button
									Content="{Binding KeyE.CurrentChar}" />
								<Button
									Content="{Binding KeyR.CurrentChar}" />
								<Button
									Content="{Binding KeyT.CurrentChar}" />
								<Button
									Content="{Binding KeyZ.CurrentChar}" />
								<Button
									Content="{Binding KeyU.CurrentChar}" />
								<Button
									Content="{Binding KeyI.CurrentChar}" />
								<Button
									Content="{Binding KeyO.CurrentChar}" />
								<Button
									Content="{Binding KeyP.CurrentChar}" />
							</StackPanel>
							<StackPanel
								Orientation="Horizontal"
								Width="Auto"
								Margin="-5 10 20 0"
								HorizontalAlignment="Center">
								<Button
									Margin="15 0 0 0"
									Content="{Binding KeyBackslash.CurrentChar, FallbackValue=/}"
									Visibility="{Binding NetworkVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
								<Button
									Content="{Binding KeyA.CurrentChar}" />
								<Button
									Content="{Binding KeyS.CurrentChar}" />
								<Button
									Content="{Binding KeyD.CurrentChar}" />
								<Button
									Content="{Binding KeyF.CurrentChar}" />
								<Button
									Content="{Binding KeyG.CurrentChar}" />
								<Button
									Content="{Binding KeyH.CurrentChar}" />
								<Button
									Content="{Binding KeyJ.CurrentChar}" />
								<Button
									Content="{Binding KeyK.CurrentChar}" />
								<Button
									Content="{Binding KeyL.CurrentChar}" />
							</StackPanel>
							<StackPanel
								Name="cancelPanel"
								Orientation="Horizontal"
								Width="Auto"
								Margin="-5 10 20 0"
								HorizontalAlignment="Center">
								<Button
									Content="{Binding KeyAt.CurrentChar}"
									Visibility="{Binding EmailVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
								<Button
									Margin="15 0 0 0"
									Content="{Binding KeyDollar.CurrentChar, FallbackValue=/}"
									Visibility="{Binding NetworkVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
								<Button
									Content="{Binding KeyY.CurrentChar}" />
								<Button
									Content="{Binding KeyX.CurrentChar}" />
								<Button
									Content="{Binding KeyC.CurrentChar}" />
								<Button
									Content="{Binding KeyV.CurrentChar}" />
								<Button
									Content="{Binding KeyB.CurrentChar}" />
								<Button
									Content="{Binding KeyN.CurrentChar}" />
								<Button
									Content="{Binding KeyM.CurrentChar}" />
								<Button
									Content="{Binding KeyMinusAndUnderscore.CurrentChar}" />
								<Button
									Content="{Binding KeyPoint.CurrentChar, FallbackValue=.}"
									Visibility="{Binding HasNotEnterButton, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
								<RepeatButton
									Width="140"
									Command="{Binding EnterCommand}"
									Visibility="{Binding HasEnterButton, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
									<ButtonBase.CommandParameter>
										<MultiBinding
											Converter="{StaticResource keyboardTypeBoxConverter}">
											<Binding
												Path="Type" />
											<Binding
												ElementName="inputBox" />
											<Binding
												ElementName="passwordBox" />
										</MultiBinding>
									</ButtonBase.CommandParameter>
									<Image
										Source="..\img\enter_keyboard.png"
										Stretch="None" />
								</RepeatButton>
								<Button
									Style="{StaticResource defaultButtonStyle}"
									Margin="15 0 0 0"
									Foreground="#FF5D0808"
									Command="{Binding CancelAllCommand}"
									Visibility="{Binding CancelVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
									<Image
										Source="..\img\cancel_saving.png"
										Stretch="None" />
								</Button>
							</StackPanel>
							<StackPanel
								Orientation="Horizontal"
								Width="740"
								Margin="0 15 0 0">
								<Button
									Style="{StaticResource okButtonStyle}"
									Margin="0 0 5 0"
									Command="{Binding CommitCommand}">
									<Image
										Source="..\img\ok.png"
										Stretch="None" />
								</Button>
								<ToggleButton
									Width="140"
									Margin="5 0 0 0"
									Style="{StaticResource capsButton}"
									IsChecked="{Binding IsUpperCase}"
									Command="{Binding ToggleCaseCommand}" />
								<Button
									Width="290"
									Content="{Binding KeySpace.CurrentChar}" />
								<RepeatButton
									Width="140"
									Command="{Binding BackspaceCommand}">
									<ButtonBase.CommandParameter>
										<MultiBinding
											Converter="{StaticResource keyboardTypeBoxConverter}">
											<Binding
												Path="Type" />
											<Binding
												ElementName="inputBox" />
											<Binding
												ElementName="passwordBox" />
										</MultiBinding>
									</ButtonBase.CommandParameter>
									<Image
										Source="..\img\delete_keyboard.png"
										Stretch="None" />
								</RepeatButton>
								<Button
									Style="{StaticResource cancelButtonStyle}"
									Margin="15 0 0 0"
									Command="{Binding CancelCommand}">
									<Image
										Source="..\img\cancel.png"
										Stretch="None" />
								</Button>
							</StackPanel>
						</StackPanel>
					</Border>
					<Grid
						Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Border
							Grid.Row="1"
							Grid.ColumnSpan="3"
							BorderBrush="#ffffff"
							BorderThickness="0 1 0 0"
							Visibility="{Binding Widescreen, Mode=OneWay, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
							<Border.Background>
								<LinearGradientBrush
									StartPoint="0,0"
									EndPoint="0,1">
									<GradientStop
										Offset="0.00"
										Color="#dedede" />
									<GradientStop
										Offset="1.00"
										Color="#eceaea" />
								</LinearGradientBrush>
							</Border.Background>
						</Border>
						<Border
							Grid.Row="1"
							Grid.Column="1"
							BorderBrush="#ffffff"
							BorderThickness="0 1 0 0"
							Visibility="{Binding Widescreen, Mode=OneWay, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
							<StackPanel
								Orientation="Vertical"
								Height="375"
								VerticalAlignment="Center">
								<StackPanel
									Orientation="Horizontal"
									Width="750"
									Margin="0 10 0 0">
									<Button
										Margin="0 0 0 0"
										Content="{Binding KeyQ.CurrentChar, FallbackValue=Q}" />
									<Button
										Content="{Binding KeyW.CurrentChar, FallbackValue=W}" />
									<Button
										Content="{Binding KeyE.CurrentChar, FallbackValue=E}" />
									<Button
										Content="{Binding KeyR.CurrentChar, FallbackValue=R}" />
									<Button
										Content="{Binding KeyT.CurrentChar, FallbackValue=T}" />
									<Button
										Content="{Binding KeyZ.CurrentChar, FallbackValue=Z}" />
									<Button
										Content="{Binding KeyU.CurrentChar, FallbackValue=U}" />
									<Button
										Content="{Binding KeyI.CurrentChar, FallbackValue=I}" />
									<Button
										Content="{Binding KeyO.CurrentChar, FallbackValue=O}" />
									<Button
										Content="{Binding KeyP.CurrentChar, FallbackValue=P}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Width="700"
									Margin="0 10 0 0">
									<Button
										Content="{Binding KeyA.CurrentChar, FallbackValue=A}" />
									<Button
										Content="{Binding KeyS.CurrentChar, FallbackValue=S}" />
									<Button
										Content="{Binding KeyD.CurrentChar, FallbackValue=D}" />
									<Button
										Content="{Binding KeyF.CurrentChar, FallbackValue=F}" />
									<Button
										Content="{Binding KeyG.CurrentChar, FallbackValue=G}" />
									<Button
										Content="{Binding KeyH.CurrentChar, FallbackValue=H}" />
									<Button
										Content="{Binding KeyJ.CurrentChar, FallbackValue=J}" />
									<Button
										Content="{Binding KeyK.CurrentChar, FallbackValue=K}" />
									<Button
										Content="{Binding KeyL.CurrentChar, FallbackValue=L}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Width="Auto"
									Margin="65 10 0 0">
									<Button
										Margin="10 0 0 0"
										Content="{Binding KeyBracketAt.CurrentChar, FallbackValue=@}"
										Visibility="{Binding EmailVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}" />
									<Button
										Content="{Binding KeyY.CurrentChar, FallbackValue=Y}" />
									<Button
										Content="{Binding KeyX.CurrentChar, FallbackValue=X}" />
									<Button
										Content="{Binding KeyC.CurrentChar, FallbackValue=C}" />
									<Button
										Content="{Binding KeyV.CurrentChar, FallbackValue=V}" />
									<Button
										Content="{Binding KeyB.CurrentChar, FallbackValue=B}" />
									<Button
										Content="{Binding KeyN.CurrentChar, FallbackValue=N}" />
									<Button
										Content="{Binding KeyM.CurrentChar, FallbackValue=M}" />
									<RepeatButton
										Width="140"
										Command="{Binding EnterCommand}"
										Visibility="{Binding HasEnterButton, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
										<ButtonBase.CommandParameter>
											<MultiBinding
												Converter="{StaticResource keyboardTypeBoxConverter}">
												<Binding
													Path="Type" />
												<Binding
													ElementName="inputBox" />
												<Binding
													ElementName="passwordBox" />
											</MultiBinding>
										</ButtonBase.CommandParameter>
										<Image
											Source="..\img\enter_keyboard.png"
											Stretch="None" />
									</RepeatButton>
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Width="740"
									Margin="0 10 0 0">
									<Button
										Style="{StaticResource okButtonStyle}"
										Margin="0 0 5 0"
										Command="{Binding CommitCommand}">
										<Image
											Source="..\img\ok.png"
											Stretch="None" />
									</Button>
									<ToggleButton
										Width="140"
										Margin="5 0 0 0"
										Style="{StaticResource capsButton}"
										IsChecked="{Binding IsUpperCase}"
										Command="{Binding ToggleCaseCommand}" />
									<Button
										Width="290"
										Content="{Binding KeySpace.CurrentChar}" />
									<RepeatButton
										Width="140"
										Command="{Binding BackspaceCommand}">
										<ButtonBase.CommandParameter>
											<MultiBinding
												Converter="{StaticResource keyboardTypeBoxConverter}">
												<Binding
													Path="Type" />
												<Binding
													ElementName="inputBox" />
												<Binding
													ElementName="passwordBox" />
											</MultiBinding>
										</ButtonBase.CommandParameter>
										<Image
											Source="..\img\delete_keyboard.png"
											Stretch="None" />
									</RepeatButton>
									<Button
										Style="{StaticResource cancelButtonStyle}"
										Margin="15 0 0 0"
										Command="{Binding CancelCommand}">
										<Image
											Source="..\img\cancel.png"
											Stretch="None" />
									</Button>
								</StackPanel>
							</StackPanel>
						</Border>
						<Border
							Grid.Row="1"
							Grid.Column="2"
							BorderBrush="#ffffff"
							BorderThickness="0 1 0 0"
							Width="250"
							HorizontalAlignment="Left"
							Margin="30 0 20 0"
							Visibility="{Binding Widescreen, Mode=OneWay, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
							<StackPanel
								Orientation="Vertical"
								Height="375"
								VerticalAlignment="Center">
								<StackPanel
									Orientation="Horizontal"
									Margin="0 10 0 0">
									<Button
										Content="{Binding Key1.CurrentChar, FallbackValue=1}" />
									<Button
										Content="{Binding Key2.CurrentChar, FallbackValue=2}" />
									<Button
										Content="{Binding Key3.CurrentChar, FallbackValue=3}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Margin="0 10 0 0">
									<Button
										Content="{Binding Key4.CurrentChar, FallbackValue=4}" />
									<Button
										Content="{Binding Key5.CurrentChar, FallbackValue=5}" />
									<Button
										Content="{Binding Key6.CurrentChar, FallbackValue=6}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Margin="0 10 0 0">
									<Button
										Content="{Binding Key7.CurrentChar, FallbackValue=7}" />
									<Button
										Content="{Binding Key8.CurrentChar, FallbackValue=8}" />
									<Button
										Content="{Binding Key9.CurrentChar, FallbackValue=9}" />
								</StackPanel>
								<StackPanel
									Name="cancelPanel2"
									Orientation="Horizontal"
									Margin="75 10 0 0">
									<Button
										Style="{StaticResource defaultButtonStyle}"
										Margin="0 0 15 0"
										Foreground="#FF5D0808"
										Command="{Binding CancelAllCommand}"
										Visibility="{Binding CancelVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
										<Image
											Source="..\img\cancel_saving.png"
											Stretch="None" />
									</Button>
									<Button
										Content="{Binding Key0.CurrentChar, FallbackValue=0}" />
								</StackPanel>
							</StackPanel>
						</Border>
						<Border
							Grid.Row="1"
							Grid.Column="0"
							BorderBrush="#ffffff"
							BorderThickness="0 1 0 0"
							Width="250"
							HorizontalAlignment="Right"
							Margin="20 0 30 0"
							Visibility="{Binding Widescreen, Mode=OneWay, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
							<StackPanel
								Orientation="Vertical"
								Height="375"
								VerticalAlignment="Center">
								<StackPanel
									Orientation="Horizontal"
									Margin="0 10 0 0">
									<Button
										Content="{Binding KeyPlus.CurrentChar, FallbackValue=+}" />
									<Button
										Content="{Binding KeyMinus.CurrentChar, FallbackValue=-}" />
									<Button
										Content="{Binding KeyUnderscore.CurrentChar, FallbackValue=_}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Margin="0 10 0 0">
									<Button
										Content="{Binding KeySemicolon.CurrentChar, FallbackValue=;}" />
									<Button
										Content="{Binding KeyComma.CurrentChar, FallbackValue=,}" />
									<Button
										Content="{Binding KeyPoint.CurrentChar, FallbackValue=.}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Margin="37 10 0 0">
									<Button
										Content="{Binding KeyBracketOpen.CurrentChar, FallbackValue=(}" />
									<Button
										Content="{Binding KeyBracketClose.CurrentChar, FallbackValue=)}" />
								</StackPanel>
								<StackPanel
									Orientation="Horizontal"
									Margin="0 10 0 0"
									Visibility="{Binding NetworkVisibility, Converter={StaticResource boolToVisibilityCollapsedConverter}}">
									<Button
										Content="{Binding KeyBackSlash.CurrentChar, FallbackValue=/}" />
									<Button
										Content="{Binding KeyDollar.CurrentChar, FallbackValue=$}" />
									<Button
										Content="{Binding KeySlash.CurrentChar, FallbackValue=/}" />
								</StackPanel>
							</StackPanel>
						</Border>
					</Grid>
				</Grid>
			</DockPanel>
		</ScrollViewer>
	</Grid>
</Window>
