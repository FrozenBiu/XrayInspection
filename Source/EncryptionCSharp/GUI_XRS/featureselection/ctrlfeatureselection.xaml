<UserControl
	x:Class="GUI_XRS.CtrlFeatureSelection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
			<l:BoolToVisibilityCollapsedConverter
				x:Key="bVisConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 12">
			<ScrollViewer>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="2*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="{Binding AdvancedFiltersVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding AdvancedFiltersVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding MultiLaneViewVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding MultiProductVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding MultiLaneProductVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding MultiLaneViewVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding ZoneAnalyserVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding SensPredAndComplModeVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding SensPredAndComplModeVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding BulkObjectProductsVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding BulkObjectProducts.Enabled, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding OtherFeaturesVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding HighThroughputModeVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding AnomalyDetectionVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding ObjectDetectionVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="15"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="2"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="3"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="4"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="6"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="7"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="8"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="9"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="10"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="11"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="12"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="13"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="14"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="Software package 1"
						Margin="10 10 10 10"
						HorizontalAlignment="Left" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="{Binding AdvancedFilters.Description}" />
					<CheckBox
						Grid.Row="1"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=AdvancedFilters.Enabled}" />
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Text="Software package 2"
						Margin="10 10 10 10"
						HorizontalAlignment="Left" />
					<TextBlock
						Grid.Row="3"
						Grid.Column="0"
						Text="{Binding MultiProduct.Description}" />
					<CheckBox
						Grid.Row="3"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=MultiProduct.Enabled}" />
					<TextBlock
						Grid.Row="4"
						Grid.Column="0"
						Text="{Binding MultiLaneProduct.Description}" />
					<CheckBox
						Grid.Row="4"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=MultiLaneProduct.Enabled}" />
					<TextBlock
						Grid.Row="5"
						Grid.Column="0"
						Text="{Binding MultiLaneInspection.Description}" />
					<CheckBox
						Grid.Row="5"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=MultiLaneInspection.Enabled}" />
					<TextBlock
						Grid.Row="6"
						Grid.Column="0"
						Text="{Binding ZoneAnalyser.Description}" />
					<CheckBox
						Grid.Row="6"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=ZoneAnalyser.Enabled}" />
					<TextBlock
						Grid.Row="7"
						Grid.Column="0"
						Text="Software package 3"
						Margin="10 10 10 10"
						HorizontalAlignment="Left" />
					<TextBlock
						Grid.Row="8"
						Grid.Column="0"
						Text="{Binding SensPredAndComplMode.Description}" />
					<CheckBox
						Grid.Row="8"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=SensPredAndComplMode.Enabled}" />
					<TextBlock
						Grid.Row="9"
						Grid.Column="0"
						Text="{Binding BulkObjectProducts.Description}" />
					<CheckBox
						Grid.Row="9"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=BulkObjectProducts.Enabled}" />
					<TextBlock
						Grid.Row="10"
						Grid.Column="0"
						Text="{Binding ObjectBasedFlapsFeature.Description}" />
					<Button
						Style="{StaticResource defaultButtonStyle}"
						Grid.Row="10"
						Grid.Column="1"
						Margin="5"
						Command="{Binding ShowObjectBasedFlapsCommand}"
						Visibility="{Binding ObjectBasedFlapsEnabled, Converter={StaticResource bVisConverter}}">
						<Image
							Source="../img/settings.png"
							Height="40" />
					</Button>
					<TextBlock
						Grid.Row="11"
						Grid.Column="0"
						Text="Other features"
						Margin="10 10 10 10"
						HorizontalAlignment="Left" />
					<TextBlock
						Grid.Row="12"
						Grid.Column="0"
						Text="{Binding HighThroughputMode.Description}" />
					<CheckBox
						Grid.Row="12"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=HighThroughputMode.Enabled}" />
					<TextBlock
						Grid.Row="13"
						Grid.Column="0"
						Text="{Binding AnomalyDetection.Description}" />
					<CheckBox
						Grid.Row="13"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=AnomalyDetection.Enabled}" />
					<TextBlock
						Grid.Row="14"
						Grid.Column="0"
						Text="{Binding ObjectDetection.Description}" />
					<CheckBox
						Grid.Row="14"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=ObjectDetection.Enabled}" />
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
