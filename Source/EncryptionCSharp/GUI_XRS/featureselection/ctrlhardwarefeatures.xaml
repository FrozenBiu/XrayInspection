<UserControl
	x:Class="GUI_XRS.CtrlHardwareFeatures" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\MasterResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
				<Setter
					Property="Margin"
					Value="20 0 25 0" />
				<Setter
					Property="TextWrapping"
					Value="Wrap" />
			</Style>
			<l:BoolGridLengthStarConverter
				x:Key="boolGridLengthStarConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 12">
			<ScrollViewer>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="2*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="{Binding RFIDLoginVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding IsHigherLevelAndLineJamVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding IsHigherLevelAndLineJamVisible, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding IsBulkMachine, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding IsBulkMachine, Converter={StaticResource boolGridLengthStarConverter}}" />
						<RowDefinition
							Height="{Binding IsBulkMachine, Converter={StaticResource boolGridLengthStarConverter}}" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.RowSpan="6"
						Background="#e7efc5"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 1 0" />
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="2"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="3"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="4"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<Border
						Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						BorderBrush="#b6b6b6"
						BorderThickness="0 0 0 1" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Text="RFID Login" />
					<CheckBox
						Grid.Row="0"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=EnableRFIDLoginFeature}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Text="Higher level features" />
					<CheckBox
						Grid.Row="1"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=EnableHigherLevelFeatures}" />
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Text="Line jam sensor" />
					<CheckBox
						Grid.Row="2"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=EnableLineJamSensor}" />
					<TextBlock
						Grid.Row="3"
						Grid.Column="0"
						Text="Bin full sensor" />
					<CheckBox
						Grid.Row="3"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=EnableBulkBinFullSensor}" />
					<TextBlock
						Grid.Row="4"
						Grid.Column="0"
						Text="Reject verify sensor" />
					<CheckBox
						Grid.Row="4"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=EnableBulkRejectVerifySensor}" />
					<TextBlock
						Grid.Row="5"
						Grid.Column="0"
						Text="Speed below 0,8 m/s possible" />
					<CheckBox
						Grid.Row="5"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsChecked="{Binding Path=EnableBulkSpeedBelow08}" />
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
