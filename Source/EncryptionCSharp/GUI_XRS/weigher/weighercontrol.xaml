<UserControl
	x:Class="GUI_XRS.WeigherControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GUI_XRS" xmlns:common="clr-namespace:Common;assembly=Common"
	Stylus.IsPressAndHoldEnabled="False"
	Stylus.IsTapFeedbackEnabled="False"
	Stylus.IsTouchFeedbackEnabled="False"
	Unloaded="WeigherControl_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<l:WeightInGrammWeightUnitConverter
				x:Key="weightInGrammWeightUnitConverter" />
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="{x:Type TextBox}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#cfcfcf" />
							<GradientStop
								Offset="0.02"
								Color="#e9e9e9" />
							<GradientStop
								Offset="0.03"
								Color="#f1f1f1" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#bebebe" />
							<GradientStop
								Offset="0.10"
								Color="#d8d8d8" />
							<GradientStop
								Offset="0.9"
								Color="#d8d8d8" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="Padding"
					Value="10 5 10 5" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontSize"
					Value="30" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="TextBox.TextAlignment"
					Value="Right" />
				<Setter
					Property="Foreground"
					Value="#5e5e5e" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TextBox}">
							<Border
								CornerRadius="3"
								BorderThickness="2"
								Padding="{TemplateBinding Padding}"
								BorderBrush="{DynamicResource textBoxBorder}"
								Background="{DynamicResource textBoxBackground}">
								<ScrollViewer
									Name="PART_ContentHost"
									Margin="0" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="Margin"
					Value="65 5 65 5" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}"
				x:Key="disabledTextBox">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="textBoxBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.00"
								Color="#adadad" />
							<GradientStop
								Offset="0.02"
								Color="#bababa" />
							<GradientStop
								Offset="0.03"
								Color="#c7c7c7" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="textBoxBorder"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0.01"
								Color="#9f9f9f" />
							<GradientStop
								Offset="0.10"
								Color="#bababa" />
							<GradientStop
								Offset="0.9"
								Color="#bababa" />
							<GradientStop
								Offset="1.00"
								Color="#e6e6e6" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Margin"
					Value="65 5 65 5" />
				<Setter
					Property="TextBox.TextWrapping"
					Value="Wrap" />
			</Style>
			<Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="FontWeight"
					Value="Bold" />
				<Setter
					Property="FontSize"
					Value="18" />
				<Setter
					Property="Foreground"
					Value="#272727" />
				<Setter
					Property="TextBlock.TextAlignment"
					Value="Right" />
			</Style>
			<Style
				TargetType="{x:Type l:RadioButtonExtended}"
				x:Key="{x:Type l:RadioButtonExtended}">
				<Style.Resources>
					<ResourceDictionary>
						<LinearGradientBrush
							x:Key="BorderUpBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#828282" />
							<GradientStop
								Offset="0.3"
								Color="#696969" />
							<GradientStop
								Offset="0.5"
								Color="#5f5f5f" />
							<GradientStop
								Offset="1"
								Color="#494949" />
						</LinearGradientBrush>
						<LinearGradientBrush
							x:Key="BorderDownBackground"
							StartPoint="0,0"
							EndPoint="0,1">
							<GradientStop
								Offset="0"
								Color="#494949" />
							<GradientStop
								Offset="0.3"
								Color="#5f5f5f" />
							<GradientStop
								Offset="0.5"
								Color="#696969" />
							<GradientStop
								Offset="1"
								Color="#828282" />
						</LinearGradientBrush>
					</ResourceDictionary>
				</Style.Resources>
				<Setter
					Property="Height"
					Value="50" />
				<Setter
					Property="Width"
					Value="50" />
				<Setter
					Property="Margin"
					Value="0 5 0 5" />
				<Setter
					Property="UIElement.SnapsToDevicePixels"
					Value="True" />
				<Setter
					Property="FrameworkElement.OverridesDefaultStyle"
					Value="True" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type l:RadioButtonExtended}">
							<BulletDecorator
								Background="#00FFFFFF">
								<BulletDecorator.Bullet>
									<Border
										Width="{TemplateBinding Width}"
										Height="{TemplateBinding Height}"
										CornerRadius="3"
										BorderBrush="#4b4b4b"
										BorderThickness="1">
										<Grid>
											<Border
												Name="CheckBoxUp"
												Background="{DynamicResource BorderUpBackground}"
												CornerRadius="2"
												BorderBrush="#c5c5c5"
												BorderThickness="0 1 0 0" />
											<Border
												Name="CheckBoxDown"
												Background="{DynamicResource BorderDownBackground}"
												CornerRadius="2"
												BorderBrush="#9b9b9b"
												BorderThickness="0 1 0 0"
												Opacity="0" />
											<Image
												Name="CheckMarkDisabled"
												Source="..\img\checkmark_disabled.png"
												Stretch="None" />
											<Image
												Name="CheckMarkEnabled"
												Source="..\img\checkmark_enabled.png"
												Stretch="None" />
										</Grid>
									</Border>
								</BulletDecorator.Bullet>
								<ContentPresenter />
							</BulletDecorator>
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<Storyboard
										x:Key="CheckBoxDownTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.05"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.025"
												Value="4,4,2,2" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
									<Storyboard
										x:Key="CheckBoxUpTimeLine">
										<DoubleAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckBoxDown"
											Storyboard.TargetProperty="Opacity">
											<SplineDoubleKeyFrame
												KeyTime="00:00:00.25"
												Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkDisabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
										<ThicknessAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Storyboard.TargetName="CheckMarkEnabled"
											Storyboard.TargetProperty="Margin">
											<SplineThicknessKeyFrame
												KeyTime="00:00:00.25"
												Value="3,3,3,3" />
										</ThicknessAnimationUsingKeyFrames>
									</Storyboard>
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="false">
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="true">
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="CheckBoxDown"
										Property="UIElement.Opacity"
										Value="1" />
									<Setter
										TargetName="CheckMarkDisabled"
										Property="Margin"
										Value="4,4,2,2" />
									<Setter
										TargetName="CheckMarkEnabled"
										Property="Margin"
										Value="4,4,2,2" />
									<TriggerBase.EnterActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxDownTimeLine}" />
									</TriggerBase.EnterActions>
									<TriggerBase.ExitActions>
										<BeginStoryboard
											Storyboard="{StaticResource CheckBoxUpTimeLine}" />
									</TriggerBase.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="12 24 12 24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="2*" />
			<RowDefinition
				Height="2*" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Border
			Grid.Row="0"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 0 0 5">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="3*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="2"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#e1e1e1"
					BorderThickness="0 1 0 0" />
				<Border
					Grid.Row="1"
					Grid.Column="0">
					<Border.Background>
						<LinearGradientBrush
							MappingMode="Absolute"
							StartPoint="0,0"
							EndPoint="1,1"
							SpreadMethod="Repeat">
							<GradientStop
								Offset="0"
								Color="#c0d537" />
							<GradientStop
								Offset="0.3"
								Color="#c0d537" />
							<GradientStop
								Offset="0.3"
								Color="Transparent" />
							<GradientStop
								Offset="1"
								Color="Transparent" />
							<Brush.Transform>
								<ScaleTransform
									ScaleX="2"
									ScaleY="2" />
							</Brush.Transform>
						</LinearGradientBrush>
					</Border.Background>
				</Border>
				<TextBlock
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=StrWeight.LocalizedText, FallbackValue=Gewicht}" /> (<TextBlock
						Text="{Binding Path=WeightUnitAbbr, FallbackValue=g}" /><TextBlock
						Text=")"
						Margin="0 0 25 0" /></TextBlock>
				<TextBox
					Grid.Row="0"
					Grid.Column="1"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeWeightCommand}">
					<TextBox.Text>
						<MultiBinding
							Converter="{StaticResource weightInGrammWeightUnitConverter}">
							<Binding
								Path="ExpectedWeight"
								Mode="TwoWay"
								UpdateSourceTrigger="PropertyChanged" />
							<Binding
								Path="WeightInGramm" />
						</MultiBinding>
					</TextBox.Text>
				</TextBox>
				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=StrCurrentWeight.LocalizedText, FallbackValue=Aktuelles Gewicht}" /> (<TextBlock
						Text="{Binding Path=WeightUnitAbbr, FallbackValue=g}" /><TextBlock
						Text=")"
						Margin="0 0 25 0" /></TextBlock>
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					Style="{StaticResource disabledTextBox}"
					IsEnabled="False"
					Margin="65 5 65 5">
					<TextBox.Text>
						<MultiBinding
							Converter="{StaticResource weightInGrammWeightUnitConverter}">
							<Binding
								Path="CurrentWeight"
								Mode="TwoWay" />
							<Binding
								Path="WeightInGramm" />
						</MultiBinding>
					</TextBox.Text>
				</TextBox>
			</Grid>
		</Border>
		<Border
			Grid.Row="1"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="3*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="2"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<Border
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					BorderBrush="#e1e1e1"
					BorderThickness="0 1 0 0" />
				<TextBlock
					Margin="20 0 0 0">
					<TextBlock
						Text="{Binding Path=StrMinimum.LocalizedText, FallbackValue=Minimum}" /> (<TextBlock
						Text="{Binding Path=WeightUnitAbbr, FallbackValue=g}" /><TextBlock
						Text=")"
						Margin="0 0 25 0" /></TextBlock>
				<TextBox
					Grid.Row="0"
					Grid.Column="1"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMinWeightCommand}">
					<TextBox.Text>
						<MultiBinding
							Converter="{StaticResource weightInGrammWeightUnitConverter}">
							<Binding
								Path="MinWeight"
								Mode="TwoWay"
								UpdateSourceTrigger="PropertyChanged" />
							<Binding
								Path="WeightInGramm" />
						</MultiBinding>
					</TextBox.Text>
				</TextBox>
				<TextBlock
					Margin="20 0 0 0"
					Grid.Row="1"
					Grid.Column="0">
					<TextBlock
						Text="{Binding Path=StrMaximum.LocalizedText, FallbackValue=Maximum}" /> (<TextBlock
						Text="{Binding Path=WeightUnitAbbr, FallbackValue=g}" /><TextBlock
						Text=")"
						Margin="0 0 25 0" /></TextBlock>
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					common:MouseCommandBehavior.MouseUpCommand="{Binding ChangeMaxWeightCommand}">
					<TextBox.Text>
						<MultiBinding
							Converter="{StaticResource weightInGrammWeightUnitConverter}">
							<Binding
								Path="MaxWeight"
								Mode="TwoWay"
								UpdateSourceTrigger="PropertyChanged" />
							<Binding
								Path="WeightInGramm" />
						</MultiBinding>
					</TextBox.Text>
				</TextBox>
			</Grid>
		</Border>
		<Border
			Grid.Row="2"
			BorderBrush="#a8a8a8"
			BorderThickness="1"
			Background="#d1d1d1"
			Margin="0 5 0 0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="3*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
				</Grid.RowDefinitions>
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="2"
					Background="#e7efc5"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 1 0" />
				<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					BorderBrush="#b6b6b6"
					BorderThickness="0 0 0 1" />
				<TextBlock
					Margin="20 0 25 0"
					Grid.Row="0"
					Grid.Column="0"
					Text="{Binding Path=StrWeightUnit.LocalizedText, FallbackValue=Gewichtseinheit}" />
				<Grid
					Row="0"
					Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<StackPanel
						Grid.Column="0"
						Orientation="Horizontal"
						HorizontalAlignment="Center">
						<TextBlock
							Margin="0 0 10 0"
							Text="g" />
						<l:RadioButtonExtended
							GroupName="rbWeightUnit"
							IsCheckedReal="{Binding Path=WeightInGramm, Mode=TwoWay}" />
					</StackPanel>
					<StackPanel
						Grid.Column="1"
						Orientation="Horizontal"
						HorizontalAlignment="Center">
						<TextBlock
							Margin="0 0 10 0"
							Text="oz" />
						<l:RadioButtonExtended
							GroupName="rbWeightUnit"
							IsCheckedReal="{Binding Path=WeightInOunce, Mode=OneWay}" />
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
